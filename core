RandStr()
{
    local str_size=${1:-8}
    local str_array=(
        q w e r t y u i o p a s d f g h j k l z x c v b n m
        Q W E R T Y U I O P A S D F G H J K L Z X C V B N M
    )
    local str_array_size=${#str_array[*]}
    local str_len=0
    local rand_str="" str_index
    while [[ $str_len -lt $str_size ]]
    do
        str_index=$((RANDOM%str_array_size))
        rand_str="$rand_str${str_array[str_index]}"
        str_len=$((str_len+1))
    done
    echo "$rand_str"
}

