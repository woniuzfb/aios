Trim()
{
    local text="${!1}"
    text="${text#"${text%%[![:space:]]*}"}"
    text="${text%"${text##*[![:space:]]}"}"
    read -r ${1} <<< "$text"
}

JoinByChar()
{
    local IFS="$1"
    shift
    printf "%s" "$*"
}

JoinByString()
{
    local separator="$1"
    shift
    local first="$1"
    shift
    printf "%s" "$first" "${@/#/$separator}"
}

JoinByStringUnquote()
{
    local separator="$1"
    shift

    local cleaned=( "${@#\"}" )
    cleaned=( "${cleaned[@]%\"}" )
    cleaned=( "${cleaned[@]//\\\"/\"}" )
    cleaned=( "${cleaned[@]//\\\\/\\}" )

    local result
    printf -v result "%s%s" "${cleaned[@]/#/$separator}"

    printf "%s" "${result#"$separator"}"
}

ToJsonArray()
{
    local var=("$1"[@])
    if [[ -z "${!var:-}" ]]
    then
        echo "[]"
        return 0
    fi
    local arr=("${!var}")
    local json_array=$(printf '%s\n' "${arr[@]}" | $JQ_FILE -R . | $JQ_FILE -s -c .)
    echo "$json_array"
}

ToQuoteArray()
{
    if [[ -z "${1:-}" ]]
    then
        return 1
    fi

    local keys
    eval "keys=(\"\${!$1[@]}\")"

    if [[ ${#keys[@]} -eq 0 ]]
    then
        return 0
    fi

    local i quoted_ele val

    for i in "${keys[@]}"
    do
        eval "val=\"\${$1[$i]}\""

        quoted_ele="${val//\\/\\\\}"
        quoted_ele="${quoted_ele//\"/\\\"}"
        quoted_ele="\"$quoted_ele\""

        eval "$1[$i]=\"\$quoted_ele\""
    done

    return 0
}

ToUnquoteArray()
{
    if [[ -z "${1:-}" ]]
    then
        return 1
    fi

    local keys
    eval "keys=(\"\${!$1[@]}\")"

    local i val unquoted

    for i in "${keys[@]}"
    do
        eval "val=\"\${$1[$i]}\""

        unquoted="${val#\"}"
        unquoted="${unquoted%\"}"
        unquoted="${unquoted//\\\"/\"}"
        unquoted="${unquoted//\\\\/\\}"

        eval "$1[$i]=\"\$unquoted\""
    done

    return 0
}

ArrayToQuotedList()
{
    ToQuoteArray "$@"

    local var=("$1"[@])

    if [[ -z "${!var:-}" ]]
    then
        return 0
    fi

    local arr=("${!var}")

    JoinByString ', ' "${arr[@]}"
}

ArrayToList()
{
    local var=("$1"[@])

    if [[ -z "${!var:-}" ]]
    then
        return 0
    fi

    local arr=("${!var}")

    JoinByString ', ' "${arr[@]}"
