Edit4gtvAcc()
{
    Select4gtvAcc || return 1

    Set4gtvAccEmail
    Set4gtvAccPass
    new_acc=$(
        $JQ_FILE -n --arg email "$_4gtv_acc_email" --arg password "$_4gtv_acc_pass" \
            '{
                email: $email,
                password: $password
            }'
    )
    jq_merge=true
    jq_path='["4gtv","accounts",'"$_4gtv_accs_index"']'

    if JQ update "$SERVICES_CONFIG" "$new_acc"
    then
        Println "$(eval_gettext "\$info 账号修改成功")\n"
    else
        Println "$(eval_gettext "\$error 账号修改失败")\n"
        return 1
    fi
}
