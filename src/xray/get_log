XrayGetLog()
{
    SetDelimiters

    jq_payload=$(JQs flat "$X_CONFIG" '.log')

    jq_path='[
        ["access"],
        ["error"],
        ["loglevel"],
        ["dnsLog"],
        ["maskAddress"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name="$path_name"
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    log_access="${jq_access:-none}"
    log_error="${jq_error:-none}"
    log_loglevel="${jq_loglevel:-warning}"
    log_dnsLog="${jq_dnsLog:-false}"
    log_maskAddress="${jq_maskAddress:-}"

    return 0
}
