XrayGetVersion()
{
    SetDelimiters

    jq_payload=$(JQs flat "$X_CONFIG" '.version')

    jq_path='[
        ["min"],
        ["max"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name="version_${path_name#*_}"
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    return 0

}
