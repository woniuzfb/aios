XrayGetApi()
{
    SetDelimiters

    jq_payload=$(JQs flat "$X_CONFIG" '.api')

    jq_path='[
        ["tag"],
        ["listen"],
        ["services"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name="api_${path_name#*_}"
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    return 0
}
