XrayGetBin()
{
    if [ -n "${XRAY_FILE:-}" ] && [ -x "$XRAY_FILE" ]
    then
        printf '%s' "$XRAY_FILE"
    elif [ -n "${XCTL_FILE:-}" ] && [ -x "$XCTL_FILE" ]
    then
        printf '%s' "$XCTL_FILE"
    elif command -v xray > /dev/null 2>&1
    then
        command -v xray
    fi
}

XrayAddInbound()
{
    local mode_options=( "$(gettext "直连 xray 入站")" "$(gettext "本地 nginx 反代入站")" )
    local mode_idx=0
    echo
    inquirer list_input_index "$(gettext "选择入站模式")" mode_options mode_idx

    local proto_options=( 'vless' 'vmess' 'trojan' 'shadowsocks' 'socks' 'http' 'tunnel' 'hysteria' 'wireguard' 'tun' 'masque' )
    local proto_idx=0
    inquirer list_input_index "$(gettext "选择入站协议")" proto_options proto_idx
    local protocol="${proto_options[$proto_idx]}"

    local default_listen="0.0.0.0"
    local tag_prefix="${protocol}-"
    if [ "$mode_idx" -eq 1 ]
    then
        default_listen="127.0.0.1"
        tag_prefix="nginx-${protocol}-"
    fi

    local listen port tag
    inquirer text_input "$(gettext "输入监听地址")" listen "$default_listen"
    inquirer text_input "$(gettext "输入监听端口 (留空随机)")" port ""
    if [ -z "$port" ]
    then
        port=$(GetFreePort)
    fi
    if [[ $port =~ ^[0-9]+$ ]]
    then
        if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]
        then
            Println "$(eval_gettext "\$error 监听端口必须在 1-65535 之间")\n"
            return 1
        fi
    elif [[ ! $port =~ ^[0-9]+-[0-9]+$ ]]
    then
        Println "$(eval_gettext "\$error 监听端口格式无效 (应为端口或端口范围, 如 443 或 10000-20000)")\n"
        return 1
    fi
    inquirer text_input "$(gettext "输入入站标识 (留空随机)")" tag ""
    if [ -z "$tag" ]
    then
        tag=$(ProxyGetFreeTag "$X_CONFIG" "$tag_prefix")
    elif [ "$mode_idx" -eq 1 ] && [ "${tag:0:6}" != "nginx-" ]
    then
        tag="nginx-${tag}"
    fi

    local xray_bin
    xray_bin=$(XrayGetBin)

    local settings_json='{}'
    case "$protocol" in
        vless)
            local uuid flow email decryption
            inquirer text_input "$(gettext "输入用户 UUID (留空自动生成)")" uuid ""
            if [ -z "$uuid" ]
            then
                if [ -n "$xray_bin" ]
                then
                    uuid=$("$xray_bin" uuid 2> /dev/null | head -n 1 | tr -d '\r\n')
                fi
                if [ -z "$uuid" ] && command -v uuidgen > /dev/null 2>&1
                then
                    uuid=$(uuidgen 2> /dev/null | tr '[:upper:]' '[:lower:]' | tr -d '\r\n')
                fi
                if [ -z "$uuid" ] && [ -r /proc/sys/kernel/random/uuid ]
                then
                    uuid=$(cat /proc/sys/kernel/random/uuid | tr -d '\r\n')
                fi
                if [ -z "$uuid" ]
                then
                    Println "$(eval_gettext "\$error 自动生成 UUID 失败, 请手动输入")\n"
                    return 1
                fi
                Println "$(eval_gettext "\$info 已自动生成 UUID: \${green}\${uuid}\${normal}")\n"
            fi
            inquirer text_input "$(gettext "输入流控 flow (如 xtls-rprx-vision, 可留空)")" flow ""
            inquirer text_input "$(gettext "输入用户 email (可留空)")" email ""
            inquirer text_input "$(gettext "输入 decryption")" decryption "none"
            JQs build settings_json '{
                "decryption": $decryption,
                "users": [{"id": $id, "flow": $flow, "email": $email, "level": 0}]
            }' --arg decryption "$decryption" --arg id "$uuid" --arg flow "$flow" --arg email "$email"
        ;;
        vmess)
            local uuid email
            inquirer text_input "$(gettext "输入用户 UUID (留空自动生成)")" uuid ""
            if [ -z "$uuid" ]
            then
                if [ -n "$xray_bin" ]
                then
                    uuid=$("$xray_bin" uuid 2> /dev/null | head -n 1 | tr -d '\r\n')
                fi
                if [ -z "$uuid" ] && command -v uuidgen > /dev/null 2>&1
                then
                    uuid=$(uuidgen 2> /dev/null | tr '[:upper:]' '[:lower:]' | tr -d '\r\n')
                fi
                if [ -z "$uuid" ] && [ -r /proc/sys/kernel/random/uuid ]
                then
                    uuid=$(cat /proc/sys/kernel/random/uuid | tr -d '\r\n')
                fi
                if [ -z "$uuid" ]
                then
                    Println "$(eval_gettext "\$error 自动生成 UUID 失败, 请手动输入")\n"
                    return 1
                fi
                Println "$(eval_gettext "\$info 已自动生成 UUID: \${green}\${uuid}\${normal}")\n"
            fi
            inquirer text_input "$(gettext "输入用户 email (可留空)")" email ""
            JQs build settings_json '{
                "users": [{"id": $id, "email": $email, "level": 0}]
            }' --arg id "$uuid" --arg email "$email"
        ;;
        trojan)
            local password email
            inquirer text_input "$(gettext "输入密码")" password ""
            inquirer text_input "$(gettext "输入用户 email (可留空)")" email ""
            JQs build settings_json '{
                "users": [{"password": $password, "email": $email, "level": 0}]
            }' --arg password "$password" --arg email "$email"
        ;;
        shadowsocks)
            local method password network email
            inquirer text_input "$(gettext "输入加密方式")" method "2022-blake3-aes-256-gcm"
            inquirer text_input "$(gettext "输入密钥 (SS2022 留空自动生成)")" password ""
            if [ -z "$password" ] && [[ "$method" == 2022-* ]]
            then
                local ss_bytes=32
                if [[ "$method" == *aes-128* ]]
                then
                    ss_bytes=16
                fi
                password=$(openssl rand -base64 "$ss_bytes" 2> /dev/null | tr -d '\r\n')
                if [ -z "$password" ]
                then
                    Println "$(eval_gettext "\$error 自动生成 SS2022 密钥失败, 请手动输入")\n"
                    return 1
                fi
                Println "$(eval_gettext "\$info 已自动生成 SS2022 密钥: \${green}\${password}\${normal}")\n"
            fi
            inquirer text_input "$(gettext "输入监听网络 (tcp/udp/tcp,udp)")" network "tcp,udp"
            inquirer text_input "$(gettext "输入用户 email (可留空)")" email ""
            JQs build settings_json '{
                "method": $method,
                "password": $password,
                "network": $network,
                "email": $email
            }' --arg method "$method" --arg password "$password" --arg network "$network" --arg email "$email"
        ;;
        socks)
            local auth_opts=( 'noauth' 'password' )
            local auth="" udp_idx=1 user="" pass=""
            local yn_opts=( "$(gettext "否")" "$(gettext "是")" )
            inquirer list_input "$(gettext "选择认证方式 auth")" auth_opts auth
            inquirer list_input_index "$(gettext "开启 UDP 转发")" yn_opts udp_idx
            if [ "$auth" == "password" ]
            then
                inquirer text_input "$(gettext "输入用户名")" user ""
                inquirer text_input "$(gettext "输入密码")" pass ""
                JQs build settings_json '{
                    "auth": $auth,
                    "udp": ($udp == "1"),
                    "users": [{"user": $user, "pass": $pass}]
                }' --arg auth "$auth" --arg udp "$udp_idx" --arg user "$user" --arg pass "$pass"
            else
                JQs build settings_json '{
                    "auth": $auth,
                    "udp": ($udp == "1")
                }' --arg auth "$auth" --arg udp "$udp_idx"
            fi
        ;;
        http)
            local user pass
            inquirer text_input "$(gettext "输入用户名 (留空无认证)")" user ""
            if [ -n "$user" ]
            then
                inquirer text_input "$(gettext "输入密码")" pass ""
                JQs build settings_json '{
                    "users": [{"user": $user, "pass": $pass}]
                }' --arg user "$user" --arg pass "$pass"
            fi
        ;;
        tunnel)
            local rw_addr rw_port allowed_net fr_idx=0
            local yn_opts=( "$(gettext "否")" "$(gettext "是")" )
            inquirer text_input "$(gettext "输入目标转发地址")" rw_addr "127.0.0.1"
            inquirer text_input "$(gettext "输入目标转发端口")" rw_port "8080"
            if [[ ! $rw_port =~ ^[0-9]+$ ]] || [ "$rw_port" -lt 1 ] || [ "$rw_port" -gt 65535 ]
            then
                Println "$(eval_gettext "\$error 目标转发端口必须为 1-65535 的整数")\n"
                return 1
            fi
            inquirer text_input "$(gettext "输入允许网络 (tcp/udp/tcp,udp)")" allowed_net "tcp"
            inquirer list_input_index "$(gettext "启用 followRedirect")" yn_opts fr_idx
            JQs build settings_json '{
                "rewriteAddress": $addr,
                "rewritePort": ($port | tonumber),
                "allowedNetwork": $net,
                "followRedirect": ($fr == "1")
            }' --arg addr "$rw_addr" --arg port "$rw_port" --arg net "$allowed_net" --arg fr "$fr_idx"
        ;;
        hysteria)
            local auth email
            inquirer text_input "$(gettext "输入认证密钥 auth")" auth ""
            inquirer text_input "$(gettext "输入用户 email (可留空)")" email ""
            JQs build settings_json '{
                "version": 2,
                "users": [{"auth": $auth, "email": $email, "level": 0}]
            }' --arg auth "$auth" --arg email "$email"
        ;;
        wireguard)
            local secret_key peer_pub allowed_ip mtu
            inquirer text_input "$(gettext "输入服务端 secretKey (留空自动生成)")" secret_key ""
            if [ -z "$secret_key" ]
            then
                if [ -n "$xray_bin" ]
                then
                    local wg_out wg_pub=""
                    wg_out=$("$xray_bin" wg 2> /dev/null)
                    secret_key=$(printf '%s\n' "$wg_out" | awk -F': ' '/^Private[ ]?[Kk]ey:/ {print $2; exit}' | tr -d '\r\n ')
                    wg_pub=$(printf '%s\n' "$wg_out" | awk -F': ' '/^Public[ ]?[Kk]ey:/ {print $2; exit}' | tr -d '\r\n ')
                    if [ -n "$secret_key" ]
                    then
                        Println "$(eval_gettext "\$info 已自动生成 WireGuard secretKey: \${green}\${secret_key}\${normal}")\n"
                        if [ -n "$wg_pub" ]
                        then
                            Println "$(eval_gettext "\$info 对应服务端 publicKey: \${green}\${wg_pub}\${normal}")\n"
                        fi
                    fi
                fi
                if [ -z "$secret_key" ]
                then
                    Println "$(eval_gettext "\$error 自动生成 WireGuard secretKey 失败, 请手动输入")\n"
                    return 1
                fi
            fi
            inquirer text_input "$(gettext "输入对端 publicKey")" peer_pub ""
            inquirer text_input "$(gettext "输入 allowedIPs (逗号分隔)")" allowed_ip "10.0.0.2/32"
            inquirer text_input "$(gettext "输入 MTU")" mtu "1420"
            if [[ ! $mtu =~ ^[0-9]+$ ]]
            then
                Println "$(eval_gettext "\$error MTU 必须为正整数")\n"
                return 1
            fi
            JQs build settings_json '{
                "secretKey": $sk,
                "mtu": ($mtu | tonumber),
                "peers": [{"publicKey": $pk, "allowedIPs": ($ips | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0)))}]
            }' --arg sk "$secret_key" --arg mtu "$mtu" --arg pk "$peer_pub" --arg ips "$allowed_ip"
        ;;
        tun)
            local tun_name tun_mtu tun_gw tun_dns
            inquirer text_input "$(gettext "TUN 网卡名称")" tun_name "xray0"
            inquirer text_input "MTU" tun_mtu "1500"
            if [[ ! $tun_mtu =~ ^[0-9]+$ ]]
            then
                Println "$(eval_gettext "\$error MTU 必须为正整数")\n"
                return 1
            fi
            inquirer text_input "$(gettext "gateway (逗号分隔, 可留空)")" tun_gw ""
            inquirer text_input "$(gettext "dns (逗号分隔, 可留空)")" tun_dns ""
            JQs build settings_json '{
                "name": $name,
                "mtu": ($mtu | tonumber),
                "gateway": (if $gw != "" then ($gw | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))) else null end),
                "dns": (if $dns != "" then ($dns | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))) else null end)
            }' --arg name "$tun_name" --arg mtu "$tun_mtu" --arg gw "$tun_gw" --arg dns "$tun_dns"
        ;;
        masque)
            local m_addr m_mtu m_pass m_email
            inquirer text_input "$(gettext "MASQUE address (逗号分隔)")" m_addr "10.0.0.1/24"
            inquirer text_input "MTU" m_mtu "1280"
            if [[ ! $m_mtu =~ ^[0-9]+$ ]]
            then
                Println "$(eval_gettext "\$error MTU 必须为正整数")\n"
                return 1
            fi
            inquirer text_input "$(gettext "用户 pass")" m_pass ""
            inquirer text_input "$(gettext "用户 email (必填, 不能包含 :)")" m_email ""
            if [ -z "$m_email" ] || [[ "$m_email" == *:* ]]
            then
                Println "$(eval_gettext "\$error MASQUE 用户 email 必填且不能包含 :")\n"
                return 1
            fi
            JQs build settings_json '{
                "address": ($addr | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))),
                "mtu": ($mtu | tonumber),
                "users": [{"pass": $pass, "email": $email, "level": 0}]
            }' --arg addr "$m_addr" --arg mtu "$m_mtu" --arg pass "$m_pass" --arg email "$m_email"
        ;;
    esac

    local network="" security=""
    if [ "$protocol" == "masque" ]
    then
        network="masque"
        security="tls"
    elif [ "$protocol" == "hysteria" ]
    then
        network="hysteria"
        security="tls"
    else
        local net_options=( 'raw' 'xhttp' 'ws' 'grpc' 'httpupgrade' 'kcp' 'hysteria' )
        local net_idx=0
        inquirer list_input_index "$(gettext "选择传输方式")" net_options net_idx
        network="${net_options[$net_idx]}"

        if [ "$network" == "hysteria" ]
        then
            security="tls"
        elif [ "$network" == "raw" ] || [ "$network" == "xhttp" ] || [ "$network" == "grpc" ]
        then
            local sec_options=( 'none' 'tls' 'reality' )
            local sec_idx=0
            inquirer list_input_index "$(gettext "选择传输安全")" sec_options sec_idx
            security="${sec_options[$sec_idx]}"
        else
            local sec_options=( 'none' 'tls' )
            local sec_idx=0
            inquirer list_input_index "$(gettext "选择传输安全")" sec_options sec_idx
            security="${sec_options[$sec_idx]}"
        fi
    fi

    if [ "$security" == "reality" ] && [ "$network" != "raw" ] && [ "$network" != "xhttp" ] && [ "$network" != "grpc" ]
    then
        Println "$(eval_gettext "\$tip REALITY 仅支持 raw/xhttp/grpc, 已自动回退为 tls")\n"
        security="tls"
    fi

    local xhttp_host="" xhttp_path="" xhttp_mode=""
    local ws_path="" ws_host="" grpc_svc="" hu_path="" hu_host=""
    local tls_sni="" tls_cert="" tls_key=""
    local r_target="" r_sni="" r_pk="" r_sid=""

    case "$network" in
        xhttp)
            inquirer text_input "$(gettext "XHTTP host (可留空)")" xhttp_host ""
            inquirer text_input "XHTTP path" xhttp_path "/"
            local xm_opts=( 'auto' 'packet-up' 'stream-up' 'stream-one' )
            inquirer list_input "$(gettext "选择 XHTTP mode")" xm_opts xhttp_mode
        ;;
        ws)
            inquirer text_input "WebSocket path" ws_path "/"
            inquirer text_input "$(gettext "WebSocket host (可留空)")" ws_host ""
        ;;
        grpc)
            inquirer text_input "gRPC serviceName" grpc_svc ""
        ;;
        httpupgrade)
            inquirer text_input "HTTPUpgrade path" hu_path "/"
            inquirer text_input "$(gettext "HTTPUpgrade host (可留空)")" hu_host ""
        ;;
    esac

    if [ "$security" == "tls" ]
    then
        inquirer text_input "$(gettext "TLS serverName (可留空)")" tls_sni ""
        inquirer text_input "$(gettext "证书文件路径 certificateFile")" tls_cert ""
        inquirer text_input "$(gettext "私钥文件路径 keyFile")" tls_key ""
    elif [ "$security" == "reality" ]
    then
        inquirer text_input "$(gettext "REALITY target (如 www.example.com:443)")" r_target ""
        inquirer text_input "$(gettext "REALITY serverNames (逗号分隔)")" r_sni ""
        inquirer text_input "$(gettext "REALITY privateKey (留空自动生成)")" r_pk ""
        if [ -z "$r_pk" ]
        then
            if [ -n "$xray_bin" ]
            then
                local x25519_out r_pub=""
                x25519_out=$("$xray_bin" x25519 2> /dev/null)
                r_pk=$(printf '%s\n' "$x25519_out" | awk -F': ' '/^Private[ ]?[Kk]ey:/ {print $2; exit}' | tr -d '\r\n ')
                r_pub=$(printf '%s\n' "$x25519_out" | awk -F': ' '/^(Password|Public[ ]?[Kk]ey):/ {print $2; exit}' | tr -d '\r\n ')
                if [ -n "$r_pk" ]
                then
                    Println "$(eval_gettext "\$info 已自动生成 REALITY privateKey: \${green}\${r_pk}\${normal}")\n"
                    if [ -n "$r_pub" ]
                    then
                        Println "$(eval_gettext "\$info 对应客户端公钥 (Password/PublicKey): \${green}\${r_pub}\${normal}")\n"
                    fi
                fi
            fi
            if [ -z "$r_pk" ]
            then
                Println "$(eval_gettext "\$error 自动生成 REALITY privateKey 失败, 请手动输入")\n"
                return 1
            fi
        fi
        inquirer text_input "$(gettext "REALITY shortIds (逗号分隔, 留空默认为 [\"\"])")" r_sid ""
    fi

    local yn_opts=( "$(gettext "否")" "$(gettext "是")" )
    local sniff_idx=1 route_only_idx=0
    inquirer list_input_index "$(gettext "开启流量探测 sniffing")" yn_opts sniff_idx
    if [ "$sniff_idx" -eq 1 ]
    then
        inquirer list_input_index "$(gettext "嗅探域名仅用于路由 routeOnly")" yn_opts route_only_idx
    fi

    local inbound_json=""
    JQs build inbound_json '{
        "listen": $listen,
        "port": (if ($port | test("^[0-9]+$")) then ($port | tonumber) else $port end),
        "protocol": $protocol,
        "tag": $tag,
        "settings": $settings,
        "streamSettings": {
            "network": $network,
            "security": $security,
            "xhttpSettings": (if $network == "xhttp" then {"host": $xh_host, "path": $xh_path, "mode": $xh_mode} else null end),
            "wsSettings": (if $network == "ws" then {"path": $ws_path, "host": $ws_host} else null end),
            "grpcSettings": (if $network == "grpc" then {"serviceName": $grpc_svc} else null end),
            "httpupgradeSettings": (if $network == "httpupgrade" then {"path": $hu_path, "host": $hu_host} else null end),
            "hysteriaSettings": (if $network == "hysteria" then {"version": 2} else null end),
            "tlsSettings": (if $security == "tls" then {
                "serverName": $tls_sni,
                "certificates": (if $tls_cert != "" then [{"certificateFile": $tls_cert, "keyFile": $tls_key}] else [] end)
            } else null end),
            "realitySettings": (if $security == "reality" then {
                "target": $r_target,
                "serverNames": (if $r_sni != "" then ($r_sni | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))) else [] end),
                "privateKey": $r_pk
            } else null end)
        },
        "sniffing": {
            "enabled": ($sniff == "1"),
            "destOverride": (if $sniff == "1" then ["http", "tls", "quic"] else [] end),
            "routeOnly": ($route_only == "1")
        }
    }' \
        --arg listen "$listen" \
        --arg port "$port" \
        --arg protocol "$protocol" \
        --arg tag "$tag" \
        --argjson settings "$settings_json" \
        --arg network "$network" \
        --arg security "$security" \
        --arg xh_host "$xhttp_host" \
        --arg xh_path "$xhttp_path" \
        --arg xh_mode "$xhttp_mode" \
        --arg ws_path "$ws_path" \
        --arg ws_host "$ws_host" \
        --arg grpc_svc "$grpc_svc" \
        --arg hu_path "$hu_path" \
        --arg hu_host "$hu_host" \
        --arg tls_sni "$tls_sni" \
        --arg tls_cert "$tls_cert" \
        --arg tls_key "$tls_key" \
        --arg r_target "$r_target" \
        --arg r_sni "$r_sni" \
        --arg r_pk "$r_pk" \
        --arg sniff "$sniff_idx" \
        --arg route_only "$route_only_idx"

    if [ "$security" == "reality" ]
    then
        inbound_json=$($JQ_FILE -c --arg r_sid "$r_sid" '
            .streamSettings.realitySettings = (.streamSettings.realitySettings // {})
            | .streamSettings.realitySettings.shortIds = (
                if $r_sid == "" then
                    [""]
                else
                    ($r_sid | split(",") | map(gsub("^\\s+|\\s+$"; "")))
                end
            )
        ' <<< "$inbound_json")
    fi

    if [ "$network" == "masque" ]
    then
        inbound_json=$($JQ_FILE -c '
            .streamSettings.masqueSettings = (.streamSettings.masqueSettings // {})
        ' <<< "$inbound_json")
    fi

    if ! ProxyAddBound "$X_CONFIG" inbounds "$inbound_json"
    then
        Println "$(eval_gettext "\$error 添加 Xray 入站 \${tag} 失败")\n"
        return 1
    fi
    ProxyRestartIfActive xray
    Println "$(eval_gettext "\$info 已添加 Xray 入站 \${green}\${tag}\${normal} (\${protocol})")\n"
}
