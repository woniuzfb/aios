XrayGenUuid()
{
    local xray_bin=""
    xray_bin=$(ProxyDetectCoreBin "xray")

    local gen=""
    if [ -n "$xray_bin" ] && [ -x "$xray_bin" ]
    then
        gen=$("$xray_bin" uuid 2> /dev/null | head -n 1 | tr -d '\r\n')
    fi
    if [ -z "$gen" ] && command -v uuidgen > /dev/null 2>&1
    then
        gen=$(uuidgen 2> /dev/null | tr '[:upper:]' '[:lower:]' | tr -d '\r\n')
    fi
    if [ -z "$gen" ] && [ -r /proc/sys/kernel/random/uuid ]
    then
        gen=$(cat /proc/sys/kernel/random/uuid | tr -d '\r\n')
    fi
    printf '%s' "$gen"
}

XrayGenSs2022Key()
{
    local method="$1"
    local bytes=""
    if ! bytes=$(ProxySs2022KeyBytes "$method")
    then
        return 1
    fi

    openssl rand -base64 "$bytes" 2> /dev/null | tr -d '\r\n'
}

XrayAddInboundAccount()
{
    ProxySelectBound "$X_CONFIG" inbounds "$(gettext "选择要添加账号的入站")" || return 1
    local idx="$selected_bound_index"
    local bound_tag="${inbounds_tag[idx]}"
    local protocol="${inbounds_protocol[idx]}"
    local user_json=""
    local target_ver=""
    target_ver=$(ProxyGetTargetVersion "xray")
    local acc_key=""

    if [ "$protocol" == "wireguard" ]
    then
        acc_key="peers"
    else
        acc_key=$(ProxyXrayInboundUserKey "$protocol" "$target_ver")
    fi

    case "$protocol" in
        vless)
            local uuid flow email
            inquirer text_input "$(gettext "输入用户 UUID (留空自动生成)")" uuid ""
            if [ -z "$uuid" ]
            then
                uuid=$(XrayGenUuid)
                if [ -z "$uuid" ]
                then
                    Println "$(eval_gettext "\$error 自动生成 UUID 失败, 请手动输入")\n"
                    return 1
                fi
                Println "$(eval_gettext "\$info 已自动生成 UUID: \${green}\${uuid}\${normal}")\n"
            fi
            inquirer text_input "$(gettext "输入 flow (可留空)")" flow ""
            inquirer text_input "$(gettext "输入 email (可留空)")" email ""
            JQs build user_json '{"id": $id, "flow": $flow, "email": $email, "level": 0}' \
                --arg id "$uuid" --arg flow "$flow" --arg email "$email"
        ;;
        vmess)
            local uuid email
            inquirer text_input "$(gettext "输入用户 UUID (留空自动生成)")" uuid ""
            if [ -z "$uuid" ]
            then
                uuid=$(XrayGenUuid)
                if [ -z "$uuid" ]
                then
                    Println "$(eval_gettext "\$error 自动生成 UUID 失败, 请手动输入")\n"
                    return 1
                fi
                Println "$(eval_gettext "\$info 已自动生成 UUID: \${green}\${uuid}\${normal}")\n"
            fi
            inquirer text_input "$(gettext "输入 email (可留空)")" email ""
            JQs build user_json '{"id": $id, "email": $email, "level": 0}' \
                --arg id "$uuid" --arg email "$email"
        ;;
        trojan)
            local password email
            inquirer text_input "$i18n_input_password" password ""
            inquirer text_input "$(gettext "输入 email (可留空)")" email ""
            JQs build user_json '{"password": $pw, "email": $email, "level": 0}' \
                --arg pw "$password" --arg email "$email"
        ;;
        shadowsocks)
            local inb_method="" inb_psk=""
            SetDelimiters
            IFS="$field_sep" read -r inb_method inb_psk < <(JQs query "$X_CONFIG" '
                if (.inbounds | type) == "array" and (.inbounds[$i] | type) == "object"
                    and (.inbounds[$i].settings | type) == "object"
                then [(.inbounds[$i].settings.method // "" | tostring), (.inbounds[$i].settings.password // "" | tostring)] | join($sep)
                else $sep end
            ' --argjson i "$idx" --arg sep "$field_sep")
            inb_method=$(ProxyNormalizeSsMethod "$inb_method")
            local ss_rc=0
            ProxyValidateXraySsMultiUser "$inb_method" "$inb_psk" || ss_rc=$?
            if [ "$ss_rc" -eq 2 ]
            then
                Println "$(eval_gettext "\$error 2022-blake3-chacha20-poly1305 不支持多用户入站")\n"
                return 1
            elif [ "$ss_rc" -eq 3 ]
            then
                Println "$(eval_gettext "\$error SS-2022 多用户入站缺少顶层服务端 password PSK")\n"
                return 1
            fi
            local password email user_method=""
            if [[ "$inb_method" == 2022-* ]]
            then
                inquirer text_input "$(gettext "输入密钥 (SS2022 留空自动生成)")" password ""
                if [ -z "$password" ]
                then
                    password=$(XrayGenSs2022Key "$inb_method")
                    if [ -z "$password" ]
                    then
                        Println "$(eval_gettext "\$error 自动生成 SS2022 密钥失败, 请手动输入")\n"
                        return 1
                    fi
                    Println "$(eval_gettext "\$info 已自动生成 SS2022 密钥: \${green}\${password}\${normal}")\n"
                fi
                inquirer text_input "$(gettext "输入 email (可留空)")" email ""
                JQs build user_json '{"password": $pw, "email": $email, "level": 0}' \
                    --arg pw "$password" --arg email "$email"
            else
                inquirer text_input "$(gettext "输入用户加密方式 method")" user_method "${inb_method:-aes-256-gcm}"
                user_method=$(ProxyNormalizeSsMethod "$user_method")
                inquirer text_input "$i18n_input_password" password ""
                inquirer text_input "$(gettext "输入 email (可留空)")" email ""
                JQs build user_json '{"method": $method, "password": $pw, "email": $email, "level": 0}' \
                    --arg method "$user_method" --arg pw "$password" --arg email "$email"
            fi
        ;;
        socks|http)
            local user pass
            inquirer text_input "$(gettext "输入用户名")" user ""
            inquirer text_input "$i18n_input_password" pass ""
            JQs build user_json '{"user": $user, "pass": $pass}' \
                --arg user "$user" --arg pass "$pass"
        ;;
        hysteria)
            local auth email
            inquirer text_input "$(gettext "输入认证密钥 auth")" auth ""
            inquirer text_input "$(gettext "输入 email (可留空)")" email ""
            JQs build user_json '{"auth": $auth, "email": $email, "level": 0}' \
                --arg auth "$auth" --arg email "$email"
        ;;
        masque)
            local pass email
            inquirer text_input "$(gettext "输入用户 pass")" pass ""
            inquirer text_input "$(gettext "输入用户 email (必填, 不能包含 :)")" email ""
            if [ -z "$email" ] || [[ "$email" == *:* ]]
            then
                Println "$(eval_gettext "\$error MASQUE 用户 email 必填且不能包含 :")\n"
                return 1
            fi
            JQs build user_json '{"pass": $pass, "email": $email, "level": 0}' \
                --arg pass "$pass" --arg email "$email"
        ;;
        wireguard)
            local pk allowed_ips psk
            inquirer text_input "$(gettext "输入对端 publicKey")" pk ""
            inquirer text_input "$(gettext "输入 allowedIPs (逗号分隔)")" allowed_ips "10.0.0.2/32"
            inquirer text_input "$(gettext "输入 preSharedKey (可留空)")" psk ""
            JQs build user_json '{
                "publicKey": $pk,
                "allowedIPs": ($ips | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))),
                "preSharedKey": $psk
            }' --arg pk "$pk" --arg ips "$allowed_ips" --arg psk "$psk"
        ;;
        *)
            Println "$(eval_gettext "\$error 协议 \${protocol} 不支持多账号管理")\n"
            return 1
        ;;
    esac

    if ! ProxyMutateConfigTx "xray" '
        def arr($x): if ($x | type) == "array" then $x else [] end;
        def pick_list($a; $b; $c):
            if (arr($a) | length) > 0 then arr($a)
            elif (arr($b) | length) > 0 then arr($b)
            elif (arr($c) | length) > 0 then arr($c)
            else [] end;
        .inbounds[$i].settings |= (
            (if $proto == "shadowsocks" and ((.method // "") | ascii_downcase | startswith("2022-") | not)
                and ((.password // "") != "")
                and ((pick_list(.users; .clients; .accounts) | length) == 0)
             then
                .[$k] = [{method: ((.method // "aes-256-gcm") | ascii_downcase), password: .password, email: (.email // ""), level: (.level // 0)}]
                | del(.password, .email)
             else . end)
            | (if $k == "users" then
                .users = (pick_list(.users; .clients; .accounts) + [$u])
                | del(.clients, .accounts)
               elif $k == "clients" then
                .clients = (pick_list(.clients; .users; null) + [$u])
                | del(.users)
               elif $k == "accounts" then
                .accounts = (pick_list(.accounts; .users; null) + [$u])
                | del(.users)
               else
                .[$k] = (arr(.[$k]) + [$u])
               end)
        )
    ' --argjson i "$idx" --arg k "$acc_key" --arg proto "$protocol" --argjson u "$user_json"
    then
        local err_detail="${PROXY_LAST_VALIDATE_ERROR:-unknown}"
        Println "$(eval_gettext "\$error 向入站 \${bound_tag} 添加账号失败: \$err_detail")\n"
        return 1
    fi
    Println "$(eval_gettext "\$info 已向入站 \${green}\${bound_tag}\${normal} 添加账号")\n"
}

XrayDeleteInboundAccount()
{
    ProxySelectBound "$X_CONFIG" inbounds "$(gettext "选择要删除账号的入站")" || return 1
    local idx="$selected_bound_index"
    local acc_key
    acc_key=$(JQs query "$X_CONFIG" '
        if (.inbounds | type) == "array" and (.inbounds[$i] | type) == "object"
            and (.inbounds[$i].settings | type) == "object"
        then
            if (.inbounds[$i].settings.peers | type) == "array" and (.inbounds[$i].settings.peers | length) > 0 then "peers"
            elif (.inbounds[$i].settings.users | type) == "array" and (.inbounds[$i].settings.users | length) > 0 then "users"
            elif (.inbounds[$i].settings.clients | type) == "array" and (.inbounds[$i].settings.clients | length) > 0 then "clients"
            elif (.inbounds[$i].settings.accounts | type) == "array" and (.inbounds[$i].settings.accounts | length) > 0 then "accounts"
            else "" end
        else "" end
    ' --argjson i "$idx")

    if [ -z "$acc_key" ]
    then
        Println "$(eval_gettext "\$error 该入站没有可删除的账号")\n"
        return 1
    fi

    local user_options=()
    local line
    while IFS= read -r line
    do
        [ -n "$line" ] && user_options+=("$line")
    done < <(JQs query "$X_CONFIG" '
        (if (.inbounds | type) == "array" and (.inbounds[$i] | type) == "object"
            and (.inbounds[$i].settings | type) == "object"
            and (.inbounds[$i].settings[$k] | type) == "array"
         then .inbounds[$i].settings[$k]
         else [] end)
        | to_entries[]
        | select(.value | type == "object")
        | "\(.key + 1). \(.value.email // .value.id // .value.user // .value.publicKey // .value.password // .value.pass // .value.auth // "user")"
    ' --argjson i "$idx" --arg k "$acc_key")

    if [ "${#user_options[@]}" -eq 0 ]
    then
        Println "$(eval_gettext "\$error 该入站没有可删除的账号")\n"
        return 1
    fi

    local user_idx=0
    echo
    inquirer list_input_index "$(gettext "选择要删除的账号")" user_options user_idx
    if ! ProxyMutateConfigTx "xray" 'del(.inbounds[$i].settings[$k][$u])' \
        --argjson i "$idx" --arg k "$acc_key" --argjson u "$user_idx"
    then
        local err_detail="${PROXY_LAST_VALIDATE_ERROR:-unknown}"
        Println "$(eval_gettext "\$error 删除账号失败: \$err_detail")\n"
        return 1
    fi
    local del_user="${user_options[user_idx]}"
    Println "$(eval_gettext "\$info 已删除账号 \${green}\${del_user}\${normal}")\n"
}
