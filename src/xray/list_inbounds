        stream_settings_list="${stream_settings_list}maxIdleTimeout: ${green}${inbounds_streamSettings_quicParams_maxIdleTimeout[inbounds_index]:-30}${normal} keepAlivePeriod: ${green}${inbounds_streamSettings_quicParams_keepAlivePeriod[inbounds_index]:-0}${normal}\n${indent_6}"
