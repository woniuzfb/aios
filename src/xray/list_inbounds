        stream_settings_list="${stream_settings_list}maxOutgoingStreams: ${green}${inbounds_streamSettings_quicParams_maxOutgoingStreams[inbounds_index]:-0}${normal}\n${indent_6}"

        stream_settings_list="${stream_settings_list}${red}sockopt${normal} mark: ${green}${inbounds_streamSettings_sockopt_mark[inbounds_index]:-0}${normal} tcpMaxSeg: ${green}${inbounds_streamSettings_sockopt_tcpMaxSeg[inbounds_index]:-1440}${normal}\n${indent_6}"
        stream_settings_list="${stream_settings_list}tcpFastOpen: ${green}${inbounds_streamSettings_sockopt_tcpFastOpen[inbounds_index]:-false}${normal} tproxy: ${green}${inbounds_streamSettings_sockopt_tproxy[inbounds_index]:-false}${normal}\n${indent_6}"
        stream_settings_list="${stream_settings_list}domainStrategy: ${green}${inbounds_streamSettings_sockopt_domainStrategy[inbounds_index]:-AsIs} dialerProxy: ${green}${inbounds_streamSettings_sockopt_dialerProxy[inbounds_index]:-}${normal}\n${indent_6}"
        stream_settings_list="${stream_settings_list}acceptProxyProtocol: ${green}${inbounds_streamSettings_sockopt_acceptProxyProtocol[inbounds_index]:-false}${normal} trustedXForwardedFor: ${green}${inbounds_streamSettings_sockopt_trustedXForwardedFor[inbounds_index]:-}${normal}\n${indent_6}"
