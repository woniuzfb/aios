        stream_settings_list="${stream_settings_list}tcpUserTimeout: ${green}${inbounds_streamSettings_sockopt_tcpUserTimeout[inbounds_index]:-10000}${normal} tcpcongestion: ${green}${inbounds_streamSettings_sockopt_tcpcongestion[inbounds_index]:-bbr}${normal}\n${indent_6}"
        stream_settings_list="${stream_settings_list}interface: ${green}${inbounds_streamSettings_sockopt_interface[inbounds_index]:-}${normal} V6Only: ${green}${inbounds_streamSettings_sockopt_V6Only[inbounds_index]:-false}${normal}\n${indent_6}"
        stream_settings_list="${stream_settings_list}tcpWindowClamp: ${green}${inbounds_streamSettings_sockopt_tcpWindowClamp[inbounds_index]:-600} addressPortStrategy: ${green}${inbounds_streamSettings_sockopt_addressPortStrategy[inbounds_index]:-none}${normal}\n${indent_6}"

        inbounds_list="$inbounds_list# ${green}$((j+1))${normal}${indent_6}$inbound_settings_list$stream_settings_list$inbound_sniffing_list\n\n"
    done

    Println "$inbounds_list\n"
}
