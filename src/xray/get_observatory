XrayGetObservatory()
{
    SetDelimiters

    jq_payload=$(JQs flat "$X_CONFIG" '.observatory')

    jq_path='[
        ["subjectSelector"],
        ["probeUrl"],
        ["probeInterval"],
        ["enableConcurrency"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name="observatory_${path_name#*_}"
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    return 0
}
