XrayListInboundAccounts()
{
    XrayListInbounds "${1:-}" || return 1

    if ! ProxySelectBound "$X_CONFIG" inbounds "$(gettext "选择查看账号明细的入站")"
    then
        inbounds_index=""
        return 1
    fi

    local idx="$selected_bound_index"
    local bound_tag="${inbounds_tag[idx]}"
    inbounds_index="$idx"
    local accounts_out
    accounts_out=$(ProxyRenderInboundAccounts "$X_CONFIG" "$idx")

    if [ -z "$accounts_out" ]
    then
        Println "$(eval_gettext "\$info 入站 \${green}\${bound_tag}\${normal} 没有多账号配置")\n"
        return 0
    fi

    Println "\n$(eval_gettext "=== 入站 \${green}\${bound_tag}\${normal} 账号明细 ===")\n$accounts_out\n"
}
