XrayListOutbounds()
{
    XrayGetOutbounds

    if [ "$outbounds_count" -eq 0 ]
    then
        Println "$(eval_gettext "\$error 没有出站")\n"
        return 1
    fi

    Println "\n$(eval_gettext "=== 出站数 \${green} \$outbounds_count \${normal}")"
    outbounds_list=$(ProxyRenderOutbounds "$X_CONFIG" xray)
    Println "$outbounds_list"
}
