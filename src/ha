Include src/haproxy/install "$@"
Include src/service/control "$@"
Include utils/build "$@"
Include utils/lua "$@"
Include utils/openssl "$@"
Include utils/quictls "$@"
Include utils/zlib "$@"

DepInstall sudo

haproxy_options=( "$i18n_install" "$i18n_update" "$(gettext "卸载")" )
echo
inquirer list_input_index "$i18n_please_select" haproxy_options haproxy_options_index

case $haproxy_options_index in
    0) HAProxyInstall
    ;;
    1) HAProxyUpdate
    ;;
    2) HAProxyUninstall
    ;;
esac
