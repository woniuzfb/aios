Include src/v2ray/get_policy "$@"

V2rayListPolicy()
{
    if [ -s "$V2_CONFIG" ]
    then
        V2rayGetPolicy
    fi

    local out
    out=$(ProxyRenderPolicy "$V2_CONFIG" v2ray)
    if [ -z "$out" ]
    then
        Println "$(eval_gettext "\$error 未配置策略")\n"
        return 1
    fi
    Println "\n=== $(gettext "V2Ray 策略配置") ===\n$out\n"
}
