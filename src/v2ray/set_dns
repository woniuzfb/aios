V2raySetDns()
{
    local actions=(
        '添加静态 IP (hosts)'
        '添加 DNS 服务器'
        '设置 clientIp'
        '设置 DNS 标识 tag'
        '设置 queryStrategy'
        '设置缓存与回退开关'
        '删除静态 IP (hosts)'
        '删除 DNS 服务器'
    )
    local action_idx=0
    echo
    inquirer list_input_index "选择 V2Ray DNS 操作" actions action_idx

    case "$action_idx" in
        0)
            local domain ips
            Println "$tip 格式如 v2fly.org, domain:v2fly.org, geosite:cn"
            inquirer text_input "输入域名或规则" domain ""
            inquirer text_input "输入目标 IP/域名 (逗号分隔)" ips ""
            JQ mutate "$V2_CONFIG" '
                def trim: gsub("^[ \t]+|[ \t]+$"; "");
                .dns.hosts = ((.dns.hosts // {}) + {
                    ($d | trim): (
                        if ($v | contains(",")) then
                            ($v | split(",") | map(trim) | map(select(. != "")))
                        else
                            ($v | trim)
                        end
                    )
                })' --arg d "$domain" --arg v "$ips"
            Println "$info 静态 IP 添加成功: ${green}${domain}${normal}\n"
        ;;
        1)
            local addr port client_ip domains expect_ips
            local skip_fb_opts=( '否' '是' )
            local skip_fb_idx=0
            inquirer text_input "输入 DNS 地址 (如 1.1.1.1, https://...)" addr "1.1.1.1"
            inquirer text_input "输入端口 (留空默认)" port ""
            inquirer text_input "输入服务器级 clientIp (可留空)" client_ip ""
            inquirer text_input "输入匹配 domains (逗号分隔, 可留空)" domains ""
            inquirer text_input "输入 expectIPs (逗号分隔, 可留空)" expect_ips ""
            inquirer list_input_index "跳过回退 skipFallback" skip_fb_opts skip_fb_idx

            if [ -n "$port" ] && { ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; }
            then
                Println "$error DNS 端口必须为 1-65535 的整数: ${port}\n"
                return 1
            fi

            local srv_json=""
            if [ -z "$port" ] && [ -z "$client_ip" ] && [ -z "$domains" ] && [ -z "$expect_ips" ] && [ "$skip_fb_idx" -eq 0 ]
            then
                JQs build srv_json '$addr' --arg addr "$addr"
            else
                JQs build srv_json '
                    def csv: split(",") | map(gsub("^[ \t]+|[ \t]+$"; "")) | map(select(. != ""));
                    {
                        "address": $addr,
                        "port": (if $port != "" then ($port | tonumber) else null end),
                        "clientIp": $cip,
                        "domains": (if $dom != "" then ($dom | csv) else null end),
                        "expectIPs": (if $eip != "" then ($eip | csv) else null end),
                        "skipFallback": (if $sf == "1" then true else null end)
                    }' --arg addr "$addr" --arg port "$port" --arg cip "$client_ip" --arg dom "$domains" \
                    --arg eip "$expect_ips" --arg sf "$skip_fb_idx"
            fi
            jq_path='["dns","servers"]'
            JQ add "$V2_CONFIG" "[$srv_json]"
            Println "$info DNS 服务器添加成功: ${green}${addr}${normal}\n"
        ;;
        2)
            local cip
            inquirer text_input "输入全局 clientIp (留空清除)" cip ""
            jq_path='["dns","clientIp"]'
            if [ -z "$cip" ]
            then
                JQ delete "$V2_CONFIG"
            else
                JQ update "$V2_CONFIG" "$cip"
            fi
            Println "$info DNS clientIp 设置成功\n"
        ;;
        3)
            local dtag
            inquirer text_input "输入 DNS 标识 tag" dtag "dns_inbound"
            jq_path='["dns","tag"]'
            JQ update "$V2_CONFIG" "$dtag"
            Println "$info DNS tag 设置成功: ${green}${dtag}${normal}\n"
        ;;
        4)
            local qs_options=( 'UseIP' 'UseIPv4' 'UseIPv6' )
            local qs=""
            inquirer list_input "选择 DNS 查询策略 queryStrategy" qs_options qs
            jq_path='["dns","queryStrategy"]'
            JQ update "$V2_CONFIG" "$qs"
            Println "$info queryStrategy 已设置为 ${green}${qs}${normal}\n"
        ;;
        5)
            local yn_opts=( '否' '是' )
            local dc_idx=0 df_idx=0 dfm_idx=0
            inquirer list_input_index "禁用缓存 disableCache" yn_opts dc_idx
            inquirer list_input_index "禁用回退 disableFallback" yn_opts df_idx
            inquirer list_input_index "匹配时不回退 disableFallbackIfMatch" yn_opts dfm_idx

            JQ mutate "$V2_CONFIG" '.dns = ((.dns // {}) * {
                "disableCache": ($dc == "1"),
                "disableFallback": ($df == "1"),
                "disableFallbackIfMatch": ($dfm == "1")
            })' --arg dc "$dc_idx" --arg df "$df_idx" --arg dfm "$dfm_idx"
            Println "$info V2Ray DNS 全局开关已更新\n"
        ;;
        6)
            local host_keys=()
            local k
            while IFS= read -r k
            do
                [ -n "$k" ] && host_keys+=("$k")
            done < <(JQs query "$V2_CONFIG" 'if (.dns | type) == "object" and (.dns.hosts | type) == "object" then (.dns.hosts | keys[]) else empty end')
            if [ "${#host_keys[@]}" -eq 0 ]
            then
                Println "$error 没有可删除的静态 IP\n"
                return 1
            fi
            local del_idx=0
            inquirer list_input_index "选择要删除的静态 IP" host_keys del_idx
            local del_key="${host_keys[$del_idx]}"
            JQ mutate "$V2_CONFIG" 'del(.dns.hosts[$k])' --arg k "$del_key"
            Println "$info 已删除静态 IP: ${green}${del_key}${normal}\n"
        ;;
        7)
            local srv_opts=()
            local line
            while IFS= read -r line
            do
                [ -n "$line" ] && srv_opts+=("$line")
            done < <(JQs query "$V2_CONFIG" 'if (.dns | type) == "object" and (.dns.servers | type) == "array" then (.dns.servers | to_entries[] | "\(.key + 1). \(if (.value | type) == "string" then .value elif (.value | type) == "object" then (.value.address // "server") else "server" end)") else empty end')
            if [ "${#srv_opts[@]}" -eq 0 ]
            then
                Println "$error 没有可删除的 DNS 服务器\n"
                return 1
            fi
            local del_idx=0
            inquirer list_input_index "选择要删除的 DNS 服务器" srv_opts del_idx
            jq_path='["dns","servers",'"$del_idx"']'
            JQ delete "$V2_CONFIG"
            Println "$info 已删除 DNS 服务器: ${green}${srv_opts[$del_idx]}${normal}\n"
        ;;
    esac

    ProxyRestartIfActive v2ray
}
