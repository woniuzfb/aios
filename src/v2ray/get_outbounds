V2rayGetOutbounds()
{
    SetDelimiters

    jq_payload=$(JQs flat "$V2_CONFIG" '.outbounds')

    jq_path='[
        ["sendThrough"],
        ["protocol"],
        ["settings","response","type"],
        ["settings","network"],
        ["settings","address"],
        ["settings","port"],
        ["settings","domainStrategy"],
        ["settings","redirect"],
        ["settings","userLevel"],
        ["settings","servers","address"],
        ["settings","servers","port"],
        ["settings","servers","users","user"],
        ["settings","servers","users","pass"],
        ["settings","servers","users","level"],
        ["settings","servers","email"],
        ["settings","servers","method"],
        ["settings","servers","password"],
        ["settings","servers","level"],
        ["settings","servers","ivCheck"],
        ["settings","vnext","address"],
        ["settings","vnext","port"],
        ["settings","vnext","users","id"],
        ["settings","vnext","users","alterId"],
        ["settings","vnext","users","security"],
        ["settings","vnext","users","level"],
        ["settings","vnext","users","encryption"],
        ["settings","inboundTag"],
        ["streamSettings","network"],
        ["streamSettings","security"],
        ["streamSettings","tlsSettings","serverName"],
        ["streamSettings","tlsSettings","allowInsecure"],
        ["streamSettings","tlsSettings","disableSystemRoot"],
        ["streamSettings","tlsSettings","verifyClientCertificate"],
        ["streamSettings","tlsSettings","pinnedPeerCertificateChainSha256"],
        ["streamSettings","tlsSettings","alpn"],
        ["streamSettings","tlsSettings","certificates","usage"],
        ["streamSettings","tlsSettings","certificates","certificateFile"],
        ["streamSettings","tlsSettings","certificates","keyFile"],
        ["streamSettings","tlsSettings","certificates","certificate"],
        ["streamSettings","tlsSettings","certificates","key"],
        ["streamSettings","tcpSettings","header","type"],
        ["streamSettings","tcpSettings","header","request","version"],
        ["streamSettings","tcpSettings","header","request","method"],
        ["streamSettings","tcpSettings","header","request","path"],
        ["streamSettings","tcpSettings","header","request","headers"],
        ["streamSettings","tcpSettings","header","response","version"],
        ["streamSettings","tcpSettings","header","response","status"],
        ["streamSettings","tcpSettings","header","response","reason"],
        ["streamSettings","tcpSettings","header","response","headers"],
        ["streamSettings","kcpSettings","mtu"],
        ["streamSettings","kcpSettings","tti"],
        ["streamSettings","kcpSettings","uplinkCapacity"],
        ["streamSettings","kcpSettings","downlinkCapacity"],
        ["streamSettings","kcpSettings","congestion"],
        ["streamSettings","kcpSettings","readBufferSize"],
        ["streamSettings","kcpSettings","writeBufferSize"],
        ["streamSettings","kcpSettings","header","type"],
        ["streamSettings","kcpSettings","seed"],
        ["streamSettings","wsSettings","path"],
        ["streamSettings","wsSettings","headers"],
        ["streamSettings","wsSettings","maxEarlyData"],
        ["streamSettings","wsSettings","useBrowserForwarding"],
        ["streamSettings","wsSettings","earlyDataHeaderName"],
        ["streamSettings","httpSettings","host"],
        ["streamSettings","httpSettings","path"],
        ["streamSettings","httpSettings","method"],
        ["streamSettings","httpSettings","headers"],
        ["streamSettings","quicSettings","security"],
        ["streamSettings","quicSettings","key"],
        ["streamSettings","quicSettings","header","type"],
        ["streamSettings","dsSettings","path"],
        ["streamSettings","dsSettings","abstract"],
        ["streamSettings","dsSettings","padding"],
        ["streamSettings","grpcSettings","serviceName"],
        ["streamSettings","sockopt","mark"],
        ["streamSettings","sockopt","tcpFastOpen"],
        ["streamSettings","sockopt","tcpFastOpenQueueLength"],
        ["streamSettings","sockopt","tproxy"],
        ["streamSettings","sockopt","tcpKeepAliveInterval"],
        ["streamSettings","sockopt","bindToDevice"],
        ["streamSettings","sockopt","mptcp"],
        ["tag"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name=${path_name}
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    if [ -z "${jq_protocol:-}" ]
    then
        outbounds_count=0
        return 0
    fi

    IFS="${delimiters[1]}" read -r -a outbounds_sendThrough <<< "$jq_sendThrough"
    IFS="${delimiters[1]}" read -r -a outbounds_protocol <<< "$jq_protocol"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_response_type <<< "$jq_settings_response_type"
    IFS="${delimiters[2]}" read -r -a outbounds_settings_network <<< "$jq_settings_network"
    IFS="${delimiters[2]}" read -r -a outbounds_settings_address <<< "$jq_settings_address"
    IFS="${delimiters[2]}" read -r -a outbounds_settings_port <<< "$jq_settings_port"
    IFS="${delimiters[2]}" read -r -a outbounds_settings_domainStrategy <<< "$jq_settings_domainStrategy"
    IFS="${delimiters[2]}" read -r -a outbounds_settings_redirect <<< "$jq_settings_redirect"
    IFS="${delimiters[2]}" read -r -a outbounds_settings_userLevel <<< "$jq_settings_userLevel"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_servers_address <<< "$jq_settings_servers_address"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_servers_port <<< "$jq_settings_servers_port"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_servers_users_user <<< "$jq_settings_servers_users_user"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_servers_users_pass <<< "$jq_settings_servers_users_pass"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_servers_users_level <<< "$jq_settings_servers_users_level"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_servers_email <<< "$jq_settings_servers_email"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_servers_method <<< "$jq_settings_servers_method"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_servers_password <<< "$jq_settings_servers_password"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_servers_level <<< "$jq_settings_servers_level"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_servers_ivCheck <<< "$jq_settings_servers_ivCheck"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_vnext_address <<< "$jq_settings_vnext_address"
    IFS="${delimiters[3]}" read -r -a outbounds_settings_vnext_port <<< "$jq_settings_vnext_port"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_vnext_users_id <<< "$jq_settings_vnext_users_id"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_vnext_users_alterId <<< "$jq_settings_vnext_users_alterId"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_vnext_users_security <<< "$jq_settings_vnext_users_security"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_vnext_users_level <<< "$jq_settings_vnext_users_level"
    IFS="${delimiters[4]}" read -r -a outbounds_settings_vnext_users_encryption <<< "$jq_settings_vnext_users_encryption"
    IFS="${delimiters[2]}" read -r -a outbounds_settings_inboundTag <<< "$jq_settings_inboundTag"
    IFS="${delimiters[2]}" read -r -a outbounds_streamSettings_network <<< "$jq_streamSettings_network"
    IFS="${delimiters[2]}" read -r -a outbounds_streamSettings_security <<< "$jq_streamSettings_security"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_tlsSettings_serverName <<< "$jq_streamSettings_tlsSettings_serverName"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_tlsSettings_allowInsecure <<< "$jq_streamSettings_tlsSettings_allowInsecure"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_tlsSettings_disableSystemRoot <<< "$jq_streamSettings_tlsSettings_disableSystemRoot"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_tlsSettings_verifyClientCertificate <<< "$jq_streamSettings_tlsSettings_verifyClientCertificate"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_tlsSettings_pinnedPeerCertificateChainSha256 <<< "$jq_streamSettings_tlsSettings_pinnedPeerCertificateChainSha256"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_tlsSettings_alpn <<< "$jq_streamSettings_tlsSettings_alpn"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_tlsSettings_certificates_usage <<< "$jq_streamSettings_tlsSettings_certificates_usage"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_tlsSettings_certificates_certificateFile <<< "$jq_streamSettings_tlsSettings_certificates_certificateFile"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_tlsSettings_certificates_keyFile <<< "$jq_streamSettings_tlsSettings_certificates_keyFile"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_tlsSettings_certificates_certificate <<< "$jq_streamSettings_tlsSettings_certificates_certificate"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_tlsSettings_certificates_key <<< "$jq_streamSettings_tlsSettings_certificates_key"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_tcpSettings_header_type <<< "$jq_streamSettings_tcpSettings_header_type"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_request_version <<< "$jq_streamSettings_tcpSettings_header_request_version"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_request_method <<< "$jq_streamSettings_tcpSettings_header_request_method"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_request_path <<< "$jq_streamSettings_tcpSettings_header_request_path"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_request_headers <<< "$jq_streamSettings_tcpSettings_header_request_headers"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_response_version <<< "$jq_streamSettings_tcpSettings_header_response_version"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_response_status <<< "$jq_streamSettings_tcpSettings_header_response_status"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_response_reason <<< "$jq_streamSettings_tcpSettings_header_response_reason"
    IFS="${delimiters[5]}" read -r -a outbounds_streamSettings_tcpSettings_header_response_headers <<< "$jq_streamSettings_tcpSettings_header_response_headers"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_mtu <<< "$jq_streamSettings_kcpSettings_mtu"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_tti <<< "$jq_streamSettings_kcpSettings_tti"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_uplinkCapacity <<< "$jq_streamSettings_kcpSettings_uplinkCapacity"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_downlinkCapacity <<< "$jq_streamSettings_kcpSettings_downlinkCapacity"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_congestion <<< "$jq_streamSettings_kcpSettings_congestion"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_readBufferSize <<< "$jq_streamSettings_kcpSettings_readBufferSize"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_writeBufferSize <<< "$jq_streamSettings_kcpSettings_writeBufferSize"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_kcpSettings_header_type <<< "$jq_streamSettings_kcpSettings_header_type"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_kcpSettings_seed <<< "$jq_streamSettings_kcpSettings_seed"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_wsSettings_path <<< "$jq_streamSettings_wsSettings_path"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_wsSettings_headers <<< "$jq_streamSettings_wsSettings_headers"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_wsSettings_maxEarlyData <<< "$jq_streamSettings_wsSettings_maxEarlyData"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_wsSettings_useBrowserForwarding <<< "$jq_streamSettings_wsSettings_useBrowserForwarding"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_wsSettings_earlyDataHeaderName <<< "$jq_streamSettings_wsSettings_earlyDataHeaderName"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_httpSettings_host <<< "$jq_streamSettings_httpSettings_host"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_httpSettings_path <<< "$jq_streamSettings_httpSettings_path"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_httpSettings_method <<< "$jq_streamSettings_httpSettings_method"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_httpSettings_headers <<< "$jq_streamSettings_httpSettings_headers"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_quicSettings_security <<< "$jq_streamSettings_quicSettings_security"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_quicSettings_key <<< "$jq_streamSettings_quicSettings_key"
    IFS="${delimiters[4]}" read -r -a outbounds_streamSettings_quicSettings_header_type <<< "$jq_streamSettings_quicSettings_header_type"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_dsSettings_path <<< "$jq_streamSettings_dsSettings_path"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_dsSettings_abstract <<< "$jq_streamSettings_dsSettings_abstract"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_dsSettings_padding <<< "$jq_streamSettings_dsSettings_padding"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_grpcSettings_serviceName <<< "$jq_streamSettings_grpcSettings_serviceName"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_sockopt_mark <<< "$jq_streamSettings_sockopt_mark"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_sockopt_tcpFastOpen <<< "$jq_streamSettings_sockopt_tcpFastOpen"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_sockopt_tcpFastOpenQueueLength <<< "$jq_streamSettings_sockopt_tcpFastOpenQueueLength"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_sockopt_tproxy <<< "$jq_streamSettings_sockopt_tproxy"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_sockopt_tcpKeepAliveInterval <<< "$jq_streamSettings_sockopt_tcpKeepAliveInterval"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_sockopt_bindToDevice <<< "$jq_streamSettings_sockopt_bindToDevice"
    IFS="${delimiters[3]}" read -r -a outbounds_streamSettings_sockopt_mptcp <<< "$jq_streamSettings_sockopt_mptcp"
    IFS="${delimiters[1]}" read -r -a outbounds_tag <<< "$jq_tag"

    outbounds_count=${#outbounds_protocol[@]}

    return 0
}
