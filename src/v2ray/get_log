V2rayGetLog()
{
    SetDelimiters

    jq_payload=$(JQs flat "$V2_CONFIG" '.log')

    jq_path='[
        ["access"],
        ["error"],
        ["loglevel"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name="$path_name"
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    log_access="${jq_access:-none}"
    log_error="${jq_error:-none}"
    log_loglevel="${jq_loglevel:-warning}"

    return 0
}
