V2rayListOutboundAccounts()
{
    V2rayListOutbounds || return 1

    ProxySelectBound "$V2_CONFIG" outbounds "$(gettext "选择查看账号/服务端明细的出站")" || return 0
    local idx="$selected_bound_index"
    outbounds_index="$idx"
    local accounts_out
    accounts_out=$(ProxyRenderOutboundAccounts "$V2_CONFIG" "$idx")

    local target_tag="${outbounds_tag[idx]}"
    if [ -z "$accounts_out" ]
    then
        Println "$(eval_gettext "\$info 出站 \${green}\$target_tag\${normal} 没有账号/服务端明细")\n"
        return 0
    fi

    Println "\n=== $(eval_gettext "出站 \${green}\$target_tag\${normal} 账号/服务端明细") ===\n$accounts_out\n"
}
