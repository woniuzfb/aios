V2rayDeleteInboundAccount()
{
    ProxySelectBound "$V2_CONFIG" inbounds "选择要删除账号的入站" || return 1
    local idx="$selected_bound_index"
    local protocol="${inbounds_protocol[idx]}"
    local field="clients"
    if [ "$protocol" == "socks" ] || [ "$protocol" == "http" ]
    then
        field="accounts"
    fi

    local opts=()
    local line
    while IFS= read -r line
    do
        [ -n "$line" ] && opts+=("$line")
    done < <(JQs query "$V2_CONFIG" '
        (if (.inbounds | type) == "array" and (.inbounds[$i] | type) == "object"
            and (.inbounds[$i].settings | type) == "object"
            and (.inbounds[$i].settings[$f] | type) == "array"
         then .inbounds[$i].settings[$f]
         else [] end)
        | to_entries[]
        | select(.value | type == "object")
        | "\(.key + 1). \(.value.email // .value.id // .value.user // .value.password // "account")"
    ' --argjson i "$idx" --arg f "$field")

    if [ "${#opts[@]}" -eq 0 ]
    then
        Println "$error 该入站没有可删除的账号\n"
        return 1
    fi

    local acc_idx=0
    echo
    inquirer list_input_index "选择要删除的账号" opts acc_idx
    jq_path='["inbounds",'"$idx"',"settings","'"$field"'",'"$acc_idx"']'
    JQ delete "$V2_CONFIG"
    ProxyRestartIfActive v2ray
    Println "$info 已删除账号 ${green}${opts[acc_idx]}${normal}\n"
}
