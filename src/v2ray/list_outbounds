V2rayListOutbounds()
{
    V2rayGetOutbounds

    if [ "$outbounds_count" -eq 0 ]
    then
        Println "$error 没有出站\n"
        return 1
    fi

    Println "\n=== 出站数 ${green} $outbounds_count ${normal}"

    local outbounds_index i j
    outbounds_list=""

    for((outbounds_index=0;outbounds_index<outbounds_count;outbounds_index++));
    do
        outbounds_list="${outbounds_list}发送数据的 IP 地址: ${green}${outbounds_sendThrough[outbounds_index]:-0.0.0.0}${normal} 传输协议: ${green}${outbounds_protocol[outbounds_index]}${normal} 标识: ${green}${outbounds_tag[outbounds_index]}${normal}\n${indent_6}"
        outbound_proxySettings_list="proxySettings tag: ${green}${outbounds_proxySettings_tag[outbounds_index]:-}${normal} transportLayer: ${green}${outbounds_proxySettings_transportLayer[outbounds_index]:-}${normal}\n${indent_6}"

        if [ "${outbounds_mux_enabled[outbounds_index]}" = true ]
        then
            outbound_mux_list="Mux 转发请求: ${green}开启${normal} "
        else
            outbound_mux_list="Mux 转发请求: ${red}关闭${normal} "
        fi

        outbound_mux_list="${outbound_mux_list}最大并发连接数: ${green}${outbounds_mux_concurrency[outbounds_index]:-8}${normal}\n${indent_6}"

        case ${outbounds_protocol[outbounds_index]} in
            "blackhole")
                outbound_settings_list="type: ${green}${outbounds_settings_response_type[outbounds_index]:-none}${normal}\n${indent_6}"
            ;;
            "dns")
                outbound_settings_list="network: ${green}${outbounds_settings_network[outbounds_index]:-}${normal} address: ${green}${outbounds_settings_address[outbounds_index]:-}${normal} port: ${green}${outbounds_settings_port[outbounds_index]:-}${normal}\n${indent_6}"
            ;;
            "freedom")
                outbound_settings_list="domainStrategy: ${green}${outbounds_settings_domainStrategy[outbounds_index]:-AsIs}${normal} redirect: ${green}${outbounds_settings_redirect[outbounds_index]:-}${normal}\n${indent_6}"
                outbound_settings_list="${outbound_settings_list}用户等级: ${green}${outbounds_settings_userLevel[outbounds_index]:-0}${normal}\n${indent_6}"
            ;;
            "http")
                if [ -z "${outbounds_settings_servers_address[outbounds_index]:-}" ]
                then
                    break
                fi

                IFS="${delimiters[3]}" read -r -a outbound_settings_servers_address <<< "${outbounds_settings_servers_address[outbounds_index]:-}"
                IFS="${delimiters[3]}" read -r -a outbound_settings_servers_port <<< "${outbounds_settings_servers_port[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_users_user <<< "${outbounds_settings_users_user[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_users_pass <<< "${outbounds_settings_users_pass[outbounds_index]:-}"

                outbound_settings_servers_count="${#outbound_settings_servers_address[@]}"

                for((j=0;j<outbound_settings_servers_count;j++));
                do
                    outbound_settings_list="服务器$((j+1)):\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}地址: ${green}${outbound_settings_servers_address[j]:-}${normal} 端口: ${green}${outbound_settings_servers_port[j]:-}${normal}\n${indent_6}"

                    if [ -z "${outbound_settings_servers_users_user[j]:-}" ]
                    then
                        continue
                    fi

                    IFS="${delimiters[5]}" read -r -a outbound_settings_servers_user_user <<< "${outbound_settings_servers_users_user[j]:-}"
                    IFS="${delimiters[5]}" read -r -a outbound_settings_servers_user_pass <<< "${outbound_settings_servers_users_pass[j]:-}"

                    outbound_settings_servers_users_count="${#outbound_settings_servers_user_user[@]}"

                    for((i=0;i<outbound_settings_servers_users_count;i++));
                    do
                        outbound_settings_list="${outbound_settings_list}账号$((i+1)) 用户名:${green}${outbound_settings_servers_user_user[i]}${normal} 密码: ${green}${outbound_settings_servers_user_pass[i]}${normal}\n${indent_6}"
                    done

                    outbound_settings_list="${outbound_settings_list}\n${indent_6}"
                done
            ;;
            "socks")
                if [ -z "${outbounds_settings_servers_address[outbounds_index]:-}" ]
                then
                    break
                fi

                IFS="${delimiters[3]}" read -r -a outbound_settings_servers_address <<< "${outbounds_settings_servers_address[outbounds_index]:-}"
                IFS="${delimiters[3]}" read -r -a outbound_settings_servers_port <<< "${outbounds_settings_servers_port[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_users_user <<< "${outbounds_settings_users_user[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_users_pass <<< "${outbounds_settings_users_pass[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_users_level <<< "${outbounds_settings_users_level[outbounds_index]:-}"

                outbound_settings_servers_count="${#outbound_settings_servers_address[@]}"

                for((j=0;j<outbound_settings_servers_count;j++));
                do
                    outbound_settings_list="服务器$((j+1)):\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}地址: ${green}${outbound_settings_servers_address[j]:-}${normal} 端口: ${green}${outbound_settings_servers_port[j]:-}${normal}\n${indent_6}"

                    if [ -z "${outbound_settings_servers_users_user[j]:-}" ]
                    then
                        continue
                    fi

                    IFS="${delimiters[5]}" read -r -a outbound_settings_servers_user_user <<< "${outbound_settings_servers_users_user[j]:-}"
                    IFS="${delimiters[5]}" read -r -a outbound_settings_servers_user_pass <<< "${outbound_settings_servers_users_pass[j]:-}"
                    IFS="${delimiters[5]}" read -r -a outbound_settings_servers_user_level <<< "${outbound_settings_servers_users_level[j]:-}"

                    outbound_settings_servers_users_count="${#outbound_settings_servers_user_user[@]}"

                    for((i=0;i<outbound_settings_servers_users_count;i++));
                    do
                        outbound_settings_list="${outbound_settings_list}账号$((i+1)) 用户名:${green}${outbound_settings_servers_user_user[i]}${normal} 密码: ${green}${outbound_settings_servers_user_pass[i]}${normal} 等级: ${green}${outbound_settings_servers_user_level[i]}${normal}\n${indent_6}"
                    done

                    outbound_settings_list="${outbound_settings_list}\n${indent_6}"
                done
            ;;
            "vmess")
                if [ -z "${outbounds_settings_vnext_address[outbounds_index]:-}" ]
                then
                    break
                fi

                IFS="${delimiters[4]}" read -r -a outbound_settings_vnext_address <<< "${outbounds_settings_vnext_address[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_vnext_port <<< "${outbounds_settings_vnext_port[outbounds_index]:-}"
                IFS="${delimiters[5]}" read -r -a outbound_settings_vnext_users_id <<< "${outbounds_settings_vnext_users_id[outbounds_index]:-}"
                IFS="${delimiters[5]}" read -r -a outbound_settings_vnext_users_alterId <<< "${outbounds_settings_vnext_users_alterId[outbounds_index]:-}"
                IFS="${delimiters[5]}" read -r -a outbound_settings_vnext_users_security <<< "${outbounds_settings_vnext_users_security[outbounds_index]:-}"
                IFS="${delimiters[5]}" read -r -a outbound_settings_vnext_users_level <<< "${outbounds_settings_vnext_users_level[outbounds_index]:-}"

                outbound_settings_vnext_count="${#outbound_settings_vnext_address[@]}"

                for((j=0;j<outbound_settings_vnext_count;j++));
                do
                    outbound_settings_list="服务器$((j+1)):\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}地址: ${green}${outbound_settings_vnext_address[j]:-}${normal} 端口: ${green}${outbound_settings_vnext_port[j]:-}${normal}\n${indent_6}"

                    if [ -z "${outbound_settings_vnext_users_id[j]:-}" ]
                    then
                        continue
                    fi

                    IFS="${delimiters[6]}" read -r -a outbound_settings_vnext_user_id <<< "${outbound_settings_vnext_users_id[j]:-}"
                    IFS="${delimiters[6]}" read -r -a outbound_settings_vnext_user_alterId <<< "${outbound_settings_vnext_users_alterId[j]:-}"
                    IFS="${delimiters[6]}" read -r -a outbound_settings_vnext_user_security <<< "${outbound_settings_vnext_users_security[j]:-}"
                    IFS="${delimiters[6]}" read -r -a outbound_settings_vnext_user_level <<< "${outbound_settings_vnext_users_level[j]:-}"

                    outbound_settings_vnext_users_count="${#outbound_settings_vnext_user_id[@]}"

                    for((i=0;i<outbound_settings_vnext_users_count;i++));
                    do
                        outbound_settings_list="${outbound_settings_list}账号$((i+1)) id:${green}${outbound_settings_vnext_user_id[i]}${normal} alterId: ${green}${outbound_settings_vnext_user_alterId[i]}${normal}\n${indent_6}"
                        outbound_settings_list="${outbound_settings_list}security: ${green}${outbound_settings_vnext_user_security[i]}${normal} level: ${green}${outbound_settings_servers_user_level[i]:-0}${normal}\n${indent_6}"
                    done

                    outbound_settings_list="${outbound_settings_list}\n${indent_6}"
                done
            ;;
            "shadowsocks")
                if [ -z "${outbounds_settings_servers_address[outbounds_index]:-}" ]
                then
                    break
                fi

                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_address <<< "${outbounds_settings_servers_address[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_port <<< "${outbounds_settings_servers_port[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_method <<< "${outbounds_settings_servers_method[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_password <<< "${outbounds_settings_servers_password[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_email <<< "${outbounds_settings_servers_email[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_level <<< "${outbounds_settings_servers_level[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_ivCheck <<< "${outbounds_settings_servers_ivCheck[outbounds_index]:-}"

                outbound_settings_servers_count="${#outbound_settings_servers_address[@]}"

                for((i=0;i<outbound_settings_servers_count;i++));
                do
                    outbound_settings_list="账号$((i+1)):\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}address: ${green}${outbound_settings_servers_address[i]:-}${normal} port: ${green}${outbound_settings_servers_port[i]:-}${normal}\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}method: ${green}${outbound_settings_servers_method[i]:-}${normal} password: ${green}${outbound_settings_servers_password[i]:-}${normal}\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}email: ${green}${outbound_settings_servers_email[i]:-}${normal} level: ${green}${outbound_settings_servers_level[i]:-}${normal} ivCheck: ${green}${outbound_settings_servers_ivCheck[i]:-false}${normal}\n\n${indent_6}"
                done
            ;;
            "trojan")
                if [ -z "${outbounds_settings_servers_address[outbounds_index]:-}" ]
                then
                    break
                fi

                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_address <<< "${outbounds_settings_servers_address[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_port <<< "${outbounds_settings_servers_port[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_password <<< "${outbounds_settings_password[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_email <<< "${outbounds_settings_email[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_level <<< "${outbounds_settings_level[outbounds_index]:-}"

                outbound_settings_servers_count="${#outbound_settings_servers_address[@]}"

                for((i=0;i<outbound_settings_servers_count;i++));
                do
                    outbound_settings_list="服务器$((i+1)):\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}地址: ${green}${outbound_settings_servers_address[i]:-}${normal} 端口: ${green}${outbound_settings_servers_port[i]:-}${normal}\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}密码: ${green}${outbound_settings_servers_password[i]:-}${normal} 邮箱: ${green}${outbound_settings_servers_email[i]:-}${normal} 等级: ${green}${outbound_settings_servers_level[i]:-}${normal}\n\n${indent_6}"
                done
            ;;
            "vless")
                if [ -z "${outbounds_settings_vnext_address[outbounds_index]:-}" ]
                then
                    break
                fi

                IFS="${delimiters[4]}" read -r -a outbound_settings_vnext_address <<< "${outbounds_settings_vnext_address[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_vnext_port <<< "${outbounds_settings_vnext_port[outbounds_index]:-}"
                IFS="${delimiters[5]}" read -r -a outbound_settings_vnext_users_id <<< "${outbounds_settings_vnext_users_id[outbounds_index]:-}"
                IFS="${delimiters[5]}" read -r -a outbound_settings_vnext_users_encryption <<< "${outbounds_settings_vnext_users_encryption[outbounds_index]:-}"
                IFS="${delimiters[5]}" read -r -a outbound_settings_vnext_users_level <<< "${outbounds_settings_vnext_users_level[outbounds_index]:-}"

                outbound_settings_vnext_count="${#outbound_settings_vnext_address[@]}"

                for((j=0;j<outbound_settings_vnext_count;j++));
                do
                    outbound_settings_list="服务器$((j+1)):\n${indent_6}"
                    outbound_settings_list="${outbound_settings_list}地址: ${green}${outbound_settings_vnext_address[j]:-}${normal} 端口: ${green}${outbound_settings_vnext_port[j]:-}${normal}\n${indent_6}"

                    if [ -z "${outbound_settings_vnext_users_id[j]:-}" ]
                    then
                        continue
                    fi

                    IFS="${delimiters[6]}" read -r -a outbound_settings_vnext_user_id <<< "${outbound_settings_vnext_users_id[j]:-}"
                    IFS="${delimiters[6]}" read -r -a outbound_settings_vnext_user_encryption <<< "${outbound_settings_vnext_users_encryption[j]:-}"
                    IFS="${delimiters[6]}" read -r -a outbound_settings_vnext_user_level <<< "${outbound_settings_vnext_users_level[j]:-}"

                    outbound_settings_vnext_users_count="${#outbound_settings_vnext_user_id[@]}"

                    for((i=0;i<outbound_settings_vnext_users_count;i++));
                    do
                        outbound_settings_list="${outbound_settings_list}账号$((i+1)) id:${green}${outbound_settings_vnext_user_id[i]}${normal} encryption: ${green}${outbound_settings_vnext_user_encryption[i]}${normal} level: ${green}${outbound_settings_servers_user_level[i]:-0}${normal}\n${indent_6}"
                    done

                    outbound_settings_list="${outbound_settings_list}\n${indent_6}"
                done
            ;;
            "loopback")
                outbound_settings_list="inboundTag: ${green}${outbounds_settings_inboundTag[outbounds_index]:-}${normal}\n${indent_6}"
            ;;
            "hysteria2")
                if [ -z "${outbounds_settings_servers_address[outbounds_index]:-}" ]
                then
                    break
                fi

                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_address <<< "${outbounds_settings_servers_address[outbounds_index]:-}"
                IFS="${delimiters[4]}" read -r -a outbound_settings_servers_port <<< "${outbounds_settings_servers_port[outbounds_index]:-}"

                outbound_settings_servers_count="${#outbound_settings_servers_address[@]}"

                for((i=0;i<outbound_settings_servers_count;i++));
                do
                    outbound_settings_list="服务器$((i+1)) 地址: ${green}${outbound_settings_servers_address[i]:-}${normal} 密码: ${green}${outbound_settings_servers_password[i]:-}${normal}\n${indent_6}"
                done
            ;;
        esac

        stream_settings_list="传输方式: ${green}${outbounds_streamSettings_network[outbounds_index]}${normal} 传输安全: ${green}${outbounds_streamSettings_security[outbounds_index]}${normal}\n${indent_6}"

        case ${outbounds_streamSettings_network[outbounds_index]} in
            "tcp")
                if [ "${outbounds_streamSettings_tcpSettings_header_type[outbounds_index]:-none}" = "none" ]
                then
                    stream_settings_list="${stream_settings_list}头部伪装: ${red}否${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}头部伪装: ${green}http${normal}\n${indent_6}"
                    stream_settings_list="${stream_settings_list}请求协议: ${green}${outbounds_streamSettings_tcpSettings_header_request_version[outbounds_index]:-1.1}${normal} method: ${green}${outbounds_streamSettings_tcoSettings_header_request_method[outbounds_index]:-GET}${normal}\n${indent_6}"

                    IFS="${delimiters[6]}" read -r -a outbound_streamSettings_tcpSettings_header_request_path <<< "${outbounds_streamSettings_tcpSettings_header_request_path[outbounds_index]:-/}"
                    stream_settings_list="${stream_settings_list}请求路径: ${green}$(ArrayToList outbound_streamSettings_tcpSettings_header_request_path)${normal}\n${indent_6}"

                    jq_payload="${outbounds_streamSettings_tcpSettings_header_request_headrs[outbounds_index]:-{}}"
                    jq_path='[]'

                    outbound_streamSettings_tcpSettings_header_request_headrs_list=""
                    local header_name header_value

                    while IFS="^" read -r header_name header_value; do
                        outbound_streamSettings_tcpSettings_header_request_headrs_list="${outbound_streamSettings_tcpSettings_header_request_headrs_list}, ${header_name}: ${header_value}"
                    done < <(JQs get jq_payload '. // {} | to_entries[] | "\(.key)^\(.value)"')

                    stream_settings_list="${stream_settings_list}请求头: ${green}${outbound_streamSettings_tcpSettings_header_request_headrs_list:2}${normal}\n${indent_6}"
                    stream_settings_list="${stream_settings_list}响应协议: ${green}${outbounds_streamSettings_tcpSettings_header_response_version[outbounds_index]:-1.1}${normal} status: ${green}${outbounds_streamSettings_tcpSettings_header_response_status[outbounds_index]:-200}${normal} reason: ${green}${outbounds_streamSettings_tcpSettings_header_response_reason[outbounds_index]:-OK}${normal}\n${indent_6}"

                    jq_payload="${outbounds_streamSettings_tcpSettings_header_response_headrs[outbounds_index]:-{}}"
                    jq_path='[]'

                    outbound_streamSettings_tcpSettings_header_response_headrs_list=""

                    while IFS="^" read -r header_name header_value; do
                        outbound_streamSettings_tcpSettings_header_response_headrs_list="${outbound_streamSettings_tcpSettings_header_response_headrs_list}, ${header_name}: ${header_value}"
                    done < <(JQs get jq_payload '. // {} | to_entries[] | "\(.key)^\(.value)"')

                    stream_settings_list="${stream_settings_list}响应头: ${green}${outbound_streamSettings_tcpSettings_header_response_headrs_list:2}${normal}\n${indent_6}"
                fi
            ;;
            "mkcp")
                stream_settings_list="${stream_settings_list}mtu: ${green}${outbounds_streamSettings_kcpSettings_mtu[outbounds_index]:-1350}${normal} tti: ${green}${outbounds_streamSettings_kcpSettings_tti[outbounds_index]:-50}${normal}ms\n${indent_6}"
                stream_settings_list="${stream_settings_list}uplinkCapacity: ${green}${outbounds_streamSettings_kcpSettings_uplinkCapacity[outbounds_index]:-5}${normal}MB/s downlinkCapacity: ${green}${outbounds_streamSettings_kcpSettings_downlinkCapacity[outbounds_index]:-20}${normal}MB/s\n${indent_6}"
                stream_settings_list="${stream_settings_list}header type: ${green}${outbounds_streamSettings_kcpSettings_header_type[outbounds_index]:-none}${normal} seed: ${green}${outbounds_streamSettings_kcpSettings_seed[outbounds_index]:-}${normal}\n${indent_6}"
                stream_settings_list="${stream_settings_list}congestion: ${green}${outbounds_streamSettings_kcpSettings_congestion[outbounds_index]:-false}{normal} readBufferSize: ${green}${outbounds_streamSettings_kcpSettings_readBufferSize[outbounds_index]:-2}${normal}MB writeBufferSize: ${green}${outbounds_streamSettings_kcpSettings_writeBufferSize[outbounds_index]:-2}${normal}MB\n${indent_6}"
            ;;
            "websocket")
                if [ "${outbounds_streamSettings_wsSettings_acceptProxyProtocol[outbounds_index]:-false}" = false ]
                then
                    stream_settings_list="${stream_settings_list}acceptProxyProtocol: ${red}否${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}acceptProxyProtocol: ${green}是${normal}\n${indent_6}"
                fi

                stream_settings_list="${stream_settings_list}路径: ${green}${outbounds_streamSettings_wsSettings_path[outbounds_index]:-/}${normal} useBrowserForwarding: ${green}${outbounds_streamSettings_wsSettings_useBrowserForwarding[outbounds_index]:-false}${normal}\n${indent_6}"
                stream_settings_list="${stream_settings_list}maxEarlyData: ${green}${outbounds_streamSettings_wsSettings_maxEarlyData[outbounds_index]:-}${normal} earlyDataHeaderName: ${green}${outbounds_streamSettings_wsSettings_earlyDataHeaderName[outbounds_index]:-}${normal}\n${indent_6}"

                if [ -z "${outbounds_streamSettings_wsSettings_headers[outbounds_index]:-}" ]
                then
                    break
                fi

                jq_payload="${outbounds_streamSettings_wsSettings_headers[outbounds_index]}"
                jq_path='[]'

                local header_name header_value
                outbounds_streamSettings_wsSettings_headers_list=""

                while IFS="^" read -r header_name header_value; do
                    outbounds_streamSettings_wsSettings_headers_list="${outbounds_streamSettings_wsSettings_headers_list}, ${header_name}: ${header_value}"
                done < <(JQs get jq_payload '. // {} | to_entries[] | "\(.key)^\(.value)"')

                stream_settings_list="${stream_settings_list}请求头: ${green}${outbounds_streamSettings_wsSettings_headers_list:2}${normal}\n${indent_6}"
            ;;
            "http")
                stream_settings_list="${stream_settings_list}path: ${green}${outbounds_streamSettings_httpSettings_path[outbounds_index]:-/}${normal} method: ${green}${outbounds_streamSettings_httpSettings_method[outbounds_index]:-PUT}${normal}\n${indent_6}"



                jq_payload="${outbounds_streamSettings_httpSettings_headers[outbounds_index]:-{}}"
                jq_path='[]'

                local header_name header_value
                outbounds_streamSettings_httpSettings_headers_list=""

                while IFS="^" read -r header_name header_value; do
                    outbounds_streamSettings_httpSettings_headers_list="${outbounds_streamSettings_httpSettings_headers_list}, ${header_name}: ${header_value}"
                done < <(JQs get jq_payload '. // {} | to_entries[] | "\(.key)^\(.value)"')

                stream_settings_list="${stream_settings_list}请求头: ${green}${outbounds_streamSettings_httpSettings_headers_list:2}${normal}\n${indent_6}"
            ;;
            "grpc")
                stream_settings_list="${stream_settings_list}authority: ${green}${outbounds_streamSettings_grpcSettings_authority[outbounds_index]:-}${normal} serviceName: ${green}${outbounds_streamSettings_grpcSettings_serviceName[outbounds_index]:-}${normal}\n${indent_6}"
                stream_settings_list="${stream_settings_list}multiMode: ${green}${outbounds_streamSettings_grpcSettings_multiMode[outbounds_index]:-false}${normal} user_agent: ${green}${outbounds_streamSettings_grpcSettings_user_agent[outbounds_index]:-}${normal}\n${indent_6}"
                stream_settings_list="${stream_settings_list}idle_timeout: ${green}${outbounds_streamSettings_grpcSettings_idle_timeout[outbounds_index]:-60}${normal} health_check_timeout: ${green}${outbounds_streamSettings_grpcSettings_health_check_timeout[outbounds_index]:-20}${normal}\n${indent_6}"
                stream_settings_list="${stream_settings_list}permit_without_stream: ${green}${outbounds_streamSettings_grpcSettings_permit_without_stream[outbounds_index]:-false}${normal} initial_windows_size: ${green}${outbounds_streamSettings_grpcSettings_initial_windows_size[outbounds_index]:-}${normal}\n${indent_6}"
            ;;
            "hysteria")
                stream_settings_list="${stream_settings_list}版本: ${green}${outbounds_streamSettings_hysteriaSettings_version[outbounds_index]:-2}${normal} 认证密码: ${green}${outbounds_streamSettings_hysteriaSettings_auth[outbounds_index]:-}${normal} UDP超时断开: ${green}${outbounds_streamSettings_hysteriaSettings_udpIdleTimeout[outbounds_index]:-60}${normal}秒\n${indent_6}"
                stream_settings_list="${stream_settings_list}http3 页面伪装 type: ${green}${outbounds_streamSettings_hysteriaSettings_masquerade_type[outbounds_index]:-}${normal} dir: ${green}${outbounds_streamSettings_hysteriaSettings_masquerade_dir[outbounds_index]:-}${normal} url: ${green}${outbounds_streamSettings_hysteriaSettings_masquerade_url[outbounds_index]:-}${normal} rewriteHost: ${green}${outbounds_streamSettings_hysteriaSettings_masquerade_rewriteHost[outbounds_index]:-false}${normal} insecure: ${green}${outbounds_streamSettings_hysteriaSettings_masquerade_insecure[outbounds_index]:-false}${normal} content: ${green}${outbounds_streamSettings_hysteriaSettings_masquerade_content[outbounds_index]:-}${normal} statusCode: ${green}${outbounds_streamSettings_hysteriaSettings_masquerade_statusCode[outbounds_index]:-0}${normal}\n${indent_6}"

                jq_payload="${outbounds_streamSettings_hysteriaSettings_masquerade_headers[outbounds_index]:-{}}"
                jq_path='[]'

                outbound_streamSettings_hysteriaSettings_masquerade_headrs_list=""
                local header_name header_value

                while IFS="^" read -r header_name header_value; do
                    outbound_streamSettings_hysteriaSettings_masquerade_headrs_list="${outbound_streamSettings_hysteriaSettings_masquerade_headrs_list}, ${header_name}: ${header_value}"
                done < <(JQs get jq_payload '. // {} | to_entries[] | "\(.key)^\(.value)"')

                stream_settings_list="${stream_settings_list}伪装 headers: ${green}${outbound_streamSettings_hysteriaSettings_masquerade_headrs_list:2}${normal}\n${indent_6}"
            ;;
        esac

        if [ -n "${outbounds_proxy_tag[outbounds_index]}" ]
        then
            stream_settings_list="指定的出站代理标签: ${outbounds_proxy_tag[outbounds_index]}\n${indent_6}"
        else
            stream_settings_list=""

            if [ "${outbounds_stream_sockopt_mark[outbounds_index]}" -eq 0 ]
            then
                stream_settings_list="${stream_settings_list}出站标记: ${red}否${normal}\n${indent_6}"
            else
                stream_settings_list="${stream_settings_list}出站标记: ${green}${outbounds_stream_sockopt_mark[outbounds_index]}${normal}\n${indent_6}"
            fi

            if [ "${outbounds_stream_network[outbounds_index]}" == "http" ]
            then
                stream_settings_list="传输方式: ${green}http/2${normal}\n${indent_6}"
            elif [ -n "${outbounds_stream_network[outbounds_index]}" ]
            then
                stream_settings_list="传输方式: ${green}${outbounds_stream_network[outbounds_index]}${normal}\n${indent_6}"
            fi

            if [ "${outbounds_protocol[outbounds_index]}" != "blackhole" ] && [ "${outbounds_protocol[outbounds_index]}" != "dns" ] && [ "${outbounds_protocol[outbounds_index]}" != "freedom" ]
            then
                if [ "${outbounds_stream_security[outbounds_index]}" == "none" ]
                then
                    stream_settings_list="${stream_settings_list}$tls_name 加密: ${red}否${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}$tls_name 加密: ${green}${outbounds_stream_security[outbounds_index]}${normal}\n${indent_6}"
                    if [ -n "${outbounds_stream_tls_server_name[outbounds_index]}" ]
                    then
                        stream_settings_list="${stream_settings_list}指定证书域名: ${green}${outbounds_stream_tls_server_name[outbounds_index]}${normal}\n${indent_6}"
                    else
                        stream_settings_list="${stream_settings_list}指定证书域名: ${red}否${normal}\n${indent_6}"
                    fi
                    if [ "${outbounds_stream_tls_allow_insecure[outbounds_index]}" = false ]
                    then
                        stream_settings_list="${stream_settings_list}允许不安全连接: ${red}否${normal}\n${indent_6}"
                    else
                        stream_settings_list="${stream_settings_list}允许不安全连接: ${green}是${normal}\n${indent_6}"
                    fi
                    if [ "${outbounds_stream_tls_disable_system_root[outbounds_index]}" = false ]
                    then
                        stream_settings_list="${stream_settings_list}禁用操作系统自带 CA 证书: ${red}否${normal}\n${indent_6}"
                    else
                        stream_settings_list="${stream_settings_list}禁用操作系统自带 CA 证书: ${green}是${normal}\n${indent_6}"
                    fi
                    if [ -n "${outbounds_stream_tls_alpn[outbounds_index]}" ]
                    then
                        stream_settings_list="${stream_settings_list}$tls_name 握手 ALPN: ${green}${outbounds_stream_tls_alpn[outbounds_index]//|/,}${normal}\n${indent_6}"
                    else
                        stream_settings_list="${stream_settings_list}$tls_name 握手 ALPN: ${green}h2,http/1.1${normal}\n${indent_6}"
                    fi
                    if [ -n "${outbounds_stream_tls_certificates_usage[outbounds_index]}" ]
                    then
                        certificates_list="${green}证书:${normal}\n${indent_6}"
                        IFS="|" read -r -a ocsp_stapling <<< "${outbounds_stream_tls_certificates_ocsp_stapling[outbounds_index]}"
                        IFS="|" read -r -a one_time_loading <<< "${outbounds_stream_tls_certificates_one_time_loading[outbounds_index]}"
                        IFS="|" read -r -a usages <<< "${outbounds_stream_tls_certificates_usage[outbounds_index]}"
                        IFS="|" read -r -a certificate_files <<< "${outbounds_stream_tls_certificates_certificate_file[outbounds_index]}"
                        IFS="|" read -r -a key_files <<< "${outbounds_stream_tls_certificates_key_file[outbounds_index]}"
                        IFS="|" read -r -a certificates <<< "${outbounds_stream_tls_certificates_certificate[outbounds_index]}"
                        for((certificate_i=0;certificate_i<${#usages[@]};certificate_i++));
                        do
                            if [ "${usages[certificate_i]}" == "encipherment" ]
                            then
                                certificate_usage="$tls_name 认证和加密"
                            elif [ "${usages[certificate_i]}" == "verify" ]
                            then
                                certificate_usage="验证远端 $tls_name"
                            elif [ "${usages[certificate_i]}" == "issue" ]
                            then
                                certificate_usage="签发其它证书"
                            else
                                certificate_usage="验证客户端身份"
                            fi
                            if [ -n "${certificates:-}" ] && [ -n "${certificates[certificate_i]}" ]
                            then
                                certificates_list="$certificates_list$((certificate_i+1)). 用途: ${green}$certificate_usage [自签名]${normal}\n${indent_6}"
                            else
                                certificates_list="$certificates_list$((certificate_i+1)). 用途: ${green}$certificate_usage${normal}\n${indent_6}"
                            fi
                            if [ "$v2ray_name" == "xray" ] && [ "${usages[certificate_i]}" == "encipherment" ]
                            then
                                if [ "${one_time_loading[certificate_i]}" = true ]
                                then
                                    certificates_list="$certificates_list证书热重载: ${red}否${normal}\n${indent_6}"
                                else
                                    certificates_list="$certificates_list证书热重载: ${green}是${normal}\n${indent_6}OCSP 装订更新: ${green}${ocsp_stapling[certificate_i]}(秒)${normal}\n${indent_6}"
                                fi
                            fi
                            if [ -n "${certificate_files[certificate_i]}" ]
                            then
                                certificates_list="$certificates_list证书路径: ${green}${certificate_files[certificate_i]}${normal}\n${indent_6}"
                            fi
                            if [ -n "${key_files[certificate_i]}" ]
                            then
                                certificates_list="$certificates_list密钥路径: ${green}${key_files[certificate_i]}${normal}\n${indent_6}"
                            fi
                        done
                        stream_settings_list="$stream_settings_list\n${indent_6}$certificates_list\n${indent_6}"
                    fi
                fi
            fi

            if [ "${outbounds_stream_network[outbounds_index]}" == "tcp" ]
            then
                if [ "${outbounds_stream_header_type[outbounds_index]}" == "none" ]
                then
                    stream_settings_list="${stream_settings_list}数据包头部: ${red}不伪装${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}数据包头部: ${green}http 伪装${normal}\n${indent_6}"
                    if [ -n "${outbounds_stream_header_request[outbounds_index]}" ]
                    then
                        IFS="|" read -r -a header_request <<< "${outbounds_stream_header_request[outbounds_index]}"
                        header_request_list=""
                        for request in "${header_request[@]}"
                        do
                            request_key=${request%%=*}
                            request_value=${request#*=}
                            if [ "$request_key" == "headers" ]
                            then
                                IFS="!" read -r -a headers <<< "$request_value"
                                if [ -n "${headers:-}" ]
                                then
                                    header_request_list="$header_request_list${green}headers${normal}:\n\033[8C"
                                    for header in "${headers[@]}"
                                    do
                                        header_key=${header%%=*}
                                        header_value=${header#*=}
                                        IFS="~" read -r -a header_values <<< "$header_value"
                                        if [ -z "${header_values:-}" ]
                                        then
                                            header_request_list="$header_request_list${green}$header_key => \"\"${normal}\n\033[8C"
                                            continue
                                        fi
                                        header_request_list="$header_request_list${green}$header_key => ${normal}\n\033[8C"
                                        for header_value in "${header_values[@]}"
                                        do
                                            header_request_list="$header_request_list  ${green}$header_value${normal}\n\033[8C"
                                        done
                                    done
                                fi
                            else
                                header_request_list="$header_request_list${green}$request_key${normal}: ${green}${request_value//~/, }${normal}\n${indent_6}"
                            fi
                        done
                        [ -n "$header_request_list" ] && stream_settings_list="${stream_settings_list}自定义 HTTP 头:\n${indent_6}$header_request_list"
                    fi
                fi
            elif [ "${outbounds_stream_network[outbounds_index]}" == "kcp" ]
            then
                if [ "${outbounds_stream_header_type[outbounds_index]}" == "none" ]
                then
                    stream_settings_list="${stream_settings_list}数据包头部伪装: ${red}否${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}数据包头部伪装: ${green}${outbounds_stream_network[outbounds_index]}${normal}\n${indent_6}"
                fi
                if [ "${outbounds_stream_kcp_congestion[outbounds_index]}" = false ]
                then
                    stream_settings_list="${stream_settings_list}拥塞控制: ${red}否${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}拥塞控制: ${green}是${normal}\n${indent_6}"
                fi
                stream_settings_list="${stream_settings_list}最大传输单元: ${green}${outbounds_stream_kcp_mtu[outbounds_index]}${normal}\n${indent_6}传输时间间隔: ${green}${outbounds_stream_kcp_tti[outbounds_index]}(ms)${normal}\n${indent_6}上行链路容量: ${green}${outbounds_stream_kcp_uplink_capacity[outbounds_index]}(MB/s)${normal}\n${indent_6}下行链路容量: ${green}${outbounds_stream_kcp_downlink_capacity[outbounds_index]}(MB/s)${normal}\n${indent_6}读取缓冲区大小: ${green}${outbounds_stream_kcp_downlink_capacity[outbounds_index]}(MB)${normal}\n${indent_6}写入缓冲区大小: ${green}${outbounds_stream_kcp_downlink_capacity[outbounds_index]}(MB)${normal}\n${indent_6}"
                if [ -n "${outbounds_stream_kcp_seed[outbounds_index]}" ]
                then
                    stream_settings_list="${stream_settings_list}混淆密码: ${green}${outbounds_stream_kcp_seed[outbounds_index]}${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}混淆密码: ${red}否${normal}\n${indent_6}"
                fi
            elif [ "${outbounds_stream_network[outbounds_index]}" == "ws" ]
            then
                stream_settings_list="${stream_settings_list}路径: ${green}${outbounds_stream_path[outbounds_index]}${normal}\n${indent_6}"
                if [ -n "${outbounds_stream_ws_headers[outbounds_index]}" ]
                then
                    IFS="|" read -r -a headers <<< "${outbounds_stream_ws_headers[outbounds_index]}"
                    headers_list=""
                    for header in "${headers[@]}"
                    do
                        headers_list="$headers_list${green}${header%%=*}${normal}: ${green}${header#*=}${normal}\n${indent_6}"
                    done
                    [ -n "$headers_list" ] && stream_settings_list="${stream_settings_list}自定义 HTTP 头:\n${indent_6}$headers_list"
                fi
                if [ "$v2ray_name" == "v2ray" ]
                then
                    if [ "${outbounds_stream_ws_max_early_data[outbounds_index]}" -eq 0 ]
                    then
                        stream_settings_list="${stream_settings_list}前置数据: ${red}否${normal}\n${indent_6}"
                    else
                        stream_settings_list="${stream_settings_list}前置数据最长长度: ${green}${outbounds_stream_ws_max_early_data[outbounds_index]}${normal}\n${indent_6}"
                        if [ -n "${outbounds_stream_ws_early_data_header_name[outbounds_index]}" ]
                        then
                            stream_settings_list="${stream_settings_list}前置数据: ${green}基于 HTTP 头 ${outbounds_stream_ws_early_data_header_name[outbounds_index]}${normal}\n${indent_6}"
                        else
                            stream_settings_list="${stream_settings_list}前置数据: ${green}基于路径${normal}\n${indent_6}"
                        fi
                    fi
                    if [ "${outbounds_stream_ws_use_browser_forwarding[outbounds_index]}" = false ] || [ "${outbounds_stream_ws_early_data_header_name[outbounds_index]}" != "Sec-WebSocket-Protocol" ]
                    then
                        stream_settings_list="${stream_settings_list}浏览器转发: ${red}否${normal}\n${indent_6}"
                    else
                        stream_settings_list="${stream_settings_list}浏览器转发: ${green}是${normal}\n${indent_6}"
                    fi
                fi
            elif [ "${outbounds_stream_network[outbounds_index]}" == "http" ]
            then
                stream_settings_list="${stream_settings_list}路径: ${green}${outbounds_stream_path[outbounds_index]}${normal}\n${indent_6}"
                if [ -n "${outbounds_stream_http_host[outbounds_index]}" ]
                then
                    stream_settings_list="${stream_settings_list}通信域名: ${green}${outbounds_stream_http_host[outbounds_index]//|/, }${normal}\n${indent_6}"
                fi
                if [ "$v2ray_name" == "v2ray" ]
                then
                    stream_settings_list="${stream_settings_list}HTTP 方法: ${green}${outbounds_stream_http_method[outbounds_index]}${normal}\n${indent_6}"
                    if [ -z "${outbounds_stream_http_headers[outbounds_index]}" ]
                    then
                        stream_settings_list="${stream_settings_list}自定义 HTTP 头: ${red}否${normal}\n${indent_6}"
                    else
                        IFS="|" read -r -a http_headers <<< "${outbounds_stream_http_headers[outbounds_index]}"
                        http_headers_list="${green}headers${normal}:\n\033[8C"
                        for header in "${http_headers[@]}"
                        do
                            header_key=${header%%=*}
                            header_value=${header#*=}
                            IFS="~" read -r -a header_values <<< "$header_value"
                            if [ -n "${header_values:-}" ]
                            then
                                header_request_list="$header_request_list${green}$header_key => ${normal}\n\033[8C"
                                for header_value in "${header_values[@]}"
                                do
                                    header_request_list="$header_request_list  ${green}$header_value${normal}\n\033[8C"
                                done
                            else
                                header_request_list="$header_request_list${green}$header_key => \"\"${normal}\n\033[8C"
                            fi
                        done
                        stream_settings_list="${stream_settings_list}自定义 HTTP 头:\n${indent_6}$http_headers_list"
                    fi
                fi
            elif [ "${outbounds_stream_network[outbounds_index]}" == "quic" ]
            then
                if [ "${outbounds_stream_quic_security[outbounds_index]}" == "none" ]
                then
                    stream_settings_list="${stream_settings_list}数据包加密方式: ${red}不加密${normal} 密钥: ${green}${outbounds_stream_quic_key[outbounds_index]}${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}数据包加密方式: ${green}${outbounds_stream_quic_security[outbounds_index]}${normal} 密钥: ${green}${outbounds_stream_quic_key[outbounds_index]}${normal}\n${indent_6}"
                fi
                if [ "${outbounds_stream_header_type[outbounds_index]}" == "none" ]
                then
                    stream_settings_list="${stream_settings_list}数据包头部: ${red}不伪装${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}数据包头部: ${green}http 伪装${normal}\n${indent_6}"
                fi
            elif [ "${outbounds_stream_network[outbounds_index]}" == "grpc" ]
            then
                if [ "$v2ray_name" == "v2ray" ]
                then
                    stream_settings_list="${stream_settings_list}gRPC 服务名称: ${green}${outbounds_stream_grpc_service_name[outbounds_index]}${normal}\n${indent_6}"
                elif [ "${outbounds_stream_grpc_multi_mode[outbounds_index]}" = false ]
                then
                    stream_settings_list="${stream_settings_list}gRPC 服务名称: ${green}${outbounds_stream_grpc_service_name[outbounds_index]}${normal} multiMode: ${red}否${normal}\n${indent_6}"
                else
                    stream_settings_list="${stream_settings_list}gRPC 服务名称: ${green}${outbounds_stream_grpc_service_name[outbounds_index]}${normal} multiMode: ${green}是${normal}\n${indent_6}"
                fi
            fi
        fi

        if [ "${outbounds_mux_enabled[outbounds_index]}" = true ]
        then
            mux_settings_list="${green}已开启 Mux${normal} 最大并发连接数: ${green}${outbounds_mux_concurrency[outbounds_index]}${normal}\n${indent_6}"
        else
            mux_settings_list=""
        fi

        outbounds_list="$outbounds_list# ${green}$((outbounds_index+1))${normal}${indent_6}标签: ${green}${outbounds_tag[outbounds_index]:-无}${normal}\n${indent_6}$protocol_settings_list$stream_settings_list$mux_settings_list\n\n"
    done

    Println "$outbounds_list\n"
}
