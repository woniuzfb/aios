V2rayListOutbounds()
{
    V2rayGetOutbounds

    if [ "$outbounds_count" -eq 0 ]
    then
        Println "$error 没有出站\n"
        return 1
    fi

    Println "\n=== 出站数 ${green} $outbounds_count ${normal}"
    outbounds_list=$(ProxyRenderOutbounds "$V2_CONFIG" v2ray)
    Println "$outbounds_list"
}
