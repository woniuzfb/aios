V2rayDeleteOutboundAccount()
{
    ProxySelectBound "$V2_CONFIG" outbounds "选择要删除服务端/账号的出站" || return 1
    local idx="$selected_bound_index"
    local protocol="${outbounds_protocol[idx]}"
    local field="servers"
    if [ "$protocol" == "vmess" ] || [ "$protocol" == "vless" ]
    then
        field="vnext"
    fi

    local opts=()
    local line
    while IFS= read -r line
    do
        [ -n "$line" ] && opts+=("$line")
    done < <(JQs query "$V2_CONFIG" '
        (if (.outbounds | type) == "array" and (.outbounds[$i] | type) == "object"
            and (.outbounds[$i].settings | type) == "object"
            and (.outbounds[$i].settings[$f] | type) == "array"
         then .outbounds[$i].settings[$f]
         else [] end)
        | to_entries[]
        | select(.value | type == "object")
        | "\(.key + 1). \(.value.address // ""):\(.value.port // "")"
    ' --argjson i "$idx" --arg f "$field")

    if [ "${#opts[@]}" -eq 0 ]
    then
        Println "$error 该出站没有可删除的服务端/账号\n"
        return 1
    fi

    local srv_idx=0
    echo
    inquirer list_input_index "选择要删除的服务端/账号" opts srv_idx
    jq_path='["outbounds",'"$idx"',"settings","'"$field"'",'"$srv_idx"']'
    JQ delete "$V2_CONFIG"
    ProxyRestartIfActive v2ray
    Println "$info 已删除服务端 ${green}${opts[srv_idx]}${normal}\n"
}
