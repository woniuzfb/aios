V2rayGetRouting()
{
    SetDelimiters

    jq_payload=$(JQs flat "$V2_CONFIG" '.routing')

    jq_path='[
        ["domainStrategy"],
        ["domainMatcher"],
        ["rules","domainMatcher"],
        ["rules","type"],
        ["rules","domains"],
        ["rules","ip"],
        ["rules","port"],
        ["rules","sourcePort"],
        ["rules","network"],
        ["rules","source"],
        ["rules","user"],
        ["rules","inboundTag"],
        ["rules","protocol"],
        ["rules","attrs"],
        ["rules","outboundTag"],
        ["rules","balancerTag"],
        ["balancers","tag"],
        ["balancers","selector"],
        ["balancers","strategy","type"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name="jq_routing_${path_name#*_}"
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    routing_domainStrategy="${jq_routing_domainStrategy:-AsIs}"
    routing_domainMatcher="${jq_routing_domainMatcher:-mph}"

    if [ -z "${jq_routing_balancers_tag:-}" ]
    then
        routing_balancers_count=0
    else
        IFS="${delimiters[2]}" read -r -a routing_balancers_tag <<< "$jq_routing_balancers_tag"
        IFS="${delimiters[2]}" read -r -a routing_balancers_selector <<< "$jq_routing_balancers_selector"
        IFS="${delimiters[3]}" read -r -a routing_balancers_strategy_type <<< "$jq_routing_balancers_strategy_type"

        routing_balancers_count=${#routing_balancers_tag[@]}
    fi

    if [ -z "${jq_routing_rules_type:-}" ]
    then
        routing_rules_count=0
        return 0
    fi

    IFS="${delimiters[1]}" read -r -a routing_domainStrategy <<< "$jq_routing_domainStrategy"
    IFS="${delimiters[1]}" read -r -a routing_domainMatcher <<< "$jq_routing_domainMatcher"
    IFS="${delimiters[2]}" read -r -a routing_rules_domainMatcher <<< "$jq_routing_rules_domainMatcher"
    IFS="${delimiters[2]}" read -r -a routing_rules_type <<< "$jq_routing_rules_type"
    IFS="${delimiters[2]}" read -r -a routing_rules_domains <<< "$jq_routing_rules_domains"
    IFS="${delimiters[2]}" read -r -a routing_rules_ip <<< "$jq_routing_rules_ip"
    IFS="${delimiters[2]}" read -r -a routing_rules_port <<< "$jq_routing_rules_port"
    IFS="${delimiters[2]}" read -r -a routing_rules_sourcePort <<< "$jq_routing_rules_sourcePort"
    IFS="${delimiters[2]}" read -r -a routing_rules_network <<< "$jq_routing_rules_network"
    IFS="${delimiters[2]}" read -r -a routing_rules_source <<< "$jq_routing_rules_source"
    IFS="${delimiters[2]}" read -r -a routing_rules_user <<< "$jq_routing_rules_user"
    IFS="${delimiters[2]}" read -r -a routing_rules_inboundTag <<< "$jq_routing_rules_inboundTag"
    IFS="${delimiters[2]}" read -r -a routing_rules_protocol <<< "$jq_routing_rules_protocol"
    IFS="${delimiters[2]}" read -r -a routing_rules_attrs <<< "$jq_routing_rules_attrs"
    IFS="${delimiters[2]}" read -r -a routing_rules_outboundTag <<< "$jq_routing_rules_outboundTag"
    IFS="${delimiters[2]}" read -r -a routing_rules_balancerTag <<< "$jq_routing_rules_balancerTag"

    routing_rules_count=${#routing_rules_type[@]}

}
