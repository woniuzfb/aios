V2rayGetObservatory()
{
    SetDelimiters

    jq_payload=$(JQs flat "$V2_CONFIG" '.observatory')

    jq_path='[
        ["subjectSelector"],
        ["probeURL"],
        ["probeInterval"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name="observatory_${path_name#*_}"
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    return 0
}
