    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_kcpSettings_tti <<< "$jq_streamSettings_kcpSettings_tti"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_kcpSettings_uplinkCapacity <<< "$jq_streamSettings_kcpSettings_uplinkCapacity"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_kcpSettings_downlinkCapacity <<< "$jq_streamSettings_kcpSettings_downlinkCapacity"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_kcpSettings_congestion <<< "$jq_streamSettings_kcpSettings_congestion"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_kcpSettings_readBufferSize <<< "$jq_streamSettings_kcpSettings_readBufferSize"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_kcpSettings_writeBufferSize <<< "$jq_streamSettings_kcpSettings_writeBufferSize"
    IFS="${delimiters[4]}" read -r -a inbounds_streamSettings_kcpSettings_header_type <<< "$jq_streamSettings_kcpSettings_header_type"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_kcpSettings_seed <<< "$jq_streamSettings_kcpSettings_seed"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_wsSettings_acceptProxyProtocol <<< "$jq_streamSettings_wsSettings_acceptProxyProtocol"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_wsSettings_path <<< "$jq_streamSettings_wsSettings_path"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_wsSettings_maxEarlyData <<< "$jq_streamSettings_wsSettings_maxEarlyData"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_wsSettings_earlyDataHeaderName <<< "$jq_streamSettings_wsSettings_earlyDataHeaderName"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_httpSettings_host <<< "$jq_streamSettings_httpSettings_host"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_httpSettings_path <<< "$jq_streamSettings_httpSettings_path"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_httpSettings_method <<< "$jq_streamSettings_httpSettings_method"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_quicSettings_security <<< "$jq_streamSettings_quicSettings_security"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_quicSettings_key <<< "$jq_streamSettings_quicSettings_key"
    IFS="${delimiters[4]}" read -r -a inbounds_streamSettings_quicSettings_header_type <<< "$jq_streamSettings_quicSettings_header_type"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_dsSettings_path <<< "$jq_streamSettings_dsSettings_path"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_dsSettings_abstract <<< "$jq_streamSettings_dsSettings_abstract"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_dsSettings_padding <<< "$jq_streamSettings_dsSettings_padding"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_grpcSettings_serviceName <<< "$jq_streamSettings_grpcSettings_serviceName"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_sockopt_mark <<< "$jq_streamSettings_sockopt_mark"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_sockopt_tcpFastOpen <<< "$jq_streamSettings_sockopt_tcpFastOpen"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_sockopt_tcpFastOpenQueueLength <<< "$jq_streamSettings_sockopt_tcpFastOpenQueueLength"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_sockopt_tproxy <<< "$jq_streamSettings_sockopt_tproxy"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_sockopt_tcpKeepAliveInterval <<< "$jq_streamSettings_sockopt_tcpKeepAliveInterval"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_sockopt_bindToDevice <<< "$jq_streamSettings_sockopt_bindToDevice"
    IFS="${delimiters[3]}" read -r -a inbounds_streamSettings_sockopt_mptcp <<< "$jq_streamSettings_sockopt_mptcp"
    IFS="${delimiters[2]}" read -r -a inbounds_sniffing_enabled <<< "$jq_sniffing_enabled"
    IFS="${delimiters[2]}" read -r -a inbounds_sniffing_destOverride <<< "$jq_sniffing_destOverride"
    IFS="${delimiters[2]}" read -r -a inbounds_sniffing_metadataOnly <<< "$jq_sniffing_metadataOnly"
    IFS="${delimiters[2]}" read -r -a inbounds_allocate_strategy <<< "$jq_allocate_strategy"
    IFS="${delimiters[2]}" read -r -a inbounds_allocate_refresh <<< "$jq_allocate_refresh"
    IFS="${delimiters[2]}" read -r -a inbounds_allocate_concurrency <<< "$jq_allocate_concurrency"
    IFS="${delimiters[1]}" read -r -a inbounds_tag <<< "$jq_tag"

    inbounds_count=${#inbounds_protocol[@]}

    inbounds_nginx_index=()
    inbounds_other_index=()

    for((inbounds_i=0;inbounds_i<inbounds_count;inbounds_i++));
    do
        if [ "${inbounds_tag[inbounds_i]:0:6}" == "nginx-" ]
        then
            inbounds_nginx_count=$((inbounds_nginx_count+1))
            inbounds_nginx_index+=("$inbounds_i")
        else
            inbounds_other_count=$((inbounds_other_count+1))
            inbounds_other_index+=("$inbounds_i")
        fi
    done
}
