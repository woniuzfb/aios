V2rayListInbounds()
{
    V2rayGetInbounds

    local list_inbounds_options=( "$(gettext "全部入站")" "$(gettext "本地 nginx 入站")" "$(gettext "直连 v2ray 入站")" )
    local filter_mode="all"
    count=0

    if [ "${1:-}" == "nginx" ]
    then
        list_inbounds_options_index=1
        filter_mode="nginx"
        count=$inbounds_nginx_count
    elif [ "${1:-}" == "direct" ]
    then
        list_inbounds_options_index=2
        filter_mode="direct"
        count=$inbounds_other_count
    else
        echo
        inquirer list_input_index "$(gettext "选择显示的范围")" list_inbounds_options list_inbounds_options_index

        if [ "$list_inbounds_options_index" -eq 0 ]
        then
            filter_mode="all"
            count=$inbounds_count
        elif [ "$list_inbounds_options_index" -eq 1 ]
        then
            filter_mode="nginx"
            count=$inbounds_nginx_count
        else
            filter_mode="direct"
            count=$inbounds_other_count
        fi
    fi

    local scope_label="${list_inbounds_options[list_inbounds_options_index]}"

    if [ "$count" -eq 0 ]
    then
        if [ "$list_inbounds_options_index" -eq 0 ]
        then
            Println "$(eval_gettext "\$error 请先添加入站")\n"
        else
            Println "$(eval_gettext "\$error 请先添加 \${scope_label}")\n"
        fi
        return 1
    fi

    Println "\n$(eval_gettext "=== \${scope_label}数 \${green} \$count \${normal}")"
    inbounds_list=$(ProxyRenderInbounds "$V2_CONFIG" v2ray "$filter_mode")
    Println "$inbounds_list"
}
