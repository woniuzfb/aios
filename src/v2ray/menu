read -p "$(gettext "输入序号") [1-26]: " v2ray_num
case $v2ray_num in
    1)
        V2rayInstall
    ;;
    2)
        V2rayUpdate
    ;;
    3)
        V2rayConfigDomain
    ;;
    4)
        ServiceControl status v2ray
    ;;
    5)
        V2rayListInboundAccounts && V2rayListInboundShare
    ;;
    6)
        V2rayAddInbound
    ;;
    7)
        V2rayAddInboundAccount
    ;;
    8)
        V2rayListOutboundAccounts
    ;;
    9)
        V2rayAddOutbound
    ;;
    10)
        V2rayAddOutboundAccount
    ;;
    11)
        V2rayListDns
    ;;
    12)
        V2raySetDns
    ;;
    13)
        V2rayListRouting
    ;;
    14)
        V2raySetRouting
    ;;
    15)
        V2rayListPolicy
    ;;
    16)
        V2raySetPolicy
    ;;
    17)
        V2rayListStats
    ;;
    18)
        V2rayResetStats
    ;;
