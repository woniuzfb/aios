case $* in
    "e")
        [ ! -e "$V2_CONFIG" ] && Println "$error 尚未安装, 请检查 !\n" && exit 1
        editor "$V2_CONFIG" && exit 0
    ;;
    *)
    ;;
esac

ProxyDetectNginx

