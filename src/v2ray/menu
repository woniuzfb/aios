    1)
        V2rayInstall
    ;;
    2)
        V2rayUpdate
    ;;
    3)
        V2rayConfigDomain
    ;;
    4)
        ServiceControl status v2ray
    ;;
    5)
        V2rayListInboundAccounts && V2rayListInboundShare
    ;;
    6)
        V2rayAddInbound
    ;;
    7)
        V2rayAddInboundAccount
    ;;
    8)
        V2rayListOutboundAccounts
    ;;
    9)
        V2rayAddOutbound
    ;;
    10)
        V2rayAddOutboundAccount
    ;;
    11)
        V2rayListDns
    ;;
    12)
        V2raySetDns
    ;;
    13)
        V2rayListRouting
    ;;
    14)
        V2raySetRouting
    ;;
    15)
        V2rayListPolicy
    ;;
    16)
        V2raySetPolicy
    ;;
    17)
        V2rayListStats
    ;;
    18)
        V2rayResetStats
    ;;
    19)
        V2rayListReverse
    ;;
    20)
        V2raySetReverse
    ;;
    21)
        V2rayDeleteInbound
    ;;
    22)
        V2rayDeleteInboundAccount
    ;;
    23)
        V2rayDeleteOutbound
    ;;
    24)
        V2rayDeleteOutboundAccount
    ;;
    25)
        ProxyToggleService v2ray "$V2_CONFIG"
    ;;
    26)
        ProxyRestartService v2ray "$V2_CONFIG"
    ;;
    *) Println "$error $i18n_input_correct_number [1-26]\n"
    ;;
esac

exit 0
