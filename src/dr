Include src/docker/install "$@"
Include src/docker/crt "$@"
Include src/docker/service "$@"
Include src/service/browse "$@"
Include utils/postgresql "$@"
Include utils/yq "$@"

DepInstall sudo

docker_options=( "$(gettext "服务")" "$(gettext "管理证书")" "$(gettext "安装/更新 docker")" "$(gettext "安装/更新 postgresql")" "$(gettext "安装/更新 yq")" )
echo
inquirer list_input_index "$i18n_please_select" docker_options docker_options_index

case $docker_options_index in
    0) DockerService
    ;;
    1) DockerCrtManage
    ;;
    2) DockerInstall update
    ;;
    3) PostgresqlInstall update
    ;;
    4) YqInstall update
    ;;
esac
