            fi

            echo
            inquirer list_input_index "$(gettext "选择同步目标")" rclone_sync_target_options rclone_sync_target_options_index 20

            if [ "$rclone_sync_target_options_index" -eq 0 ] 
            then
                echo
                ExitOnText "$(gettext "输入同步的本地目录")" rclone_sync_target RcloneSyncLocalValidator "$(gettext "路径错误")"
                RemoveQuotes rclone_sync_target
            else
                rclone_sync_target="${rclone_sync_target_options[rclone_sync_target_options_index]}"
                echo
                ExitOnText "$(eval_gettext "输入同步目标 \$rclone_sync_target 的路径")" rclone_sync_target_path
                rclone_sync_target="$rclone_sync_target:$rclone_sync_target_path"
            fi

            if [ "$rclone_sync_target" != "${rclone_syncs_target[rclone_syncs_index]}" ] 
            then
                jq_path='["rclone","sync",'"$rclone_syncs_index"',"target"]'
                JQ update "$SERVICES_CONFIG" "$rclone_sync_target"
                Println "$(eval_gettext "\$info 同步目标修改成功")\n"
            fi
        ;;
        2) 
            echo
            inquirer text_input "$(gettext "输入同步参数")" rclone_sync_args "$i18n_blank"

            if [ "$rclone_sync_args" != "${rclone_syncs_args[rclone_syncs_index]}" ] 
            then
                jq_path='["rclone","sync",'"$rclone_syncs_index"',"args"]'
                JQ update "$SERVICES_CONFIG" "$rclone_sync_args"
                Println "$(eval_gettext "\$info 同步参数修改成功")\n"
            fi
        ;;
        3)
            if [ -z "${rclone_syncs_exclude_before[rclone_syncs_index]:-}" ] 
            then
                RcloneSyncSetExcludeBefore
            else
                IFS="${delimiters[4]}" read -r -a rclone_sync_excludes_before <<< "${rclone_syncs_exclude_before[rclone_syncs_index]}"
                rclone_sync_exclude_options=( "$i18n_add" "$i18n_edit" "$i18n_delete" )
                echo
                inquirer list_input_index "$i18n_select_action" rclone_sync_exclude_options rclone_sync_exclude_options_index

                if [ "$rclone_sync_exclude_options_index" -eq 0 ] 
                then
                    RcloneSyncSetExcludeBefore
                else
                    echo
                    inquirer checkbox_input_indices "$(gettext "选择排除的文件或目录")" rclone_sync_excludes_before rclone_sync_excludes_before_indices

                    if [ "$rclone_sync_exclude_options_index" -eq 1 ] 
                    then
                        local i18n_input_new_item
                        i18n_input_new_item=$(gettext "输入新的文件或目录")
                        for rclone_sync_excludes_before_index in "${rclone_sync_excludes_before_indices[@]}"
                        do
                            Println "$info $i18n_edit ${rclone_sync_excludes_before[rclone_sync_excludes_before_index]}"
                            inquirer text_input "$i18n_input_new_item" rclone_sync_exclude_before "$i18n_skip"
                            RemoveQuotes rclone_sync_exclude_before
                            if [ "$rclone_sync_exclude_before" == "$i18n_skip" ] || [ "$rclone_sync_exclude_before" == "${rclone_sync_excludes_before[rclone_sync_excludes_before_index]}" ]
                            then
                                continue
                            fi
                            jq_path='["rclone","sync",'"$rclone_syncs_index"',"exclude_before",'"$rclone_sync_excludes_before_index"']'
                            JQ update "$SERVICES_CONFIG" "$rclone_sync_exclude_before"
