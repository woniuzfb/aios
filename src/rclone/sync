                if [ "$rclone_sync_exclude_options_index" -eq 0 ] 
                then
                    RcloneSyncSetExcludeAfter
                else
                    echo
                    inquirer checkbox_input_indices "$(gettext "选择排除的文件或目录")" rclone_sync_excludes_after rclone_sync_excludes_after_indices

                    if [ "$rclone_sync_exclude_options_index" -eq 1 ] 
