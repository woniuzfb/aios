                echo
                inquirer list_input_index "$(gettext "选择同步源")" rclone_remotes_options rclone_remotes_index 20

                rclone_sync_remote_name="${rclone_remotes_name[rclone_remotes_index]}"
                echo
                ExitOnText "$(eval_gettext "输入远端 \$rclone_sync_remote_name 的路径")" rclone_sync_remote_path
                rclone_sync_source="$rclone_sync_remote_name:$rclone_sync_remote_path"
            fi

            if [ "$rclone_sync_source" != "${rclone_syncs_source[rclone_syncs_index]}" ] 
            then
                jq_path='["rclone","sync",'"$rclone_syncs_index"',"source"]'
                JQ update "$SERVICES_CONFIG" "$rclone_sync_source"
            fi

            if [ "$rclone_sync_rsync" != "${rclone_syncs_rsync[rclone_syncs_index]}" ] 
            then
                jq_bool=true
                jq_path='["rclone","sync",'"$rclone_syncs_index"',"rsync"]'
                JQ update "$SERVICES_CONFIG" "$rclone_sync_rsync"
            fi

            Println "$(eval_gettext "\$info 同步源修改成功")\n"
        ;;
        1) 
            rclone_sync_target_options=( "$(gettext "输入本地目录")" )

            if [ "${rclone_syncs_rsync[rclone_syncs_index]}" = true ] 
            then
                if rclone_sync_rsync_hosts=($(grep "^Host " ~/.ssh/config | grep -v "Host \*" | awk '{print $2}'))
