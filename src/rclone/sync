RcloneSyncView()
{
    ServiceGet rclone sync

    if [ "$rclone_syncs_count" -eq 0 ] 
    then
        Println "$(eval_gettext "\$error 请先添加同步")\n"
        return 1
    fi

    local rclone_syncs_list="" i rclone_sync_include_list rclone_sync_exclude_before_list rclone_sync_exclude_after_list
    local i18n_exclude_before i18n_include i18n_exclude_after i18n_sync_source i18n_sync_target i18n_sync_args i18n_src i18n_dst
    i18n_exclude_before=$(gettext "前排除")
    i18n_include=$(gettext "包含")
    i18n_exclude_after=$(gettext "后排除")
    i18n_sync_source=$(gettext "同步源")
    i18n_sync_target=$(gettext "同步目标")
    i18n_sync_args=$(gettext "同步参数")
    i18n_src=$(gettext "源")
    i18n_dst=$(gettext "目标")
    rclone_syncs_options=()

    for((i=0;i<rclone_syncs_count;i++));
    do
        rclone_syncs_list="${rclone_syncs_list}${green}$((i+1)).${normal} rsync: "
        if [ "${rclone_syncs_rsync[i]}" = true ] 
        then
            rclone_syncs_list="${rclone_syncs_list}${green}${i18n_yes}${normal}\n"
        else
            rclone_syncs_list="${rclone_syncs_list}${red}${i18n_no}${normal}\n"
        fi
        if [[ -z "${rclone_syncs_exclude_before[i]:-}" ]] 
        then
            rclone_sync_exclude_before_list="${i18n_exclude_before}: ${i18n_not_set}\n"
        else
            IFS="${delimiters[4]}" read -r -a rclone_sync_excludes_before <<< "${rclone_syncs_exclude_before[i]}"
            rclone_sync_exclude_before_list="${i18n_exclude_before}:\n$(printf '%s\n' "${rclone_sync_excludes_before[@]}")\n"
        fi
        if [[ -z "${rclone_syncs_include[i]:-}" ]] 
        then
            rclone_sync_include_list="${i18n_include}: ${i18n_not_set}\n"
        else
            IFS="${delimiters[4]}" read -r -a rclone_sync_includes <<< "${rclone_syncs_include[i]}"
            rclone_sync_include_list="${i18n_include}:\n$(printf '%s\n' "${rclone_sync_includes[@]}")"
        fi
        if [[ -z "${rclone_syncs_exclude_after[i]:-}" ]] 
        then
            rclone_sync_exclude_after_list="${i18n_exclude_after}: ${i18n_not_set}\n"
        else
            IFS="${delimiters[4]}" read -r -a rclone_sync_excludes_after <<< "${rclone_syncs_exclude_after[i]}"
            rclone_sync_exclude_after_list="${i18n_exclude_after}:\n$(printf '%s\n' "${rclone_sync_excludes_after[@]}")\n"
        fi
        rclone_syncs_list="${rclone_syncs_list}${i18n_sync_source}: ${rclone_syncs_source[i]}\n${i18n_sync_target}: ${rclone_syncs_target[i]}\n${i18n_sync_args}: ${rclone_syncs_args[i]:-$i18n_none}\n${rclone_sync_exclude_before_list}${rclone_sync_include_list}${rclone_sync_exclude_after_list}\n"
        rclone_syncs_options+=("${i18n_src}: ${rclone_syncs_source[i]} ${i18n_dst}: ${rclone_syncs_target[i]} rsync: ${rclone_syncs_rsync[i]}")
    done

    Println "$rclone_syncs_list"
}

RcloneSyncLocalValidator()
{
    if [[ "$1" == "$i18n_cancel" ]] || [[ "$1" =~ ^[\'\"]?/.*[\'\"]?$ ]]
    then
        return 0
    fi

    return 1
}

RcloneSyncRsyncRemoteValidator()
{
    if [[ "$1" == "$i18n_cancel" ]] || [[ "$1" =~ ^[a-zA-Z0-9]+:.*$ ]] 
    then
        return 0
    fi

    return 1
}

RcloneSyncAdd()
{
    Println "$(eval_gettext "\$tip 如果选否将使用 rsync 同步")"
    inquirer list_input_index "$(gettext "是否使用远端")" ny_options ny_index

    rclone_sync_target_options=( "$(gettext "输入本地目录")" )
    rclone_sync_excludes_before=()
    rclone_sync_includes=()
    rclone_sync_excludes_after=()

    if [ "$ny_index" -eq 0 ] 
    then
        rclone_sync_rsync=true
        rclone_sync_rsync_options=( "$(gettext "输入本地同步源")" "$(gettext "输入远程同步源")" )

        if rclone_sync_rsync_hosts=($(grep "^Host " ~/.ssh/config | grep -v "Host \*" | awk '{print $2}'))
        then
            rclone_sync_rsync_options+=("${rclone_sync_rsync_hosts[@]}")
            rclone_sync_target_options+=("${rclone_sync_rsync_hosts[@]}")
        fi

        echo
        inquirer list_input_index "$(gettext "选择同步源")" rclone_sync_rsync_options rclone_sync_rsync_options_index 20

        case $rclone_sync_rsync_options_index in
            0) 
                echo
                ExitOnText "$(gettext "输入本地路径")" rclone_sync_source RcloneSyncLocalValidator "$(gettext "路径错误")"
                RemoveQuotes rclone_sync_source
            ;;
            1) 
                echo
                ExitOnText "$(gettext "输入远程同步源")" rclone_sync_source RcloneSyncRsyncRemoteValidator "$(gettext "远程格式错误")"
            ;;
            *) 
                rclone_sync_rsync_host="${rclone_sync_rsync_hosts[rclone_sync_rsync_options_index-2]}"
                echo
                ExitOnText "$(eval_gettext "输入远程同步源 \$rclone_sync_rsync_host 的路径")" rclone_sync_rsync_host_path
                rclone_sync_source="$rclone_sync_rsync_host:$rclone_sync_rsync_host_path"
            ;;
        esac
    else
        rclone_sync_rsync=false

        RcloneRemoteView

        echo
        inquirer list_input_index "$(gettext "选择同步源")" rclone_remotes_options rclone_remotes_index 20

        rclone_sync_remote_name="${rclone_remotes_name[rclone_remotes_index]}"
        echo
        ExitOnText "$(eval_gettext "输入远端 \$rclone_sync_remote_name 的路径")" rclone_sync_remote_path
        rclone_sync_source="$rclone_sync_remote_name:$rclone_sync_remote_path"

        rclone_sync_target_options+=("${rclone_remotes_name[@]}")
    fi

    RcloneSyncSetExcludeBefore
    RcloneSyncSetInclude
    RcloneSyncSetExcludeAfter

    echo
    inquirer list_input_index "$(gettext "选择同步目标")" rclone_sync_target_options rclone_sync_target_options_index 20

    if [ "$rclone_sync_target_options_index" -eq 0 ] 
    then
        echo
        ExitOnText "$(gettext "输入同步的本地目录")" rclone_sync_target RcloneSyncLocalValidator "$(gettext "路径错误")"
        RemoveQuotes rclone_sync_target
    else
        rclone_sync_target="${rclone_sync_target_options[rclone_sync_target_options_index]}"
        echo
        ExitOnText "$(eval_gettext "输入同步目标 \$rclone_sync_target 的路径")" rclone_sync_target_path
        rclone_sync_target="$rclone_sync_target:$rclone_sync_target_path"
    fi

    echo
    inquirer text_input "$(gettext "输入同步参数")" rclone_sync_args "$i18n_blank"

    rclone_sync=$(
        $JQ_FILE -c -n --arg rsync "$rclone_sync_rsync" --arg source "$rclone_sync_source" --arg target "$rclone_sync_target" \
        --arg args "$rclone_sync_args" --argjson exclude_before "$(ToJsonArray rclone_sync_excludes_before)" --argjson include "$(ToJsonArray rclone_sync_includes)" --argjson exclude_after "$(ToJsonArray rclone_sync_excludes_after)" \
        '{
            rsync: $rsync | test("true"),
            source: $source,
            target: $target,
            args: $args,
            exclude_before: $exclude_before,
            include: $include,
            exclude_after: $exclude_after
        }'
    )

    jq_path='["rclone","sync"]'
    JQ add "$SERVICES_CONFIG" "[$rclone_sync]"

    Println "$(eval_gettext "\$info 同步添加成功")\n"
}

RcloneSyncSetExcludeBefore()
{
    local i18n_input_exclude
    i18n_input_exclude=$(gettext "输入排除的文件或目录")
    rclone_sync_excludes_before=()
    while true 
    do
        if [ "$rclone_sync_rsync" = true ] 
        then
            Println "$(eval_gettext "\$tip 用于参数 --exclude, 置于所有 --include 之前, 每次输入一项")"
        else
            Println "$(eval_gettext "\$tip 用于参数 --filter - , 置于所有 --filter + 之前, 每次输入一项")"
        fi
        inquirer text_input "$i18n_input_exclude" rclone_sync_exclude_before "$i18n_skip"
        RemoveQuotes rclone_sync_exclude_before
        if [ "$rclone_sync_exclude_before" == "$i18n_skip" ] 
        then
            break
        fi
        rclone_sync_excludes_before+=("$rclone_sync_exclude_before")
    done
    return 0
}

RcloneSyncSetInclude()
{
    local i18n_input_include
    i18n_input_include=$(gettext "输入包含的文件或目录")
    rclone_sync_includes=()
    while true 
    do
        if [ "$rclone_sync_rsync" = true ] 
        then
            Println "$(eval_gettext "\$tip 用于参数 --include, 每次输入一项, 如果设置将排除其他所有文件")"
        else
            Println "$(eval_gettext "\$tip 用于参数 --filter + , 每次输入一项")"
        fi
        inquirer text_input "$i18n_input_include" rclone_sync_include "$i18n_skip"
        RemoveQuotes rclone_sync_include
        if [ "$rclone_sync_include" == "$i18n_skip" ] 
        then
            break
        fi
        rclone_sync_includes+=("$rclone_sync_include")
    done
    return 0
}

RcloneSyncSetExcludeAfter()
{
    local i18n_input_exclude
    i18n_input_exclude=$(gettext "输入排除的文件或目录")
    rclone_sync_excludes_after=()
    while true 
    do
        if [ "$rclone_sync_rsync" = true ] 
        then
            Println "$(eval_gettext "\$tip 用于参数 --exclude, 置于所有 --include 之后, 每次输入一项")"
