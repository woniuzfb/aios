NginxConfigDirective()
{
    local msg_add_directive msg_select_directive msg_edit_directive msg_delete_directive msg_back_select msg_confirm_delete
    msg_add_directive=$(gettext "添加指令")
    msg_select_directive=$(gettext "选择指令")
    msg_edit_directive=$(gettext "修改指令")
    msg_delete_directive=$(gettext "删除指令")
    msg_back_select=$(gettext "返回选择")
    msg_confirm_delete=$(gettext "确认删除, 此操作不可恢复")

    case $1 in
        level_1)
            local msg_edit_sub
            msg_edit_sub=$(gettext "修改二级指令")
            while true
            do
                level_1_options=()

                for((level_1_index=0;level_1_index<level_1_count;level_1_index++));
                do
                    level_1_option="${level_1_directive_arr[level_1_index]:-''}"

                    if [ -n "${level_1_args_arr[level_1_index]}" ]
                    then
                        IFS="${delimiters[4]}" read -r -a args <<< "${level_1_args_arr[level_1_index]}"
                        for arg in "${args[@]}"
                        do
                            level_1_option="$level_1_option ${arg:-''}"
                        done
                    fi

                    level_1_option=${level_1_option//\\\\/\\}

                    if [ "$level_2_d1_count" -gt 0 ] && [ -n "${level_2_directive_arr[level_1_index]}" ]
                    then
                        level_1_option="$level_1_option {...}"
                    fi

                    level_1_options+=("$level_1_option")
                done

                level_1_options+=("$msg_add_directive" "$i18n_cancel")
                level_1_options_count=${#level_1_options[@]}

                while true
                do
                    echo
                    inquirer list_input_index "$msg_select_directive" level_1_options level_1_index

                    if [ "$level_1_index" -eq "$((level_1_options_count-1))" ]
                    then
                        Println "$i18n_canceled...\n"
                        break
                    elif [ "$level_1_index" -eq "$((level_1_options_count-2))" ]
                    then
                        NginxAddDirective level_1
                        continue 2
                    else
                        level_1_actions=("$msg_edit_sub" "$msg_edit_directive" "$msg_delete_directive" "$msg_back_select")

                        echo
                        inquirer list_input "$i18n_select_action" level_1_actions level_1_action

                        if [ "$level_1_action" == "$msg_edit_sub" ]
                        then
                            from_level_1=1
                            NginxConfigDirective level_2
                            unset from_level_1
                        elif [ "$level_1_action" == "$msg_edit_directive" ]
                        then
                            NginxInputArgs
                            jq_path='["config",0,"parsed",'"$level_1_index"',"args"]'
                            JQs replace parse_out "[$new_args]"
                            NginxBuildConf parse_out
                            local directive_name="${level_1_directive_arr[level_1_index]}"
                            Println "$(eval_gettext "\$info \$directive_name 指令修改成功")\n"
                            NginxGetConfig
                            continue 2
                        elif [ "$level_1_action" == "$msg_delete_directive" ]
                        then
                            echo
                            inquirer list_input "$msg_confirm_delete" ny_options yn_option
                            if [ "$yn_option" == "$i18n_yes" ]
                            then
                                jq_path='["config",0,"parsed"]'
                                JQs delete parse_out "$level_1_index"
                                NginxBuildConf parse_out
                                local directive_name="${level_1_directive_arr[level_1_index]}"
                                Println "$(eval_gettext "\$info 已删除指令 \$directive_name")\n"
                                NginxGetConfig
                                continue 2
                            fi
                        fi
                    fi
                done
                break
            done
        ;;
        level_2)
            local msg_back_parent msg_edit_sub
            msg_back_parent=$(gettext "返回一级指令")
            msg_edit_sub=$(gettext "修改三级指令")
            while true
            do
                level_2_options=()

                if [ "$level_2_d1_count" -gt 0 ] && [ -n "${level_2_directive_arr[level_1_index]}" ]
                then
                    level_2_directive_d1=${level_2_directive_arr[level_1_index]}
                    level_2_args_d1=${level_2_args_arr[level_1_index]}

                    IFS="${delimiters[4]}" read -r -a level_2_directive_d1_arr <<< "${level_2_directive_d1}"
                    IFS="${delimiters[4]}" read -r -a level_2_args_d1_arr <<< "${level_2_args_d1}"

                    if [ "$level_3_d1_count" -gt 0 ] && [ -n "${level_3_directive_arr[level_1_index]}" ]
                    then
                        level_3_directive_d1=${level_3_directive_arr[level_1_index]}
                        IFS="${delimiters[5]}" read -r -a level_3_directive_d1_arr <<< "${level_3_directive_d1}"
                    fi

                    for((level_2_index=0;level_2_index<${#level_2_directive_d1_arr[@]};level_2_index++));
                    do
                        level_2_option="${level_2_directive_d1_arr[level_2_index]:-''}"

                        if [ -n "${level_2_args_d1_arr[level_2_index]}" ]
                        then
                            IFS="${delimiters[5]}" read -r -a args <<< "${level_2_args_d1_arr[level_2_index]}"
                            for arg in "${args[@]}"
                            do
                                level_2_option="$level_2_option ${arg:-''}"
                            done
                        fi

                        level_2_option=${level_2_option//\\\\/\\}

                        if [ "$level_3_d1_count" -gt 0 ] && [ -n "${level_3_directive_arr[level_1_index]}" ] && [ -n "${level_3_directive_d1_arr[level_2_index]}" ]
                        then
                            level_2_option="$level_2_option {...}"
                        fi

                        level_2_options+=("$level_2_option")
                    done
                fi

                level_2_options+=("$msg_add_directive")

                if [ "${from_level_1:-0}" -eq 1 ]
                then
                    level_2_options+=("$msg_back_parent")
                else
                    level_2_options+=("$i18n_cancel")
                fi

                level_2_options_count=${#level_2_options[@]}

                while true
                do
                    echo
                    inquirer list_input_index "$msg_select_directive" level_2_options level_2_index

                    if [ "$level_2_index" -eq "$((level_2_options_count-1))" ]
                    then
                        if [ "${from_level_1:-0}" -eq 0 ]
                        then
                            Println "$i18n_canceled...\n"
                        fi
                        break
                    elif [ "$level_2_index" -eq "$((level_2_options_count-2))" ]
                    then
                        NginxAddDirective level_2
                        continue 2
                    else
                        level_2_actions=("$msg_edit_sub" "$msg_edit_directive" "$msg_delete_directive" "$msg_back_select")

                        echo
                        inquirer list_input "$i18n_select_action" level_2_actions level_2_action

                        if [ "$level_2_action" == "$msg_edit_sub" ]
                        then
                            from_level_2=1
                            NginxConfigDirective level_3
                            unset from_level_2
                        elif [ "$level_2_action" == "$msg_edit_directive" ]
                        then
                            NginxInputArgs
                            jq_path='["config",0,"parsed",'"$level_1_index"',"block",'"$level_2_index"',"args"]'
                            JQs replace parse_out "[$new_args]"
                            NginxBuildConf parse_out
                            NginxGetConfig
                            local directive_name="${level_2_directive_d1_arr[level_2_index]}"
                            Println "$(eval_gettext "\$info \$directive_name 指令修改成功")\n"
                            continue 2
                        elif [ "$level_2_action" == "$msg_delete_directive" ]
                        then
                            echo
                            inquirer list_input "$msg_confirm_delete" ny_options yn_option
                            if [ "$yn_option" == "$i18n_yes" ]
                            then
                                jq_path='["config",0,"parsed",'"$level_1_index"',"block"]'
                                JQs delete parse_out "$level_2_index"
                                NginxBuildConf parse_out
                                NginxGetConfig
                                local directive_name="${level_2_directive_d1_arr[level_2_index]}"
                                Println "$(eval_gettext "\$info 已删除指令 \$directive_name")\n"
                                continue 2
                            fi
                        fi
                    fi
                done
                break
            done
        ;;
        level_3)
            local msg_back_parent msg_edit_sub
            msg_back_parent=$(gettext "返回二级指令")
            msg_edit_sub=$(gettext "修改四级指令")
            while true
            do
                level_3_options=()

                if [ "$level_3_d1_count" -gt 0 ] && [ -n "${level_3_directive_arr[level_1_index]}" ]
                then
                    level_3_directive_d1=${level_3_directive_arr[level_1_index]}
                    level_3_args_d1=${level_3_args_arr[level_1_index]}

                    IFS="${delimiters[5]}" read -r -a level_3_directive_d1_arr <<< "${level_3_directive_d1}"
                    IFS="${delimiters[5]}" read -r -a level_3_args_d1_arr <<< "${level_3_args_d1}"

                    if [ -n "${level_3_directive_d1_arr[level_2_index]}" ]
                    then
                        level_3_directive_d2=${level_3_directive_d1_arr[level_2_index]}
                        level_3_args_d2=${level_3_args_d1_arr[level_2_index]}

                        IFS="${delimiters[6]}" read -r -a level_3_directive_d2_arr <<< "${level_3_directive_d2}"
                        IFS="${delimiters[6]}" read -r -a level_3_args_d2_arr <<< "${level_3_args_d2}"

                        if [ "$level_4_d1_count" -gt 0 ] && [ -n "${level_4_directive_arr[level_1_index]}" ]
                        then
                            level_4_directive_d1=${level_4_directive_arr[level_1_index]}
                            IFS="${delimiters[6]}" read -r -a level_4_directive_d1_arr <<< "${level_4_directive_d1}"
                            if [ -n "${level_4_directive_d1_arr[level_2_index]}" ] && [ -n "${level_4_directive_d1_arr[level_2_index]}" ]
                            then
                                level_4_directive_d2=${level_4_directive_d1_arr[level_2_index]}
                                IFS="${delimiters[7]}" read -r -a level_4_directive_d2_arr <<< "${level_4_directive_d2}"
                            fi
                        fi

                        for((level_3_index=0;level_3_index<${#level_3_directive_d2_arr[@]};level_3_index++));
                        do
                            level_3_option="${level_3_directive_d2_arr[level_3_index]:-''}"

                            if [ -n "${level_3_args_d2_arr[level_3_index]}" ]
                            then
                                IFS="${delimiters[7]}" read -r -a args <<< "${level_3_args_d2_arr[level_3_index]}"
                                for arg in "${args[@]}"
                                do
                                    level_3_option="$level_3_option ${arg:-''}"
                                done
                            fi

                            level_3_option=${level_3_option//\\\\/\\}

                            if [ "$level_4_d1_count" -gt 0 ] && [ -n "${level_4_directive_arr[level_1_index]}" ] && [ -n "${level_4_directive_d1_arr[level_2_index]}" ] && [ -n "${level_4_directive_d2_arr[level_3_index]}" ]
                            then
                                level_3_option="$level_3_option {...}"
                            fi

                            level_3_options+=("$level_3_option")
                        done
                    fi
                fi

                level_3_options+=("$msg_add_directive")

                if [ "${from_level_2:-0}" -eq 1 ]
                then
                    level_3_options+=("$msg_back_parent")
                else
                    level_3_options+=("$i18n_cancel")
                fi

                level_3_options_count=${#level_3_options[@]}

                while true
                do
                    echo
                    inquirer list_input_index "$msg_select_directive" level_3_options level_3_index

                    if [ "$level_3_index" -eq "$((level_3_options_count-1))" ]
                    then
                        if [ "${from_level_2:-0}" -eq 0 ]
                        then
                            Println "$i18n_canceled...\n"
                        fi
                        break
                    elif [ "$level_3_index" -eq "$((level_3_options_count-2))" ]
                    then
                        NginxAddDirective level_3
                        continue 2
                    else
                        level_3_actions=("$msg_edit_sub" "$msg_edit_directive" "$msg_delete_directive" "$msg_back_select")

                        echo
                        inquirer list_input "$i18n_select_action" level_3_actions level_3_action

                        if [ "$level_3_action" == "$msg_edit_sub" ]
                        then
                            from_level_3=1
                            NginxConfigDirective level_4
                            unset from_level_3
                        elif [ "$level_3_action" == "$msg_edit_directive" ]
                        then
                            NginxInputArgs
                            jq_path='["config",0,"parsed",'"$level_1_index"',"block",'"$level_2_index"',"block",'"$level_3_index"',"args"]'
                            JQs replace parse_out "[$new_args]"
                            NginxBuildConf parse_out
                            NginxGetConfig
                            local directive_name="${level_3_directive_d2_arr[level_3_index]}"
                            Println "$(eval_gettext "\$info \$directive_name 指令修改成功")\n"
                            continue 2
                        elif [ "$level_3_action" == "$msg_delete_directive" ]
                        then
                            echo
                            inquirer list_input "$msg_confirm_delete" ny_options yn_option
                            if [ "$yn_option" == "$i18n_yes" ]
                            then
                                jq_path='["config",0,"parsed",'"$level_1_index"',"block",'"$level_2_index"',"block"]'
                                JQs delete parse_out "$level_3_index"
                                NginxBuildConf parse_out
                                NginxGetConfig
                                local directive_name="${level_3_directive_d2_arr[level_3_index]}"
                                Println "$(eval_gettext "\$info 已删除指令 \$directive_name")\n"
                                continue 2
                            fi
                        fi
                    fi
                done
                break
            done
        ;;
        level_4)
            local msg_back_parent msg_edit_sub
            msg_back_parent=$(gettext "返回三级指令")
            msg_edit_sub=$(gettext "修改五级指令")
            while true
            do
                level_4_options=()

                if [ "$level_4_d1_count" -gt 0 ] && [ -n "${level_4_directive_arr[level_1_index]}" ]
                then
                    level_4_directive_d1=${level_4_directive_arr[level_1_index]}
                    level_4_args_d1=${level_4_args_arr[level_1_index]}

                    IFS="${delimiters[6]}" read -r -a level_4_directive_d1_arr <<< "${level_4_directive_d1}"
                    IFS="${delimiters[6]}" read -r -a level_4_args_d1_arr <<< "${level_4_args_d1}"

                    if [ -n "${level_4_directive_d1_arr[level_2_index]}" ]
                    then
                        level_4_directive_d2=${level_4_directive_d1_arr[level_2_index]}
                        level_4_args_d2=${level_4_args_d1_arr[level_2_index]}

                        IFS="${delimiters[7]}" read -r -a level_4_directive_d2_arr <<< "${level_4_directive_d2}"
                        IFS="${delimiters[7]}" read -r -a level_4_args_d2_arr <<< "${level_4_args_d2}"

                        if [ -n "${level_4_directive_d2_arr[level_3_index]}" ]
                        then
                            level_4_directive_d3=${level_4_directive_d2_arr[level_3_index]}
                            level_4_args_d3=${level_4_args_d2_arr[level_3_index]}

                            IFS="${delimiters[8]}" read -r -a level_4_directive_d3_arr <<< "${level_4_directive_d3}"
                            IFS="${delimiters[8]}" read -r -a level_4_args_d3_arr <<< "${level_4_args_d3}"

                            if [ "$level_5_d1_count" -gt 0 ] && [ -n "${level_5_directive_arr[level_1_index]}" ]
                            then
                                level_5_directive_d1=${level_5_directive_arr[level_1_index]}
                                IFS="${delimiters[7]}" read -r -a level_5_directive_d1_arr <<< "${level_5_directive_d1}"
                                if [ -n "${level_5_directive_d1_arr[level_2_index]}" ]
                                then
                                    level_5_directive_d2=${level_5_directive_d1_arr[level_2_index]}
                                    IFS="${delimiters[8]}" read -r -a level_5_directive_d2_arr <<< "${level_5_directive_d2}"
                                    if [ -n "${level_5_directive_d2_arr[level_3_index]}" ]
                                    then
                                        level_5_directive_d3=${level_5_directive_d2_arr[level_3_index]}
                                        IFS="${delimiters[9]}" read -r -a level_5_directive_d3_arr <<< "${level_5_directive_d3}"
                                    fi
                                fi
                            fi

                            for((level_4_index=0;level_4_index<${#level_4_directive_d3_arr[@]};level_4_index++));
                            do
                                level_4_option="${level_4_directive_d3_arr[level_4_index]:-''}"

                                if [ -n "${level_4_args_d3_arr[level_4_index]}" ]
                                then
                                    IFS="${delimiters[9]}" read -r -a args <<< "${level_4_args_d3_arr[level_4_index]}"
                                    for arg in "${args[@]}"
                                    do
                                        level_4_option="$level_4_option ${arg:-''}"
                                    done
                                fi

                                level_4_option=${level_4_option//\\\\/\\}

                                if [ "$level_5_d1_count" -gt 0 ] && [ -n "${level_5_directive_arr[level_1_index]}" ] && [ -n "${level_5_directive_d1_arr[level_2_index]}" ] && [ -n "${level_5_directive_d2_arr[level_3_index]}" ] && [ -n "${level_5_directive_d3_arr[level_4_index]}" ]
                                then
                                    level_4_option="$level_4_option {...}"
                                fi

                                level_4_options+=("$level_4_option")
                            done
                        fi
                    fi
                fi

                level_4_options+=("$msg_add_directive")

                if [ "${from_level_3:-0}" -eq 1 ]
                then
                    level_4_options+=("$msg_back_parent")
                else
                    level_4_options+=("$i18n_cancel")
                fi

                level_4_options_count=${#level_4_options[@]}

                while true
                do
                    echo
                    inquirer list_input_index "$msg_select_directive" level_4_options level_4_index

                    if [ "$level_4_index" -eq "$((level_4_options_count-1))" ]
                    then
                        if [ "${from_level_3:-0}" -eq 0 ]
                        then
                            Println "$i18n_canceled...\n"
                        fi
                        break
                    elif [ "$level_4_index" -eq "$((level_4_options_count-2))" ]
                    then
                        NginxAddDirective level_4
                        continue 2
                    else
                        level_4_actions=("$msg_edit_sub" "$msg_edit_directive" "$msg_delete_directive" "$msg_back_select")

                        echo
                        inquirer list_input "$i18n_select_action" level_4_actions level_4_action

                        if [ "$level_4_action" == "$msg_edit_sub" ]
                        then
                            from_level_4=1
                            NginxConfigDirective level_5
                            unset from_level_4
                        elif [ "$level_4_action" == "$msg_edit_directive" ]
                        then
                            NginxInputArgs
                            jq_path='["config",0,"parsed",'"$level_1_index"',"block",'"$level_2_index"',"block",'"$level_3_index"',"block",'"$level_4_index"',"args"]'
                            JQs replace parse_out "[$new_args]"
                            NginxBuildConf parse_out
                            NginxGetConfig
                            local directive_name="${level_4_directive_d3_arr[level_4_index]}"
                            Println "$(eval_gettext "\$info \$directive_name 指令修改成功")\n"
                            continue 2
                        elif [ "$level_4_action" == "$msg_delete_directive" ]
                        then
                            echo
                            inquirer list_input "$msg_confirm_delete" ny_options yn_option
                            if [ "$yn_option" == "$i18n_yes" ]
                            then
                                jq_path='["config",0,"parsed",'"$level_1_index"',"block",'"$level_2_index"',"block",'"$level_3_index"',"block"]'
                                JQs delete parse_out "$level_4_index"
                                NginxBuildConf parse_out
                                NginxGetConfig
                                local directive_name="${level_4_directive_d3_arr[level_4_index]}"
                                Println "$(eval_gettext "\$info 已删除指令 \$directive_name")\n"
                                continue 2
                            fi
                        fi
                    fi
                done
                break
            done
        ;;
        level_5)
            local msg_back_parent
            msg_back_parent=$(gettext "返回四级指令")
            while true
            do
                level_5_options=()

                if [ "$level_5_d1_count" -gt 0 ] && [ -n "${level_5_directive_arr[level_1_index]}" ]
                then
                    level_5_directive_d1=${level_5_directive_arr[level_1_index]}
                    level_5_args_d1=${level_5_args_arr[level_1_index]}

                    IFS="${delimiters[7]}" read -r -a level_5_directive_d1_arr <<< "${level_5_directive_d1}"
                    IFS="${delimiters[7]}" read -r -a level_5_args_d1_arr <<< "${level_5_args_d1}"

                    if [ -n "${level_5_directive_d1_arr[level_2_index]}" ]
                    then
                        level_5_directive_d2=${level_5_directive_d1_arr[level_2_index]}
                        level_5_args_d2=${level_5_args_d1_arr[level_2_index]}

                        IFS="${delimiters[8]}" read -r -a level_5_directive_d2_arr <<< "${level_5_directive_d2}"
                        IFS="${delimiters[8]}" read -r -a level_5_args_d2_arr <<< "${level_5_args_d2}"

                        if [ -n "${level_5_directive_d2_arr[level_3_index]}" ]
                        then
                            level_5_directive_d3=${level_5_directive_d2_arr[level_3_index]}
                            level_5_args_d3=${level_5_args_d2_arr[level_3_index]}

                            IFS="${delimiters[9]}" read -r -a level_5_directive_d3_arr <<< "${level_5_directive_d3}"
                            IFS="${delimiters[9]}" read -r -a level_5_args_d3_arr <<< "${level_5_args_d3}"

                            if [ -n "${level_5_directive_d3_arr[level_4_index]}" ]
                            then
                                level_5_directive_d4=${level_5_directive_d3_arr[level_4_index]}
                                level_5_args_d4=${level_5_args_d3_arr[level_4_index]}

                                IFS="${delimiters[10]}" read -r -a level_5_directive_d4_arr <<< "${level_5_directive_d4}"
                                IFS="${delimiters[10]}" read -r -a level_5_args_d4_arr <<< "${level_5_args_d4}"

                                for((level_5_index=0;level_5_index<${#level_5_directive_d4_arr[@]};level_5_index++));
                                do
                                    level_5_option="${level_5_directive_d4_arr[level_5_index]:-''}"

                                    if [ -n "${level_5_args_d4_arr[level_5_index]}" ]
                                    then
                                        IFS="${delimiters[11]}" read -r -a args <<< "${level_5_args_d4_arr[level_5_index]}"
                                        for arg in "${args[@]}"
                                        do
                                            level_5_option="$level_5_option ${arg:-''}"
                                        done
                                    fi

                                    level_5_options+=("${level_5_option//\\\\/\\}")
                                done
                            fi
                        fi
                    fi
                fi

                level_5_options+=("$msg_add_directive")

                if [ "${from_level_4:-0}" -eq 1 ]
                then
                    level_5_options+=("$msg_back_parent")
                else
                    level_5_options+=("$i18n_cancel")
                fi

                level_5_options_count=${#level_5_options[@]}

                while true
                do
                    echo
                    inquirer list_input_index "$msg_select_directive" level_5_options level_5_index

                    if [ "$level_5_index" -eq "$((level_5_options_count-1))" ]
                    then
                        if [ "${from_level_4:-0}" -eq 0 ]
                        then
                            Println "$i18n_canceled...\n"
                        fi
                        break
                    elif [ "$level_5_index" -eq "$((level_5_options_count-2))" ]
                    then
                        NginxAddDirective level_5
                        continue 2
                    else
                        level_5_actions=("$msg_edit_directive" "$msg_delete_directive" "$msg_back_select")

                        echo
                        inquirer list_input "$i18n_select_action" level_5_actions level_5_action

                        if [ "$level_5_action" == "$msg_edit_directive" ]
                        then
                            NginxInputArgs
                            jq_path='["config",0,"parsed",'"$level_1_index"',"block",'"$level_2_index"',"block",'"$level_3_index"',"block",'"$level_4_index"',"block",'"$level_5_index"',"args"]'
                            JQs replace parse_out "[$new_args]"
                            NginxBuildConf parse_out
                            NginxGetConfig
                            local directive_name="${level_5_directive_d4_arr[level_5_index]}"
                            Println "$(eval_gettext "\$info \$directive_name 指令修改成功")\n"
                            continue 2
                        elif [ "$level_5_action" == "$msg_delete_directive" ]
                        then
                            echo
                            inquirer list_input "$msg_confirm_delete" ny_options yn_option
                            if [ "$yn_option" == "$i18n_yes" ]
                            then
                                jq_path='["config",0,"parsed",'"$level_1_index"',"block",'"$level_2_index"',"block",'"$level_3_index"',"block",'"$level_4_index"',"block"]'
                                JQs delete parse_out "$level_5_index"
                                NginxBuildConf parse_out
                                NginxGetConfig
                                local directive_name="${level_5_directive_d4_arr[level_5_index]}"
                                Println "$(eval_gettext "\$info 已删除指令 \$directive_name")\n"
                                continue 2
                            fi
                        fi
                    fi
                done
                break
            done
        ;;
    esac
}
