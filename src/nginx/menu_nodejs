NodejsMenu()
{
    [ ! -d "$IPTV_ROOT" ] && Println "$(eval_gettext "\$error 请先输入 tv 安装 !")\n" && exit 1

    echo
    nodejs_options=( "$i18n_install" "$(gettext "升级")" "$(gettext "运行 iptv node")" )
    inquirer list_input_index "$i18n_select_action" nodejs_options nodejs_options_index

    if [ "$nodejs_options_index" -eq 0 ] 
    then
        if [[ -x $(command -v node) ]] && [[ -x $(command -v npm) ]] 
        then
            Println "$(eval_gettext "\$error nodejs 已存在")\n"
            exit 1
        fi

        NodejsInstall
    elif [ "$nodejs_options_index" -eq 1 ] 
    then
        if [[ ! -x $(command -v node) ]] || [[ ! -x $(command -v npm) ]] 
        then
            Println "$(eval_gettext "\$error 请先安装 nodejs")\n"
            exit 1
        fi

        NodejsInstall
    else
        if [ -f "$NODE_ROOT/index.js" ] 
        then
            Println "$(eval_gettext "\$error iptv node 已存在")\n"
            exit 1
        fi

        if [[ ! -x $(command -v node) ]] || [[ ! -x $(command -v npm) ]] 
        then
            Println "$(eval_gettext "\$error 请先安装 nodejs")\n"
            exit 1
        fi

        if [[ ! -x $(command -v mongod) ]] 
        then
            Println "$(eval_gettext "\$error 请先安装 mongodb")\n"
            exit 1
        fi

        NodejsConfig
    fi
}
