    local rc=0

    jq_path='["'"$bound_type"'"]'
    JQ add "$config_file" "[$bound_json]" || rc=$?
    jq_path=""
    return "$rc"
}

ProxyDeleteBound()
{
    local config_file="$1"
    local bound_type="$2"
    local bound_index="$3"
    local rc=0

    jq_path='["'"$bound_type"'",'"$bound_index"']'
