ProxyFormatStatsJson()
{
    local raw_stats="$1"

    $JQ_FILE -r --arg g "$green" --arg n "$normal" '
        def fmt_bytes($b):
            ($b | tonumber? // 0) as $v
            | if $v >= 1099511627776 then "\(($v / 1099511627776 * 100 | floor) / 100) TB"
              elif $v >= 1073741824 then "\(($v / 1073741824 * 100 | floor) / 100) GB"
              elif $v >= 1048576 then "\(($v / 1048576 * 100 | floor) / 100) MB"
              elif $v >= 1024 then "\(($v / 1024 * 100 | floor) / 100) KB"
              else "\($v) B" end;
        (if (type == "object") and (.stat | type) == "array" then (.stat | map(select(type == "object" and (.name | type) == "string"))) else [] end)
        | if length == 0 then
            ""
          else
            group_by(.name | split(">>>")[0])
            | map(
                (.[0].name | split(">>>")[0]) as $grp
                | "[\($grp)]\n" + (
                    map(
                        (.name | split(">>>")) as $parts
                        | if ($parts[2] // "") == "traffic" then
                            "  \($parts[1] // .name) (\($parts[3] // "")): \($g)\(fmt_bytes(.value // 0))\($n) (\(.value // 0) B)"
                          else
                            "  \(.name): \($g)\(.value // 0)\($n)"
                          end
                    ) | join("\n")
                )
            )
            | join("\n")
          end
    ' <<< "$raw_stats"
}

ProxyRenderDns()
{
