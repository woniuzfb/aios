                "查询策略: \(cv($d.queryStrategy // "UseIP"))"
                + (if ($d.tag // "" | tostring) != "" then " 标识: \(cv($d.tag))" else "" end)
                + (if ($d.clientIp // $d.clientIP // "") != "" then " clientIp: \(cv($d.clientIp // $d.clientIP))" else "" end),
                "禁用缓存: \(yv($d.disableCache // false)) 禁用回退: \(yv($d.disableFallback // false)) 匹配不回退: \(yv($d.disableFallbackIfMatch // false))"
            ]
            + (if $core == "xray" then
                [
                    "过期缓存: \(yv($d.serveStale // false))"
                    + (if ($d.serveExpiredTTL // 0) != 0 then " TTL: \(cv($d.serveExpiredTTL))" else "" end)
                    + " 并行查询: \(yv($d.enableParallelQuery // false)) 系统Hosts: \(yv($d.useSystemHosts // false))"
                ]
              else [] end)
            + (if ($d.hosts | type) == "object" and ($d.hosts | length) > 0 then
                ["Hosts:"] + ($d.hosts | to_entries | map("  \(.key) => \(cv(arr(.value)))"))
              else [] end)
            + (if ($d.servers | type) == "array" and ($d.servers | length) > 0 then
                ["DNS 服务器 (\($d.servers | length)):"]
                + ($d.servers | to_entries | map(
                    (.key + 1) as $i
                    | .value as $s
                    | if ($s | type) == "string" then
                        "  \($i). \(cv($s))"
                      elif ($s | type) == "object" then
                        "  \($i). \(cv($s.address // ""))"
                        + (if $s.port != null then ":\(cv($s.port))" else "" end)
                        + (if ($s.tag // "" | tostring) != "" then " tag: \(cv($s.tag))" else "" end)
                        + (if ($s.queryStrategy // "" | tostring) != "" then " queryStrategy: \(cv($s.queryStrategy))" else "" end)
                        + (if ($s.clientIP // $s.clientIp // "" | tostring) != "" then " clientIP: \(cv($s.clientIP // $s.clientIp))" else "" end)
                        + (if $s.timeoutMs != null then " timeoutMs: \(cv($s.timeoutMs))" else "" end)
                        + (if $s.disableCache != null then " disableCache: \(yv($s.disableCache))" else "" end)
                        + (if (arr($s.domains) | length) > 0 then " 域名: \(cv(arr($s.domains)))" else "" end)
                        + (if $core == "xray" and (arr($s.expectedIPs) | length) > 0 then " expectedIPs: \(cv(arr($s.expectedIPs)))" else "" end)
                        + (if $core == "xray" and (arr($s.unexpectedIPs) | length) > 0 then " unexpectedIPs: \(cv(arr($s.unexpectedIPs)))" else "" end)
                        + (if $core == "v2ray" and (arr($s.expectIPs) | length) > 0 then " expectIPs: \(cv(arr($s.expectIPs)))" else "" end)
                        + (if $s.skipFallback == true then " skipFallback: \(yv(true))" else "" end)
                        + (if $core == "xray" and $s.finalQuery == true then " finalQuery: \(yv(true))" else "" end)
                      else empty end
                  ))
              else [] end)
        )
        | join("\n")
      end
    ' "$config_file"
}

ProxyRenderRouting()
{
    local config_file="$1"
    local core_type="${2:-xray}"

    if [ ! -s "$config_file" ]
    then
        return 1
    fi

    $JQ_FILE -r \
        --arg core "$core_type" \
        --arg g "$green" \
        --arg r "$red" \
        --arg n "$normal" \
        --arg ind "$indent_6" \
    '
    def cv($v): "\($g)\($v)\($n)";
    def arr($a): if ($a | type) == "array" then ($a | map(select(. != null) | tostring) | join(", ")) else ($a // "" | tostring) end;
    def kv($obj): if ($obj | type) == "object" then ($obj | to_entries | map("\(.key)=\(.value | tostring)") | join(", ")) else ($obj // "" | tostring) end;
    def fld($k; $v): if ($v // "" | tostring) != "" then "\($k): \(cv($v))" else empty end;

    (if (.routing | type) == "object" then .routing else {} end) as $rt
    | if ($rt | length) == 0 then
        ""
      else
        (
            [
                "域名解析策略: \(cv($rt.domainStrategy // "AsIs"))"
                + (if $core == "v2ray" and ($rt.domainMatcher // "") != "" then " domainMatcher: \(cv($rt.domainMatcher))" else "" end)
            ]
            + (if ($rt.rules | type) == "array" and ($rt.rules | length) > 0 then
                ["路由规则 (\($rt.rules | length)):"]
                + ($rt.rules | to_entries | map(
                    select(.value | type == "object")
                    | (.key + 1) as $i
                    | .value as $ru
                    | "  \($i). " + ([
                        (if $core == "xray" then fld("ruleTag"; $ru.ruleTag) else fld("type"; $ru.type) end),
                        fld("outboundTag"; $ru.outboundTag),
                        fld("balancerTag"; $ru.balancerTag),
                        fld("network"; arr($ru.network)),
                        fld("port"; $ru.port),
                        fld("sourcePort"; $ru.sourcePort),
                        (if $core == "xray" then fld("localPort"; $ru.localPort) else empty end),
                        (if $core == "xray" then fld("domain"; arr($ru.domain // [])) else fld("domains"; arr($ru.domains // $ru.domain // [])) end),
                        fld("ip"; arr($ru.ip // [])),
                        (if $core == "xray" then fld("sourceIP"; arr($ru.sourceIP // $ru.source // [])) else fld("source"; arr($ru.source // [])) end),
                        (if $core == "xray" then fld("localIP"; arr($ru.localIP // [])) else empty end),
                        fld("inboundTag"; arr($ru.inboundTag // [])),
                        fld("protocol"; arr($ru.protocol // [])),
                        fld("user"; arr($ru.user // [])),
                        (if $core == "xray" then fld("process"; arr($ru.process // [])) else empty end),
                        (if $core == "xray" then fld("vlessRoute"; $ru.vlessRoute) else empty end),
                        (if $ru.attrs != null then fld("attrs"; kv($ru.attrs)) else empty end),
                        (if $core == "xray" and ($ru.webhook | type) == "object" then fld("webhook"; $ru.webhook.url) else empty end)
                    ] | join(" "))
                  ))
              else [] end)
            + (if ($rt.balancers | type) == "array" and ($rt.balancers | length) > 0 then
                ["负载均衡 (\($rt.balancers | length)):"]
                + ($rt.balancers | to_entries | map(
                    select(.value | type == "object")
                    | (.key + 1) as $i
                    | .value as $b
                    | "  \($i). tag: \(cv($b.tag // "")) selector: \(cv(arr($b.selector // [])))"
                    + (if ($b.strategy | type) == "object" and ($b.strategy.type // "") != "" then " strategy: \(cv($b.strategy.type))" else "" end)
                    + (if $core == "xray" and ($b.fallbackTag // "") != "" then " fallbackTag: \(cv($b.fallbackTag))" else "" end)
                  ))
              else [] end)
        )
        | join("\n")
      end
    ' "$config_file"
}

