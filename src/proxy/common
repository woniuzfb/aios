ProxyRenderShareLinks()
{
    local config_file="$1"
    local host="${2:-}"
    local only_idx="${3:-}"
    local core_type="${4:-xray}"

    if [ ! -s "$config_file" ]
    then
        return 0
    fi

    if [ -z "$host" ]
    then
        if ! host=$(GetServerIp) || [ -z "$host" ]
        then
            host="$PROXY_DEFAULT_HOST"
        fi
    fi

    SetDelimiters

    local xray_bin=""
    if [ -n "${XRAY_FILE:-}" ] && [ -x "$XRAY_FILE" ]
    then
        xray_bin="$XRAY_FILE"
    elif command -v xray > /dev/null 2>&1
    then
        xray_bin="xray"
    fi

    local pbk_map="{}"
    if [ -n "$xray_bin" ]
    then
        local priv_keys
        priv_keys=$($JQ_FILE -r '
            (if (.inbounds | type) == "array" then .inbounds else [] end)
            | map(
                select(type == "object")
                | select((.streamSettings | type) == "object" and (.streamSettings.realitySettings | type) == "object")
                | .streamSettings.realitySettings.privateKey
                | select(type == "string" and length > 0)
              )
            | unique[]
        ' "$config_file" 2> /dev/null)

        if [ -n "$priv_keys" ]
        then
            local priv_key pub_out pub_val pbk_pairs=""
            while IFS= read -r priv_key
            do
                [ -z "$priv_key" ] && continue
                pub_out=$("$xray_bin" x25519 -i "$priv_key" 2> /dev/null) || continue
                pub_val=$(printf '%s\n' "$pub_out" | awk '/^(Password|Public key):/{sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit}')
                if [ -n "$pub_val" ]
                then
                    pbk_pairs="${pbk_pairs}${priv_key}${field_sep}${pub_val}"$'\n'
                fi
            done <<< "$priv_keys"

            if [ -n "$pbk_pairs" ]
            then
                pbk_map=$($JQ_FILE -Rn --arg sep "$field_sep" '
                    [inputs | select(length > 0) | split($sep) | select(length >= 2) | {key: .[0], value: .[1]}]
                    | from_entries
                ' <<< "$pbk_pairs")
                [ -z "$pbk_map" ] && pbk_map="{}"
            fi
        fi
    fi

    local raw_lines
    raw_lines=$($JQ_FILE -r --arg sep "$field_sep" --arg host "$host" --arg only "$only_idx" --arg core "$core_type" --argjson pbk_map "$pbk_map" '
        def q($k; $v): if (($v | type) == "string" or ($v | type) == "number" or ($v | type) == "boolean") and ($v | tostring) != "" then "\($k)=\($v | tostring | @uri)" else empty end;
        def obj($x): if ($x | type) == "object" then $x else {} end;
        def arr_objs($x): if ($x | type) == "array" then ($x | map(select(type == "object"))) else [] end;
        def first_str($x): if ($x | type) == "array" then ($x[0] // "" | tostring) elif ($x | type) == "string" then $x else "" end;
        def fmt_host($h): if ($h | contains(":")) and (($h | startswith("[")) | not) then "[\($h)]" else $h end;
        (if (.inbounds | type) == "array" then .inbounds else [] end)
        | to_entries[]
        | select(.value | type == "object")
        | select($only == "" or (.key | tostring) == $only)
        | .value as $inb
        | ($inb.protocol // "" | tostring) as $p
        | ($inb.port // "" | tostring) as $port
        | ($inb.tag // $p | tostring) as $tag
        | obj($inb.settings) as $set
        | obj($inb.streamSettings) as $st
        | ($st.method // $st.network // (if $core == "xray" then "raw" else "tcp" end) | tostring) as $net
        | ($st.security // "none" | tostring) as $sec
        | obj($st.realitySettings) as $rl
        | obj($st.tlsSettings) as $tls
        | (if (arr_objs($set.users) | length) > 0 then arr_objs($set.users)
           elif (arr_objs($set.clients) | length) > 0 then arr_objs($set.clients)
           else [] end) as $users
        | (
            (if $net == "websocket" then "ws"
             elif $net == "mkcp" then "kcp"
             elif $net == "splithttp" then "xhttp"
             else $net end) as $uri_net
            | [
                q("type"; $uri_net),
                q("security"; $sec),
                (if $sec == "reality" then
                    ($rl.privateKey // "" | tostring) as $priv
                    | (if $priv != "" and ($pbk_map[$priv] // "") != "" then $pbk_map[$priv]
                       else ($rl.publicKey // $rl.password // "") end) as $pbk
                    | q("pbk"; $pbk),
                      q("sni"; first_str($rl.serverNames)),
                      q("sid"; first_str($rl.shortIds)),
                      q("fp"; ($rl.fingerprint // "chrome")),
                      q("spx"; ($rl.spiderX // "")),
                      q("pqv"; ($rl.mldsa65Verify // ""))
                elif $sec == "tls" then
                    q("sni"; ($tls.serverName // "")),
                    q("alpn"; (if ($tls.alpn | type) == "array" and ($tls.alpn | length) > 0 then ($tls.alpn | map(tostring) | join(",")) else "" end))
                else empty end),
                (if $net == "xhttp" or $net == "splithttp" then
                    obj($st.xhttpSettings // $st.splithttpSettings) as $xh
                    | q("path"; ($xh.path // "/")),
                      q("host"; ($xh.host // "")),
                      q("mode"; ($xh.mode // "auto")),
                      (if ($xh.extra | type) == "object" and ($xh.extra | length) > 0 then q("extra"; ($xh.extra | tojson)) else empty end)
                elif $net == "ws" or $net == "websocket" then
                    obj($st.wsSettings) as $ws
                    | obj($ws.headers) as $wsh
                    | q("path"; ($ws.path // "/")),
                      q("host"; ($ws.host // $wsh.Host // $wsh.host // ""))
                elif $net == "grpc" then
                    obj($st.grpcSettings) as $gr
                    | q("serviceName"; ($gr.serviceName // "")),
                      q("authority"; ($gr.authority // "")),
                      (if $gr.multiMode == true then q("mode"; "multi") else empty end)
                elif $net == "httpupgrade" then
                    obj($st.httpupgradeSettings) as $hu
                    | q("path"; ($hu.path // "/")),
                      q("host"; ($hu.host // ""))
                elif $net == "kcp" or $net == "mkcp" then
                    obj($st.kcpSettings) as $ks
                    | obj($ks.header) as $kh
                    | q("headerType"; ($kh.type // "")),
                      q("seed"; ($ks.seed // ""))
                elif $net == "h2" or $net == "http" then
                    obj($st.httpSettings) as $hs
                    | q("path"; ($hs.path // "/")),
                      q("host"; first_str($hs.host))
                else empty end)
            ] | join("&")
          ) as $qs
        | if $p == "vless" then
            $users[]
            | ((.flow // $set.flow // "") | tostring) as $flow
            | (($set.decryption // "") | tostring) as $dec
            | "PLAIN\($sep)vless://\(.id // "")@\(fmt_host($host)):\($port)?\($qs)"
              + (if $flow != "" then "&flow=\($flow | @uri)" else "" end)
              + (if $dec == "" or $dec == "none" then "&encryption=none" else "&encryption=VLESS_CLIENT_ENCRYPTION_REQUIRED" end)
              + "#\((.email // $tag | tostring) | @uri)"
          elif $p == "vmess" then
            obj($st.rawSettings) as $rs
            | obj($st.tcpSettings) as $ts
            | obj($st.wsSettings) as $ws
            | obj($ws.headers) as $wsh
            | obj($st.xhttpSettings // $st.splithttpSettings) as $xh
            | obj($st.httpupgradeSettings) as $hu
            | obj($st.httpSettings) as $hs
            | obj($st.grpcSettings) as $gr
            | obj($st.kcpSettings) as $ks
            | (if $net == "raw" then "tcp"
               elif $net == "websocket" then "ws"
               elif $net == "mkcp" then "kcp"
               elif $net == "http" then "h2"
               else $net end) as $vnet
            | $users[]
            | "VMESS\($sep)" + ({
                "v": "2",
                "ps": (.email // $tag | tostring),
                "add": $host,
                "port": $port,
                "id": (.id // "" | tostring),
                "aid": ((.alterId // 0) | tostring),
                "net": $vnet,
                "type": (obj($rs.header).type // obj($ts.header).type // obj($ks.header).type // "none"),
                "host": ($ws.host // $wsh.Host // $xh.host // $hu.host // first_str($hs.host)),
                "path": ($ws.path // $xh.path // $hu.path // $hs.path // $gr.serviceName // $ks.seed // ""),
                "tls": (if $sec == "tls" then "tls" else "" end),
                "sni": ($tls.serverName // "")
              } | tojson)
          elif $p == "trojan" then
            $users[]
            | "PLAIN\($sep)trojan://\(.password // "" | tostring | @uri)@\(fmt_host($host)):\($port)?\($qs)#\((.email // $tag | tostring) | @uri)"
          elif $p == "shadowsocks" then
            ($set.method // "" | tostring) as $smethod
            | if ($users | length) > 0 then
                $users[]
                | if ($smethod | startswith("2022-")) then
                    "SS\($sep)\($smethod):\($set.password // ""):\(.password // "")\($sep)\(fmt_host($host)):\($port)\($sep)\((.email // $tag | tostring) | @uri)"
                  else
                    "SS\($sep)\(.method // $smethod):\(.password // "")\($sep)\(fmt_host($host)):\($port)\($sep)\((.email // $tag | tostring) | @uri)"
                  end
              elif ($set.password // "") != "" then
                "SS\($sep)\($smethod):\($set.password // "")\($sep)\(fmt_host($host)):\($port)\($sep)\((($set.email // $tag | tostring) | @uri))"
              else empty end
          elif $p == "hysteria" or $p == "hy2" or $p == "hysteria2" then
            ([q("sni"; ($tls.serverName // ""))] | join("&")) as $hy_qs
            | (if $hy_qs != "" then "?\($hy_qs)" else "" end) as $hy_qpart
            | if ($users | length) > 0 then
                $users[]
                | "PLAIN\($sep)hysteria2://\(.auth // .password // "" | tostring | @uri)@\(fmt_host($host)):\($port)\($hy_qpart)#\((.email // $tag | tostring) | @uri)"
              else
                (obj($st.hysteriaSettings).auth // obj($st.hysteria2Settings // $st.hy2steriaSettings).password // $set.auth // $set.password // "" | tostring) as $hy_auth
                | if $hy_auth != "" then
                    "PLAIN\($sep)hysteria2://\($hy_auth | @uri)@\(fmt_host($host)):\($port)\($hy_qpart)#\($tag | @uri)"
                  else empty end
              end
          else empty end
    ' "$config_file")

    local kind p1 p2 p3 b64
    while IFS="$field_sep" read -r kind p1 p2 p3
    do
        [ -z "$kind" ] && continue
        case "$kind" in
            PLAIN)
                printf '%s\n' "$p1"
            ;;
            VMESS)
                b64=$(printf '%s' "$p1" | base64 | tr -d '\n')
                printf 'vmess://%s\n' "$b64"
            ;;
            SS)
                b64=$(printf '%s' "$p1" | base64 | tr -d '\n')
                printf 'ss://%s@%s#%s\n' "$b64" "$p2" "$p3"
            ;;
        esac
    done <<< "$raw_lines"
}

ProxyPrintQrCode()
{
