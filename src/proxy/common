ProxyDetectNginx()
{
    if { [ -d "$OPENRESTY_PREFIX_DEFAULT" ] && [ ! -d "$NGINX_PREFIX_DEFAULT" ]; } || { [ -s "$OPENRESTY_PREFIX_DEFAULT/nginx/logs/nginx.pid" ] && kill -0 "$(< "$OPENRESTY_PREFIX_DEFAULT/nginx/logs/nginx.pid")" 2> /dev/null; }
    then
        nginx_prefix="$OPENRESTY_PREFIX_DEFAULT/nginx"
        nginx_name="openresty"
        nginx_ctl="or"
    else
        nginx_prefix="$NGINX_PREFIX_DEFAULT"
        nginx_name="nginx"
        nginx_ctl="nx"
    fi

    NGINX_FILE="$nginx_prefix/sbin/nginx"
}

ProxyGetFreeTag()
{
    local config_file="$1"
    local prefix="${2:-}"
    local candidate

    while true
    do
        candidate="${prefix}$(RandStr)"
        if [ ! -e "$config_file" ] || ! grep -q '"tag"[[:space:]]*:[[:space:]]*"'"$candidate"'"' < "$config_file"
        then
            echo "$candidate"
            return 0
        fi
    done
}

ProxyLoadInboundsIndex()
{
    local config_file="$1"

    inbounds_count=0
    inbounds_nginx_count=0
    inbounds_other_count=0
    inbounds_json_index=()
    inbounds_listen=()
    inbounds_port=()
    inbounds_protocol=()
    inbounds_tag=()
    inbounds_nginx_index=()
    inbounds_other_index=()

    if [ ! -s "$config_file" ]
    then
        return 0
    fi

    SetDelimiters
    local real_idx listen port protocol tag
    while IFS="$field_sep" read -r real_idx listen port protocol tag
    do
        inbounds_json_index+=("$real_idx")
        inbounds_listen[real_idx]="$listen"
        inbounds_port[real_idx]="$port"
        inbounds_protocol[real_idx]="$protocol"
        inbounds_tag[real_idx]="$tag"

        if [[ "$tag" == "${PROXY_NGINX_PREFIX}"* ]]
        then
            inbounds_nginx_count=$((inbounds_nginx_count + 1))
            inbounds_nginx_index+=("$real_idx")
        else
            inbounds_other_count=$((inbounds_other_count + 1))
            inbounds_other_index+=("$real_idx")
        fi
    done < <($JQ_FILE -r --arg sep "$field_sep" '
        (if (.inbounds | type) == "array" then .inbounds else [] end)
        | to_entries[]
        | select(.value | type == "object")
        | [
            (.key | tostring),
            (.value.listen // "0.0.0.0" | tostring),
            (.value.port // "" | tostring),
            (.value.protocol // "" | tostring),
            (.value.tag // "" | tostring)
          ]
        | join($sep)
    ' "$config_file")

    inbounds_count=${#inbounds_json_index[@]}
}

ProxyLoadOutboundsIndex()
{
    local config_file="$1"

    outbounds_count=0
    outbounds_json_index=()
    outbounds_sendThrough=()
    outbounds_protocol=()
    outbounds_tag=()

    if [ ! -s "$config_file" ]
    then
        return 0
    fi

    SetDelimiters
    local real_idx send_through protocol tag
    while IFS="$field_sep" read -r real_idx send_through protocol tag
    do
        outbounds_json_index+=("$real_idx")
        outbounds_sendThrough[real_idx]="$send_through"
        outbounds_protocol[real_idx]="$protocol"
        outbounds_tag[real_idx]="$tag"
    done < <($JQ_FILE -r --arg sep "$field_sep" '
        (if (.outbounds | type) == "array" then .outbounds else [] end)
        | to_entries[]
        | select(.value | type == "object")
        | [
            (.key | tostring),
            (.value.sendThrough // "0.0.0.0" | tostring),
            (.value.protocol // "" | tostring),
            (.value.tag // "" | tostring)
          ]
        | join($sep)
    ' "$config_file")

    outbounds_count=${#outbounds_json_index[@]}
}

ProxyRenderInbounds()
{
    local config_file="$1"
    local core_type="${2:-xray}"
    local filter_mode="${3:-all}"

    if [ ! -s "$config_file" ]
    then
        return 1
    fi

    $JQ_FILE -r \
        --arg core "$core_type" \
        --arg filter "$filter_mode" \
        --arg nginx_prefix "${PROXY_NGINX_PREFIX:-nginx-}" \
        --arg g "$green" \
        --arg r "$red" \
        --arg n "$normal" \
        --arg ind "$indent_6" \
    '
    def cv($v): "\($g)\($v)\($n)";
    def bv($v): if $v == true then "\($g)开启\($n)" else "\($r)关闭\($n)" end;
    def yv($v): if $v == true then "\($g)是\($n)" else "\($r)否\($n)" end;
    def arr($a): if ($a | type) == "array" then ($a | map(tostring) | join(", ")) else ($a // "" | tostring) end;
    def kv($obj): if ($obj | type) == "object" then ($obj | to_entries | map("\(.key) => \(.value | tostring)") | join(", ")) else "" end;
    def line($label; $val): if ($val // "" | tostring) != "" then "\($label): \(cv($val))" else empty end;
    def bline($label; $val): if $val != null then "\($label): \(yv($val))" else empty end;

    def render_sniffing($s):
        if ($s | type) != "object" then []
        else [
            "流量探测: \(bv($s.enabled // false)) 仅元数据: \(yv($s.metadataOnly // false))"
            + (if ($s.destOverride | type) == "array" and ($s.destOverride | length) > 0 then " 目标重置: \(cv(arr($s.destOverride)))" else "" end)
            + (if $core == "xray" and ($s.routeOnly // false) == true then " 仅路由: \(yv(true))" else "" end),
            (if $core == "xray" and ($s.domainsExcluded | type) == "array" and ($s.domainsExcluded | length) > 0 then "排除域名: \(cv(arr($s.domainsExcluded)))" else empty end),
            (if $core == "xray" and ($s.ipsExcluded | type) == "array" and ($s.ipsExcluded | length) > 0 then "排除IP: \(cv(arr($s.ipsExcluded)))" else empty end)
        ] end;

    def render_stream($st):
        if ($st | type) != "object" then []
        else [
            "传输方式: \(cv($st.method // $st.network // (if $core == "xray" then "raw" else "tcp" end))) 传输安全: \(cv($st.security // "none"))",
            (if ($st.tlsSettings | type) == "object" then
                ($st.tlsSettings) as $t
                | "TLS: " + ([
                    line("SNI"; $t.serverName),
                    line("ALPN"; arr($t.alpn // [])),
                    line("minVersion"; $t.minVersion),
                    line("maxVersion"; $t.maxVersion),
                    line("cipherSuites"; $t.cipherSuites),
                    line("fingerprint"; $t.fingerprint),
                    bline("rejectUnknownSni"; $t.rejectUnknownSni),
                    bline("disableSystemRoot"; $t.disableSystemRoot),
                    bline("enableSessionResumption"; $t.enableSessionResumption),
                    bline("verifyClientCertificate"; $t.verifyClientCertificate),
                    bline("allowInsecure"; $t.allowInsecure),
                    line("verifyPeerCertByName"; arr($t.verifyPeerCertByName)),
                    bline("useSystemCA"; $t.useSystemCA),
                    line("pinnedPeerCertSha256"; $t.pinnedPeerCertSha256),
                    line("pinnedPeerCertificateChainSha256"; arr($t.pinnedPeerCertificateChainSha256 // [])),
                    line("curvePreferences"; arr($t.curvePreferences // [])),
                    (if ($t.echServerKeys // "") != "" then "echServerKeys: \(cv("已配置"))" else empty end),
                    (if ($t.echConfigList // "") != "" then "echConfigList: \(cv("已配置"))" else empty end)
                ] | join(" ")),
                ((if ($t.certificates | type) == "array" then $t.certificates else [] end) | to_entries[]
                    | select(.value | type == "object")
                    | "  证书\(.key + 1): " + ([
                        line("usage"; .value.usage),
                        line("cert"; (.value.certificateFile // (if (.value.certificate | type) == "array" and (.value.certificate | length) > 0 then "<inline>" else null end))),
                        line("key"; (.value.keyFile // (if (.value.key | type) == "array" and (.value.key | length) > 0 then "<inline>" else null end))),
                        line("ocspStapling"; .value.ocspStapling),
                        bline("oneTimeLoading"; .value.oneTimeLoading),
                        bline("buildChain"; .value.buildChain)
                    ] | join(" "))
                )
            else empty end),
            (if ($st.realitySettings | type) == "object" then
                ($st.realitySettings) as $rl
                | "REALITY: " + ([
                    bline("show"; $rl.show),
                    line("target"; ($rl.target // $rl.dest)),
                    line("serverNames"; arr($rl.serverNames // [])),
                    line("shortIds"; arr($rl.shortIds // [])),
                    line("xver"; $rl.xver),
                    line("minClientVer"; $rl.minClientVer),
                    line("maxClientVer"; $rl.maxClientVer),
                    line("maxTimeDiff"; $rl.maxTimeDiff),
                    (if ($rl.mldsa65Seed // "") != "" then "mldsa65Seed: \(cv("已配置"))" else empty end),
                    (if ($rl.limitFallbackUpload | type) == "object" then "limitUpload: \(cv("\($rl.limitFallbackUpload.afterBytes // 0)/\($rl.limitFallbackUpload.bytesPerSec // 0)/\($rl.limitFallbackUpload.burstBytesPerSec // 0)"))" else empty end),
                    (if ($rl.limitFallbackDownload | type) == "object" then "limitDownload: \(cv("\($rl.limitFallbackDownload.afterBytes // 0)/\($rl.limitFallbackDownload.bytesPerSec // 0)/\($rl.limitFallbackDownload.burstBytesPerSec // 0)"))" else empty end)
                ] | join(" "))
            else empty end),
            (if (($st.rawSettings // $st.tcpSettings) | type) == "object" then
                ($st.rawSettings // $st.tcpSettings) as $raw
                | (if ($raw.header | type) == "object" then $raw.header else {} end) as $hdr
                | "RAW/TCP: " + ([
                    bline("acceptProxyProtocol"; $raw.acceptProxyProtocol),
                    line("header"; $hdr.type),
                    line("reqPath"; (if ($hdr.request | type) == "object" then arr($hdr.request.path // []) else "" end))
                ] | join(" "))
            else empty end),
            (if ($st.wsSettings | type) == "object" then
                "WebSocket: " + ([
                    bline("acceptProxyProtocol"; $st.wsSettings.acceptProxyProtocol),
                    line("path"; $st.wsSettings.path),
                    line("host"; $st.wsSettings.host),
                    line("headers"; kv($st.wsSettings.headers)),
                    line("maxEarlyData"; $st.wsSettings.maxEarlyData),
                    line("earlyDataHeaderName"; $st.wsSettings.earlyDataHeaderName),
                    bline("useBrowserForwarding"; $st.wsSettings.useBrowserForwarding),
                    line("heartbeatPeriod"; $st.wsSettings.heartbeatPeriod)
                ] | join(" "))
            else empty end),
            (if (($st.xhttpSettings // $st.splithttpSettings) | type) == "object" then
                ($st.xhttpSettings // $st.splithttpSettings) as $xh
                | (if ($xh.extra | type) == "object" then $xh.extra else {} end) as $ex
                | "XHTTP: " + ([
                    line("host"; $xh.host),
                    line("path"; $xh.path),
                    line("mode"; $xh.mode),
                    line("xPaddingBytes"; $ex.xPaddingBytes),
                    bline("noSSEHeader"; $ex.noSSEHeader),
                    line("scMaxEachPostBytes"; $ex.scMaxEachPostBytes)
                ] | join(" "))
            else empty end),
            (if ($st.grpcSettings | type) == "object" then
                "gRPC: " + ([
                    line("serviceName"; $st.grpcSettings.serviceName),
                    line("authority"; $st.grpcSettings.authority),
                    bline("multiMode"; $st.grpcSettings.multiMode),
                    line("idle_timeout"; $st.grpcSettings.idle_timeout),
                    line("health_check_timeout"; $st.grpcSettings.health_check_timeout),
                    bline("permit_without_stream"; $st.grpcSettings.permit_without_stream),
                    line("initial_windows_size"; $st.grpcSettings.initial_windows_size)
                ] | join(" "))
            else empty end),
            (if ($st.httpupgradeSettings | type) == "object" then
                "HTTPUpgrade: " + ([
                    bline("acceptProxyProtocol"; $st.httpupgradeSettings.acceptProxyProtocol),
                    line("host"; $st.httpupgradeSettings.host),
                    line("path"; $st.httpupgradeSettings.path)
                ] | join(" "))
            else empty end),
            (if ($st.httpSettings | type) == "object" then
                "HTTP/2: " + ([
                    line("host"; arr($st.httpSettings.host // [])),
                    line("path"; $st.httpSettings.path),
                    line("method"; $st.httpSettings.method),
                    line("headers"; kv($st.httpSettings.headers))
                ] | join(" "))
            else empty end),
            (if ($st.kcpSettings | type) == "object" then
                "mKCP: " + ([
                    line("mtu"; $st.kcpSettings.mtu),
                    line("tti"; $st.kcpSettings.tti),
                    line("uplinkCapacity"; $st.kcpSettings.uplinkCapacity),
                    line("downlinkCapacity"; $st.kcpSettings.downlinkCapacity),
                    bline("congestion"; $st.kcpSettings.congestion),
                    line("readBufferSize"; $st.kcpSettings.readBufferSize),
                    line("writeBufferSize"; $st.kcpSettings.writeBufferSize),
                    line("header"; (if ($st.kcpSettings.header | type) == "object" then $st.kcpSettings.header.type else null end)),
                    line("seed"; $st.kcpSettings.seed)
                ] | join(" "))
            else empty end),
            (if ($st.quicSettings | type) == "object" then
                "QUIC: " + ([line("security"; $st.quicSettings.security), line("key"; $st.quicSettings.key), line("header"; (if ($st.quicSettings.header | type) == "object" then $st.quicSettings.header.type else null end))] | join(" "))
            else empty end),
            (if ($st.dsSettings | type) == "object" then
                "DomainSocket: " + ([line("path"; $st.dsSettings.path), bline("abstract"; $st.dsSettings.abstract), bline("padding"; $st.dsSettings.padding)] | join(" "))
            else empty end),
            (if ($st.hysteriaSettings | type) == "object" then
                "Hysteria: " + ([
                    line("version"; $st.hysteriaSettings.version),
                    line("auth"; $st.hysteriaSettings.auth),
                    line("udpIdleTimeout"; $st.hysteriaSettings.udpIdleTimeout),
                    line("masquerade"; (if ($st.hysteriaSettings.masquerade | type) == "object" then $st.hysteriaSettings.masquerade.type else null end))
                ] | join(" "))
            else empty end),
            (if (($st.hysteria2Settings // $st.hy2steriaSettings) | type) == "object" then
                ($st.hysteria2Settings // $st.hy2steriaSettings) as $hy2
                | (if ($hy2.congestion | type) == "object" then $hy2.congestion else {} end) as $cg
                | "Hysteria2: " + ([line("password"; $hy2.password), line("congestion"; $cg.type), line("up_mbps"; $cg.up_mbps), line("down_mbps"; $cg.down_mbps), bline("use_udp_extension"; $hy2.use_udp_extension)] | join(" "))
            else empty end),
            (if ($st.masqueSettings | type) == "object" then
                ($st.masqueSettings) as $mq
                | "MASQUE: " + ([line("uri"; $mq.uri), line("mtu"; $mq.mtu), bline("enableUdp"; $mq.enableUdp)] | join(" "))
            else empty end),
            (if ($st.finalmask | type) == "object" then
                "Finalmask: " + ([
                    (if ($st.finalmask.tcp | type) == "array" and ($st.finalmask.tcp | length) > 0 then "tcp: \(cv($st.finalmask.tcp | map(select(type == "object") | .type // empty | tostring) | join(",")))" else empty end),
                    (if ($st.finalmask.udp | type) == "array" and ($st.finalmask.udp | length) > 0 then "udp: \(cv($st.finalmask.udp | map(select(type == "object") | .type // empty | tostring) | join(",")))" else empty end)
                ] | join(" "))
            else empty end),
            (if ($st.sockopt | type) == "object" then
                ($st.sockopt) as $so
                | "Sockopt: " + ([
                    line("tproxy"; $so.tproxy),
                    line("tcpFastOpen"; $so.tcpFastOpen),
                    line("mark"; $so.mark),
                    line("dialerProxy"; $so.dialerProxy),
                    line("domainStrategy"; $so.domainStrategy),
                    bline("acceptProxyProtocol"; $so.acceptProxyProtocol),
                    line("tcpMaxSeg"; $so.tcpMaxSeg),
                    line("tcpKeepAliveIdle"; $so.tcpKeepAliveIdle),
                    line("tcpKeepAliveInterval"; $so.tcpKeepAliveInterval),
                    line("tcpUserTimeout"; $so.tcpUserTimeout),
                    line("tcpcongestion"; $so.tcpcongestion),
                    line("interface"; ($so.interface // $so.bindToDevice)),
                    bline("V6Only"; $so.V6Only),
                    bline("tcpMptcp"; (if $so.tcpMptcp != null then $so.tcpMptcp else $so.mptcp end))
                ] | join(" "))
            else empty end)
        ] end;

    def render_fallbacks($fbs):
        if ($fbs | type) == "array" and ($fbs | length) > 0 then
            ($fbs | to_entries | map(
                select(.value | type == "object")
                | "  Fallback\(.key + 1): " + ([
                    line("name"; .value.name),
                    line("alpn"; .value.alpn),
                    line("path"; .value.path),
                    line("dest"; .value.dest),
                    line("xver"; .value.xver)
                ] | join(" "))
            ))
        else [] end;

    def ulist($s):
        if ($s.users | type) == "array" and ($s.users | length) > 0 then ($s.users | map(select(type == "object")))
        elif ($s.clients | type) == "array" and ($s.clients | length) > 0 then ($s.clients | map(select(type == "object")))
        elif ($s.accounts | type) == "array" and ($s.accounts | length) > 0 then ($s.accounts | map(select(type == "object")))
        else [] end;

    def render_settings($p; $s):
        if ($s | type) != "object" then []
        elif $p == "vless" or $p == "vmess" or $p == "trojan" then
            ulist($s) as $us
            | [
                ([
                    line("decryption"; $s.decryption),
                    bline("disableInsecureEncryption"; $s.disableInsecureEncryption),
                    line("detour"; (if ($s.detour | type) == "object" then $s.detour.to else null end)),
                    line("packetEncoding"; $s.packetEncoding),
                    (if ($us | length) > 0 then "用户数: \(cv($us | length))" else empty end)
                ] | join(" "))
              ] + render_fallbacks($s.fallbacks)
        elif $p == "shadowsocks" then
            ulist($s) as $us
            | [
                ([
                    line("method"; $s.method),
                    line("network"; $s.network),
                    (if $core == "v2ray" then bline("udp"; $s.udp) else empty end),
                    line("email"; $s.email),
                    bline("ivCheck"; $s.ivCheck),
                    line("packetEncoding"; $s.packetEncoding),
                    (if ($us | length) > 0 then "用户数: \(cv($us | length))" else empty end)
                ] | join(" "))
            ]
        elif $p == "tunnel" or $p == "dokodemo-door" then
            [
                ([
                    line("目标地址"; ($s.rewriteAddress // $s.address)),
                    line("目标端口"; ($s.rewritePort // $s.port)),
                    line("网络"; ($s.allowedNetwork // $s.network // "tcp")),
                    line("timeout"; $s.timeout),
                    (if $s.followRedirect == true then "followRedirect: \(yv(true))" else empty end)
                ] | join(" ")),
                (if ($s.portMap | type) == "object" then "端口映射: \(cv(kv($s.portMap)))" else empty end)
            ]
        elif $p == "socks" or $p == "http" then
            ulist($s) as $us
            | [
                ([
                    line("auth"; $s.auth),
                    (if $s.udp == true then "UDP: \(yv(true))" else empty end),
                    line("ip"; $s.ip),
                    bline("allowTransparent"; $s.allowTransparent),
                    line("timeout"; $s.timeout),
                    line("packetEncoding"; $s.packetEncoding),
                    (if ($us | length) > 0 then "账号数: \(cv($us | length))" else empty end)
                ] | join(" "))
            ]
        elif $p == "wireguard" then
            (if ($s.peers | type) == "array" then ($s.peers | map(select(type == "object"))) else [] end) as $prs
            | [
                ([line("mtu"; $s.mtu), (if ($prs | length) > 0 then "Peers: \(cv($prs | length))" else empty end)] | join(" "))
            ] + ($prs | to_entries | map("  Peer\(.key + 1): " + ([line("publicKey"; .value.publicKey), line("allowedIPs"; arr(.value.allowedIPs // [])), line("keepAlive"; .value.keepAlive)] | join(" "))))
        elif $p == "tun" then
            [
                ([line("name"; $s.name), line("mtu"; $s.mtu), line("gateway"; arr($s.gateway // [])), line("dns"; arr($s.dns // [])), line("autoOutboundsInterface"; $s.autoOutboundsInterface)] | join(" "))
            ]
        elif $p == "masque" then
            ulist($s) as $us
            | [
                ([line("address"; arr($s.address // [])), line("mtu"; $s.mtu), (if ($us | length) > 0 then "用户数: \(cv($us | length))" else empty end)] | join(" "))
            ]
        elif $p == "hysteria" or $p == "hy2" or $p == "hysteria2" then
            ulist($s) as $us
            | [
                ([line("version"; $s.version), line("auth"; $s.auth), line("password"; $s.password), (if ($us | length) > 0 then "用户数: \(cv($us | length))" else empty end)] | join(" "))
            ]
        else [] end;

    (if (.inbounds | type) == "array" then .inbounds else [] end)
    | [ to_entries[]
        | select(.value | type == "object")
        | select(
            if $filter == "nginx" then ((.value.tag // "" | tostring) | startswith($nginx_prefix))
            elif $filter == "direct" then (((.value.tag // "" | tostring) | startswith($nginx_prefix)) | not)
            else true end
          )
      ]
    | to_entries[]
    | (.key + 1) as $num
    | .value.value as $inb
    | (
        [
            "监听地址: \(cv($inb.listen // "0.0.0.0")) 监听端口: \(cv($inb.port // ""))",
            "传输协议: \(cv($inb.protocol // "")) 标识: \(cv($inb.tag // ""))"
        ]
        + render_settings($inb.protocol // ""; $inb.settings)
        + render_stream($inb.streamSettings)
        + render_sniffing($inb.sniffing)
        + (if $core == "v2ray" and ($inb.allocate | type) == "object" then ["端口分配: \(cv($inb.allocate.strategy // "always")) refresh: \(cv($inb.allocate.refresh // 5)) concurrency: \(cv($inb.allocate.concurrency // 3))"] else [] end)
      )
    | map(select(. != ""))
    | " \($g)\($num).\($n)\($ind)" + join("\n\($ind)") + "\n"
    ' "$config_file"
}

ProxyRenderOutbounds()
{
    local config_file="$1"
    local core_type="${2:-xray}"

    if [ ! -s "$config_file" ]
    then
        return 1
    fi

    $JQ_FILE -r \
        --arg core "$core_type" \
        --arg g "$green" \
        --arg r "$red" \
        --arg n "$normal" \
        --arg ind "$indent_6" \
    '
    def cv($v): "\($g)\($v)\($n)";
    def bv($v): if $v == true then "\($g)开启\($n)" else "\($r)关闭\($n)" end;
    def arr($a): if ($a | type) == "array" then ($a | map(tostring) | join(", ")) else ($a // "" | tostring) end;
    def line($label; $val): if ($val // "" | tostring) != "" then "\($label): \(cv($val))" else empty end;

    def arr_objs($x): if ($x | type) == "array" then ($x | map(select(type == "object"))) else [] end;

    def render_out_settings($p; $s):
        if ($s | type) != "object" then []
        elif $p == "freedom" then
            [
                ([line("domainStrategy"; $s.domainStrategy), line("redirect"; $s.redirect), line("proxyProtocol"; $s.proxyProtocol)] | join(" ")),
                (if ($s.fragment | type) == "object" then "fragment: \(cv("\($s.fragment.packets // "") / \($s.fragment.length // "") / \($s.fragment.interval // "")"))" else empty end),
                (if ($s.noises | type) == "array" and ($s.noises | length) > 0 then "noises: \(cv($s.noises | length))" else empty end),
                (if ($s.finalRules | type) == "array" and ($s.finalRules | length) > 0 then "finalRules: \(cv($s.finalRules | length))" else empty end)
            ]
        elif $p == "blackhole" then
            [([line("response"; (if ($s.response | type) == "object" then ($s.response.type // "none") else "none" end))] | join(" "))]
        elif $p == "dns" then
            [
                ([line("network"; ($s.rewriteNetwork // $s.network)), line("address"; ($s.rewriteAddress // $s.address)), line("port"; ($s.rewritePort // $s.port))] | join(" ")),
                (if ($s.rules | type) == "array" and ($s.rules | length) > 0 then "rules: \(cv($s.rules | length))" else empty end)
            ]
        elif $p == "loopback" then
            [([line("inboundTag"; $s.inboundTag)] | join(" "))]
        elif $p == "vless" or $p == "vmess" then
            arr_objs($s.vnext) as $vn
            | if ($vn | length) > 0 then
                [($vn | map("\(.address // ""):\(.port // "") (users: \(arr_objs(.users) | length))") | join("; ")) | "服务端: \(cv(.))"]
            else
                [([line("address"; $s.address), line("port"; $s.port), line("flow"; $s.flow), line("encryption"; ($s.encryption // $s.security))] | join(" "))]
            end
        elif $p == "trojan" or $p == "shadowsocks" or $p == "socks" or $p == "http" then
            arr_objs($s.servers) as $sv
            | if ($sv | length) > 0 then
                [($sv | map("\(.address // ""):\(.port // "")") | join("; ")) | "服务端: \(cv(.))"]
            else
                [([line("address"; $s.address), line("port"; $s.port), line("method"; $s.method)] | join(" "))]
            end
        elif $p == "wireguard" then
            [([line("mtu"; $s.mtu), line("address"; arr($s.address // [])), (if ($s.peers | type) == "array" and ($s.peers | length) > 0 then "Peers: \(cv($s.peers | length))" else empty end)] | join(" "))]
        elif $p == "hysteria" or $p == "hy2" or $p == "hysteria2" or $p == "masque" then
            arr_objs($s.servers) as $sv
            | if ($sv | length) > 0 then
                [($sv | map("\(.address // ""):\(.port // "")") | join("; ")) | "服务端: \(cv(.))"]
              else
                [([line("address"; $s.address), line("port"; $s.port), line("version"; $s.version)] | join(" "))]
              end
        else [] end;

    (if (.outbounds | type) == "array" then .outbounds else [] end)
    | to_entries[]
    | select(.value | type == "object")
    | (.key + 1) as $num
    | .value as $out
    | (
        [
            "发送地址: \(cv($out.sendThrough // "0.0.0.0")) 传输协议: \(cv($out.protocol // ""))",
            "标识: \(cv($out.tag // ""))"
            + (if $core == "xray" and ($out.targetStrategy // "") != "" then " targetStrategy: \(cv($out.targetStrategy))" else "" end),
            (if $core == "v2ray" and ($out.proxySettings | type) == "object" then "proxySettings: \(cv($out.proxySettings.tag // ""))" else empty end),
            (if ($out.mux | type) == "object" then
                "Mux: \(bv($out.mux.enabled // false)) 并发: \(cv($out.mux.concurrency // 8))"
                + (if $core == "xray" and ($out.mux.xudpConcurrency // "") != "" then " xudpConcurrency: \(cv($out.mux.xudpConcurrency))" else "" end)
                + (if $core == "xray" and ($out.mux.xudpProxyUDP443 // "") != "" then " xudpProxyUDP443: \(cv($out.mux.xudpProxyUDP443))" else "" end)
             else empty end)
        ]
        + render_out_settings($out.protocol // ""; $out.settings)
        + (if ($out.streamSettings | type) == "object" then
            ($out.streamSettings) as $st
            | [
                "传输方式: \(cv($st.method // $st.network // (if $core == "xray" then "raw" else "tcp" end))) 传输安全: \(cv($st.security // "none"))",
                (if ($st.tlsSettings | type) == "object" then
                    ($st.tlsSettings) as $t
                    | ([
                        line("serverName"; $t.serverName),
                        line("fingerprint"; $t.fingerprint),
                        line("ALPN"; arr($t.alpn // [])),
                        (if $t.allowInsecure == true then "allowInsecure: \(cv("是"))" else empty end)
                      ] | join(" ")) as $tsum
                    | if $tsum != "" then "TLS: \($tsum)" else empty end
                 else empty end),
                (if ($st.realitySettings | type) == "object" then
                    ($st.realitySettings) as $rl
                    | ([
                        line("serverName"; $rl.serverName),
                        line("fingerprint"; $rl.fingerprint),
                        line("shortId"; $rl.shortId),
                        line("spiderX"; $rl.spiderX),
                        (if ($rl.publicKey // $rl.password // "") != "" then "publicKey: \(cv("已配置"))" else empty end)
                      ] | join(" ")) as $rsum
                    | if $rsum != "" then "REALITY: \($rsum)" else empty end
                 else empty end),
                (if ($st.sockopt | type) == "object" and ($st.sockopt.dialerProxy // "") != "" then "dialerProxy: \(cv($st.sockopt.dialerProxy))" else empty end)
            ]
          else [] end)
      )
    | map(select(. != ""))
    | " \($g)\($num).\($n)\($ind)" + join("\n\($ind)") + "\n"
    ' "$config_file"
}

