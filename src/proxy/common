        --arg r "$red" \
        --arg n "$normal" \
        --arg ind "$indent_6" \
    '
    def cv($v): "\($g)\($v)\($n)";
    def yv($v): if $v == true then "\($g)是\($n)" else "\($r)否\($n)" end;
    def arr($a): if ($a | type) == "array" then ($a | map(select(. != null) | tostring) | join(", ")) else ($a // "" | tostring) end;

