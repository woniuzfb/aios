ProxySelectBound()
{
    local config_file="$1"
    local bound_type="$2"
    local prompt_title="$3"

    local options=()
    local i ridx
    if [ "$bound_type" == "inbounds" ]
    then
        ProxyLoadInboundsIndex "$config_file"
        if [ "$inbounds_count" -eq 0 ]
        then
            Println "$error 请先添加入站\n"
            return 1
        fi
        for ((i=0; i<inbounds_count; i++))
        do
            ridx="${inbounds_json_index[i]}"
            options+=("$((i+1)). [${inbounds_protocol[ridx]}] ${inbounds_tag[ridx]} (${inbounds_listen[ridx]}:${inbounds_port[ridx]})")
        done
        echo
        inquirer list_input_index "$prompt_title" options selected_bound_index
        selected_bound_index="${inbounds_json_index[selected_bound_index]}"
    else
        ProxyLoadOutboundsIndex "$config_file"
        if [ "$outbounds_count" -eq 0 ]
        then
            Println "$error 没有出站\n"
            return 1
        fi
        for ((i=0; i<outbounds_count; i++))
        do
            ridx="${outbounds_json_index[i]}"
            options+=("$((i+1)). [${outbounds_protocol[ridx]}] ${outbounds_tag[ridx]} (${outbounds_sendThrough[ridx]})")
        done
        echo
        inquirer list_input_index "$prompt_title" options selected_bound_index
        selected_bound_index="${outbounds_json_index[selected_bound_index]}"
    fi
}

ProxyToggleService()
{
    local service_name="$1"
    local config_file="$2"

    if [ ! -e "$config_file" ]
    then
        Println "$error $service_name 未安装...\n"
        exit 1
    fi

    echo
    local err_msg=""
    if ServiceControl is-active "$service_name"
    then
        ExitOnList y "`eval_gettext \"\\\$service_name 正在运行, 是否关闭\"`"
        if err_msg=$(ServiceControl stop "$service_name" 2>&1)
        then
            Println "$info $service_name 已关闭\n"
        else
            Println "$error $service_name 关闭失败: ${err_msg}\n"
            return 1
        fi
    else
        ExitOnList y "`eval_gettext \"\\\$service_name 未运行, 是否开启\"`"
        if err_msg=$(ServiceControl start "$service_name" 2>&1)
        then
            Println "$info $service_name 已开启\n"
        else
            Println "$error $service_name 开启失败: ${err_msg}\n"
            return 1
        fi
    fi
}

ProxyRestartService()
{
    local service_name="$1"
    local config_file="$2"

    if [ ! -e "$config_file" ]
    then
        Println "$error $service_name 未安装...\n"
        exit 1
    fi

    local err_msg=""
    if err_msg=$(ServiceControl restart "$service_name" 2>&1)
    then
        Println "$info $service_name 已重启\n"
    else
        Println "$error $service_name 重启失败: ${err_msg}\n"
        return 1
    fi
}

ProxyRestartIfActive()
{
    local service_name="$1"
    if ServiceControl is-active "$service_name"
    then
        local err_msg=""
        if ! err_msg=$(ServiceControl restart "$service_name" 2>&1)
        then
            Println "$error $service_name 重启失败: ${err_msg}\n"
            return 1
        fi
    fi
}
