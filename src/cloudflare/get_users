CloudflareGetUsers()
{
    SetDelimiters
    cf_users_list=""
    cf_users_count=0
    cf_users_email=()
    cf_users_pass=()
    cf_users_token=()
    cf_users_api_key=()
    while IFS="$field_sep" read -r email pass token key
    do
        cf_users_count=$((cf_users_count+1))
        cf_users_email+=("$email")
        cf_users_pass+=("$pass")
        cf_users_token+=("$token")
        cf_users_api_key+=("$key")

        cf_users_list="$cf_users_list ${green}$cf_users_count.${normal}${indent_6}邮箱: ${green}$email${normal}  密码: ${green}$pass${normal}\n${indent_6}Token: ${green}${token:-无}${normal}\n${indent_6}Key: ${green}${key:-无}${normal}\n\n"
    done < <(JQs query "$CF_CONFIG" '
        (if type == "object" and (.users | type) == "array" then .users else [] end)
        | map(select(type == "object"))[]
        | [(.email // "" | tostring), (.pass // "" | tostring), (.token // "" | tostring), (.key // "" | tostring)]
        | join($sep)
    ' --arg sep "$field_sep")
    return 0
}
