CloudflarePartnerMenu()
{
    if [ "${CLOUDFLARE_PARTNER_MENU_LOCALE:-}" != "${sh_locale:-zh_CN}" ] || [ -z "${CLOUDFLARE_PARTNER_MENU_TEXT:-}" ]
    then
        CLOUDFLARE_PARTNER_MENU_TITLE="$(gettext "cloudflare 面板")"
        CLOUDFLARE_PARTNER_MENU_TEXT="
  ${green}1.${normal} $(gettext "查看 源站 CNAME")
  ${green}2.${normal} $(gettext "添加 源站 CNAME")
  ${green}3.${normal} $(gettext "查看 源站")
  ${green}4.${normal} $(gettext "添加 源站")
  ${green}5.${normal} $(gettext "设置 源站")
  ${green}6.${normal} $(gettext "移动 源站")
  ${green}7.${normal} $(gettext "查看 用户")
  ${green}8.${normal} $(gettext "添加 用户")
  ${green}9.${normal} $(gettext "更改 用户")
 ${green}10.${normal} $(gettext "查看 用户 Token")
 ${green}11.${normal} $(gettext "添加 用户 Token")
 ${green}12.${normal} $(gettext "更新 用户 Token")
 ${green}13.${normal} $(gettext "查看 CFP")
 ${green}14.${normal} $(gettext "添加 CFP")
 ${green}15.${normal} $(gettext "更改 CFP")
 ${green}16.${normal} $(gettext "删除 源站")
 ${green}17.${normal} $(gettext "删除 用户")
 ${green}18.${normal} $(gettext "删除 CFP")
 ${green}19.${normal} $(gettext "获取最优 IP")
 ${green}20.${normal} $(gettext "更新脚本")

 ${tip} $(gettext "当前"): ${green}partner${normal} $(gettext "面板")
 ${tip} $(gettext "输入: w 切换到 workers 面板")\n\n"
        CLOUDFLARE_PARTNER_MENU_LOCALE="${sh_locale:-zh_CN}"
    fi

    Println "  ${CLOUDFLARE_PARTNER_MENU_TITLE} ${normal}${red}[v$sh_ver]${normal}
${CLOUDFLARE_PARTNER_MENU_TEXT}"
    read -p "$i18n_input_no [1-20]: " cloudflare_partner_num
    case $cloudflare_partner_num in
        w)
            CloudflareWorkersMenu
        ;;
        1) CloudflareListSubdomain
        ;;
        2) CloudflareAddSubdomain
        ;;
        3) CloudflareListZone
        ;;
        4) CloudflareAddZone
        ;;
        5) CloudflareEditZone
        ;;
        6) CloudflareMoveZone
        ;;
        7) CloudflareListUser
        ;;
        8) CloudflareAddUser
        ;;
        9) CloudflareEditUser
        ;;
        10) CloudflareListToken
        ;;
        11) CloudflareAddToken
        ;;
        12) CloudflareUpdateToken
        ;;
        13) CloudflareListHost
        ;;
        14) CloudflareAddHost
        ;;
        15) CloudflareRegenHost
        ;;
        16) CloudflareDelZone
        ;;
        17) CloudflareDelUser
        ;;
        18) CloudflareDelHost
        ;;
        19) 
            Println "$(eval_gettext "\$info 一键获取最优 IP 脚本 Mac/Linux: ")\n\nhttps://github.com/woniuzfb/cloudflare-fping\n"
        ;;
        20) ShFileUpdate cloudflare
        ;;
        *) Println "$error $i18n_input_correct_number [1-20]\n"
        ;;
    esac
}
