ServiceResolveLabel()
{
    [ -z "${dist:-}" ] && DistCheck

    local raw_id="$1"
    service_label="$raw_id"

    case "$raw_id" in
        aios-xray|aios-v2ray)
            if [ "$dist" == "mac" ]
            then
                service_label="com.aios.${raw_id}"
                service_file="$HOME/Library/LaunchAgents/${service_label}.plist"
            else
                service_label="$raw_id"
                service_file="/etc/systemd/system/${service_label}.service"
            fi
            return 0
        ;;
        v2ray|xray|nginx|openresty|trojan|dnscrypt-proxy)
            if [ "$dist" == "mac" ]
            then
                service_file="$HOME/Library/LaunchAgents/${service_label}.plist"
            else
                service_file="/etc/systemd/system/${service_label}.service"
            fi
            return 0
        ;;
    esac

    if [ "$dist" == "mac" ]
    then
        service_label="com.aios.$raw_id"
        service_file="$HOME/Library/LaunchAgents/${service_label}.plist"
    else
        service_label="aios.$raw_id"
        service_file="/etc/systemd/system/${service_label}.service"
    fi
}

ServiceControlIsActive()
{
    ServiceResolveLabel "$1"
    if [ "$dist" == "mac" ]
    then
        if [ ! -f "$service_file" ] || ! { launchctl print "gui/$UID/$service_label" 2> /dev/null | grep -q "pid ="; }
        then
            return 1
        fi
    else
        if [ ! -f "$service_file" ] || ! systemctl is-active --quiet "$service_label"
        then
            return 1
        fi
    fi
    return 0
}

ServiceControlIsEnabled()
{
    ServiceResolveLabel "$1"

    if [ "$dist" == "mac" ]
    then
        if [ ! -f "$service_file" ]
        then
            return 1
        fi
    else
        if command -v systemctl > /dev/null 2>&1
        then
            if ! systemctl is-enabled --quiet "$service_label" 2> /dev/null
            then
                return 1
            fi
        elif [ ! -f "$service_file" ]
        then
            return 1
        fi
    fi
    return 0
}

ServiceControlStatus()
{
    ServiceResolveLabel "$1"
    if [ "$dist" == "mac" ]
    then
        launchctl print "gui/$UID/$service_label"
    else
        systemctl --no-pager -l status "$service_label"
    fi
}

ServiceControlStart()
{
    if ServiceControlIsActive "$1"
    then
        printf '%s\n' "$(gettext "服务已启动")"
        return 0
    fi

    local args=() arg arr

    if [ -n "${2:-}" ]
    then
        local var=("$2"[@])
        if [[ -n "${!var:-}" ]]
        then
            args=("${!var}")
            if [[ ! -x "${args[0]}" ]]
            then
                echo "${args[0]} $(gettext "不存在")"
                return 1
            fi
        fi
    fi

    if [ "${#args[@]}" -eq 0 ] && [ ! -f "$service_file" ]
    then
        printf '%s\n' "$(eval_gettext "\$service_file 不存在")"
        return 1
    fi

    if [ "$dist" == "mac" ]
    then
        if [ ! -f "$service_file" ] || [ -n "${3:-}" ]
        then
            arr="<array>"
            for arg in "${args[@]}"
            do
                arr="$arr\n        <string>$arg</string>"
            done
            arr="$arr\n    </array>"
            arr=$(echo -e "$arr")
cat > "$service_file" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$service_label</string>
    <key>ProgramArguments</key>
    $arr
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
EOF
        fi
        launchctl load "$service_file"
    else
        if [ ! -f "$service_file" ] || [ -n "${3:-}" ]
        then
            local work_dir="/"
            if [ "${#args[@]}" -gt 0 ]
            then
                work_dir="${args[0]%/*}/"
            fi
cat > "$service_file" <<EOF
[Unit]
Description=${service_label}
After=syslog.target network-online.target nss-lookup.target
Wants=network-online.target

[Service]
ExecStart=${args[*]}
WorkingDirectory=${work_dir}
StartLimitInterval=60s
StartLimitBurst=5
RestartSec=5
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
        fi
        systemctl daemon-reload
        systemctl enable "${service_label}.service"
        systemctl start "${service_label}.service"
    fi
}

ServiceControlStop()
{
    if ! ServiceControlIsActive "$1"
    then
        printf '%s\n' "$(gettext "服务未启动")"
        return 0
    fi

    if [ "$dist" == "mac" ]
    then
        launchctl unload "$service_file"
    else
        systemctl stop "${service_label}.service"
    fi
}

ServiceControlRestart()
{
    if ServiceControlIsActive "$1"
    then
        ServiceControlStop "$1"
    fi

    ServiceControlStart "$@"
}

ServiceControlDisable()
{
    if ServiceControlIsActive "$1"
    then
        ServiceControlStop "$1"
    fi

    if [ "$dist" == "mac" ]
    then
        rm -f "$service_file"
    else
        systemctl disable "${service_label}".service --now > /dev/null 2> /dev/null || true
        rm -f /etc/systemd/system/"${service_label}".service
        rm -f /lib/systemd/system/"${service_label}".service
        rm -f /etc/init.d/"${service_label}"
    fi
}

ServiceControlRename()
{
    local old_service_file="" new_service_file=""
    ServiceResolveLabel "$1"
    old_service_file="$service_file"
    ServiceResolveLabel "$2"
    new_service_file="$service_file"
    mv "$old_service_file" "$new_service_file"
}

ServiceControl()
{
    DistCheck

    local cmd=$1
    shift
    case $cmd in
        is-active)
            ServiceControlIsActive "$@"
        ;;
        is-enabled)
            ServiceControlIsEnabled "$@"
        ;;
        status)
            ServiceControlStatus "$@"
        ;;
        start)
            ServiceControlStart "$@"
        ;;
        stop)
            ServiceControlStop "$@"
        ;;
        restart)
            ServiceControlRestart "$@"
        ;;
        disable)
            ServiceControlDisable "$@"
        ;;
        rename)
            ServiceControlRename "$@"
        ;;
    esac
    return $?
}
