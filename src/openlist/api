OpenList.auth.login()
{
    openlist_payload=$(
    $JQ_FILE -c -n --arg username "$openlist_acc_username" --arg password "$openlist_acc_password" \
        '{
            username: $username,
            password: $password,
            otp_code: ""
        }'
    )

    response=$(
        curl -s -Lm 20 "${openlists_url[openlists_index]}"/api/auth/login \
        -H "Content-Type: application/json" \
        -H "User-Agent: $USER_AGENT_BROWSER" \
        --data "$openlist_payload"
    )

    jq_payload=$(JQs flat "$response")

    jq_path='[
        ["code"],
        ["message"],
        ["data","token"]
    ]'

    while IFS=": " read -r path_name value; do
        var_name=${path_name}
        read -r ${var_name?} <<< "$value"
    done < <(JQs gets jq_payload)

    auth_login_code="$jq_code"
    auth_login_message="$jq_message"
    openlist_acc_token="$jq_data_token"

    if [ "$auth_login_code" -eq 200 ] 
    then
        jq_path='["openlist",'"$openlists_index"',"accs",'"$openlist_accs_index"',"token"]'
        JQ update "$SERVICES_CONFIG" "$openlist_acc_token"
        Println "$info 账号 $openlist_acc_username 登陆成功\n"
    else
        Println "$error 账号 $openlist_acc_username 登陆失败: $auth_login_message\n"
        return 1
    fi
}

