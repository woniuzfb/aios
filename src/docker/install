DockerInstall()
{
    local install="$(gettext "更新")"

    if [ -z "${1:-}" ]
    then
        if [[ -x $(command -v docker) ]]
        then
            return 0
        fi
        install="$(gettext "安装")"
    elif [[ ! -x $(command -v docker) ]]
    then
        install="$(gettext "安装")"
    fi

    if [ "$dist" == "mac" ]
    then
        brew install --cask docker
        Println "$(eval_gettext "\$info docker \${install}成功, 打开 docker app 完成最后设置!")\n"
        return 0
    fi

    DepInstall curl
    DepInstall ca-certificates
    DepInstall gpg

    case $dist in
        ubu|deb)
            local docker_dist="ubuntu" docker_codename docker_repo_base docker_key_url
            if [ "$dist" == "deb" ]
            then
                docker_dist="debian"
            fi

            docker_codename=$(AptGetCodename)

            if grep -q "docker-ce" < /etc/apt/sources.list
            then
                sed -i '/docker-ce/d' /etc/apt/sources.list
            fi

            if [ ! -f "/etc/apt/sources.list.d/docker.list" ]
            then
                docker_repo_base="${DOCKER_REPO_LINK}/${docker_dist}"
                if grep -q "$USTC_MIRROR_HOST" < /etc/apt/sources.list
                then
                    docker_key_url="http://${USTC_MIRROR_HOST}/docker-ce/linux/${docker_dist}/gpg"
                else
                    docker_key_url="${DOCKER_REPO_LINK}/${docker_dist}/gpg"
                fi

                if ! AptRepoCheck "$docker_repo_base" "$docker_codename"
                then
                    local docker_codename_display="${docker_codename:-unknown}"
                    Println "$(eval_gettext "\$error Docker 官方源暂不支持当前系统 (\$docker_codename_display), 未写入失效源")\n"
                    return 1
                fi

                curl -fsSL "$docker_key_url" | gpg --batch --yes --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
                echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] ${docker_repo_base} \
                ${docker_codename} stable" | tee /etc/apt/sources.list.d/docker.list
                AptUpdate force
            fi

            for pkg in docker.io docker-doc docker-compose podman-docker containerd runc
            do
                sudo apt-get -y remove $pkg || true
            done

            AptInstall docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
        ;;
        rpm)
            echo
            sudo yum install -y yum-utils
            sudo yum-config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
            sudo yum remove docker \
                docker-client \
                docker-client-latest \
                docker-common \
                docker-latest \
                docker-latest-logrotate \
                docker-logrotate \
                docker-engine || true
            sudo yum -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
        ;;
        *)
            Println "$(eval_gettext "\$error 不支持的系统")\n"
            return 1
        ;;
    esac

    if [ ! -f /etc/systemd/system/docker.service.d/clear_mount_propagation_flags.conf ]
    then
cat > /etc/systemd/system/docker.service.d/clear_mount_propagation_flags.conf <<EOF
[Service]
MountFlags=shared
EOF
        systemctl daemon-reload
        systemctl restart docker
    fi

    Println "$(eval_gettext "\$info docker 安装成功")\n"
}
