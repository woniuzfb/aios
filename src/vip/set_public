VipSetPublicRoot()
{
    Println "$(gettext "请输入公开目录, 比如 /usr/local/nginx/html 或 /usr/local/openresty/nginx/html")"
    read -p "($(gettext "默认: 不公开")): " vip_public_root
    if [ -n "$vip_public_root" ] 
    then
        vip_public_root=${vip_public_root%\/}
    fi
    jq_path='["config","public_root"]'
    JQ update "$VIP_FILE" "$vip_public_root"
    Println "  $(gettext "VIP 公开目录"): ${green} ${vip_public_root:-$i18n_none} ${normal}\n"
}

VipSetPublicHost()
{
    Println "$(eval_gettext "\$tip 比如 http://localhost")"
    inquirer text_input "$(gettext "请输入公开目录的 域名 或者 IP 网址"): " vip_public_host "$i18n_blank"
    jq_path='["config","public_host"]'
    JQ update "$VIP_FILE" "$vip_public_host"
}

VipConfig()
{
    VipSetPublicRoot
    if [ -n "$vip_public_root" ] 
    then
        VipSetPublicHost
    fi
}
