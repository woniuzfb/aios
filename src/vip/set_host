VipSetHostIp()
{
    Println "$(gettext "请输入 VIP 频道所在服务器 IP/域名")"
    read -p "$i18n_default_cancel" vip_host_ip
    [ -z "$vip_host_ip" ] && Println "$i18n_canceled...\n" && exit 1
    Println "  $(eval_gettext "VIP 服务器 IP/域名: \${green} \$vip_host_ip \${normal}")\n"
}

