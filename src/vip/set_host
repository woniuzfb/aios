VipSetHostToken()
{
    echo
    inquirer text_input "$(gettext "请输入 VIP 频道所在服务器的 token"): " vip_host_token "$i18n_blank"
}

VipSetHostStatus()
{
    echo
    inquirer list_input "$(gettext "是否启用此 VIP 服务器")" yn_options vip_host_status

    if [[ $vip_host_status == "$i18n_yes" ]] 
    then
        vip_host_status="on"
        vip_host_status_text="${green}$i18n_enabled${normal}"
    else
        vip_host_status="off"
        vip_host_status_text="${red}$i18n_disabled${normal}"
    fi
    Println "  $(eval_gettext "VIP 服务器状态: \$vip_host_status_text")\n"
}
