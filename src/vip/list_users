VipListUsers()
{
    if [ ! -s "$VIP_FILE" ] 
    then
        Println "$(eval_gettext "\$error 请先添加 VIP 服务器")\n" && exit 1
    fi

    VipGetUsers

    if [ "$vip_users_count" -gt 0 ] 
    then
        Println "$vip_users_list"
    else
        Println "$(eval_gettext "\$error 请先添加用户")\n" && exit 1
    fi
}
