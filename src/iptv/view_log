ViewChannelLog()
{
    ListChannels
    InputChannelsIndex

    for chnl_pid in "${chnls_pid_chosen[@]}"
    do
        ListChannel

        Println "${green}$(gettext "输出日志"):${normal}\n"
        if [ -s "$FFMPEG_LOG_ROOT/$chnl_pid.log" ] 
        then
            tail -n 10 "$FFMPEG_LOG_ROOT/$chnl_pid.log"
        else
            echo "$(gettext "无")"
        fi

        Println "${red}$(gettext "错误日志"):${normal}\n"
        if [ -s "$FFMPEG_LOG_ROOT/$chnl_pid.err" ] 
        then
            cat "$FFMPEG_LOG_ROOT/$chnl_pid.err"
        else
            echo "$(gettext "无")"
        fi
        echo
    done
}
