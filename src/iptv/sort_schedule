SortChannelSchedules()
{
    IFS="${delimiters[4]}" read -ra chnl_schedules_start_time <<< "${chnls_schedule_start_time[chnls_index]}"
    IFS="${delimiters[4]}" read -ra chnl_schedules_end_time <<< "${chnls_schedule_end_time[chnls_index]}"
    IFS="${delimiters[4]}" read -ra chnl_schedules_loop <<< "${chnls_schedule_loop[chnls_index]}"
    IFS="${delimiters[4]}" read -ra chnl_schedules_auto_remove <<< "${chnls_schedule_auto_remove[chnls_index]}"
    IFS="${delimiters[4]}" read -ra chnl_schedules_hls_change <<< "${chnls_schedule_hls_change[chnls_index]}"
    IFS="${delimiters[4]}" read -ra chnl_schedules_hls_change_once <<< "${chnls_schedule_hls_change_once[chnls_index]}"
    IFS="${delimiters[4]}" read -ra chnl_schedules_status <<< "${chnls_schedule_status[chnls_index]}"

    chnl_schedules_count=${#chnl_schedules_status[@]}

    if [ "$chnl_schedules_count" -eq 1 ] 
    then
        Println "$error $(gettext "频道") [ ${chnls_channel_name[chnls_index]} ] $(gettext "计划只有一个")"
        return 0
    fi

    IFS="${delimiters[4]}" read -ra chnl_schedules_channel_name <<< "${chnls_schedule_channel_name[chnls_index]}"

    chnl_schedules_indices=("${!chnl_schedules_status[@]}")
    chnl_schedules_list="${indent_6}${dim_underlined}${chnls_channel_name[chnls_index]}${normal}\n\n"
    chnl_schedules_options=()

    local lbl_wait lbl_running lbl_ended lbl_once lbl_channel_name lbl_schedule lbl_anti_leech lbl_loop lbl_auto_remove lbl_start_time lbl_end_time
    lbl_wait=$(gettext "等待")
    lbl_running=$(gettext "进行")
    lbl_ended=$(gettext "结束")
    lbl_once=$(gettext "一次")
    lbl_channel_name=$(gettext "频道名称")
    lbl_schedule=$(gettext "计划")
    lbl_anti_leech=$(gettext "防盗链")
    lbl_loop=$(gettext "循环")
    lbl_auto_remove=$(gettext "自动清除")
    lbl_start_time=$(gettext "开始时间")
    lbl_end_time=$(gettext "结束时间")

    for chnl_schedules_index in "${chnl_schedules_indices[@]}"
    do
        if [ "${chnl_schedules_status[chnl_schedules_index]}" -eq 0 ]
        then
            chnl_schedule_status_list="${green}$lbl_wait${normal}"
        elif [ "${chnl_schedules_status[chnl_schedules_index]}" -eq 1 ]
        then
            chnl_schedule_status_list="${blue}$lbl_running${normal}"
        else
            chnl_schedule_status_list="${red}$lbl_ended${normal}"
        fi

        if [ "${chnl_schedules_hls_change_once[chnl_schedules_index]}" = true ]
        then
            chnl_schedule_hls_change_list="${green}$lbl_once${normal}"
        elif [ "${chnl_schedules_hls_change[chnl_schedules_index]}" = true ]
        then
            chnl_schedule_hls_change_list="${green}$i18n_yes${normal}"
        else
            chnl_schedule_hls_change_list="${red}$i18n_no${normal}"
        fi

        if [ "${chnl_schedules_loop[chnl_schedules_index]}" = true ]
        then
            chnl_schedule_loop_list="${green}$i18n_yes${normal}"
        else
            chnl_schedule_loop_list="${red}$i18n_no${normal}"
        fi

        if [ "${chnl_schedules_auto_remove[chnl_schedules_index]}" = true ]
        then
            chnl_schedule_auto_remove_list="${green}$i18n_yes${normal}"
        else
            chnl_schedule_auto_remove_list="${red}$i18n_no${normal}"
        fi

        if [ -n "${chnl_schedules_channel_name[chnl_schedules_index]}" ]
        then
            chnl_schedule_channel_name_list="${indent_6}$lbl_channel_name: ${blue}${chnl_schedules_channel_name[chnl_schedules_index]}${normal}\n"
        else
            chnl_schedule_channel_name_list=""
        fi
        chnl_schedules_options+=("$lbl_schedule$((chnl_schedules_index+1))")
        chnl_schedules_list="$chnl_schedules_list  ${green}$((chnl_schedules_index+1)).${normal}${indent_6}$i18n_status: $chnl_schedule_status_list${indent_20}$lbl_anti_leech: $chnl_schedule_hls_change_list\n${indent_6}$lbl_loop: $chnl_schedule_loop_list${indent_20}$lbl_auto_remove: $chnl_schedule_auto_remove_list\n$chnl_schedule_channel_name_list${indent_6}$lbl_start_time: $(FormatEpoch "${chnl_schedules_start_time[chnl_schedules_index]}" '+%c')\n${indent_6}$lbl_end_time: $(FormatEpoch "${chnl_schedules_end_time[chnl_schedules_index]}" '+%c')\n\n"
    done

    Println "$chnl_schedules_list"

    echo
    inquirer sort_input_indices "$(gettext "排序计划")" chnl_schedules_options chnl_schedules_indices

    new_schedules=()

    for chnl_schedules_index in "${chnl_schedules_indices[@]}"
    do
        new_schedule=$(
            $JQ_FILE -n --arg start_time "${chnl_schedules_start_time[chnl_schedules_index]}" \
                --arg end_time "${chnl_schedules_end_time[chnl_schedules_index]}" \
                --arg loop "${chnl_schedules_loop[chnl_schedules_index]}" \
                --arg auto_remove "${chnl_schedules_auto_remove[chnl_schedules_index]}" \
                --arg hls_change "${chnl_schedules_hls_change[chnl_schedules_index]}" \
                --arg hls_change_once "${chnl_schedules_hls_change_once[chnl_schedules_index]}" \
                --arg channel_name "${chnl_schedules_channel_name[chnl_schedules_index]}" \
                --arg status "${chnl_schedules_status[chnl_schedules_index]}" \
            '{
                start_time: $start_time | tonumber,
                end_time: $end_time | tonumber,
                loop: $loop | test("true"),
                auto_remove: $auto_remove | test("true"),
                hls_change: $hls_change | test("true"),
                hls_change_once: $hls_change_once | test("true"),
                channel_name: $channel_name,
                status: $status | tonumber
            }'
        )
        new_schedules+=("$new_schedule")
    done

    jq_file=true
    jq_file_json=true
    jq_path='["channels",'"$chnls_index"',"schedule"]'
    JQ update "$CHANNELS_FILE" new_schedules

    Println "$info $(gettext "频道") [ ${chnls_channel_name[chnls_index]} ] $(gettext "计划排序成功")\n"
}

SortChannelsSchedule()
{
    ListChannelsSchedule

    if [ -z "$chnls_schedule_list" ] 
    then
        Println "$(eval_gettext "\$error 请先添加频道计划")\n"
        exit 1
    fi

    echo -e "  ${green}$((chnls_count+1)).${normal}${indent_6}$i18n_all\n\n"

    echo "$(gettext "输入频道序号(多个频道用空格分隔 比如: 1 2 4-5)")"
    while read -p "$i18n_default_cancel" chnls_num
    do
        if [ -z "$chnls_num" ] 
        then
            Println "$i18n_canceled...\n" && exit 1
        fi

        if [ "$chnls_num" == $((chnls_count+1)) ] 
        then
            for chnls_index in "${chnls_schedule_indices[@]}"
            do
                SortChannelSchedules
            done
            break
        fi

        IFS=" " read -ra chnls_num_arr <<< "$chnls_num"

        error_no=0
        for chnl_num in "${chnls_num_arr[@]}"
        do
            case "$chnl_num" in
                *"-"*)
                    chnl_num_start=${chnl_num%-*}
                    chnl_num_end=${chnl_num#*-}
                    if [[ $chnl_num_start == *[!0-9]* ]] || [[ $chnl_num_end == *[!0-9]* ]] || [ "$chnl_num_start" -eq 0 ] || [ "$chnl_num_end" -eq 0 ] || [ "$chnl_num_end" -gt "$chnls_count" ] || [ "$chnl_num_start" -ge "$chnl_num_end" ]
                    then
                        error_no=3
                        break
                    else
                        for((i=chnl_num_start-1;i<chnl_num_end;i++));
                        do
                            if [ -z "${chnls_schedule_status[i]}" ] 
                            then
                                error_no=3
                                break 2
                            fi
                        done
                    fi
                ;;
                *[!0-9]*)
                    error_no=1
                    break
                ;;
                *)
                    if [ "$chnl_num" -lt 1 ] || [ "$chnl_num" -gt "$chnls_count" ] || [ -z "${chnls_schedule_status[chnl_num-1]}" ]
                    then
                        error_no=2
                        break
                    fi
                ;;
            esac
        done

        case "$error_no" in
            1|2|3)
                Println "$error $i18n_input_correct_number\n"
            ;;
            *)
                for chnl_num in "${chnls_num_arr[@]}"
                do
                    if [[ $chnl_num =~ - ]] 
                    then
                        chnls_start=${chnl_num%-*}
                        chnls_end=${chnl_num#*-}
                        for((chnls_index=chnls_start-1;chnls_index<chnls_end;chnls_index++));
                        do
                            SortChannelSchedules
                        done
                    else
                        chnls_index=$((chnl_num-1))
                        SortChannelSchedules
                    fi
                done
                break
            ;;
        esac
    done
}
