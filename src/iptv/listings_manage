}

ScheduleDel()
{
    ScheduleViewCron

    echo -e " ${green}$((chnls_count+1)).${normal}${indent_6}$i18n_all"

    Println "$(gettext "选择删除的频道, 多个频道用空格分隔 比如: 5 7 9-11")"
