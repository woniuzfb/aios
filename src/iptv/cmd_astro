Println "$info 检测 astro ..."

SetDelimiters

response=$(
    curl -s -Lm 20 -H 'User-Agent: '"$USER_AGENT_BROWSER"'' https://contenthub-api.eco.astro.com.my/channel/all.json
)

jq_payload=$(JQs flat "$response")

jq_path='[
    ["response","id"],
    ["response","title"],
    ["response","description"],
    ["response","isHd"],
    ["response","language"]
]'

while IFS=": " read -r path_name value; do
    var_name=${path_name}
    read -r ${var_name?} <<< "$value"
done < <(JQs gets jq_payload)

IFS="${delimiters[2]}" read -ra chnls_id <<< "$jq_response_id"
IFS="${delimiters[2]}" read -ra chnls_title <<< "$jq_response_title"
IFS="${delimiters[2]}" read -ra chnls_description <<< "$jq_response_description"
IFS="${delimiters[2]}" read -ra chnls_is_hd <<< "$jq_response_isHd"
IFS="${delimiters[2]}" read -ra chnls_language <<< "$jq_response_language"

chnls_list=""
for((i=0;i<${#chnls_id[@]};i++));
do
    if [ "${chnls_is_hd[i]}" = true ] 
    then
        is_hd="${green}是${normal}"
    else
        is_hd="${red}否${normal}"
    fi
    chnls_list="$chnls_list ${green}$((i+1)).${normal}${indent_6}频道ID: ${green}${chnls_id[i]}${normal} 频道名称: ${green}${chnls_title[i]}${normal}\n${indent_6}高清: ${green}$is_hd${normal} 语言: ${green}${chnls_language[i]}${normal}\n${indent_6}${chnls_description[i]}\n\n"
done

Println "$chnls_list"
exit 0
