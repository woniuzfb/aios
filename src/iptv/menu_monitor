Include src/iptv/monitor_antiddos "$@"
Include src/iptv/monitor_restart "$@"
Include src/iptv/monitor_schedule "$@"
Include src/iptv/monitor_daemon "$@"

MonitorMenu()
{
    [ ! -d "$IPTV_ROOT" ] && Println "$(eval_gettext "\$error 尚未安装, 请先安装 !")" && exit 1
    [ ! -d "${MONITOR_LOG%/*}" ] && MONITOR_LOG="$HOME/monitor.log"

    echo
    monitor_options=( "$i18n_view" "$i18n_open" "$i18n_close" )
    inquirer list_input_index "$i18n_select_action" monitor_options monitor_options_index

    if [ "$monitor_options_index" -eq 0 ]
    then
        MonitorList
    elif [ "$monitor_options_index" -eq 1 ]
    then
        MonitorStart
    else
        MonitorStop
    fi
}
