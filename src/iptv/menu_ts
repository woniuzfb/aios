    ["data","id"],
    ["data","name"],
    ["data","user_agent"],
    ["data","verify_type"],
    ["data","verify_acc_type"],
    ["data","reg_type"],
    ["data","server_version"],
    ["data","unique_url"],
    ["data","access_token_url"],
    ["data","refresh_access_token_url"],
