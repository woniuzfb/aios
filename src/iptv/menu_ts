if [ -z "${jq_data_name:-}" ]
then
    Println "$error 没有找到频道\n"
    exit 1
fi

IFS="${delimiters[2]}" read -ra ts_id <<< "$jq_data_id"
IFS="${delimiters[2]}" read -ra ts_name <<< "$jq_data_name"
