CheckIfXtreamCodes()
{
    XtreamCodesGetDomains

    FFmpegInstall

    to_try=0

    if XtreamPortalParseMacLink "$chnl_stream_link"
    then
        for xc_domain in ${xtream_codes_domains[@]+"${xtream_codes_domains[@]}"}
        do
            if [ "$xc_domain" == "$chnl_domain" ]
            then
                Println "$(eval_gettext "\$info 频道 [ \$chnl_channel_name ] 检测账号中...")"
                XtreamCodesGetChnls
                for xc_chnl_mac in ${xc_chnls_mac[@]+"${xc_chnls_mac[@]}"}
                do
                    if [ "$xc_chnl_mac" == "$chnl_domain/$chnl_mac" ]
                    then
                        to_try=1
                        break
                    fi
                done
                break
            fi
        done

        if [ "$to_try" -eq 1 ]
        then
            to_try=1
            try_success=0
            MonitorTryAccounts

            if [ "$try_success" -eq 0 ]
            then
                Println "$(eval_gettext "\$error 没有可用账号")"
            fi
        else
            GetDefault

            local hs_rc=0
            XtreamPortalHandshake "$chnl_domain" "$chnl_mac" "${chnl_xc_proxy:-}" || hs_rc=$?

            if [ "$hs_rc" -eq 1 ]
            then
                to_try=1
                Println "$error $chnl_domain $chnl_mac"
            elif [ "$hs_rc" -eq 2 ]
            then
                to_try=1

                if [ -z "$profile" ]
                then
                    Println "$error $chnl_mac profile"
                else
                    Println "$error $chnl_mac exp_date"
                fi
            fi

            if [ "$to_try" -eq 1 ]
            then
                to_try=1
                try_success=0
                MonitorTryAccounts

                if [ "$try_success" -eq 0 ]
                then
                    Println "$(eval_gettext "\$error 没有可用账号")"
                fi
            else
                local cl_rc=0
                XtreamPortalCreateLink "$chnl_cmd" "${chnl_xc_proxy:-}" || cl_rc=$?

                if [ "$cl_rc" -eq 1 ]
                then
                    Println "$error $chnl_domain $chnl_mac $chnl_xc_proxy $chnl_stream_link\n" && exit 1
                elif [ "$cl_rc" -eq 2 ]
                then
                    Println "$(eval_gettext "\$error \$chnl_domain 返回 cmd"): ${cmd:-$i18n_none} $chnl_domain $chnl_mac\n" && exit 1
                fi

                chnl_stream_links[0]="$chnl_domain|$chnl_stream_link|$chnl_cmd|$chnl_mac"

                Println "$(eval_gettext "\$info 跳过检测频道 [ \$chnl_channel_name ] 直接开启 ? [y/N]")"
                read -t 3 -p "$(gettext "(默认: 3 秒后自动检测): ")" skip_check_yn || true && echo
                skip_check_yn=${skip_check_yn:-N}

                if [[ $skip_check_yn == [Yy] ]]
                then
                    return 0
                fi

                XtreamPortalProbeAudioVideo $chnl_proxy_command -user_agent "$chnl_user_agent" -headers "$chnl_headers_command" -cookies "$chnl_cookies_command" -i "$chnl_stream_link"

                if [ "$audio" -eq 0 ] || [ "$video" -eq 0 ]
                then
                    to_try=1
                    try_success=0
                    MonitorTryAccounts

                    if [ "$try_success" -eq 0 ]
                    then
                        Println "$(eval_gettext "\$error 没有可用账号")"
                    fi
                fi
            fi
        fi
    elif [[ $chnl_stream_link =~ ^http://([^/]+)/([^/]+)/([^/]+)/ ]]
    then
        chnl_domain=${BASH_REMATCH[1]}

        for xc_domain in ${xtream_codes_domains[@]+"${xtream_codes_domains[@]}"}
        do
            if [ "$xc_domain" == "$chnl_domain" ]
            then
                Println "$(eval_gettext "\$info 频道 [ \$chnl_channel_name ] 检测账号中...")"
                to_try=1
                break
            fi
        done

        xc_chnl_found=0

        if [ "$to_try" -eq 1 ]
        then
            if [ "${BASH_REMATCH[2]}" == "live" ] && [[ $chnl_stream_link =~ ^http://([^/]+)/live/([^/]+)/([^/]+)/ ]]
            then
                chnl_account="${BASH_REMATCH[2]}:${BASH_REMATCH[3]}"
            else
                chnl_account="${BASH_REMATCH[2]}:${BASH_REMATCH[3]}"
            fi
            XtreamCodesGetChnls
            for xc_chnl in ${xc_chnls[@]+"${xc_chnls[@]}"}
            do
                if [ "$xc_chnl" == "$chnl_domain/$chnl_account" ]
                then
                    xc_chnl_found=1
                    break
                fi
            done
        fi

        if [ "$xc_chnl_found" -eq 1 ]
        then
            to_try=1
            try_success=0
            MonitorTryAccounts

            if [ "$try_success" -eq 0 ]
            then
                Println "$(eval_gettext "\$error 没有可用账号")"
            fi
        elif [ "$to_try" -eq 1 ]
        then
            printf -v chnl_headers_command '%b' "$chnl_headers"
            printf -v chnl_cookies_command '%b' "${chnl_cookies//;/; path=\/;\\r\\n}; path=/;"

            XtreamPortalProbeAudioVideo $chnl_proxy_command -user_agent "$chnl_user_agent" -headers "$chnl_headers_command" -cookies "$chnl_cookies_command" -i "$chnl_stream_link"

            if [ "$audio" -eq 0 ] || [ "$video" -eq 0 ]
            then
                try_success=0
                MonitorTryAccounts

                if [ "$try_success" -eq 0 ]
                then
                    Println "$(eval_gettext "\$error 没有可用账号")"
                fi
            else
                to_try=0
            fi
        fi
    fi
}
