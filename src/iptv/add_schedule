AddChannelsSchedule()
{
    echo
    add_options=( "$(gettext "手动添加")" "$(gettext "足球比赛")" )
    inquirer list_input_index "$i18n_select_action" add_options add_options_index

    if [ "$add_options_index" -eq 1 ] 
    then
        echo
        search_options=( "$(gettext "12小时内")" "$(gettext "今天")" "$(gettext "今明两天")" )
        inquirer list_input_index "$(gettext "搜索范围")" search_options search_options_index

        Progress "$(gettext "搜索足球节目表")" &
        progress_pid=$!

        trap '
            kill $progress_pid
            wait $progress_pid 2> /dev/null
        ' EXIT

        SearchSoccerSchedules

        schedules_count=${#schedules_chnl_id[@]}

        for((i=0;i<schedules_count;i++));
        do
            flag=0

            for((j=0;j<schedules_count-i-1;j++));
            do
                if [ "${schedules_start_time[j]}" -gt "${schedules_start_time[j+1]}" ] 
                then
                    temp="${schedules_start_time[j]}"
                    schedules_start_time[j]="${schedules_start_time[j+1]}"
                    schedules_start_time[j+1]="$temp"
                    temp="${schedules_end_time[j]}"
                    schedules_end_time[j]="${schedules_end_time[j+1]}"
                    schedules_end_time[j+1]="$temp"
                    temp="${schedules_chnl_id[j]}"
                    schedules_chnl_id[j]="${schedules_chnl_id[j+1]}"
                    schedules_chnl_id[j+1]="$temp"
                    temp="${schedules_title[j]}"
                    schedules_title[j]="${schedules_title[j+1]}"
                    schedules_title[j+1]="$temp"
                    temp="${schedules_list[j]}"
                    schedules_list[j]="${schedules_list[j+1]}"
                    schedules_list[j+1]="$temp"
                    flag=1
                fi
            done

            if [ "$flag" -eq 0 ] 
            then
                break
            fi
        done

        kill $progress_pid
        wait $progress_pid 2> /dev/null || true
        trap - EXIT
        echo "...100%"

        echo
        inquirer checkbox_input_indices "$(gettext "选择比赛")" schedules_list schedules_indices

        GetChannels
        chnls_indices=("${!chnls_pid[@]}")

        local lbl_schedule lbl_start_date lbl_end_date lbl_daily_loop lbl_auto_remove lbl_anti_leech lbl_anti_leech_once lbl_input_chnl_name
        lbl_schedule=$(gettext "计划")
        lbl_start_date=$(gettext "设置开始日期")
        lbl_end_date=$(gettext "设置结束日期")
        lbl_daily_loop=$(gettext "每日循环")
        lbl_auto_remove=$(gettext "结束后自动清除")
        lbl_anti_leech=$(gettext "防盗链")
        lbl_anti_leech_once=$(gettext "防盗链一次")
        lbl_input_chnl_name=$(gettext "输入频道名称")

        for schedules_index in "${schedules_indices[@]}"
        do
            Println "$info $i18n_add ${schedules_list[schedules_index]} $lbl_schedule"

            schedule_chnl_id="${schedules_chnl_id[schedules_index]}"
            schedule_start_time="${schedules_start_time[schedules_index]}"
            schedule_end_time="${schedules_end_time[schedules_index]}"
            schedule_title="${schedules_title[schedules_index]}"

            for chnls_index in "${chnls_indices[@]}"
            do
                if [ "${chnls_output_dir_name[chnls_index]}" == "$schedule_chnl_id" ]
                then
                    ListChannelSchedules

                    inquirer date_pick "$lbl_start_date" schedule_start_time

                    echo
                    inquirer date_pick "$lbl_end_date" schedule_end_time

                    echo
                    inquirer list_input_index "$lbl_daily_loop" ny_options ny_index

                    if [ "$ny_index" -eq 0 ]
                    then
                        schedule_loop=false

                        echo
                        inquirer list_input_index "$lbl_auto_remove" ny_options ny_index

                        if [ "$ny_index" -eq 0 ]
                        then
                            schedule_auto_remove=false
                        else
                            schedule_auto_remove=true
                        fi
                    else
                        schedule_loop=true
                        schedule_auto_remove=false
                    fi

                    echo
                    inquirer list_input_index "$lbl_anti_leech" yn_options yn_index

                    if [ "$yn_index" -eq 0 ]
                    then
                        schedule_hls_change=true

                        echo
                        inquirer list_input_index "$lbl_anti_leech_once" ny_options yn_index

                        if [ "$yn_index" -eq 0 ]
                        then
                            schedule_hls_change_once=false
                        else
                            schedule_hls_change_once=true
                        fi
                    else
                        schedule_hls_change=false
                        schedule_hls_change_once=false
                    fi

                    echo
                    inquirer text_input "$lbl_input_chnl_name" schedule_channel_name "$schedule_title"

                    chnl_schedule=$(
                        $JQ_FILE -n --arg start_time "$schedule_start_time" \
                            --arg end_time "$schedule_end_time" \
                            --arg loop "$schedule_loop" \
                            --arg auto_remove "$schedule_auto_remove" \
                            --arg hls_change "$schedule_hls_change" \
                            --arg hls_change_once "$schedule_hls_change_once" \
                            --arg channel_name "$schedule_channel_name" \
                            --arg status 0 \
                        '{
                            start_time: $start_time | tonumber,
                            end_time: $end_time | tonumber,
                            loop: $loop | test("true"),
                            auto_remove: $auto_remove | test("true"),
                            hls_change: $hls_change | test("true"),
                            hls_change_once: $hls_change_once | test("true"),
                            channel_name: $channel_name,
                            status: $status | tonumber
                        }'
                    )

                    jq_path='["channels",'"$chnls_index"',"schedule"]'
                    JQ add "$CHANNELS_FILE" "[$chnl_schedule]"

                    Println "$(eval_gettext "\$info 频道 [ \$schedule_channel_name ] 计划添加成功")\n"

                    continue 2
                fi
            done

            Println "$(eval_gettext "\$error 未找到输出目录为 [ \$schedule_chnl_id ] 的频道, 请添加频道")"
        done

        return 0
    fi

    ListChannels
    InputChannelsIndex

    local lbl_start_date lbl_end_date lbl_daily_loop lbl_auto_remove lbl_anti_leech lbl_anti_leech_once lbl_input_chnl_name lbl_channel lbl_sched_added lbl_continue_add
    lbl_start_date=$(gettext "设置开始日期")
    lbl_end_date=$(gettext "设置结束日期")
    lbl_daily_loop=$(gettext "每日循环")
    lbl_auto_remove=$(gettext "结束后自动清除")
    lbl_anti_leech=$(gettext "防盗链")
    lbl_anti_leech_once=$(gettext "防盗链一次")
    lbl_input_chnl_name=$(gettext "输入频道名称")
    lbl_channel=$(gettext "频道")
    lbl_sched_added=$(gettext "计划添加成功")
    lbl_continue_add=$(gettext "是否继续添加此频道计划")

    for chnls_index in "${chnls_indices[@]}"
    do
        ListChannelSchedules

        while true
        do
            inquirer date_pick "$lbl_start_date" schedule_start_time

            echo
            inquirer date_pick "$lbl_end_date" schedule_end_time

            echo
            inquirer list_input_index "$lbl_daily_loop" ny_options ny_index

            if [ "$ny_index" -eq 0 ]
            then
                schedule_loop=false

                echo
                inquirer list_input_index "$lbl_auto_remove" ny_options ny_index

                if [ "$ny_index" -eq 0 ]
                then
                    schedule_auto_remove=false
                else
                    schedule_auto_remove=true
                fi
            else
                schedule_loop=true
                schedule_auto_remove=false
            fi

            echo
            inquirer list_input_index "$lbl_anti_leech" yn_options yn_index

            if [ "$yn_index" -eq 0 ]
            then
                schedule_hls_change=true

                echo
                inquirer list_input_index "$lbl_anti_leech_once" ny_options yn_index

                if [ "$yn_index" -eq 0 ]
                then
                    schedule_hls_change_once=false
                else
                    schedule_hls_change_once=true
                fi
            else
                schedule_hls_change=false
                schedule_hls_change_once=false
            fi

            echo
            inquirer text_input "$lbl_input_chnl_name" schedule_channel_name "$i18n_blank"

            chnl_schedule=$(
                $JQ_FILE -n --arg start_time "$schedule_start_time" \
                    --arg end_time "$schedule_end_time" \
                    --arg loop "$schedule_loop" \
                    --arg auto_remove "$schedule_auto_remove" \
                    --arg hls_change "$schedule_hls_change" \
                    --arg hls_change_once "$schedule_hls_change_once" \
                    --arg channel_name "$schedule_channel_name" \
                    --arg status 0 \
                '{
                    start_time: $start_time | tonumber,
                    end_time: $end_time | tonumber,
                    loop: $loop | test("true"),
                    auto_remove: $auto_remove | test("true"),
                    hls_change: $hls_change | test("true"),
                    hls_change_once: $hls_change_once | test("true"),
                    channel_name: $channel_name,
                    status: $status | tonumber
                }'
            )

            jq_path='["channels",'"$chnls_index"',"schedule"]'
            JQ add "$CHANNELS_FILE" "[$chnl_schedule]"

            Println "$info $lbl_channel [ ${schedule_channel_name:-${chnls_channel_name[chnls_index]}} ] $lbl_sched_added\n"

            echo
            inquirer list_input_index "$lbl_continue_add" ny_options ny_index

            if [ "$ny_index" -eq 0 ]
            then
                break
            fi

            echo
        done
    done

    echo
}
