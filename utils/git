GitInstall()
{
    if [[ -x $(command -v git) ]] 
    then
        return 0
    fi

    Println "$info 安装 git"

    case $dist in
        mac) brew install git
        ;;
        rpm) yum -y install git
        ;;
        deb) AptInstall git
        ;;
        ubu) 
            add-apt-repository ppa:git-core/ppa -y
            apt-get -y update
            AptInstall git
        ;;
    esac

    Println "$info git 安装成功\n"
}
