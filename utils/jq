JQInstall()
{
    if [[ -x "$JQ_FILE" ]]
    then
        return
    elif [[ -x "$IPTV_ROOT"/jq ]]
    then
        JQ_FILE="$IPTV_ROOT"/jq
        return
    fi

    DepsCheck
    ArchCheck

    if [ "$dist" == "mac" ]
    then
        DepInstall jq check
        return 0
    elif grep -q "arm" <<< "$arch"
    then
        if ! /usr/local/bin/jq -V > /dev/null 2>&1
        then
            Println "`eval_gettext \"\\\$info 开始下载/安装 JQ...\"`"
            cd ~
            git clone https://github.com/stedolan/jq.git > /dev/null
            cd jq
            apt-get -y install flex bison libtool make automake autoconf > /dev/null
            git submodule update --init > /dev/null
            autoreconf -fi > /dev/null
            ./configure --with-oniguruma=builtin > /dev/null
            nproc="-j$(nproc 2> /dev/null)" || nproc=""
            make $nproc > /dev/null
            make install > /dev/null
        fi
        if [ "$JQ_FILE" != "/usr/local/bin/jq" ]
        then
            rm -f "$JQ_FILE"
            ln -sf /usr/local/bin/jq "$JQ_FILE"
        fi
        Println "`eval_gettext \"\\\$info JQ 安装完成\"`"
    else
        Println "`eval_gettext \"\\\$info 开始下载/安装 JQ...\"`"
        #experimental# grep -Po '"tag_name": "jq-\K.*?(?=")'
        if ! jq_ver=$(curl -s -m 10 "$FFMPEG_MIRROR_LINK/jq.json" |  grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
        then
            Println "`eval_gettext \"\\\$error 暂时无法连接服务器, 请稍后再试 !\"`"
            exit 1
        fi
        if grep -q 64 <<< "$arch"
        then
            jq_package="jq-linux64"
        else
            jq_package="jq-linux32"
        fi
        if curl -L "$FFMPEG_MIRROR_LINK/$jq_ver/$jq_package" -o "$JQ_FILE"
        then
            chmod +x "$JQ_FILE"
            Println "`eval_gettext \"\\\$info JQ 安装完成\"`"
        else
            rm -f "$JQ_FILE"
            Println "`eval_gettext \"\\\$error 下载 JQ 失败, 请重试 !\"`"
            exit 1
        fi
    fi
}

JQ()
{
    local jq_action=$1 FILE=$2 TMP_FILE jq_args=() jq_commands=() slurp_arg
    local jq_a3=${3:-none} jq_a4=${4:-none} jq_a5=${5:-none}

    jq_path=${jq_path:-}
    jq_path2=${jq_path2:-}

    jq_map_bool=${jq_map_bool:-false}
    jq_map_string=${jq_map_string:-false}
    jq_merge=${jq_merge:-false}
    jq_json=${jq_json:-false}
    jq_number=${jq_number:-false}
    jq_bool=${jq_bool:-false}
    jq_pre=${jq_pre:-false}
    jq_file=${jq_file:-false}
    jq_file_json=${jq_file_json:-false}

    local jq_rc=0
    if TMP_FILE=$(mktemp -q)
    then
        chmod +r "$TMP_FILE"
    else
        printf -v TMP_FILE "${FILE}_%s" "$$"
    fi

    if [ -n "$jq_path" ]
    then
        jq_args+=( --argjson path "$jq_path" )
    fi

    if [ -n "$jq_path2" ]
    then
        jq_args+=( --argjson path2 "$jq_path2" )
    fi

    case $jq_action in
        add)
            local add_op
            if [ "$jq_pre" = true ]
            then
                add_op='(if type == "array" then ($add + .) else $add end)'
            else
                add_op='(if type == "array" then (. + $add) else $add end)'
            fi

            if [ -n "${4:-}" ]
            then
                local match_val
                if [ "$jq_map_bool" = true ]
                then
                    match_val='($value|test("true"))'
                elif [ "$jq_map_string" = true ]
                then
                    match_val='$value'
                else
                    match_val='($value|tonumber)'
                fi

                local map_body
                if [ -n "$jq_path2" ]
                then
                    map_body='(select(type == "object" and .[$key] == '"$match_val"') | getpath($path2)) |= '"$add_op"
                else
                    map_body='select(type == "object" and .[$key] == '"$match_val"') |= '"$add_op"
                fi

                if [ -n "$jq_path" ]
                then
                    jq_commands=( 'getpath($path) |= (if type == "array" then map('"$map_body"') else [] end)' )
                else
                    jq_commands=( 'if type == "array" then map('"$map_body"') else [] end' )
                fi

                jq_args+=( --arg key "$3" --arg value "$4" )

                if [ "$jq_file" = true ]
                then
                    slurp_arg=("$5"[@])
                else
                    jq_args+=( --argjson add "$5" )
                fi
            else
                if [ -n "$jq_path" ]
                then
                    jq_commands=( 'getpath($path) |= '"$add_op" )
                else
                    jq_commands=( "$add_op" )
                fi

                if [ "$jq_file" = true ]
                then
                    slurp_arg=("$3"[@])
                else
                    jq_args+=( --argjson add "$3" )
                fi
            fi

            if [ "$jq_file" = true ]
            then
                jq_args+=( --slurpfile add "${TMP_FILE}_slurp" )

                if [[ -z ${!slurp_arg:-} ]]
                then
                    printf '%s' "" > "${TMP_FILE}_slurp"
                elif [ "$jq_file_json" = true ]
                then
                    printf '%s\n' "${!slurp_arg//\\\\/\\}" > "${TMP_FILE}_slurp"
                else
                    printf '"%s"\n' "${!slurp_arg//\"/\\\"}" > "${TMP_FILE}_slurp"
                fi
            fi
        ;;
        update)
            local upd_op
            if [ "$jq_merge" = true ]
            then
                upd_op='|= (if type == "object" then (. * $update) else $update end)'
            elif [ "$jq_number" = true ]
            then
                upd_op='= ($update | tonumber)'
            elif [ "$jq_bool" = true ]
            then
                upd_op='= ($update | test("true"))'
            else
                upd_op='= $update'
            fi

            if [ -n "${4:-}" ]
            then
                local match_val
                if [ "$jq_map_bool" = true ]
                then
                    match_val='($value|test("true"))'
                elif [ "$jq_map_string" = true ]
                then
                    match_val='$value'
                else
                    match_val='($value|tonumber)'
                fi

                local map_body
                if [ -n "$jq_path2" ]
                then
                    map_body='(select(type == "object" and .[$key] == '"$match_val"') | getpath($path2)) '"$upd_op"
                else
                    map_body='select(type == "object" and .[$key] == '"$match_val"') '"$upd_op"
                fi

                if [ -n "$jq_path" ]
                then
                    jq_commands=( 'getpath($path) |= (if type == "array" then map('"$map_body"') else . end)' )
                else
                    jq_commands=( 'if type == "array" then map('"$map_body"') else . end' )
                fi

                jq_args+=( --arg key "$3" --arg value "$4" )

                if [ "$jq_file" = true ]
                then
                    slurp_arg=("$5"[@])
                elif [ "$jq_json" = true ] || [ "$jq_merge" = true ]
                then
                    jq_args+=( --argjson update "$5" )
                else
                    jq_args+=( --arg update "$5" )
                fi
            else
                if [ -n "$jq_path" ]
                then
                    jq_commands=( 'getpath($path) '"$upd_op" )
                else
                    if [ "$jq_merge" = true ]
                    then
                        jq_commands=( 'if type == "object" then (. * $update) else $update end' )
                    elif [ "$jq_number" = true ]
                    then
                        jq_commands=( '($update | tonumber)' )
                    elif [ "$jq_bool" = true ]
                    then
                        jq_commands=( '($update | test("true"))' )
                    else
                        jq_commands=( '$update' )
                    fi
                fi

                if [ "$jq_file" = true ]
                then
                    slurp_arg=("$3"[@])
                elif [ "$jq_json" = true ] || [ "$jq_merge" = true ]
                then
                    jq_args+=( --argjson update "$3" )
                else
                    jq_args+=( --arg update "$3" )
                fi
            fi

            if [ "$jq_file" = true ]
            then
                jq_args+=( --slurpfile update "${TMP_FILE}_slurp" )

                if [[ -z ${!slurp_arg:-} ]]
                then
                    printf '%s' "" > "${TMP_FILE}_slurp"
                elif [ "$jq_file_json" = true ]
                then
                    printf '%s\n' "${!slurp_arg//\\\\/\\}" > "${TMP_FILE}_slurp"
                else
                    printf '"%s"\n' "${!slurp_arg//\"/\\\"}" > "${TMP_FILE}_slurp"
                fi
            fi
        ;;
        delete)
            if [ -n "${3:-}" ]
            then
                local match_val
                if [ "$jq_map_bool" = true ]
                then
                    match_val='($value|test("true"))'
                elif [ "$jq_map_string" = true ]
                then
                    match_val='$value'
                else
                    match_val='($value|tonumber)'
                fi

                jq_args+=( --arg key "$3" --arg value "$4" )

                if [ -z "${5:-}" ]
                then
                    local del_sel
                    if [ -n "$jq_path2" ]
                    then
                        del_sel='(select(type == "object" and .[$key] == '"$match_val"') | getpath($path2))'
                    else
                        del_sel='select(type == "object" and .[$key] == '"$match_val"')'
                    fi

                    if [ -n "$jq_path" ]
                    then
                        jq_commands=( 'if (getpath($path) | type) == "array" then del(getpath($path)[] | '"$del_sel"') else . end' )
                    else
                        jq_commands=( 'if type == "array" then del(.[] | '"$del_sel"') else . end' )
                    fi
                else
                    jq_args+=( --argjson delete "$5" )
                    local del_op='(if type == "array" then (. - $delete) else . end)'
                    local map_body
                    if [ -n "$jq_path2" ]
                    then
                        map_body='(select(type == "object" and .[$key] == '"$match_val"') | getpath($path2)) |= '"$del_op"
                    else
                        map_body='select(type == "object" and .[$key] == '"$match_val"') |= '"$del_op"
                    fi

                    if [ -n "$jq_path" ]
                    then
                        jq_commands=( 'getpath($path) |= (if type == "array" then map('"$map_body"') else . end)' )
                    else
                        jq_commands=( 'if type == "array" then map('"$map_body"') else . end' )
                    fi
                fi
            elif [ -n "$jq_path" ]
            then
                jq_commands+=( 'del(getpath($path))' )
            else
                rm -f "$TMP_FILE" "${TMP_FILE}_slurp"
                return 1
            fi
        ;;
        mutate)
            jq_commands=( "$3" )
            shift 3
            jq_args+=( "$@" )
        ;;
    esac

    if command -v flock > /dev/null 2>&1
    then
        {
            flock -x 200 || { LogErr "`eval_gettext \"\\\$FILE JQ fd 200 失败\"`"; exit 1; }

            if ! $JQ_FILE "${jq_args[@]}" "${jq_commands[*]}" "$FILE" > "$TMP_FILE" || [ ! -s "$TMP_FILE" ]
            then
                rm -f "$TMP_FILE"
                LogInfo "JQ ERROR!! action: $jq_action, file: $FILE, tmp_file: $TMP_FILE, \$3: $jq_a3, \$4: $jq_a4, \$5: $jq_a5"
                jq_rc=1
            else
                mv "$TMP_FILE" "$FILE"
            fi

            rm -f "${TMP_FILE}_slurp"
        } 200>"$FILE.lock"
    else
        if ! $JQ_FILE "${jq_args[@]}" "${jq_commands[*]}" "$FILE" > "$TMP_FILE" || [ ! -s "$TMP_FILE" ]
        then
            rm -f "$TMP_FILE"
            LogInfo "JQ ERROR!! action: $jq_action, file: $FILE, tmp_file: $TMP_FILE, \$3: $jq_a3, \$4: $jq_a4, \$5: $jq_a5"
            jq_rc=1
        else
            mv "$TMP_FILE" "$FILE"
        fi

        rm -f "${TMP_FILE}_slurp"
    fi

    jq_path=""
    jq_path2=""

    jq_map_bool=false
    jq_map_string=false
    jq_merge=false
    jq_json=false
    jq_number=false
    jq_bool=false
    jq_pre=false
    jq_file=false
    jq_file_json=false

    return $jq_rc
}

JQs()
{
    case $1 in
        "get")
            $JQ_FILE -c -r --argjson path "$jq_path" 'getpath($path)|'"${3:-.}"'' <<< "${!2}"
            jq_path=""
        ;;
        "gets")
            local jq_gets_in="${!2:-}"
            [ -z "$jq_gets_in" ] && jq_gets_in="{}"
            $JQ_FILE -c -r --argjson paths "$jq_path" '
                . as $root
                | $paths[] as $p
                | (
                    reduce $p[] as $k ($root;
                        if type == "object" and ($k | type) == "string" then .[$k]
                        elif type == "array" and ($k | type) == "number" then .[$k]
                        else null
                        end
                    )
                  ) as $v
                | "jq_\($p | join("_")): \(
                    if ($v | type) == "string" or ($v | type) == "number" or ($v | type) == "boolean" then
                        ($v | tostring)
                    else
                        ""
                    end
                )"
            ' <<< "$jq_gets_in"
            jq_path=""
        ;;
        "add")
            if [ "${4:-}" == "pre" ]
            then
                read -r $2 < <($JQ_FILE -c --argjson path "${jq_path:-[]}" --argjson value "$3" 'getpath($path) |= $value + .' <<< "${!2}")
            else
                read -r $2 < <($JQ_FILE -c --argjson path "${jq_path:-[]}" --argjson value "$3" 'getpath($path) += $value' <<< "${!2}")
            fi
            jq_path=""
        ;;
        "update")
            if [ "${4:-}" == "number" ]
            then
                read -r $2 < <($JQ_FILE -c --argjson path "$jq_path" --arg value "$3" 'getpath($path) = ($value | tonumber)' <<< "${!2}")
            else
                read -r $2 < <($JQ_FILE -c --argjson path "$jq_path" --arg value "$3" 'getpath($path) = $value' <<< "${!2}")
            fi
            jq_path=""
        ;;
        "replace")
            read -r $2 < <($JQ_FILE -c --argjson path "$jq_path" --argjson value "$3" 'getpath($path) = $value' <<< "${!2}")
            jq_path=""
        ;;
        "delete")
            if [ -z "${3:-}" ]
            then
                read -r $2 < <($JQ_FILE -c --argjson path "$jq_path" 'del(getpath($path))' <<< "${!2}")
            else
                read -r $2 < <($JQ_FILE -c --argjson path "$jq_path" --arg index "$3" 'del(getpath($path)[$index|tonumber])' <<< "${!2}")
            fi
            jq_path=""
        ;;
        "merge")
            read -r $2 < <($JQ_FILE -c -s '
            def merge(a;b):
                reduce b[] as $item (a;
                reduce ($item | keys_unsorted[]) as $key (.;
                $item[$key] as $val | ($val | type) as $type | .[$key] = if ($type == "object") then
                    merge({}; [if .[$key] == null then {} else .[$key] end, $val])
                elif ($type == "array") then
                    (.[$key] + $val | unique)
                else
                    $val
                end)
                );
            merge({}; .)' <<< "${!2} $3")
        ;;
        "merge_c")
            local var=$2
            shift 2
            read -r $var < <($JQ_FILE -c "$@" <<< "${!var}")
        ;;
        "query")
            local src=$2
            local expr=$3
            shift 3
            if [[ $src =~ ^/ ]]
            then
                [ -s "$src" ] || return 0
                $JQ_FILE -r "$@" "$expr" "$src"
            else
                [ -n "${!src:-}" ] || return 0
                $JQ_FILE -r "$@" "$expr" <<< "${!src}"
            fi
        ;;
        "build")
            local out_var=$2
            local expr=$3
            shift 3
            read -r $out_var < <($JQ_FILE -n -c "$@" '
                def compact_obj:
                    if type == "object" then
                        with_entries(
                            .value |= compact_obj
                            | select(.value != null and .value != "" and .value != [] and .value != {})
                        )
                    elif type == "array" then
                        map(compact_obj) | map(select(. != null and . != "" and . != [] and . != {}))
                    else
                        .
                    end;
                ('"$expr"') | compact_obj
            ')
        ;;
        "flat")
            local jq_src="$2"
            local jq_is_file=false
            if [[ $jq_src =~ ^/ ]]
            then
                if [ ! -s "$jq_src" ]
                then
                    printf '{}\n'
                    return 0
                fi
                jq_is_file=true
            elif [ -z "$jq_src" ]
            then
                printf '{}\n'
                return 0
            fi

            local pre="${3:-.} | if type == \"null\" or . == \"\" then {} else . end"

            if [ $# -ge 3 ]
            then
                shift 3
            else
                shift 2
            fi

            local jq_flat_prog='
            def structural_merge:
                type as $type
                | if $type == "object" then
                    with_entries(.value |= structural_merge)
                elif $type == "array" then
                    if length == 0 then []
                    elif ([ .[] | select(. != null) | type == "object" ] | unique | length == 2) then
                        .
                    elif (map(type == "object") | any) then
                        ( [ .[] | select(type == "object") | keys[] ] | unique ) as $all_keys
                        | map(. as $obj
                        | if $obj == null or type != "object" then
                            $all_keys | map({key: ., value: null}) | from_entries
                        else
                            $all_keys | map({key: ., value: $obj[.]}) | from_entries
                        end)
                        | [ .[] | to_entries[] ]
                        | group_by(.key)
                        | map({
                            key: .[0].key,
                            value: (map(.value) | structural_merge)
                        })
                        | from_entries
                    else
                        map(structural_merge)
                        | if ([ .[] | select(. != null) | type == "object" ] | any) then structural_merge else . end
                    end
                else
                    .
                end;

            def finalize_strings($layer):
                type as $type
                | if $type == "object" then
                    with_entries(.value |= finalize_strings($layer + 1))
                elif $type == "array" then
                    if length == 0 then ""
                    else
                        map(
                            (if type == "array" then
                                finalize_strings($layer + 1)
                            elif type == "null" or . == "" then
                                ""
                            else
                                tostring
                            end) + ($delims[$layer] // "|")
                        )
                        | join("")
                    end
                elif $type == "null" or . == "" then
                    ""
                else
                    tostring
                end;

            '"$pre"' | structural_merge | finalize_strings(0)'

            if [ "$jq_is_file" = true ]
            then
                $JQ_FILE --argjson delims "$json_delimiters" -r -c "$@" "$jq_flat_prog" "$jq_src"
            else
                $JQ_FILE --argjson delims "$json_delimiters" -r -c "$@" "$jq_flat_prog" <<< "$jq_src"
            fi
        ;;
    esac
}
