DistCheck()
{
    [ -n "${dist:-}" ] && return 0

    local dist_files=( /etc/issue /etc/os-release /proc/version ) dist_file
    dist=""

    for dist_file in "${dist_files[@]}"
    do
        if [ ! -s "$dist_file" ]
        then
            continue
        fi

        if grep -qi "Ubuntu" < "$dist_file"
        then
            dist="ubu"
            break
        elif grep -qi "Debian" < "$dist_file"
        then
            dist="deb"
            break
        elif grep -Eqi "Red Hat|redhat|rhel|CentOS|Fedora|Amazon" < "$dist_file"
        then
            dist="rpm"
            break
        fi
    done

    if [ -z "$dist" ]
    then
        if [[ $OSTYPE =~ darwin ]] || [[ $(uname | tr '[:upper:]' '[:lower:]') =~ darwin ]]
        then
            dist="mac"
        else
            Println "${red}[ERROR]${normal} not support yet...\n"
            return 1
        fi
    fi
}

ArchCheck()
{
    [ -n "${arch:-}" ] && return 0

    arch=$(uname -m)

    if grep -Eqi "x86_64|amd64" <<< "$arch"
    then
        arch="x86_64"
    elif grep -Eqi "i386|i686|x86" <<< "$arch"
    then
        arch="i386"
    elif grep -Eqi "aarch64|armv8|arm64" <<< "$arch"
    then
        arch="arm64"
    elif grep -qi "armv7" <<< "$arch"
    then
        arch="armhf"
    elif grep -qi "armv6" <<< "$arch"
    then
        arch="armv6l"
    elif grep -qi "arm" <<< "$arch"
    then
        arch="armel"
    elif grep -qi "s390" <<< "$arch"
    then
        arch="s390x"
    fi
}

DebFixSources()
{
    if [ "${deb_fix:-1}" -eq 1 ]
    then
        sed -i 's/^mozilla\/DST_Root_CA_X3.crt/!mozilla\/DST_Root_CA_X3.crt/g' /etc/ca-certificates.conf
        update-ca-certificates -f >/dev/null 2>&1 || true

        if [ -f /etc/apt/sources.list.d/sources-aliyun-0.list ]
        then
            deb_list=$(< /etc/apt/sources.list.d/sources-aliyun-0.list)
            rm -f /etc/apt/sources.list.d/sources-aliyun-0.list
            rm -rf /var/lib/apt/lists/*
        else
            deb_list=$(< /etc/apt/sources.list)
        fi

        if grep -q "jessie" <<< "$deb_list"
        then
cat > /etc/apt/sources.list <<EOF
deb http://archive.debian.org/debian/ jessie main
deb-src http://archive.debian.org/debian/ jessie main

deb http://security.debian.org jessie/updates main
deb-src http://security.debian.org jessie/updates main
EOF
            apt-get clean >/dev/null 2>&1
        elif grep -q "wheezy" <<< "$deb_list"
        then
cat > /etc/apt/sources.list <<EOF
deb http://archive.debian.org/debian/ wheezy main
deb-src http://archive.debian.org/debian/ wheezy main

deb http://security.debian.org wheezy/updates main
deb-src http://security.debian.org wheezy/updates main
EOF
            apt-get clean >/dev/null 2>&1
        fi

        deb_fix=0
        sed -i '/deb_fix=/d' "$i18n_FILE"
        printf "deb_fix=%s" "$deb_fix" >> "$i18n_FILE"
    fi
}

AptFixBrokenRepos()
{
    local err_file="$1"
    local sources_dir="${APT_SOURCES_DIR:-/etc/apt/sources.list.d}"
    local sources_file="${APT_SOURCES_FILE:-/etc/apt/sources.list}"
    local broken_urls=()
    local line url

    while IFS= read -r line
    do
        if [[ $line =~ The\ repository\ \'([^[:space:]\']+)[[:space:]]+[^\']*\'\ (no\ longer\ has\ a\ Release\ file|does\ not\ have\ a\ Release\ file|is\ not\ signed) ]]
        then
            url="${BASH_REMATCH[1]}"

            if ! EleInArray "$url" broken_urls
            then
                broken_urls+=("$url")
            fi
        elif [[ $line =~ 仓库[[:space:]]*[“\"\'‘]([^[:space:]”\"\'’]+)[[:space:]]+[^”\"\'’]*[”\"\'’].*(Release|没有数字签名) ]]
        then
            url="${BASH_REMATCH[1]}"

            if ! EleInArray "$url" broken_urls
            then
                broken_urls+=("$url")
            fi
        elif [[ $line =~ GPG\ error:[[:space:]]+(https?://[^[:space:]]+) ]]
        then
            url="${BASH_REMATCH[1]}"

            if ! EleInArray "$url" broken_urls
            then
                broken_urls+=("$url")
            fi
        elif [[ $line =~ ^(Err|错误):[0-9]+[[:space:]]+(https?://[^[:space:]]+) ]]
        then
            url="${BASH_REMATCH[2]}"

            if grep -Eq "404|EXPKEYSIG|NO_PUBKEY|signatures were invalid|not signed" "$err_file" && ! EleInArray "$url" broken_urls
            then
                broken_urls+=("$url")
            fi
        fi
    done < "$err_file"

    if [ "${#broken_urls[@]}" -eq 0 ]
    then
        return 1
    fi

    local action_types=()
    local action_files=()
    local action_urls=()
    local action_descs=()
    local list_file

    for url in "${broken_urls[@]}"
    do
        if [ -d "$sources_dir" ]
        then
            for list_file in "$sources_dir"/*.list "$sources_dir"/*.sources
            do
                if [ ! -f "$list_file" ]
                then
                    continue
                fi

                if grep -Fq -- "$url" "$list_file"
                then
                    if [[ $url == *apt.postgresql.org/pub/repos/apt* ]] && ! grep -Fq "apt-archive.postgresql.org" "$list_file"
                    then
                        action_types+=("pg_archive")
                        action_files+=("$list_file")
                        action_urls+=("$url")
                        action_descs+=("$(eval_gettext "切换 PostgreSQL 归档源: \$list_file (apt.postgresql.org -> apt-archive.postgresql.org)")")
                    else
                        action_types+=("disable_file")
                        action_files+=("$list_file")
                        action_urls+=("$url")
                        action_descs+=("$(eval_gettext "禁用失效源: \$list_file -> \${list_file}.disabled (\$url)")")
                    fi
                fi
            done
        fi

        if [ -f "$sources_file" ] && grep -Fq -- "$url" "$sources_file"
        then
            action_types+=("comment_line")
            action_files+=("$sources_file")
            action_urls+=("$url")
            action_descs+=("$(eval_gettext "在 \$sources_file 中注释失效源: \$url")")
        fi
    done

    if [ "${#action_types[@]}" -eq 0 ]
    then
        return 1
    fi

    Println "\n$(eval_gettext "\$tip 检测到以下失效 APT 软件源导致 apt-get update 失败:")"

    local idx
    for((idx=0;idx<${#action_descs[@]};idx++));
    do
        Println "  $((idx + 1)). ${yellow}${action_descs[idx]}${normal}"
    done

    if [ "${APT_AUTO_FIX:-false}" != true ]
    then
        if [ -t 0 ]
        then
            local fix_opts=( "$(gettext "否")" "$(gettext "是")" )
            local fix_idx=0
            echo
            inquirer list_input_index "$(gettext "是否允许按上述方案修改 APT 软件源并重试?")" fix_opts fix_idx

            if [ "$fix_idx" -ne 1 ]
            then
                Println "$(eval_gettext "\$info 已取消修改 APT 软件源, 请手动处理后重试")\n"
                return 1
            fi
        else
            Println "$(eval_gettext "\$info 非交互模式不会自动修改 APT 软件源, 请手动处理上述失效源后重试")\n"
            return 1
        fi
    fi

    local act_type act_file act_url tmp_f
    for((idx=0;idx<${#action_types[@]};idx++));
    do
        act_type="${action_types[idx]}"
        act_file="${action_files[idx]}"
        act_url="${action_urls[idx]}"

        case "$act_type" in
            pg_archive)
                tmp_f=$(mktemp "${TMPDIR:-/tmp}/aios-apt.XXXXXX")
                sed 's|apt\.postgresql\.org/pub/repos/apt|apt-archive.postgresql.org/pub/repos/apt|g' "$act_file" > "$tmp_f"
                mv "$tmp_f" "$act_file"
                Println "$(eval_gettext "\$info 已切换至 apt-archive.postgresql.org: \${green}\$act_file\${normal}")"
            ;;
            disable_file)
                mv "$act_file" "${act_file}.disabled"
                Println "$(eval_gettext "\$info 已禁用失效源: \${yellow}\${act_file} -> \${act_file}.disabled\${normal}")"
            ;;
            comment_line)
                tmp_f=$(mktemp "${TMPDIR:-/tmp}/aios-apt.XXXXXX")
                awk -v u="$act_url" '
                    index($0, u) > 0 && $0 !~ /^[[:space:]]*#/ { print "# [AIOS disabled broken repo] " $0; next }
                    { print }
                ' "$act_file" > "$tmp_f"
                mv "$tmp_f" "$act_file"
                Println "$(eval_gettext "\$info 已在 \$act_file 中注释失效源: \${yellow}\$act_url\${normal}")"
            ;;
        esac
    done

    return 0
}

AptGetCodename()
{
    local os_release="${OS_RELEASE_FILE:-/etc/os-release}"
    local sources_file="${APT_SOURCES_FILE:-/etc/apt/sources.list}"
    local codename="" id="" id_like="" ubu_code="" deb_code="" ver_code=""

    if [ -r "$os_release" ]
    then
        id=$(sed -nE 's/^ID="?([^"[:space:]]+)"?/\1/p' "$os_release" | head -n 1)
        id_like=$(sed -nE 's/^ID_LIKE="?([^"]+)"?/\1/p' "$os_release" | head -n 1)
        ubu_code=$(sed -nE 's/^UBUNTU_CODENAME="?([^"[:space:]]+)"?/\1/p' "$os_release" | head -n 1)
        deb_code=$(sed -nE 's/^DEBIAN_CODENAME="?([^"[:space:]]+)"?/\1/p' "$os_release" | head -n 1)
        ver_code=$(sed -nE 's/^VERSION_CODENAME="?([^"[:space:]]+)"?/\1/p' "$os_release" | head -n 1)

        if [ "$id" == "ubuntu" ] || [[ " $id_like " == *" ubuntu "* ]] || [ -n "$ubu_code" ]
        then
            codename="${ubu_code:-$ver_code}"
        elif [ "$id" == "debian" ] || [[ " $id_like " == *" debian "* ]] || [ -n "$deb_code" ]
        then
            codename="${deb_code:-$ver_code}"
        else
            codename="${ver_code:-${ubu_code:-$deb_code}}"
        fi
    fi

    if [ -z "$codename" ] && [[ -x $(command -v lsb_release) ]]
    then
        codename=$(lsb_release -cs 2> /dev/null || true)
    fi

    if [ -z "$codename" ] && [ -r "$sources_file" ]
    then
        codename=$(awk '
            /^[[:space:]]*deb[[:space:]]/ {
                for (i = 2; i <= NF; i++) {
                    if ($i ~ /^\[/) {
                        while (i <= NF && $i !~ /\]$/) i++
                        continue
                    }
                    if ($i ~ /^https?:\/\//) {
                        if (i + 1 <= NF) {
                            suite = $(i + 1)
                            sub(/-(updates|backports|security)$/, "", suite)
                            if (suite !~ /\//) {
                                print suite
                                exit
                            }
                        }
                    }
                }
            }
        ' "$sources_file")
    fi

    printf '%s\n' "$codename"
}

AptRepoCheck()
{
    local repo_url="${1%/}"
    local suite="${2:-}"

    if [ -z "$repo_url" ] || [ -z "$suite" ]
    then
        return 1
    fi

    if curl -fsI -m 10 "${repo_url}/dists/${suite}/InRelease" > /dev/null 2>&1
    then
        return 0
    fi

    if curl -fsI -m 10 "${repo_url}/dists/${suite}/Release" > /dev/null 2>&1
    then
        return 0
    fi

    return 1
}

AptUpdate()
{
    local force="${1:-}"

    if [ "$force" != "force" ] && [ "${apt_updated:-false}" = true ]
    then
        return 0
    fi

    Println "$(eval_gettext "\$info 更新软件包列表...")"

    local apt_err_file attempt=0 max_attempts=3 rc=0
    apt_err_file=$(mktemp "${TMPDIR:-/tmp}/aios-apt-update.XXXXXX")

    while [ "$attempt" -lt "$max_attempts" ]
    do
        attempt=$((attempt + 1))
        rc=0

        if [ "$force" == "force" ]
        then
            LC_ALL=C apt-get update --allow-releaseinfo-change -o Acquire::http::No-Cache=true -o Acquire::BrokenProxy=true > "$apt_err_file" 2>&1 || rc=$?
        else
            LC_ALL=C apt-get update --allow-releaseinfo-change > "$apt_err_file" 2>&1 || rc=$?
        fi

        if [ "$rc" -eq 0 ]
        then
            rm -f "$apt_err_file"
            apt_updated=true
            return 0
        fi

        if [ "$attempt" -lt "$max_attempts" ] && AptFixBrokenRepos "$apt_err_file"
        then
            continue
        fi

        break
    done

    Println "$(eval_gettext "\$error apt-get update 失败:")\n$(cat "$apt_err_file")\n"
    rm -f "$apt_err_file"
    return "$rc"
}

AptInstall()
{
    if [ $# -eq 0 ]
    then
        return 0
    fi

    AptUpdate || return 1

    local inst_err rc=0
    inst_err=$(mktemp "${TMPDIR:-/tmp}/aios-apt-install.XXXXXX")
    LC_ALL=C DEBIAN_FRONTEND=noninteractive apt-get -y install "$@" > "$inst_err" 2>&1 || rc=$?

    if [ "$rc" -eq 0 ]
    then
        rm -f "$inst_err"
        return 0
    fi

    if grep -Eq 'Unable to fetch some archives|404[[:space:]]+Not Found|Failed to fetch' "$inst_err"
    then
        Println "$(eval_gettext "\$tip 软件包索引可能已过期, 正在强制刷新软件源 (No-Cache) 并重试安装...")"

        if AptUpdate force
        then
            rc=0
            LC_ALL=C DEBIAN_FRONTEND=noninteractive apt-get -y install --fix-missing "$@" > "$inst_err" 2>&1 || rc=$?

            if [ "$rc" -eq 0 ]
            then
                rm -f "$inst_err"
                return 0
            fi
        fi

        if grep -Eq '404[[:space:]]+Not Found|Failed to fetch' "$inst_err" && [ -t 0 ]
        then
            local codename
            codename=$(AptGetCodename)

            Println "\n$(eval_gettext "\$tip 刷新软件源后仍有软件包返回 404 (可能是老版本 Debian/Ubuntu 安全源已归档或镜像同步异常):")"
            grep -E '^(Err:|E: Failed to fetch)' "$inst_err" | head -n 6

            local codename_text="${codename:-stable}"
            local retry_opts=(
                "$(eval_gettext "不修改源, 尝试从发行版主源 (-t \$codename_text) 安装")"
                "$(gettext "将 /etc/apt/sources.list 中的 security.debian.org 切换至 archive.debian.org 并重试")"
                "$(gettext "放弃安装, 自行手动处理")"
            )
            local retry_idx=2
            echo
            inquirer list_input_index "$(gettext "请选择处理方式")" retry_opts retry_idx

            if [ "$retry_idx" -eq 0 ] && [ -n "$codename" ]
            then
                rc=0
                LC_ALL=C DEBIAN_FRONTEND=noninteractive apt-get -y install --allow-downgrades -t "$codename" "$@" > "$inst_err" 2>&1 || rc=$?

                if [ "$rc" -eq 0 ]
                then
                    rm -f "$inst_err"
                    return 0
                fi
            elif [ "$retry_idx" -eq 1 ]
            then
                local sources_file="${APT_SOURCES_FILE:-/etc/apt/sources.list}"

                if [ -f "$sources_file" ] && grep -Fq "security.debian.org" "$sources_file"
                then
                    local tmp_arc
                    tmp_arc=$(mktemp "${TMPDIR:-/tmp}/aios-apt.XXXXXX")
                    sed 's|security\.debian\.org|archive.debian.org|g' "$sources_file" > "$tmp_arc"
                    mv "$tmp_arc" "$sources_file"
                    Println "$(eval_gettext "\$info 已将 \$sources_file 中的 security.debian.org 切换至 archive.debian.org")\n"

                    if AptUpdate force
                    then
                        rc=0
                        LC_ALL=C DEBIAN_FRONTEND=noninteractive apt-get -y install --fix-missing "$@" > "$inst_err" 2>&1 || rc=$?

                        if [ "$rc" -eq 0 ]
                        then
                            rm -f "$inst_err"
                            return 0
                        fi
                    fi
                fi
            fi
        fi
    fi

    local inst_pkgs="$*"
    Println "$(eval_gettext "\$error 软件包安装失败 (\$inst_pkgs):")\n$(cat "$inst_err")\n"
    rm -f "$inst_err"
    return "$rc"
}

BrewInstall()
{
    if [[ ! -x $(command -v brew) ]]
    then
        export NONINTERACTIVE=1
        Println "$(eval_gettext "\${green}[info]\${normal} 安装 Homebrew ...")\n"
        if ! curl -s -S -Lm 20 https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | bash
        then
            Println "$(eval_gettext "\${green}[info]\${normal} 尝试更换国内源 ...")\n"

            export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
            export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.ustc.edu.cn/homebrew-core.git"
            export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
            export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"

            if ! curl -s -S -Lm 20 https://mirrors.ustc.edu.cn/misc/brew-install.sh | bash
            then
                Println "$(eval_gettext "\${green}[ERROR]\${normal} 无法安装 Homebrew")\n"
                return 1
            fi
        fi
        brew update >/dev/null 2>&1
        add_homebrew_path=true
    fi
}

DepInstall()
{
    local dependency=$1 check=${2:-}

    if [ -z "$check" ] && [[ -x $(command -v $dependency) ]]
    then
        return 0
    fi

    if [ "$dependency" == "gettext" ] || [ "$dependency" == "wget" ] || [ "$dependency" == "gsed" ] || [ "$dependency" == "gdate" ] || [ "$dependency" == "ggrep" ]
    then
        Println "${green}[INFO]${normal} Installing $dependency, it takes awhile..."

        if [ "$dist" == "mac" ]
        then
            if [ "$dependency" == "gsed" ]
            then
                dependency=gnu-sed
            elif [ "$dependency" == "gdate" ]
            then
                dependency=coreutils
            elif [ "$dependency" == "ggrep" ]
            then
                dependency=grep
            fi

            if ! brew list $dependency &>/dev/null
            then
                if brew install $dependency &>/dev/null
                then
                    Println "${green}[INFO]${normal} $dependency installation succeed..."
                else
                    Println "${green}[ERROR]${normal} $dependency installation failed...\n"
                    return 1
                fi
            fi
        elif [ "$dist" == "rpm" ]
        then
            if [[ -x $(command -v getenforce) ]] && [ "$(getenforce)" != "Disabled" ]
            then
                setenforce 0
            fi

            if ! rpm -q $dependency &>/dev/null
            then
                if yum -y install $dependency &>/dev/null
                then
                    Println "${green}[INFO]${normal} $dependency installation succeed..."
                else
                    Println "${green}[ERROR]${normal} $dependency installation failed...\n"
                    return 1
                fi
            fi
        else
            if [ "$dist" == "deb" ]
            then
                DebFixSources
            fi

            if ! dpkg -s $dependency &>/dev/null
            then
                AptUpdate
                if AptInstall $dependency
                then
                    Println "${green}[INFO]${normal} $dependency installation succeed..."
                else
                    Println "${green}[ERROR]${normal} $dependency installation failed...\n"
                    return 1
                fi
            fi
        fi

        return 0
    fi

    if [ "$dist" == "mac" ]
    then
        if [ "$dependency" == "tput" ]
        then
            dependency="ncurses"
        fi

        if ! brew list $dependency &>/dev/null
        then
            Println "`eval_gettext \"\\\$info 安装 \\\$dependency, 请稍等...\"`"
            if brew install $dependency >/dev/null 2>&1
            then
                Println "`eval_gettext \"\\\$info \\\$dependency 安装成功\"`"
            else
                Println "`eval_gettext \"\\\$error \\\$dependency 安装失败\"`\n"
                return 1
            fi
        fi
    elif [ "$dist" == "rpm" ]
    then
        if [[ -x $(command -v getenforce) ]] && [ "$(getenforce)" != "Disabled" ]
        then
            setenforce 0
        fi

        if [ "$dependency" == "dig" ]
        then
            dependency="bind-utils"
        elif [ "$dependency" == "hexdump" ]
        then
            dependency="util-linux"
        elif [ "$dependency" == "ss" ]
        then
            dependency="iproute"
        elif [ "$dependency" == "tput" ]
        then
            dependency="ncurses"
        fi

        if ! rpm -q $dependency &>/dev/null
        then
            Println "`eval_gettext \"\\\$info 安装 \\\$dependency, 请稍等...\"`"
            if yum -y install $dependency >/dev/null 2>&1
            then
                Println "`eval_gettext \"\\\$info \\\$dependency 安装成功\"`"
            else
                Println "`eval_gettext \"\\\$error \\\$dependency 安装失败\"`\n"
                return 1
            fi
        fi
    else
        if [ "$dist" == "deb" ]
        then
            DebFixSources
        fi

        if [ "$dependency" == "dig" ]
        then
            dependency="dnsutils"
        elif [ "$dependency" == "hexdump" ]
        then
            dependency="bsdmainutils"
        elif [ "$dependency" == "ss" ]
        then
            dependency="iproute2"
        elif [ "$dependency" == "tput" ]
        then
            dependency="ncurses-bin"
        fi

        if ! dpkg -s $dependency &>/dev/null
        then
            AptUpdate
            Println "`eval_gettext \"\\\$info 安装 \\\$dependency, 请稍等...\"`"
            if AptInstall "$1"
            then
                Println "`eval_gettext \"\\\$info \\\$dependency 安装成功\"`"
            else
                Println "`eval_gettext \"\\\$error \\\$dependency 安装失败\"`\n"
                return 1
            fi
        fi
    fi
}

DepsCheck()
{
    if [ "${deps_checked:-false}" = true ]
    then
        return 0
    fi

    DepInstall tput

    Spinner "`gettext \"检查依赖, 耗时可能会很长\"`" DepsInstall

    deps_checked=true
}

DepsInstall()
{
    if [ "$dist" == "mac" ]
    then
        depends=(wget unzip vim curl patchutils)

        for depend in "${depends[@]}"
        do
            [[ -x $(command -v $depend) ]] && continue
            if ! brew list "$depend" &> /dev/null
            then
                if brew install "$depend" >/dev/null 2>&1
                then
                    Println "`eval_gettext \"\\\$info 依赖 \\\$depend 安装成功\"`"
                else
                    Println "`eval_gettext \"\\\$error 依赖 \\\$depend 安装失败\"`\n"
                    return 1
                fi
            fi
        done
    elif [ "$dist" == "rpm" ]
    then
        if [[ -x $(command -v getenforce) ]] && [ "$(getenforce)" != "Disabled" ]
        then
            setenforce 0
        fi

        depends=(sudo wget unzip vim curl crond logrotate patch nscd bind-utils util-linux iproute ncurses)

        if [ "${rpm_fix:-1}" -eq 1 ]
        then
            yum -y update ca-certificates &> /dev/null || yum -y reinstall ca-certificates &> /dev/null
            rpm_fix=0
            sed -i '/rpm_fix=/d' "$i18n_FILE"
            printf "rpm_fix=%s" "$rpm_fix" >> "$i18n_FILE"
        fi

        for depend in "${depends[@]}"
        do
            [[ -x $(command -v $depend) ]] && continue
            if ! rpm -q "$depend" &> /dev/null
            then
                if yum -y install "$depend" &> /dev/null
                then
                    Println "`eval_gettext \"\\\$info 依赖 \\\$depend 安装成功\"`"
                else
                    Println "`eval_gettext \"\\\$error 依赖 \\\$depend 安装失败\"`\n"
                    return 1
                fi
            fi
        done
    else
        if [ "$dist" == "deb" ]
        then
            DebFixSources
        fi

        AptUpdate

        depends=(ca-certificates sudo wget unzip vim curl cron ufw python3 logrotate patch nscd dnsutils bsdmainutils ncurses-bin)

        for depend in "${depends[@]}"
        do
            [[ -x $(command -v $depend) ]] && continue
            if ! dpkg -s "$depend" &> /dev/null
            then
                if AptInstall "$depend"
                then
                    Println "`eval_gettext \"\\\$info 依赖 \\\$depend 安装成功\"`"
                else
                    Println "`eval_gettext \"\\\$error 依赖 \\\$depend 安装失败\"`\n"
                    return 1
                fi
            fi
        done
    fi
}

ResourceLimit()
{
    if [ "$dist" == "mac" ]
    then
        return 0
    fi

    if [ ! -e /proc/sys/fs/file-max ]
    then
        echo 65536 > /proc/sys/fs/file-max
        echo "fs.file-max=65536" >> /etc/sysctl.conf
    fi

    file_max=$(< /proc/sys/fs/file-max)

    if [ "$file_max" -lt 65000 ]
    then
        file_max=$((file_max*95/100))
    else
        file_max=64000
    fi

    limits=(
        "$USER soft fsize unlimited"
        "$USER hard fsize unlimited"
        "$USER soft cpu unlimited"
        "$USER hard cpu unlimited"
        "$USER soft as unlimited"
        "$USER hard as unlimited"
        "$USER soft memlock unlimited"
        "$USER hard memlock unlimited"
        "$USER soft nofile $file_max"
        "$USER hard nofile $file_max"
        "$USER soft nproc 64000"
        "$USER hard nproc 64000"
        "* soft nofile $file_max"
        "* hard nofile $file_max"
    )

    limits_append=""
    for limit in "${limits[@]}"
    do
        if ! grep -q "${limit% *}" < "/etc/security/limits.conf"
        then
            limits_append="$limits_append$limit\n"
        fi
    done

    if [ -n "$limits_append" ]
    then
        # systemd ignores limits set in the /etc/security/limits.conf
        echo -e "$limits_append" >> "/etc/security/limits.conf"
    fi

    ulimit -f unlimited
    ulimit -t unlimited
    ulimit -v unlimited
    ulimit -l unlimited
    ulimit -n $file_max
    ulimit -m unlimited
    ulimit -u 64000

    if [ "$dist" == "rpm" ]
    then
        if [ ! -e ~/.bash_profile ] || ! grep -q ulimit < ~/.bash_profile
        then
cat >> ~/.bash_profile <<EOF
ulimit -f unlimited
ulimit -t unlimited
ulimit -v unlimited
ulimit -l unlimited
ulimit -n $file_max
ulimit -m unlimited
ulimit -u 64000
EOF
        fi
    else
        if [ ! -e ~/.profile ] || ! grep -q ulimit < ~/.profile
        then
cat >> ~/.profile <<EOF
ulimit -f unlimited
ulimit -t unlimited
ulimit -v unlimited
ulimit -l unlimited
ulimit -n $file_max
ulimit -m unlimited
ulimit -u 64000
EOF
        fi
    fi

    # The limits defined in these files are set by PAM when starting a login session, but daemons started by systemd do not use PAM login sessions
    #if [ ! -e /etc/security/limits.d/99-mongodb-nproc.conf ] && ls -A /etc/security/limits.d/*-nproc.conf > /dev/null 2>&1
    #then
    #    echo -e "mongodb soft nproc 64000\nmongodb hard nproc 64000" > /etc/security/limits.d/99-mongodb-nproc.conf
    #fi
}

