TesseractInstall()
{
    if [[ -x $(command -v tesseract) ]] 
    then
        Println "$(eval_gettext "\$error tesseract 已存在!")\n"
        return 0
    fi

    DepsCheck

    if [ "$dist" == "ubu" ] 
    then
        add-apt-repository ppa:alex-p/tesseract-ocr -y
        apt-get -y update
        AptInstall tesseract
    elif [ "$dist" == "deb" ] 
    then
        Println "$(eval_gettext "\$info 参考 https://notesalexp.org/tesseract-ocr/ ...")\n"
    else
        Println "$(eval_gettext "\$info 参考 https://tesseract-ocr.github.io/tessdoc/Home.html ...")\n"
    fi
}
