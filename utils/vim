VimConfig()
{
    DepInstall vim

    if [ -e ~/.vimrc ] 
    then
        echo
        ExitOnList n "`gettext \"将安装 vim-plug 并覆盖 ~/.vimrc , 是否继续\"`"
    fi

    if curl -s -fLo ~/.vim/autoload/plug.vim --create-dirs "$FFMPEG_MIRROR_LINK/vim-plug.vim"
    then
cat > "$HOME"/.vimrc <<EOF
call plug#begin('~/.vim/plugged')
Plug 'preservim/nerdcommenter'
Plug 'ryanpcmcquen/fix-vim-pasting'
call plug#end()

set number
set mouse=a
set tabstop=2
set shiftwidth=2
set expandtab

autocmd BufRead,BufNewFile *.conf setfiletype conf
filetype indent off
EOF
        GitInstall
        Println "$(eval_gettext "\$info vimrc 设置完成, 请在 vim 下执行 PlugInstall")\n"
    else
        Println "$(eval_gettext "\$error 无法连接服务器, 请稍后再试")\n"
    fi
}
