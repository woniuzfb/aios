QuictlsInstall()
{
    local build_dir=build args=() quictls_path="$DEPENDS_ROOT"/quictls

    if [ -z "${1:-}" ] 
    then
        quictls_install_options=()
    else
        quictls_install_options=("$@")
    fi

    if EleInArray static quictls_install_options
    then
        build_dir+=-static
        quictls_path+=-static
    fi

    if [ -d "$DEPENDS_ROOT/openssl-${QUICTLS_TAG}/$build_dir" ] 
    then
        ln -sfn "$DEPENDS_ROOT/openssl-${QUICTLS_TAG}/$build_dir" "$quictls_path"
        return 0
    fi

    DepInstall ca-certificates
    DepInstall perl

    unset OPENSSL_LOCAL_CONFIG_DIR

    args=(
        --prefix="$DEPENDS_ROOT/openssl-${QUICTLS_TAG}/$build_dir"
        --openssldir="$DEPENDS_ROOT/openssl-${QUICTLS_TAG}/$build_dir/etc"
        --libdir=lib
    )

    if EleInArray static quictls_install_options
    then
        args+=(no-shared)
    fi

    ArchCheck

    if [ "$dist" == "mac" ] 
    then
        export PERL="$HOMEBREW_PREFIX"/opt/perl/bin/perl
        args+=( darwin64-${arch}-cc )
        SourceInstallReady
    else
        case $arch in
            x86_64) args+=( linux-x86_64 )
            ;;
            i386) args+=( linux-elf )
            ;;
            arm64) args+=( linux-aarch64 )
            ;;
            arm*) args+=( linux-armv4 )
            ;;
            *) Println "$(eval_gettext "\$error 不支持的架构 \$arch")\n"; return 1
        esac

        if [ "$dist" == "rpm" ] 
        then
            SourceInstallReady glibc-devel openssl-devel systemd-devel zlib-devel
        else
            SourceInstallReady gcc libc6-dev libssl-dev libsystemd-dev make zlib1g-dev
        fi
    fi

    mkdir -p "$DEPENDS_ROOT"
    cd "$DEPENDS_ROOT"

    if ! curl -Lm 30 "${QUICTLS_REPO_LINK}/${QUICTLS_TAG}.tar.gz" -o "${QUICTLS_TAG}.tar.gz"
    then
        curl -L "$FFMPEG_MIRROR_LINK/${QUICTLS_TAG}.tar.gz" -o "${QUICTLS_TAG}.tar.gz"
    fi

    Println "$(eval_gettext "\$info 解压 \${QUICTLS_TAG} ...")"
    tar xzf "${QUICTLS_TAG}.tar.gz"
    cd "openssl-${QUICTLS_TAG}"

    perl ./Configure "${args[@]}"
    make
    make install

    ln -s "$DEPENDS_ROOT/openssl-${QUICTLS_TAG}/$build_dir" "$quictls_path"
}
