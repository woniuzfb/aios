shopt -s extglob

BUILD_BINS=(v2 x nx or pve arm ibm cf cx ali lhh rc cw dr ha)

IsPureFunctionFile()
{
    local rel="$1"

    if EleInArray "$rel" pure_yes
    then
        return 0
    fi
    if EleInArray "$rel" pure_no
    then
        return 1
    fi

    local fpath="$DEV_PATH/$rel"
    if [ ! -f "$fpath" ]
    then
        pure_no+=("$rel")
        return 1
    fi

    if ! awk '
        BEGIN { in_func=0; expect_brace=0; in_here=0; here_tag=""; here_strip=0; in_sq=0; in_dq=0; bad=0 }
        {
            if (in_here) {
                line_chk=$0
                if (here_strip) sub(/^\t+/, "", line_chk)
                if (line_chk == here_tag) { in_here=0; here_strip=0 }
                next
            }
            if (in_func) {
                if (!in_sq && !in_dq && $0 ~ /<<-?[ \t]*['\''"]?[A-Za-z0-9_]+['\''"]?/) {
                    here_strip=($0 ~ /<<-/)
                    s=$0
                    sub(/.*<<-?[ \t]*/, "", s)
                    sub(/[ \t].*/, "", s)
                    gsub(/['\''"]/, "", s)
                    if (s != "") { in_here=1; here_tag=s }
                }
                if (!in_sq && !in_dq && $0 ~ /^\}[ \t]*$/) {
                    in_func=0
                    next
                }
                # Track multiline single/double-quoted strings
                line=$0
                gsub(/\\./, "", line)
                if (!in_dq) {
                    n_sq = gsub(/'\''/, "&", line)
                    if (n_sq % 2 == 1) in_sq = !in_sq
                }
                if (!in_sq) {
                    n_dq = gsub(/"/, "&", line)
                    if (n_dq % 2 == 1) in_dq = !in_dq
                }
                next
            }
            if ($0 ~ /^[ \t]*$/ || $0 ~ /^[ \t]*#/) next
            if (expect_brace) {
                if ($0 ~ /^\{[ \t]*$/) { in_func=1; expect_brace=0; next }
                bad=1; exit 1
            }
            if ($0 ~ /^[A-Za-z_][A-Za-z0-9_:]*\(\)[ \t]*$/) { expect_brace=1; next }
            if ($0 ~ /^[A-Za-z_][A-Za-z0-9_:]*\(\)[ \t]*\{[ \t]*$/) { in_func=1; next }
            if ($0 ~ /^Include[ \t]+[^ \t]+/) next
            bad=1; exit 1
        }
        END { if (bad || in_func || expect_brace) exit 1 }
    ' "$fpath"
    then
        pure_no+=("$rel")
        return 1
    fi

    # Recursively verify all top-level Include dependencies are also pure
    local deps dep
    deps=$(awk '/^Include[ \t]+[^ \t]+/ { print $2 }' "$fpath")
    for dep in $deps
    do
        [ -z "$dep" ] && continue
        if ! IsPureFunctionFile "$dep"
        then
            pure_no+=("$rel")
            return 1
        fi
    done

    pure_yes+=("$rel")
    return 0
}

CollectBranchIncludes()
{
    local rel="$1"
    if EleInArray "$rel" scan_seen
    then
        return 0
    fi
    scan_seen+=("$rel")

    local fpath="$DEV_PATH/$rel"
    [ ! -f "$fpath" ] && return 0

    local deps dep
    deps=$(awk '/^[ \t]*Include[ \t]+[^ \t]+/ { print $2 }' "$fpath")
    for dep in $deps
    do
        [ -z "$dep" ] && continue
        CollectBranchIncludes "$dep"
    done
}

BuildHoistPlan()
{
    hoist_candidates=()
    local all_branches=(tv "${BUILD_BINS[@]}" tr)
    local seen_once=()
    local seen_multi=()
    local bin item

    for bin in "${all_branches[@]}"
    do
        scan_seen=()
        CollectBranchIncludes "src/$bin"
        for item in ${scan_seen[@]+"${scan_seen[@]}"}
        do
            [ "$item" == "src/$bin" ] && continue
            if EleInArray "$item" seen_once
            then
                if ! EleInArray "$item" seen_multi
                then
                    seen_multi+=("$item")
                fi
            else
                seen_once+=("$item")
            fi
        done
    done

    for item in ${seen_multi[@]+"${seen_multi[@]}"}
    do
        if EleInArray "$item" hoisted_files
        then
            continue
        fi
        if IsPureFunctionFile "$item"
        then
            hoist_candidates+=("$item")
        fi
    done
}

ReplaceInclude()
{
    local replace_path="$DEV_PATH"
    local replace_name="$1"
    local indent="${2:-}"

    if [ "$replace_name" == "build" ]
    then
        return
    fi

    if [ "$replace_name" == "src/\$self" ]
    then
        BuildHoistPlan
        local h_item
        if [ ${#hoist_candidates[@]} -gt 0 ]
        then
            for h_item in "${hoist_candidates[@]}"
            do
                ReplaceInclude "$h_item" "$indent"
            done
        fi

        in_dispatch=1
        echo
        echo "${indent}if [ \"\$self\" == \"tv\" ] || [ \"\$self\" == \"iptv\" ] || [ \"\$self\" == \"aios\" ]"
        echo "${indent}then"
        branch_files=()
        ReplaceInclude src/tv "    ${indent}"
        for bin in "${BUILD_BINS[@]}"
        do
            echo "${indent}elif [ \"\$self\" == \"$bin\" ]"
            echo "${indent}then"
            branch_files=()
            ReplaceInclude "src/$bin" "    ${indent}"
        done
        echo "${indent}elif [ \"\$self\" == \"tr\" ]"
        echo "${indent}then"
        branch_files=()
        ReplaceInclude src/tr "    ${indent}"
        echo "${indent}fi"
        in_dispatch=0
        return
    fi

    # Skip pure function libraries already hoisted at top-level or already emitted in this branch
    if EleInArray "$replace_name" hoisted_files
    then
        return
    fi
    if [ "${in_dispatch:-0}" -eq 1 ] && EleInArray "$replace_name" branch_files
    then
        return
    fi

    if [ "${in_dispatch:-0}" -eq 0 ]
    then
        if IsPureFunctionFile "$replace_name"
        then
            hoisted_files+=("$replace_name")
        fi
    else
        if IsPureFunctionFile "$replace_name"
        then
            branch_files+=("$replace_name")
        fi
    fi

    replace_files+=("$replace_name")

    while [[ $replace_name =~ \/ ]]
    do
        replace_path="$replace_path/${replace_name%%/*}"
        replace_name="${replace_name#*/}"
    done

    local here=false here_tag="" here_strip=false line_chk=""
    while IFS= read -r line
    do
        if [ "$here" = true ]
        then
            echo "$line"
            line_chk="$line"
            if [ "$here_strip" = true ]
            then
                line_chk="${line_chk#"${line_chk%%[!$'\t']*}"}"
            fi
            if [ "$line_chk" == "$here_tag" ]
            then
                here=false
                here_strip=false
            fi
            continue
        elif [[ $line =~ ^([ ]*)cat([ ]).*(\<\<(-?)[[:space:]]*[\'\"]?([A-Za-z0-9_]+)[\'\"]?) ]]
        then
            here=true
            here_strip=false
            [ "${BASH_REMATCH[4]}" == "-" ] && here_strip=true
            here_tag="${BASH_REMATCH[5]}"
        fi
        if [ -z "$line" ]
        then
            echo
        elif [ "$here" = true ]
        then
            echo "$line"
        elif [[ $line =~ ^([ ]*)Include\ ([^ ]+) ]]
        then
            ReplaceInclude "${BASH_REMATCH[2]}" "${indent}${BASH_REMATCH[1]}"
        elif [[ $line =~ ^([ ]*)\$\{ ]] || [[ $line =~ ^([ ]*)\` ]] || [[ $line =~ ^([ ]*)\— ]] || [[ $line =~ ^([ ]*)\$\( ]]
        then
            echo "$line"
        else
            echo "${indent}$line"
        fi
    done < "$replace_path/$replace_name"
}

BuildShFile()
{
    if ! declare -F EleInArray > /dev/null 2>&1
    then
        echo "BuildShFile ERROR: EleInArray is not defined (core must be loaded first)" >&2
        return 1
    fi

    local out_file="${1:-$DEV_PATH/aios.sh}"
    replace_files=()
    hoisted_files=()
    branch_files=()
    pure_yes=()
    pure_no=()
    in_dispatch=0

    ReplaceInclude make | sed '/DEV_PATH/,/sh_ver/{/sh_ver/!d;};/Include build/d' > "$out_file"

    local built_ver
    built_ver=$(sed -nE 's/^[[:space:]]*sh_ver="?([^"[:space:]]+)"?/\1/p' "$out_file" | head -n 1)
    if [ -z "$built_ver" ]
    then
        echo "BuildShFile ERROR: failed to parse sh_ver from $out_file" >&2
        return 1
    fi

    if [ "$out_file" == "$DEV_PATH/aios.sh" ] && [ -d "$DEV_PATH/docs" ]
    then
        cp -f "$out_file" "$DEV_PATH/docs/aios.sh"
        chmod +x "$DEV_PATH/docs/aios.sh"
    fi

    if [ "$INSTALL_SH" = true ]
    then
        cp -f "$out_file" "$SH_FILE"
    fi
}

BuildI18nFiles()
{
    local make_pot="$DEV_PATH/i18n/make-pot.sh"
    local po_dir="$DEV_PATH/i18n/po"
    if [ ! -f "$make_pot" ] || ! command -v msgfmt > /dev/null 2>&1 || ! command -v xgettext > /dev/null 2>&1
    then
        return 0
    fi

    local err_log
    err_log=$(mktemp)

    if ! bash "$make_pot" zh_CN en > /dev/null 2> "$err_log"
    then
        cat "$err_log" >&2
        rm -f "$err_log"
        return 1
    fi

    local po_file po_base mo_lang mo_file mo_dir
    for po_file in "$po_dir"/aios.sh-*.po
    do
        if [ ! -f "$po_file" ]
        then
            continue
        fi

        po_base="${po_file##*/}"
        mo_lang="${po_base#aios.sh-}"
        mo_lang="${mo_lang%.po}"
        if [ "$mo_lang" == "en" ]
        then
            continue
        fi

        if ! bash "$make_pot" zh_CN "$mo_lang" > /dev/null 2> "$err_log"
        then
            cat "$err_log" >&2
            rm -f "$err_log"
            return 1
        fi
    done

    if ! bash "$make_pot" b > /dev/null 2> "$err_log" \
        || ! msgfmt --check -o /dev/null "$DEV_PATH/i18n/aios.sh.pot" 2>> "$err_log"
    then
        cat "$err_log" >&2
        rm -f "$err_log"
        return 1
    fi

    rm -f "$err_log"

    if [ "$INSTALL_SH" = true ]
    then
        for mo_file in "$po_dir"/aios.sh-*.mo
        do
            if [ ! -f "$mo_file" ]
            then
                continue
            fi

            po_base="${mo_file##*/}"
            mo_lang="${po_base#aios.sh-}"
            mo_lang="${mo_lang%.mo}"
            mo_dir="$TEXTDOMAINDIR/$mo_lang/LC_MESSAGES"
            mkdir -p "$mo_dir"
            cp -f "$mo_file" "$mo_dir/${TEXTDOMAIN}.mo"
            chmod 644 "$mo_dir/${TEXTDOMAIN}.mo"
        done
    fi
}

if [ "${1:-}" == "install" ]
then
    INSTALL_SH=true
else
    INSTALL_SH=false
fi

if [ "${BUILD_LIBRARY_ONLY:-false}" != true ]
then
    Spinner "Building aios.sh" BuildShFile
    Spinner "Building i18n (.pot/.po/.mo)" BuildI18nFiles

    Println "$info new aios.sh created! For devs only!!\n"

    exit 0
fi
