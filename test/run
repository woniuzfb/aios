# shellcheck disable=SC1091
. "$DEV_PATH/test/lib/harness"
trap 'MockInquirerCleanup; E2eSandboxCleanup' EXIT
# shellcheck disable=SC1091
. "$DEV_PATH/test/lib/sandbox"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/core_jq"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/nginx"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/xray"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/v2ray"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/matrix"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/type_safety"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/e2e_aios"
# shellcheck disable=SC1091
. "$DEV_PATH/test/suites/iptv"

case "$TARGET_SUITE" in
    core) RunSuiteCoreJq ;;
    nginx) RunSuiteNginx ;;
    xray) RunSuiteXray ;;
    v2ray) RunSuiteV2ray ;;
    matrix) RunSuiteMatrix ;;
    types) RunSuiteTypeSafety ;;
    e2e) RunSuiteE2eAios ;;
    iptv) RunSuiteIptv ;;
    all)
        RunSuiteCoreJq
        RunSuiteNginx
        RunSuiteXray
        RunSuiteV2ray
        RunSuiteMatrix
        RunSuiteTypeSafety
        RunSuiteIptv
        RunSuiteE2eAios
    ;;
esac

printf '\nSummary: %d passed, %d failed\n' "$PASS_COUNT" "$FAIL_COUNT"
[ "$FAIL_COUNT" -eq 0 ]
