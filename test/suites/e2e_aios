_E2eRunV2rayPhase()
{
    local built_aios="$1"
    local pty_mode="$2"

    E2eSandboxInit "$built_aios"
    local v2_cfg="$E2E_SANDBOX_DIR/aios/proxy/v2ray/config.json"

    # ------------------------------------------------------------------
    # V2RAY E2E — Multi-inbound matrix (v2ray_full_matrix.json)
    # ------------------------------------------------------------------
    E2eLoadFixture v2ray v2ray_full_matrix.json

    # 12. V2Ray Menu 5: 选择入站 1 (vmess-direct) -> 只输出 vmess 分享链接
    local out
    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"5<ENTER>"},{"wait":"选择显示的范围","send":"<ENTER>"},{"wait":"选择查看账号明细的入站","send":"<ENTER>"},{"wait":"分享链接","send":""}]' "$pty_mode")
    ShowCaptured "E2E v2 menu 5 (inbound 1: vmess-direct)" "$out"
    AssertContains "$out" "v2-alice@example.test" "e2e v2 menu 5: inbound 1 shows v2-alice"
    AssertContains "$out" "vmess://" "e2e v2 menu 5: share link includes selected inbound 1 (vmess)"
    AssertNotContains "$out" "trojan://" "e2e v2 menu 5: share link excludes unselected inbound 2 (trojan)"

    # 13. V2Ray Menu 5: 选择入站 2 (nginx-trojan) -> 只输出 trojan 分享链接
    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"5<ENTER>"},{"wait":"选择显示的范围","send":"<ENTER>"},{"wait":"选择查看账号明细的入站","send":"<DOWN><ENTER>"},{"wait":"分享链接","send":""}]' "$pty_mode")
    ShowCaptured "E2E v2 menu 5 (inbound 2: nginx-trojan)" "$out"
    AssertContains "$out" "trojan://v2-trojan-pass@203.0.113.10:10002?" "e2e v2 menu 5: share link includes selected inbound 2 (trojan)"
    AssertNotContains "$out" "vmess://" "e2e v2 menu 5: share link excludes unselected inbound 1 (vmess)"

    # 14. V2Ray Menu 8, 11, 13, 15, 19
    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"8<ENTER>"},{"wait":"选择查看账号/服务端明细的出站","send":"<DOWN><ENTER>"}]' "$pty_mode")
    AssertContains "$out" "v2-edge.example.test:443" "e2e v2 menu 8: shows vnext outbound address"

    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"11<ENTER>"}]' "$pty_mode")
    AssertContains "$out" "expectIPs" "e2e v2 menu 11: renders V2Ray expectIPs"

    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"13<ENTER>"}]' "$pty_mode")
    AssertContains "$out" "hybrid" "e2e v2 menu 13: renders V2Ray domainMatcher"

    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"15<ENTER>"}]' "$pty_mode")
    AssertContains "$out" "bufferSize" "e2e v2 menu 15: renders V2Ray policy bufferSize"

    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"19<ENTER>"}]' "$pty_mode")
    AssertContains "$out" "v2-br" "e2e v2 menu 19: renders V2Ray reverse bridge"

    # 15. V2Ray Menu 21 (删除入站)
    out=$(E2eRunPty v2 '[{"wait":"打开面板","send":"21<ENTER>"},{"wait":"选择要删除的入站","send":"<DOWN><ENTER>"}]' "$pty_mode")
    AssertJsonEq "$v2_cfg" '.inbounds | length' "1" "e2e v2 menu 21: deletes inbound 2"

    # 16b. Dynamic generated-config multi-inbound matrix through real aios.sh (V2Ray 3 protocols in 1 launch)
    cat > "$v2_cfg" <<'V2DYNJSON'
{
  "inbounds": [
    {
      "tag": "v2-vmess",
      "listen": "0.0.0.0",
      "port": 16000,
      "protocol": "vmess",
      "settings": {
        "clients": [{"id": "44444444-4444-4444-8444-444444444444", "email": "v2m@matrix.test", "level": 0}]
