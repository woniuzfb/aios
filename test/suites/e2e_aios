      "port": 16001,
      "protocol": "vless",
      "settings": {
        "decryption": "none",
        "clients": [{"id": "55555555-5555-4555-8555-555555555555", "email": "v2vl@matrix.test", "level": 0}]
      },
      "streamSettings": {
        "network": "grpc",
        "security": "none",
        "grpcSettings": {"serviceName": "v2-grpc"}
