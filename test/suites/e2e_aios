    ShowCaptured "E2E dynamic x (6-protocol multi-inbound vless share)" "$out"

    local vmess_out="" trojan_out=""
    vmess_out=$(E2eRunPty x '[{"wait":"打开面板","send":"5<ENTER>"},{"wait":"选择显示的范围","send":"<ENTER>"},{"wait":"选择查看账号明细的入站","send":"<DOWN><ENTER>"},{"wait":"分享链接","send":""}]' "$pty_mode")
    ShowCaptured "E2E dynamic x (6-protocol multi-inbound vmess share)" "$vmess_out"

    trojan_out=$(E2eRunPty x '[{"wait":"打开面板","send":"5<ENTER>"},{"wait":"选择显示的范围","send":"<ENTER>"},{"wait":"选择查看账号明细的入站","send":"<DOWN><DOWN><ENTER>"},{"wait":"分享链接","send":""}]' "$pty_mode")
    ShowCaptured "E2E dynamic x (6-protocol multi-inbound trojan share)" "$trojan_out"

    for dyn_spec in \
        "vless|xhttp|reality|vless://" \
        "vmess|ws|tls|vmess://" \
        "trojan|grpc|tls|trojan://" \
        "shadowsocks|raw|none|2022-blake3" \
