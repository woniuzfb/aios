        AssertContains "$out" "$d_expect" "e2e dynamic v2 (${d_proto}/${d_net}/${d_sec}) renders ${d_expect}"
    done

    E2eSandboxCleanup
}

_E2eRunPhaseSubshell()
{
    local phase_fn="$1"
    local built_aios="$2"
    local pty_mode="$3"
    local pdir="$4"

    mkdir -p "$pdir"

    if [ "${AIOS_TEST_HOST_OS:-}" == "linux" ] && [ "${AIOS_TEST_IS_ROOT:-0}" == "1" ]
    then
        chmod 755 "$pdir"
    fi
    : > "$pdir/cases.tsv"
    : > "$pdir/events.log"
    : > "$pdir/fail.log"
    : > "$pdir/stdout.log"
    : > "$pdir/stderr.log"

    (
        trap 'E2eSandboxCleanup' EXIT
        AIOS_TEST_CASES_FILE="$pdir/cases.tsv"
        AIOS_TEST_EVENTS_FILE="$pdir/events.log"
        AIOS_TEST_FAIL_LOG="$pdir/fail.log"
        PASS_COUNT=0
        FAIL_COUNT=0
        SKIP_PLATFORM_COUNT=0
        SKIP_PRIVILEGE_COUNT=0
        SKIP_DEPENDENCY_COUNT=0

        "$phase_fn" "$built_aios" "$pty_mode" > "$pdir/stdout.log" 2> "$pdir/stderr.log"
        {
            printf 'PHASE_STATUS=DONE\n'
            printf 'PHASE_PASS=%d\n' "$PASS_COUNT"
            printf 'PHASE_FAIL=%d\n' "$FAIL_COUNT"
            printf 'PHASE_SKIP_PLATFORM=%d\n' "$SKIP_PLATFORM_COUNT"
            printf 'PHASE_SKIP_PRIVILEGE=%d\n' "$SKIP_PRIVILEGE_COUNT"
            printf 'PHASE_SKIP_DEPENDENCY=%d\n' "$SKIP_DEPENDENCY_COUNT"
        } > "$pdir/counts.env.tmp"
        mv -f "$pdir/counts.env.tmp" "$pdir/counts.env"
    )
}

_E2eReplayPhaseResult()
{
    local phase_name="$1"
    local pdir="$2"
    local phase_rc="$3"
    local PHASE_STATUS="" PHASE_PASS=0 PHASE_FAIL=0 PHASE_SKIP_PLATFORM=0 PHASE_SKIP_PRIVILEGE=0 PHASE_SKIP_DEPENDENCY=0
    local counts_missing=0

    if [ -f "$pdir/counts.env" ]
    then
        # shellcheck disable=SC1091
        . "$pdir/counts.env"
    else
        counts_missing=1
    fi

    PASS_COUNT=$((PASS_COUNT + PHASE_PASS))
    FAIL_COUNT=$((FAIL_COUNT + PHASE_FAIL))
    SKIP_PLATFORM_COUNT=$((SKIP_PLATFORM_COUNT + PHASE_SKIP_PLATFORM))
    SKIP_PRIVILEGE_COUNT=$((SKIP_PRIVILEGE_COUNT + PHASE_SKIP_PRIVILEGE))
    SKIP_DEPENDENCY_COUNT=$((SKIP_DEPENDENCY_COUNT + PHASE_SKIP_DEPENDENCY))

    if [ -n "${AIOS_TEST_CASES_FILE:-}" ] && [ -s "$pdir/cases.tsv" ]
    then
        cat "$pdir/cases.tsv" >> "$AIOS_TEST_CASES_FILE"
    fi

    if [ -n "${AIOS_TEST_EVENTS_FILE:-}" ] && [ -s "$pdir/events.log" ]
    then
        cat "$pdir/events.log" >> "$AIOS_TEST_EVENTS_FILE"
    fi

    if [ -n "${AIOS_TEST_FAIL_LOG:-}" ] && [ -s "$pdir/fail.log" ]
    then
        cat "$pdir/fail.log" >> "$AIOS_TEST_FAIL_LOG"
    fi

    if [ -s "$pdir/stdout.log" ]
    then
        cat "$pdir/stdout.log"
    fi

    if [ -s "$pdir/stderr.log" ]
    then
        cat "$pdir/stderr.log" >&2
    fi

    local total_cases=$((PHASE_PASS + PHASE_FAIL + PHASE_SKIP_PLATFORM + PHASE_SKIP_PRIVILEGE + PHASE_SKIP_DEPENDENCY))

    if [ "$phase_rc" -ne 0 ] || [ "$counts_missing" -eq 1 ] || [ "$PHASE_STATUS" != "DONE" ] || [ "$total_cases" -eq 0 ]
    then
        local diag=""
        diag=$(printf '  phase=%s rc=%d counts_missing=%d status=%s total_cases=%d' \
            "$phase_name" "$phase_rc" "$counts_missing" "${PHASE_STATUS:-MISSING}" "$total_cases")
        RecordFail "e2e phase ${phase_name}: incomplete or failed execution" "$diag"
    fi
}

RunSuiteE2eAios()
{
    printf '\n=== Suite: e2e (real generated aios.sh via PTY) ===\n'

    # Build aios.sh into a temporary file so running tests never mutates the repo working tree
    local e2e_built_aios e2e_build_err e2e_build_rc=0
    e2e_built_aios=$(mktemp "${TMPDIR:-/tmp}/aios-e2e-build.XXXXXX")
    e2e_build_err=$(mktemp "${TMPDIR:-/tmp}/aios-e2e-build-err.XXXXXX")
    (
        set -euo pipefail
        DEV_PATH="$REPO_ROOT"
        BUILD_LIBRARY_ONLY=true
        # shellcheck disable=SC2329
        Include()
        {
            local p="$DEV_PATH" n="$1"
            while [[ $n =~ \/ ]]
            do
                p="$p/${n%%/*}"
                n="${n#*/}"
            done
            shift
            # shellcheck disable=SC1090
            . "$p/$n" "$@"
        }
        # shellcheck disable=SC1091
        . "$REPO_ROOT/ver"
        # shellcheck disable=SC1091
        . "$REPO_ROOT/env"
        info="[INFO]"
        Println()
        {
            printf '%b\n' "$*"
        }
        # shellcheck disable=SC1091
        . "$REPO_ROOT/utils/shfile"
        Spinner()
        {
            shift
            "$@"
        }
        # shellcheck disable=SC1091
        . "$REPO_ROOT/build"
        BuildShFile "$e2e_built_aios" > /dev/null
    ) 2> "$e2e_build_err" || e2e_build_rc=$?

    if [ "$e2e_build_rc" -ne 0 ] || [ -s "$e2e_build_err" ]
    then
        local build_detail=""
        build_detail=$(head -n 20 "$e2e_build_err")
        RecordFail "e2e: BuildShFile exited ${e2e_build_rc}" "$build_detail"
        rm -f "$e2e_built_aios" "$e2e_build_err"
        return 1
    fi
    rm -f "$e2e_build_err"

    local syntax_err=""

    if syntax_err=$(bash -n "$e2e_built_aios" 2>&1)
    then
        RecordPass "e2e: rebuilt aios.sh passes bash -n"
    else
        RecordFail "e2e: rebuilt aios.sh failed bash -n" "$syntax_err"
        rm -f "$e2e_built_aios"
        return 1
    fi

    local dup_funcs
    dup_funcs=$(grep -E '^[[:space:]]*[A-Za-z_][A-Za-z0-9_:]*\(\)[[:space:]]*$' "$e2e_built_aios" \
        | sed -E 's/^[[:space:]]+//; s/\(\)[[:space:]]*$//' \
        | sort | uniq -d)
    AssertEq "" "$dup_funcs" "e2e: rebuilt aios.sh has zero duplicate function definitions"

    local pty_mode=""
    [ "$SHOW_OUTPUT" -eq 1 ] && pty_mode="--verbose"

    if [ "${AIOS_TEST_WORKER_JOBS:-1}" -gt 1 ]
    then
        local phase_dir x_pid v2_pid x_rc=0 v2_rc=0
        phase_dir=$(mktemp -d "${TMPDIR:-/tmp}/aios-e2e-phases.XXXXXX")

        if [ "${AIOS_TEST_HOST_OS:-}" == "linux" ] && [ "${AIOS_TEST_IS_ROOT:-0}" == "1" ]
        then
            chmod 755 "$phase_dir"
        fi

        _E2eRunPhaseSubshell _E2eRunXrayPhase "$e2e_built_aios" "$pty_mode" "$phase_dir/xray" &
        x_pid=$!
        _E2eRunPhaseSubshell _E2eRunV2rayPhase "$e2e_built_aios" "$pty_mode" "$phase_dir/v2ray" &
        v2_pid=$!

        wait "$x_pid" || x_rc=$?
        wait "$v2_pid" || v2_rc=$?

        _E2eReplayPhaseResult "xray" "$phase_dir/xray" "$x_rc"
        _E2eReplayPhaseResult "v2ray" "$phase_dir/v2ray" "$v2_rc"

        rm -rf "$phase_dir" "$e2e_built_aios"

        if [ "$x_rc" -ne 0 ] || [ "$v2_rc" -ne 0 ]
        then
            return 1
        fi
    else
        _E2eRunXrayPhase "$e2e_built_aios" "$pty_mode"
        _E2eRunV2rayPhase "$e2e_built_aios" "$pty_mode"
        rm -f "$e2e_built_aios"
    fi
}
