        elif [ "$d_proto" == "trojan" ]
        then
            AssertContains "$trojan_out" "$d_expect" "e2e dynamic x (${d_proto}/${d_net}/${d_sec}) renders ${d_expect}"
        else
            AssertContains "$out" "$d_expect" "e2e dynamic x (${d_proto}/${d_net}/${d_sec}) renders ${d_expect}"
