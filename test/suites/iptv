# shellcheck shell=bash

RunSuiteIptv()
{
    printf '\n=== Suite: iptv (P0 FFmpeg 8/9, IPTV_CONFIG split, update_self, core helpers) ===\n'

    local tmpdir
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/aios-iptv-test.XXXXXX")

    # 1. Cross-platform Bash 3.2+ helpers in core
    AssertEq "0" "$(VersionLt "1.87.9" "2.0.0"; echo $?)" "VersionLt: 1.87.9 < 2.0.0"
    AssertEq "0" "$(VersionLt "2.0.0" "2.1.0"; echo $?)" "VersionLt: 2.0.0 < 2.1.0"
    AssertEq "1" "$(VersionLt "2.1.0" "2.0.9"; echo $?)" "VersionLt: 2.1.0 !< 2.0.9"
    AssertEq "1" "$(VersionLt "2.1.0" "2.1.0"; echo $?)" "VersionLt: 2.1.0 !< 2.1.0"
    AssertEq "abc" "$(StripSuffix "abcdef" 3)" "StripSuffix strips trailing 3 chars"
    AssertEq "" "$(StripSuffix "ab" 5)" "StripSuffix returns empty when n >= len"

    local spid ms_now uuid_val md5_val rx_rc
    spid=$(GetSubshellPid)
    rx_rc=1

    if [[ $spid =~ ^[0-9]+$ ]]
    then
        rx_rc=0
    fi
    AssertEq "0" "$rx_rc" "GetSubshellPid returns numeric PID"
    ms_now=$(DateMs)
    rx_rc=1

    if [[ $ms_now =~ ^[0-9]{13,}$ ]]
    then
        rx_rc=0
    fi
    AssertEq "0" "$rx_rc" "DateMs returns numeric ms timestamp"
    uuid_val=$(GenUuid)
    rx_rc=1

    if [[ $uuid_val =~ ^[0-9a-fA-F-]{36}$ ]]
    then
        rx_rc=0
    fi
    AssertEq "0" "$rx_rc" "GenUuid returns UUID"
    md5_val=$(printf 'aios' | Md5Hex)
    AssertEq "32" "${#md5_val}" "Md5Hex returns 32-char hex digest"

    local flt_file="$tmpdir/filter.txt"
    printf 'keep-1\n/opt/aios/bin/tv 4g -\nkeep-2\n' > "$flt_file"
    FilterFileLines "/opt/aios/bin/tv 4g -" "$flt_file"
    AssertNotContains "$(cat "$flt_file")" "tv 4g -" "FilterFileLines removes matching line"
    AssertContains "$(cat "$flt_file")" "keep-1" "FilterFileLines keeps non-matching lines"

    # 2. utils/jq mixed empty array [] + non-empty object array (schedule/subtitle regression)
    local mix_cfg="$tmpdir/channels_mix.json"
    cat > "$mix_cfg" <<'MIXEOF'
{
  "channels": [
    {
      "name": "ch1",
      "status": "off",
      "schedule": [{"start_time": 1700000000, "end_time": 1700003600, "status": 0, "loop": false, "auto_remove": false, "channel_name": "ep1"}],
      "subtitle": [{"name": "eng", "map": 0, "default": true}]
    },
    {
      "name": "ch2",
      "status": "off",
      "schedule": [],
      "subtitle": []
    }
  ]
}
MIXEOF
    SetDelimiters
    local flat_mix
    flat_mix=$(JQs flat "$mix_cfg")
    AssertEq "0" "$("$JQ_FILE" -e '.channels.schedule | type == "object"' <<< "$flat_mix" > /dev/null 2>&1; echo $?)" "JQs flat merges mixed [] and object array in schedule"
    AssertEq "0" "$("$JQ_FILE" -e '.channels.subtitle | type == "object"' <<< "$flat_mix" > /dev/null 2>&1; echo $?)" "JQs flat merges mixed [] and object array in subtitle"
    local sched_st
    sched_st=$("$JQ_FILE" -r '.channels.schedule.start_time' <<< "$flat_mix")
    AssertContains "$sched_st" "1700000000" "JQs flat preserves schedule.start_time when sibling channel has schedule: []"

    # 3. ParseSchedule (redirect + delimiters[1] regression)
    local ps_rc=0
    (
        # shellcheck disable=SC1091
        . "$DEV_PATH/src/iptv/parse_schedule"
        chnl_id="ch_sp1"
        mark=""
        schedules_chnl_id=()
        schedules_start_time=()
        schedules_end_time=()
        schedules_title=()
        schedules_list=()
        schedule='[{"title":"Match A","time":"12:00","start_time":1700000000,"end_time":1700007200},{"title":"Match B","time":"14:00","start_time":1700007200,"end_time":1700014400}]'
        ParseSchedule
        [ "${#schedules_title[@]}" -eq 2 ] && [ "${schedules_title[0]}" == "Match A" ] && [ "${schedules_title[1]}" == "Match B" ] && [ "${schedules_chnl_id[1]}" == "ch_sp1" ]
    ) || ps_rc=$?
    AssertEq "0" "$ps_rc" "ParseSchedule parses schedule array with delimiters[1] without stdin hang"

    # 4. IPTV_CONFIG split + update_self migration (1.87.9 -> 2.1.0) & idempotency
    local mig_rc=0
    (
        IPTV_ROOT="$tmpdir/iptv_mig"
        mkdir -p "$IPTV_ROOT"
        CHANNELS_FILE="$IPTV_ROOT/channels.json"
        # shellcheck disable=SC2030
        IPTV_CONFIG="$IPTV_ROOT/config.json"
        LOCK_FILE="$IPTV_ROOT/update.lock"
        i18n_blank="留空"
        # shellcheck disable=SC2034
        i18n_not_set="未设置"
        # shellcheck disable=SC1091
        . "$DEV_PATH/ver"
        # shellcheck disable=SC1091
        . "$DEV_PATH/src/iptv/get_default"
        # shellcheck disable=SC1091
        . "$DEV_PATH/src/iptv/edit_default"
        # shellcheck disable=SC1091
        . "$DEV_PATH/src/iptv/get_channel"
        # shellcheck disable=SC1091
        . "$DEV_PATH/src/iptv/get_channels"

        cat > "$CHANNELS_FILE" <<'MIGEOF'
{
  "default": {
    "proxy": "",
    "xc_proxy": "",
    "user_agent": "Mozilla/5.0",
    "headers": "",
    "cookies": "",
    "playlist_name": "",
    "seg_dir_name": "",
    "seg_name": "",
    "seg_length": 6,
    "seg_count": 5,
    "video_codec": "libx264",
    "audio_codec": "aac",
    "video_audio_shift": "",
    "draw_text": "",
    "quality": "",
    "bitrate": "900",
    "resolution": "1280x720",
    "const": false,
    "const_cbr": false,
    "encrypt": false,
    "encrypt_session": false,
    "keyinfo_name": "",
    "key_name": "",
    "input_flags": "-copy_unknown -reconnect 1",
    "output_flags": "-g 60 -vsync 0",
    "txt_format": "webvtt",
    "sync": true,
    "sync_file": "",
    "sync_index": "data:0:channels",
    "sync_pairs": "",
    "schedule_file": "",
    "flv_delay_seconds": 20,
    "flv_restart_nums": 20,
    "hls_delay_seconds": 120,
    "hls_min_bitrate": 500,
    "hls_max_seg_size": 5,
    "hls_restart_nums": 20,
    "hls_key_period": 30,
    "hls_end_list": false,
    "anti_ddos_port": 80,
    "anti_ddos_syn_flood": false,
    "anti_ddos_syn_flood_delay_seconds": 3,
    "anti_ddos_syn_flood_seconds": 3600,
    "anti_ddos": false,
    "anti_ddos_seconds": 120,
    "anti_ddos_level": 6,
    "anti_leech": false,
    "anti_leech_restart_nums": 3,
    "anti_leech_restart_flv_changes": true,
    "anti_leech_restart_hls_changes": true,
    "recheck_period": 0,
    "version": "1.87.9"
  },
  "channels": [
    {
      "name": "CCTV1",
      "output_dir_name": "cctv1",
      "stream_link": ["http://example.test/live.m3u8"],
      "headers": "x-forwarded-for: 127.0.0.1\r\n",
      "live": true,
      "status": "off",
      "txt_format": "webvtt",
      "schedule": []
    }
  ]
}
MIGEOF
        # Run update_self first time (1.87.9 -> 2.1.0)
        # shellcheck disable=SC1091
        . "$DEV_PATH/src/iptv/update_self" > /dev/null

        [ -s "$IPTV_CONFIG" ] || exit 11
        [ "$("$JQ_FILE" -r '.version' "$IPTV_CONFIG")" == "$sh_ver" ] || exit 12
        [ "$("$JQ_FILE" -r '.schema_version' "$IPTV_CONFIG")" == "1" ] || exit 13
        [ "$("$JQ_FILE" -r 'has("txt_format")' "$IPTV_CONFIG")" == "false" ] || exit 14
        [ "$("$JQ_FILE" -r 'has("default")' "$CHANNELS_FILE")" == "false" ] || exit 15
        [ "$("$JQ_FILE" -r '.channels | length' "$CHANNELS_FILE")" == "1" ] || exit 16
        [ "$("$JQ_FILE" -r '.channels[0].live' "$CHANNELS_FILE")" == "true" ] || exit 17
        [ "$("$JQ_FILE" -r '.channels[0] | has("subtitle") and has("hide") and has("const_cbr")' "$CHANNELS_FILE")" == "true" ] || exit 18
        [ "$("$JQ_FILE" -r '.channels[0].headers' "$CHANNELS_FILE")" == 'x-forwarded-for: 127.0.0.1\r\n' ] || exit 21

        # Run update_self second time (idempotent 2.1.0 -> 2.1.0)
        rm -f "$LOCK_FILE"
        unset d_version
        # shellcheck disable=SC1091
        . "$DEV_PATH/src/iptv/update_self" > /dev/null
        [ "$("$JQ_FILE" -r '.channels[0].live' "$CHANNELS_FILE")" == "true" ] || exit 19
        [ "$("$JQ_FILE" -r '.channels[0].stream_link | type' "$CHANNELS_FILE")" == "array" ] || exit 20

        # Test GetDefault & EditDefault on IPTV_CONFIG
        unset d_version
        GetDefault
        [ "$d_version" == "$sh_ver" ] || exit 21
        EditDefault bitrate "1500" > /dev/null
        [ "$("$JQ_FILE" -r '.bitrate' "$IPTV_CONFIG")" == "1500" ] || exit 22

        # Test GetChannel reads const_cbr & hide under set -u
        monitor=true
        kind=""
        output_dir_name="cctv1"
        GetChannel
        [ "$chnl_const_cbr" == "false" ] && [ "$chnl_hide" == "false" ] || exit 23
    ) || mig_rc=$?
    AssertEq "0" "$mig_rc" "IPTV_CONFIG split, 1.87.9->2.1.0 migration, idempotency, EditDefault & GetChannel succeed"

    # 5. FFmpeg capabilities & real dual-binary tests (FFmpeg 8.1.3 & FFmpeg 9.0.2_1 if installed)
    # shellcheck disable=SC1091
    . "$DEV_PATH/utils/ffmpeg_caps"

    local ff_bin ff_label
    for ff_bin in \
        "/opt/homebrew/Cellar/ffmpeg@8/8.1.3/bin/ffmpeg" \
        "/opt/homebrew/Cellar/ffmpeg/9.0.2_1/bin/ffmpeg"
    do
        if [ -x "$ff_bin" ]
        then
            FFMPEG_FILE="$ff_bin"
            FFMPEG_CAPS_BIN=""
            FFmpegDetectCaps "$ff_bin"
            ff_label="ffmpeg-${FFMPEG_MAJOR}.${FFMPEG_MINOR}"
            AssertEq "true" "$FFMPEG_HAS_FPS_MODE" "$ff_label: detects -fps_mode support"
            AssertEq "true" "$FFMPEG_HAS_ENHANCED_FLV_HEVC" "$ff_label: detects Enhanced FLV HEVC support"

            local norm_http norm_rtmp
            norm_http=$(FFmpegNormalizeFlags "-reconnect 1 -vsync 0 -qphist -filter_complex_script /tmp/f.txt" "https://example.test/live.m3u8")
            AssertContains "$norm_http" "-fps_mode passthrough" "$ff_label: rewrites -vsync 0 to -fps_mode passthrough"
            AssertNotContains "$norm_http" "-qphist" "$ff_label: strips deprecated -qphist"
            AssertContains "$norm_http" "-reconnect 1" "$ff_label: keeps -reconnect 1 for https"

            if [ "$FFMPEG_MAJOR" -ge 9 ]
            then
                AssertContains "$norm_http" "-/filter_complex" "$ff_label: rewrites -filter_complex_script to -/filter_complex"
            fi

            norm_rtmp=$(FFmpegNormalizeFlags "-reconnect 1 -vsync 0" "rtmp://example.test/app/stream")
            AssertNotContains "$norm_rtmp" "-reconnect" "$ff_label: strips -reconnect for non-HTTP URL"

            # Real short lavfi encode smoke test (HLS + Enhanced FLV HEVC)
            local hls_dir="$tmpdir/hls_${FFMPEG_MAJOR}" ff_rc=0
            mkdir -p "$hls_dir"
            "$ff_bin" -hide_banner -loglevel error -y \
                -f lavfi -i testsrc=duration=0.2:size=160x120:rate=10 \
                -f lavfi -i sine=frequency=440:duration=0.2 \
                -map 0:v -map 1:a -c:v libx264 -preset ultrafast -c:a aac \
                -fps_mode passthrough \
                -f hls -hls_time 1 -var_stream_map "v:0,a:0,name:sd" \
                -master_pl_name master.m3u8 "$hls_dir/v_%v.m3u8" > /dev/null 2>&1 || ff_rc=$?
            AssertEq "0" "$ff_rc" "$ff_label: real HLS multi-stream encode with -fps_mode passthrough succeeds"

            ff_rc=0
            "$ff_bin" -hide_banner -loglevel error -y \
                -f lavfi -i testsrc=duration=0.2:size=160x120:rate=10 \
                -f lavfi -i sine=frequency=440:duration=0.2 \
                -c:v libx265 -preset ultrafast -x265-params "vbv-maxrate=500:vbv-bufsize=500:log-level=none" \
                -c:a aac -fps_mode passthrough \
                -f flv "$tmpdir/out_${FFMPEG_MAJOR}.flv" > /dev/null 2>&1 || ff_rc=$?
            AssertEq "0" "$ff_rc" "$ff_label: real Enhanced FLV HEVC + x265 vbv encode succeeds"
        fi
    done

    # 6. Legacy v1 $AIOS_PREFIX/iptv -> v2 $AIOS_ROOT/iptv migration
    local legacy_rc=0
    (
        local leg_prefix="$tmpdir/legacy_prefix"
        AIOS_PREFIX="$leg_prefix"
        AIOS_ROOT="$AIOS_PREFIX/aios"
        IPTV_ROOT="$AIOS_ROOT/iptv"
        JQ_FILE="$AIOS_PREFIX/bin/jq"
        FFMPEG_FILE="$AIOS_PREFIX/bin/ffmpeg"
        FFPROBE_FILE="$AIOS_PREFIX/bin/ffprobe"
        LOCK_FILE="$IPTV_ROOT/lock"
        LOGROTATE_CONFIG="$IPTV_ROOT/logrotate"
        mkdir -p "$leg_prefix/iptv/ffmpeg-git-20240101-amd64-static"
        printf '#!/bin/sh\nexit 0\n' > "$leg_prefix/iptv/jq"
        printf '#!/bin/sh\nexit 0\n' > "$leg_prefix/iptv/ffmpeg-git-20240101-amd64-static/ffmpeg"
        chmod +x "$leg_prefix/iptv/jq" "$leg_prefix/iptv/ffmpeg-git-20240101-amd64-static/ffmpeg"
        printf 'old\n' > "$leg_prefix/iptv/lock"
        printf '%s/iptv/monitor.log {\n}\n' "$leg_prefix" > "$leg_prefix/iptv/logrotate"
        eval "$(sed -n '/^IptvMigrateLegacyRoot()/,/^}/p' "$DEV_PATH/src/tv")"
        IptvMigrateLegacyRoot > /dev/null
        [ ! -e "$leg_prefix/iptv" ] || exit 1
        [ -d "$IPTV_ROOT" ] || exit 2
        [ ! -e "$LOCK_FILE" ] || exit 3
        grep -Fq "$IPTV_ROOT/monitor.log" "$LOGROTATE_CONFIG" || exit 4
        [ -L "$JQ_FILE" ] && [ -x "$JQ_FILE" ] || exit 5
        [ -L "$FFMPEG_FILE" ] && [ -x "$FFMPEG_FILE" ] || exit 6
    ) || legacy_rc=$?
    AssertEq "0" "$legacy_rc" "IptvMigrateLegacyRoot moves legacy \$AIOS_PREFIX/iptv, rewrites logrotate, and clears old lock"

    rm -rf "$tmpdir"
}
