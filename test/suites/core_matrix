        local tun_cfg="$tmpd/neg_tun.json" hy_cfg="$tmpd/neg_hy.json" mq_cfg="$tmpd/neg_mq.json" rev_cfg="$tmpd/neg_rev.json"
        printf '{"inbounds":[{"tag":"tun-in","protocol":"tun","settings":{"name":"xray0","MTU":1500}}]}\n' > "$tun_cfg"
        printf '{"outbounds":[{"tag":"hy-out","protocol":"hysteria","settings":{"version":2,"address":"1.1.1.1","port":443}}]}\n' > "$hy_cfg"
        printf '{"outbounds":[{"tag":"mq-out","protocol":"masque","settings":{"address":"1.1.1.1","port":443}}]}\n' > "$mq_cfg"
        printf '{"reverse":{"bridges":[{"tag":"bridge","domain":"example.com"}]}}\n' > "$rev_cfg"
        AssertFail "xray v25.9.11: rule rejects tun inbound" ProxyValidateCandidateRules "xray" "$tun_cfg" "25.9.11" "json"
        AssertFail "xray v25.9.11: real binary rejects tun inbound" ProxyTestConfigWithBinary "xray" "${cores_dir}/xray/v25.9.11/xray" "$tun_cfg" "json" "$geodata_dir"
        AssertFail "xray v25.9.11: rule rejects hysteria outbound" ProxyValidateCandidateRules "xray" "$hy_cfg" "25.9.11" "json"
        AssertFail "xray v25.9.11: real binary rejects hysteria outbound" ProxyTestConfigWithBinary "xray" "${cores_dir}/xray/v25.9.11/xray" "$hy_cfg" "json" "$geodata_dir"
        AssertFail "xray v26.6.27: rule rejects masque outbound" ProxyValidateCandidateRules "xray" "$mq_cfg" "26.6.27" "json"
        AssertFail "xray v26.6.27: rule rejects legacy top-level reverse" ProxyValidateCandidateRules "xray" "$rev_cfg" "26.6.27" "json"
        if [ -x "${cores_dir}/xray/v26.6.27/xray" ]
        then
            AssertFail "xray v26.6.27: real binary rejects masque outbound" ProxyTestConfigWithBinary "xray" "${cores_dir}/xray/v26.6.27/xray" "$mq_cfg" "json" "$geodata_dir"
            AssertFail "xray v26.6.27: real binary rejects legacy top-level reverse" ProxyTestConfigWithBinary "xray" "${cores_dir}/xray/v26.6.27/xray" "$rev_cfg" "json" "$geodata_dir"
        else
            SkipDependency "core_matrix:case_e_xray_v26.6.27" "missing xray v26.6.27 for real negative test"
        fi

        local ss_dual_src="$tmpd/ss_dual.json" ss_dual_dst="$tmpd/ss_dual_out.json"
        printf '{"inbounds":[{"tag":"ss-in","listen":"127.0.0.1","port":18388,"protocol":"shadowsocks","settings":{"method":"aes-256-gcm","users":[{"method":"aes-256-gcm","password":"p1"}],"clients":[{"method":"aes-256-gcm","password":"p2"}]}}]}\n' > "$ss_dual_src"
        ProxyAdaptConfigForTarget "xray" "$ss_dual_src" "$ss_dual_dst" "26.11.9" "json"
        AssertOk "xray v26.11.9: SS dual-key removes clients when writing users" "$JQ_FILE" -e '(.inbounds[0].settings | has("users")) and (.inbounds[0].settings | has("clients") | not) and (.inbounds[0].settings.users[0].password == "p1")' "$ss_dual_dst"

        # Case F: ProxyGeodataUpdate rolls back symlink when post-update restart fails
        local geo_repo="$tmpd/geo_repo/202611240001"
        mkdir -p "$geo_repo"
        cp "$geodata_dir/geoip.dat" "$geo_repo/geoip.dat"
        cp "$geodata_dir/geosite.dat" "$geo_repo/geosite.dat"
        printf '%s  geoip.dat\n' "$(ProxySha256File "$geo_repo/geoip.dat")" > "$geo_repo/geoip.dat.sha256sum"
        printf '%s  geosite.dat\n' "$(ProxySha256File "$geo_repo/geosite.dat")" > "$geo_repo/geosite.dat.sha256sum"
        local orig_geo_link="${PROXY_GEODATA_LINK:-}" orig_geo_mirror="${PROXY_GEODATA_MIRROR_LINK:-}"
        local prev_geo_target
        prev_geo_target=$(readlink "$PROXY_GEODATA_CURRENT")
        PROXY_GEODATA_LINK="file://${tmpd}/geo_repo"
        PROXY_GEODATA_MIRROR_LINK="file://${tmpd}/geo_repo"
        touch "$mock_state/aios-xray.active"
        touch "$mock_state/fail_next_restart"
        AssertFail "ProxyGeodataUpdate rolls back when post-update restart fails" ProxyGeodataUpdate "202611240001"
        AssertEq "$prev_geo_target" "$(readlink "$PROXY_GEODATA_CURRENT")" "geodata current symlink restored after rollback"
        PROXY_GEODATA_LINK="$orig_geo_link"
        PROXY_GEODATA_MIRROR_LINK="$orig_geo_mirror"

        # Case G (ARCH-01 + ARCH-02): V2Ray jsonv5 WebSocket alias, jsonv4 <-> jsonv5 bidirectional conversion, jsonv5 protocols & account deletion against real v2ray v5.56.0
        if [ -x "${cores_dir}/v2ray/v5.56.0/v2ray" ]
        then
            local v5_bin="${cores_dir}/v2ray/v5.56.0/v2ray"
            local arch01_xdg="$tmpd/arch01_xdg"

            # ARCH-01a: jsonv5 WebSocket transport alias is "ws"
            local ws_v5_st1 ws_v5_st2
            ws_v5_st1=$(ProxyBuildStreamSettings "v2ray" "5.56.0" "jsonv5" "ws" "tls" '{"path":"/ws-v5","sni":"ws.example.test","alpn":["h2"]}')
            ws_v5_st2=$(ProxyBuildStreamSettings "v2ray" "5.56.0" "jsonv5" "websocket" "none" '{"path":"/ws-v5b"}')
            AssertEq "ws" "$(printf '%s' "$ws_v5_st1" | $JQ_FILE -r '.transport')" "ARCH-01: jsonv5 ws stream uses transport=ws"
            AssertEq "ws" "$(printf '%s' "$ws_v5_st2" | $JQ_FILE -r '.transport')" "ARCH-01: jsonv5 websocket alias maps to transport=ws"
            AssertEq "h2" "$(printf '%s' "$ws_v5_st1" | $JQ_FILE -r '.securitySettings.nextProtocol[0]')" "ARCH-01: jsonv5 maps alpn to securitySettings.nextProtocol"

            # ARCH-01b: jsonv4 <-> jsonv5 bidirectional conversion with tlsSettings <-> securitySettings & regular protocols + real v2ray v5.56.0 test
            local test_crt="$tmpd/arch01.crt" test_key="$tmpd/arch01.key"
            openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout "$test_key" -out "$test_crt" -days 1 -subj "/CN=ws.example.test" > /dev/null 2>&1
            chmod 644 "$test_crt" "$test_key"
            local bi_v4="$tmpd/bi_src_v4.json" bi_v5="$tmpd/bi_dst_v5.json" bi_rt_v4="$tmpd/bi_rt_v4.json"
            $JQ_FILE -n --arg crt "$test_crt" --arg key "$test_key" '{
                log: {loglevel: "warning"},
                inbounds: [
                    {
                        tag: "vmess-ws-tls",
                        listen: "127.0.0.1",
                        port: 24401,
                        protocol: "vmess",
                        settings: {clients: [{id: "11111111-1111-4111-8111-111111111111", alterId: 0}]},
                        streamSettings: {
                            network: "ws",
                            security: "tls",
                            wsSettings: {path: "/ws-bi", headers: {Host: "ws.example.test"}},
                            tlsSettings: {serverName: "ws.example.test", alpn: ["h2", "http/1.1"], certificates: [{certificateFile: $crt, keyFile: $key}]}
                        }
                    },
                    {tag: "vless-in", listen: "127.0.0.1", port: 24402, protocol: "vless", settings: {decryption: "none", clients: [{id: "22222222-2222-4222-8222-222222222222"}]}},
                    {tag: "trojan-in", listen: "127.0.0.1", port: 24403, protocol: "trojan", settings: {clients: [{password: "trj-secret"}]}},
                    {tag: "socks-in", listen: "127.0.0.1", port: 24404, protocol: "socks", settings: {auth: "noauth", udp: true}},
                    {tag: "http-in", listen: "127.0.0.1", port: 24405, protocol: "http", settings: {}}
                ],
                outbounds: [
                    {
                        tag: "vmess-out",
                        protocol: "vmess",
                        settings: {vnext: [{address: "127.0.0.1", port: 443, users: [{id: "11111111-1111-4111-8111-111111111111", alterId: 0, security: "auto"}]}]},
                        streamSettings: {network: "ws", security: "tls", wsSettings: {path: "/ws-out", headers: {Host: "out.example.test"}}, tlsSettings: {serverName: "out.example.test", alpn: ["h2"]}}
                    },
                    {tag: "vless-out", protocol: "vless", settings: {vnext: [{address: "127.0.0.1", port: 443, users: [{id: "22222222-2222-4222-8222-222222222222", encryption: "none"}]}]}},
                    {tag: "trojan-out", protocol: "trojan", settings: {servers: [{address: "127.0.0.1", port: 443, password: "trj-out"}]}},
                    {tag: "hy2-out", protocol: "hysteria2", settings: {servers: [{address: "127.0.0.1", port: 8443}]}, streamSettings: {network: "hy2", security: "tls", hy2Settings: {password: "hy2-pw"}, tlsSettings: {serverName: "hy2.example.test"}}}
                ]
            }' > "$bi_v4"
            AssertOk "ARCH-01: source jsonv4 passes real v2ray v5.56.0 test (-format json)" ProxyTestConfigWithBinary "v2ray" "$v5_bin" "$bi_v4" "jsonv4" "$geodata_dir" "$arch01_xdg"
            AssertOk "ARCH-01: ProxyAdaptConfigForTarget converts jsonv4 -> jsonv5" ProxyAdaptConfigForTarget "v2ray" "$bi_v4" "$bi_v5" "5.56.0" "jsonv5"
            AssertJsonEq "$bi_v5" '.inbounds[0].streamSettings.transport' "ws" "ARCH-01: jsonv4 -> jsonv5 maps ws to transport=ws"
            AssertJsonEq "$bi_v5" '.inbounds[0].streamSettings.securitySettings.serverName' "ws.example.test" "ARCH-01: jsonv4 -> jsonv5 maps tlsSettings to securitySettings"
            AssertJsonEq "$bi_v5" '.inbounds[0].streamSettings.securitySettings.nextProtocol[0]' "h2" "ARCH-01: jsonv4 -> jsonv5 maps alpn to nextProtocol"
            AssertJsonEq "$bi_v5" '.inbounds[0].streamSettings.securitySettings.certificate[0].certificateFile' "$test_crt" "ARCH-01: jsonv4 -> jsonv5 maps certificates to certificate"
            AssertJsonEq "$bi_v5" '.outbounds[3].settings.server[0].address' "127.0.0.1" "ARCH-01: jsonv4 -> jsonv5 maps hysteria2 servers to server"
            AssertOk "ARCH-01: converted jsonv5 passes real v2ray v5.56.0 test (-format jsonv5)" ProxyTestConfigWithBinary "v2ray" "$v5_bin" "$bi_v5" "jsonv5" "$geodata_dir" "$arch01_xdg"

            AssertOk "ARCH-01: ProxyAdaptConfigForTarget converts jsonv5 -> jsonv4" ProxyAdaptConfigForTarget "v2ray" "$bi_v5" "$bi_rt_v4" "5.56.0" "jsonv4"
            AssertJsonEq "$bi_rt_v4" '.inbounds[0].streamSettings.network' "ws" "ARCH-01: jsonv5 -> jsonv4 restores network=ws"
            AssertJsonEq "$bi_rt_v4" '.inbounds[0].streamSettings.tlsSettings.serverName' "ws.example.test" "ARCH-01: jsonv5 -> jsonv4 restores tlsSettings.serverName"
            AssertJsonEq "$bi_rt_v4" '.inbounds[0].streamSettings.tlsSettings.alpn[0]' "h2" "ARCH-01: jsonv5 -> jsonv4 restores tlsSettings.alpn"
            AssertJsonEq "$bi_rt_v4" '.inbounds[0].streamSettings.tlsSettings.certificates[0].certificateFile' "$test_crt" "ARCH-01: jsonv5 -> jsonv4 restores tlsSettings.certificates"
            AssertJsonEq "$bi_rt_v4" '.outbounds[3].settings.servers[0].address' "127.0.0.1" "ARCH-01: jsonv5 -> jsonv4 restores hysteria2 servers"
            AssertOk "ARCH-01: round-tripped jsonv4 passes real v2ray v5.56.0 test (-format json)" ProxyTestConfigWithBinary "v2ray" "$v5_bin" "$bi_rt_v4" "jsonv4" "$geodata_dir" "$arch01_xdg"

            # ARCH-02: jsonv5 inbound menu excludes shadowsocks2022; vmess/vless/trojan/http/socks inbounds + hysteria2 outbound (incl. uri_codec) pass real v2ray v5.56.0 test -format jsonv5; delete_inbound_account & delete_outbound_account compatible with jsonv5
            local orig_v2_fmt_env="${AIOS_V2RAY_FORMAT:-}" orig_v2_ver_env="${AIOS_V2RAY_TARGET_VERSION:-}"
            ProxyCoreImport "v2ray" "$v5_bin" "test" > /dev/null
            AIOS_V2RAY_FORMAT="jsonv5"
            AIOS_V2RAY_TARGET_VERSION="5.56.0"
            printf '{"core":"v2ray","format":"jsonv5","target_version":"5.56.0"}\n' > "$V2_META"
            printf '{"inbounds":[],"outbounds":[{"tag":"direct","protocol":"freedom","settings":{}}]}\n' > "$V2_CONFIG"

            MockInquirerReset
            MockInquirerPush "vmess"
            V2raySetInboundProtocol "5.56.0" "jsonv5" > /dev/null
            AssertInquirerDrained "ARCH-02: V2raySetInboundProtocol drained"
            AssertNotContains "${protocol_options[*]}" "shadowsocks2022" "ARCH-02: jsonv5 inbound protocol menu omits shadowsocks2022"

            # Add vmess, vless, trojan, http, socks inbounds via real V2rayAddInbound (calls ProxyConfigTx -> real v2ray test -format jsonv5)
            MockInquirerReset
            MockInquirerPush "vmess" "tcp" "0" "off" "0" "" "0" "0" "$i18n_no" "$i18n_no" "none" "v5-vmess" "127.0.0.1" "11111111-1111-4111-8111-111111111111" "$i18n_no" "none"
            AssertOk "ARCH-02: V2rayAddInbound jsonv5 vmess passes real v2ray test" V2rayAddInbound <<< "24501"
            AssertInquirerDrained "ARCH-02: V2rayAddInbound jsonv5 vmess drained"

            MockInquirerReset
            MockInquirerPush "vless" "tcp" "0" "off" "0" "" "0" "0" "$i18n_no" "$i18n_no" "none" "v5-vless" "127.0.0.1" "22222222-2222-4222-8222-222222222222" "$i18n_no" "none"
            AssertOk "ARCH-02: V2rayAddInbound jsonv5 vless passes real v2ray test" V2rayAddInbound <<< "24502"
            AssertInquirerDrained "ARCH-02: V2rayAddInbound jsonv5 vless drained"

            MockInquirerReset
            MockInquirerPush "trojan" "tcp" "0" "off" "0" "" "0" "0" "$i18n_no" "$i18n_no" "none" "v5-trojan" "127.0.0.1" "v5-trj-pass" "$i18n_no" "none"
            AssertOk "ARCH-02: V2rayAddInbound jsonv5 trojan passes real v2ray test" V2rayAddInbound <<< "24503"
            AssertInquirerDrained "ARCH-02: V2rayAddInbound jsonv5 trojan drained"

            MockInquirerReset
            MockInquirerPush "http" "tcp" "0" "off" "0" "" "0" "0" "$i18n_no" "$i18n_no" "none" "v5-http" "127.0.0.1" "$i18n_no" "none"
            AssertOk "ARCH-02: V2rayAddInbound jsonv5 http passes real v2ray test" V2rayAddInbound <<< "24504"
            AssertInquirerDrained "ARCH-02: V2rayAddInbound jsonv5 http drained"

            MockInquirerReset
            MockInquirerPush "socks" "tcp" "0" "off" "0" "" "0" "0" "$i18n_no" "$i18n_no" "none" "v5-socks" "127.0.0.1" "$i18n_yes" "127.0.0.1" "$i18n_no" "none"
            AssertOk "ARCH-02: V2rayAddInbound jsonv5 socks passes real v2ray test" V2rayAddInbound <<< "24505"
            AssertInquirerDrained "ARCH-02: V2rayAddInbound jsonv5 socks drained"

            # Add hysteria2 outbound via real V2rayAddOutbound (passes real v2ray test -format jsonv5)
            MockInquirerReset
            MockInquirerPush "hysteria2" "v5-hy2-out" "0.0.0.0" "$i18n_no" "-1" "127.0.0.1" "" "0" "0" "0" "" "0" "0" "hy2-v5-pass" "$i18n_no" "hy2.example.test" "0" "h3" "$i18n_no" "" "$i18n_no"
            AssertOk "ARCH-02: V2rayAddOutbound jsonv5 hysteria2 passes real v2ray test" V2rayAddOutbound <<< "8443"
            AssertInquirerDrained "ARCH-02: V2rayAddOutbound jsonv5 hysteria2 drained"
            AssertJsonEq "$V2_CONFIG" '.outbounds[-1].settings.server[0].address' "127.0.0.1" "ARCH-02: jsonv5 hysteria2 outbound writes settings.server"

            # uri_codec hysteria2 under jsonv5 passes real v2ray v5.56.0 test -format jsonv5
            local hy2_uri_out hy2_uri_cfg="$tmpd/arch02_hy2_uri.json"
            hy2_uri_out=$(ProxyParseUriToOutbound "hy2://uri-hy2-pw@127.0.0.1:8443?sni=uri.example.test#uri-hy2" "v2ray" "5.56.0" "jsonv5")
            AssertContains "$hy2_uri_out" '"server"' "ARCH-02: uri_codec jsonv5 hysteria2 uses settings.server"
            AssertContains "$hy2_uri_out" '"transportSettings"' "ARCH-02: uri_codec jsonv5 hysteria2 uses transportSettings"
            $JQ_FILE -n --argjson o "$hy2_uri_out" '{outbounds:[$o]}' > "$hy2_uri_cfg"
            AssertOk "ARCH-02: uri_codec jsonv5 hysteria2 passes real v2ray test (-format jsonv5)" ProxyTestConfigWithBinary "v2ray" "$v5_bin" "$hy2_uri_cfg" "jsonv5" "$geodata_dir" "$arch01_xdg"

            # V2rayDeleteInboundAccount & V2rayDeleteOutboundAccount under jsonv5
            JQ mutate "$V2_CONFIG" '.inbounds[0].settings.users += ["33333333-3333-4333-8333-333333333333"]'
            MockInquirerReset
            MockInquirerPush "0" "1"
            AssertOk "ARCH-02: V2rayDeleteInboundAccount works on jsonv5 users[]" V2rayDeleteInboundAccount
            AssertInquirerDrained "ARCH-02: V2rayDeleteInboundAccount jsonv5 drained"
            AssertJsonEq "$V2_CONFIG" '.inbounds[0].settings.users | length' "1" "ARCH-02: jsonv5 inbound users[] reduced to 1"

            JQ mutate "$V2_CONFIG" '.outbounds[-1].settings.server += [{"address":"127.0.0.2","port":8444}]'
            MockInquirerReset
            MockInquirerPush "1" "1"
            AssertOk "ARCH-02: V2rayDeleteOutboundAccount works on jsonv5 hysteria2 server[]" V2rayDeleteOutboundAccount
            AssertInquirerDrained "ARCH-02: V2rayDeleteOutboundAccount jsonv5 server[] drained"
            AssertJsonEq "$V2_CONFIG" '.outbounds[-1].settings.server | length' "1" "ARCH-02: jsonv5 hysteria2 server[] reduced to 1"

            if [ -n "$orig_v2_fmt_env" ]
            then
                AIOS_V2RAY_FORMAT="$orig_v2_fmt_env"
            else
                unset AIOS_V2RAY_FORMAT
            fi
            if [ -n "$orig_v2_ver_env" ]
            then
                AIOS_V2RAY_TARGET_VERSION="$orig_v2_ver_env"
            else
                unset AIOS_V2RAY_TARGET_VERSION
            fi
        else
            SkipDependency "core_matrix:case_g_v2ray_v5.56.0" "missing v2ray v5.56.0 for ARCH-01/ARCH-02 tests"
        fi

        eval "$orig_svc_is_active"
        eval "$orig_svc_is_enabled"
        eval "$orig_svc_ctrl"
        eval "$orig_proxy_readiness"
        PROXY_OBSERVE_SECONDS="$orig_obs"
    else
        SkipDependency "core_matrix:transactional_xray_cores" "missing xray v25.9.11 or v26.11.9 for transactional tests"
    fi

    eval "$orig_svc_resolve"
    PATH="$orig_cm_path"

    # Case H (POLKIT-REG-04): Real systemd lifecycle & daemon-reload integration (linux-root-systemd only)
    if [ "${AIOS_TEST_HOST_OS:-}" == "mac" ]
    then
        SkipPlatform "POLKIT-REG-04: real systemd lifecycle and daemon-reload integration" "Linux root systemd only"
    elif [ "${AIOS_TEST_HAS_REAL_SYSTEMD:-0}" != "1" ]
    then
        SkipPrivilege "POLKIT-REG-04: real systemd lifecycle and daemon-reload integration" "requires Linux root with real systemd"
    else
        local real_unit="aios-test-$$"
        local real_unit_file="/etc/systemd/system/${real_unit}.service"
        local sleep_bin=""
        sleep_bin=$(command -v sleep)
        cat > "$real_unit_file" <<REALSYS
[Unit]
Description=AIOS Real Systemd Regression Test Unit (${real_unit})

[Service]
Type=simple
ExecStart=${sleep_bin} 300
Restart=no

[Install]
WantedBy=multi-user.target
REALSYS
        AssertOk "POLKIT-REG-04: real systemctl daemon-reload succeeds" systemctl daemon-reload
        AssertOk "POLKIT-REG-04: real systemctl enable --now succeeds" systemctl enable --now "${real_unit}.service"
        AssertOk "POLKIT-REG-04: real systemctl is-active succeeds" systemctl is-active --quiet "${real_unit}.service"
        AssertOk "POLKIT-REG-04: real systemctl is-enabled succeeds" systemctl is-enabled --quiet "${real_unit}.service"
        AssertOk "POLKIT-REG-04: real systemctl restart succeeds" systemctl restart "${real_unit}.service"
        AssertOk "POLKIT-REG-04: real unit remains active after restart" systemctl is-active --quiet "${real_unit}.service"

        local orig_real_svc_resolve
        orig_real_svc_resolve=$(declare -f ServiceResolveLabel)
        # shellcheck disable=SC2329
        ServiceResolveLabel()
        {
            service_label="$real_unit"
            service_file="$real_unit_file"
        }

        if [ -s "$X_CONFIG" ]
        then
            AssertOk "POLKIT-REG-04: ProxyWriteServiceUnit real systemctl daemon-reload succeeds" ProxyWriteServiceUnit "xray"
            local real_tx_cfg=""
            real_tx_cfg=$(cat "$X_CONFIG")
            AssertOk "POLKIT-REG-04: ProxyConfigTx real systemctl daemon-reload succeeds" ProxyConfigTx "xray" "$real_tx_cfg" 1
        fi
        eval "$orig_real_svc_resolve"

        systemctl disable --now "${real_unit}.service" > /dev/null 2>&1 || true
        rm -f "$real_unit_file"
        AssertOk "POLKIT-REG-04: real systemctl daemon-reload cleanup succeeds" systemctl daemon-reload
    fi

    # 4. V2Ray XDG isolation test: poisoned host XDG_DATA_DIRS must not break AIOS v2ray test
    if [ -x "${cores_dir}/v2ray/v5.56.0/v2ray" ]
    then
        local poison_xdg="$tmpd/poison_xdg"
        mkdir -p "$poison_xdg/v2ray"
        printf 'CORRUPTED_GEOIP_DATA' > "$poison_xdg/v2ray/geoip.dat"
        printf 'CORRUPTED_GEOSITE_DATA' > "$poison_xdg/v2ray/geosite.dat"
        local geo_cfg="$tmpd/v2_geo_test.json"
        printf '{"inbounds":[{"tag":"socks-in","listen":"127.0.0.1","port":10808,"protocol":"socks","settings":{"udp":true}}],"outbounds":[{"tag":"direct","protocol":"freedom"},{"tag":"block","protocol":"blackhole"}],"routing":{"rules":[{"type":"field","ip":["geoip:private"],"outboundTag":"direct"}]}}\n' > "$geo_cfg"
        local orig_xdg_dirs="${XDG_DATA_DIRS:-}" orig_xdg_home="${XDG_DATA_HOME:-}"
        export XDG_DATA_DIRS="$poison_xdg"
        export XDG_DATA_HOME="$poison_xdg"
        AssertOk "v2ray v5.56.0: isolated XDG ignores poisoned host XDG_DATA_DIRS" ProxyTestConfigWithBinary "v2ray" "${cores_dir}/v2ray/v5.56.0/v2ray" "$geo_cfg" "jsonv4" "$geodata_dir" "$tmpd/clean_xdg"
        if [ -n "$orig_xdg_dirs" ]
        then
            export XDG_DATA_DIRS="$orig_xdg_dirs"
        else
            unset XDG_DATA_DIRS
        fi
        if [ -n "$orig_xdg_home" ]
        then
            export XDG_DATA_HOME="$orig_xdg_home"
        else
            unset XDG_DATA_HOME
        fi
    else
        SkipDependency "core_matrix:xdg_v2ray_v5.56.0" "missing v2ray v5.56.0 for XDG isolation test"
    fi

    PROXY_ROOT="$orig_proxy_root"
    PROXY_CORES_ROOT="$orig_proxy_cores_root"
    PROXY_CORES_MANIFEST="$orig_proxy_cores_manifest"
    PROXY_GEODATA_ROOT="$orig_proxy_geodata_root"
    PROXY_GEODATA_CURRENT="$orig_proxy_geodata_current"
    PROXY_XDG_ROOT="$orig_proxy_xdg_root"
    PROXY_TMP_ROOT="$orig_proxy_tmp_root"
