E2E_SANDBOX_DIR=""

E2eSandboxInit()
{
    local built_aios="${1:-$REPO_ROOT/aios.sh}"
    E2E_SANDBOX_DIR=$(mktemp -d "${TMPDIR:-/tmp}/aios-e2e.XXXXXX")
    mkdir -p \
        "$E2E_SANDBOX_DIR/bin" \
        "$E2E_SANDBOX_DIR/aios/proxy/xray/backups" \
        "$E2E_SANDBOX_DIR/aios/proxy/xray/logs" \
        "$E2E_SANDBOX_DIR/aios/proxy/v2ray/backups" \
        "$E2E_SANDBOX_DIR/aios/proxy/v2ray/logs" \
        "$E2E_SANDBOX_DIR/aios/proxy/cores/xray" \
        "$E2E_SANDBOX_DIR/aios/proxy/cores/v2ray" \
        "$E2E_SANDBOX_DIR/aios/proxy/geodata/current" \
        "$E2E_SANDBOX_DIR/aios/proxy/xdg" \
        "$E2E_SANDBOX_DIR/mock_svc_state"

    cp "$built_aios" "$E2E_SANDBOX_DIR/bin/tv"
    chmod +x "$E2E_SANDBOX_DIR/bin/tv"
    local alias_cmd
    for alias_cmd in x v2 nx or ibm cf cx arm pve ali lhh rc cw dr ha
    do
        ln -sf "$E2E_SANDBOX_DIR/bin/tv" "$E2E_SANDBOX_DIR/bin/$alias_cmd"
    done

    ln -sf "$(command -v jq)" "$E2E_SANDBOX_DIR/bin/jq"
    printf 'sh_locale=zh_CN\nexport LANG=zh_CN.UTF-8\nlocale_fix=0\n' > "$E2E_SANDBOX_DIR/bin/tv-i18n"

    # Mock isolated aios-xray binary (no public xray binary in sandbox PATH)
    cat > "$E2E_SANDBOX_DIR/bin/aios-xray" <<'MOCKX'
#!/bin/bash
case "${1:-}" in
    version)
        printf 'Xray 26.11.9 (Xray, Penetrates Everything.) Mock\n'
    ;;
    uuid)
        printf '00000000-0000-4000-8000-00000000aaaa\n'
    ;;
    x25519)
        printf 'PrivateKey: mock-priv-key-1234567890\nPassword (PublicKey): mock-pub-key-1234567890\n'
    ;;
    wg)
        printf 'PrivateKey: mock-wg-priv-1234567890\nPassword (PublicKey): mock-wg-pub-1234567890\n'
    ;;
    api)
        printf '{"stat":[{"name":"inbound>>>vless-reality>>>traffic>>>uplink","value":2097152},{"name":"inbound>>>vless-reality>>>traffic>>>downlink","value":5242880},{"name":"user>>>alice@example.test>>>online","value":1}]}\n'
    ;;
    -test|run)
        printf 'Configuration OK.\n'
    ;;
    *)
        printf 'aios-xray mock\n'
    ;;
esac
MOCKX
    chmod +x "$E2E_SANDBOX_DIR/bin/aios-xray"

    # Mock isolated aios-v2ray binary (v5 CLI, no v2ctl in sandbox PATH)
    cat > "$E2E_SANDBOX_DIR/bin/aios-v2ray" <<'MOCKV2'
#!/bin/bash
case "${1:-}" in
    version)
        printf 'V2Ray 5.56.0 (V2Fly, a community-driven edition of V2Ray.) Mock\n'
    ;;
    uuid)
        printf '00000000-0000-4000-8000-00000000bbbb\n'
    ;;
    api)
        printf '{"stat":[{"name":"inbound>>>vmess-direct>>>traffic>>>uplink","value":1048576}]}\n'
    ;;
    test|run)
        printf 'Configuration OK.\n'
    ;;
    *)
        printf 'aios-v2ray mock\n'
    ;;
esac
MOCKV2
    chmod +x "$E2E_SANDBOX_DIR/bin/aios-v2ray"

    cat > "$E2E_SANDBOX_DIR/bin/dig" <<'MOCKDIG'
#!/bin/bash
printf '203.0.113.10\n'
MOCKDIG
    chmod +x "$E2E_SANDBOX_DIR/bin/dig"

    cat > "$E2E_SANDBOX_DIR/bin/curl" <<'MOCKCURL'
#!/bin/bash
printf '203.0.113.10\n'
MOCKCURL
    chmod +x "$E2E_SANDBOX_DIR/bin/curl"

    # Stateful mock systemctl for safe status/restart/rollback failure injection
    cat > "$E2E_SANDBOX_DIR/bin/systemctl" <<'MOCKSYS'
#!/bin/bash
STATE_DIR="${AIOS_MOCK_SVC_STATE_DIR:-}"
action="${1:-}"
shift || true
target=""
for arg in "$@"
do
    case "$arg" in
        -*) continue ;;
        *) target="$arg" ;;
    esac
done
if [ -n "$STATE_DIR" ]
then
    case "$action" in
        is-active)
            [ -f "$STATE_DIR/${target}.active" ] && exit 0 || exit 3
        ;;
        start|restart)
            if [ -f "$STATE_DIR/fail_next_restart" ]
            then
                rm -f "$STATE_DIR/fail_next_restart"
                rm -f "$STATE_DIR/${target}.active"
                printf 'mock restart failed\n' >&2
                exit 1
            fi
            if [ -f "$STATE_DIR/fail_all_restarts" ]
            then
                rm -f "$STATE_DIR/${target}.active"
                printf 'mock persistent restart failure\n' >&2
                exit 1
            fi
            touch "$STATE_DIR/${target}.active"
            exit 0
        ;;
        stop)
            rm -f "$STATE_DIR/${target}.active"
            exit 0
        ;;
    esac
fi
printf 'systemctl mock: %s\n' "$*"
MOCKSYS
    chmod +x "$E2E_SANDBOX_DIR/bin/systemctl"

    # Mock ss so ProxyCheckReadiness exercises real jq/awk parsing against active mocked services
    cat > "$E2E_SANDBOX_DIR/bin/ss" <<'MOCKSS'
#!/bin/bash
STATE_DIR="${AIOS_MOCK_SVC_STATE_DIR:-}"
PREFIX_DIR="${AIOS_PREFIX:-}"
JQ_BIN="${PREFIX_DIR}/bin/jq"
[ -x "$JQ_BIN" ] || JQ_BIN=$(command -v jq || true)
printf 'Netid State  Recv-Q Send-Q Local Address:Port Peer Address:Port\n'
[ -n "$STATE_DIR" ] && [ -n "$PREFIX_DIR" ] && [ -x "$JQ_BIN" ] || exit 0
for core in xray v2ray
do
    [ -f "$STATE_DIR/aios-${core}.active" ] || continue
    cfg="$PREFIX_DIR/aios/proxy/${core}/config.json"
    [ -s "$cfg" ] || continue
    while IFS= read -r p
    do
        [ -z "$p" ] && continue
        IFS=',' read -r -a toks <<< "$p"
        for tok in "${toks[@]+"${toks[@]}"}"
        do
            tok="${tok//[[:space:]]/}"
            port="${tok%%-*}"
            if [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -gt 0 ]
            then
                printf 'tcp   LISTEN 0      128    0.0.0.0:%s 0.0.0.0:*\n' "$port"
            fi
        done
    done < <("$JQ_BIN" -r '
        [
            ((if (.inbounds | type) == "array" then .inbounds else [] end)[]
                | select(type == "object" and (.protocol // "") != "tun")
                | (.port // empty | tostring)
                | select(length > 0 and . != "0")),
            (if (.api | type) == "object" and (.api.listen | type) == "string" and (.api.listen | contains(":")) then
                (.api.listen | split(":") | last)
            else empty end)
        ] | unique[]
    ' "$cfg" 2> /dev/null || true)
done
MOCKSS
    chmod +x "$E2E_SANDBOX_DIR/bin/ss"
}

E2eSandboxCleanup()
{
    if [ -n "${E2E_SANDBOX_DIR:-}" ] && [ -d "$E2E_SANDBOX_DIR" ]
    then
        rm -rf "$E2E_SANDBOX_DIR"
        E2E_SANDBOX_DIR=""
    fi
}

E2eLoadFixture()
{
    local target="$1"
    local fixture_file="$2"

    if [ "$target" == "xray" ]
    then
        cp "$REPO_ROOT/test/fixtures/$fixture_file" "$E2E_SANDBOX_DIR/aios/proxy/xray/config.json"
    elif [ "$target" == "v2ray" ]
    then
        cp "$REPO_ROOT/test/fixtures/$fixture_file" "$E2E_SANDBOX_DIR/aios/proxy/v2ray/config.json"
    fi
}

E2eRunPty()
{
    local cmd_name="$1"
    local steps_json="$2"
    local mode_flag="${3:-}"

    PATH="$E2E_SANDBOX_DIR/bin:$PATH" \
    AIOS_PREFIX="$E2E_SANDBOX_DIR" \
    AIOS_MOCK_SVC_STATE_DIR="$E2E_SANDBOX_DIR/mock_svc_state" \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN \
        bash "$REPO_ROOT/test/lib/pty_driver" \
        --cmd "$E2E_SANDBOX_DIR/bin/$cmd_name" \
        --timeout 3 \
        --steps "$steps_json" \
        ${mode_flag:+$mode_flag}
}
