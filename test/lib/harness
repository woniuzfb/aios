# shellcheck shell=bash

PASS_COUNT=0
FAIL_COUNT=0
SKIP_PLATFORM_COUNT=0
SKIP_PRIVILEGE_COUNT=0
SKIP_DEPENDENCY_COUNT=0
SHOW_OUTPUT="${SHOW_OUTPUT:-0}"

AIOS_TEST_CASES_FILE="${AIOS_TEST_CASES_FILE:-}"
AIOS_TEST_EVENTS_FILE="${AIOS_TEST_EVENTS_FILE:-}"
AIOS_TEST_FAIL_LOG="${AIOS_TEST_FAIL_LOG:-}"

MOCK_INQUIRER_QUEUE=()
MOCK_INQUIRER_POS=0
MOCK_INQUIRER_TRACE=()
MOCK_SERVICE_CALLS=()
MOCK_INQUIRER_STATE_DIR="${MOCK_INQUIRER_STATE_DIR:-}"

StripAnsi()
{
    printf '%b' "$1" | sed -E $'s/\x1b\\[[0-9;]*[a-zA-Z]//g' | tr -d '\r'
}

HarnessSanitizeId()
{
    local raw="$1"
    raw="${raw//$'\t'/ }"
    raw="${raw//$'\n'/ }"
    raw="${raw//$'\r'/ }"
    printf '%s' "$raw"
}

HarnessRecordCase()
{
    local status="$1"
    local case_id="$2"

    if [ -n "${AIOS_TEST_CASES_FILE:-}" ]
    then
        printf '%s\t%s\n' "$status" "$(HarnessSanitizeId "$case_id")" >> "$AIOS_TEST_CASES_FILE"
    fi
}

HarnessEmitEvent()
{
    local line="$1"

    if [ -n "${AIOS_TEST_EVENTS_FILE:-}" ]
    then
        printf '%s\n' "$line" >> "$AIOS_TEST_EVENTS_FILE"
    fi

    printf '%s\n' "$line"
}

HarnessEmitFail()
{
    local msg="$1"

    if [ -n "${AIOS_TEST_EVENTS_FILE:-}" ]
    then
        printf '%s\n' "$msg" >> "$AIOS_TEST_EVENTS_FILE"
    fi

    if [ -n "${AIOS_TEST_FAIL_LOG:-}" ]
    then
        printf '%s\n' "$msg" >> "$AIOS_TEST_FAIL_LOG"
        printf '%s\n' "$msg"
    else
        printf '%s\n' "$msg" >&2
    fi
}

RecordPass()
{
    local label="$1"
    PASS_COUNT=$((PASS_COUNT + 1))
    HarnessRecordCase "PASS" "$label"
    HarnessEmitEvent "[PASS] ${label}"
}

RecordFail()
{
    local label="$1"
    local detail="${2:-}"
    FAIL_COUNT=$((FAIL_COUNT + 1))
    HarnessRecordCase "FAIL" "$label"

    if [ -n "$detail" ]
    then
        HarnessEmitFail "[FAIL] ${label}
${detail}"
    else
        HarnessEmitFail "[FAIL] ${label}"
    fi
}

SkipPlatform()
{
    local case_id="$1"
    local reason="$2"
    SKIP_PLATFORM_COUNT=$((SKIP_PLATFORM_COUNT + 1))
    HarnessRecordCase "SKIP_PLATFORM" "$case_id"
    HarnessEmitEvent "[SKIP][platform] ${case_id}: ${reason}"
}

SkipPrivilege()
{
    local case_id="$1"
    local reason="$2"

    if [ "${AIOS_REQUIRE_ROOT_SYSTEMD:-0}" == "1" ]
    then
        local msg="[FAIL] [SKIP][privilege] forbidden in linux-root-systemd: ${case_id}: ${reason}"
        FAIL_COUNT=$((FAIL_COUNT + 1))
        HarnessRecordCase "FAIL" "$case_id"
        HarnessEmitFail "$msg"
        return 0
    fi

    SKIP_PRIVILEGE_COUNT=$((SKIP_PRIVILEGE_COUNT + 1))
    HarnessRecordCase "SKIP_PRIVILEGE" "$case_id"
    HarnessEmitEvent "[SKIP][privilege] ${case_id}: ${reason}"
}

SkipDependency()
{
    local case_id="$1"
    local reason="$2"

    if [ "${AIOS_REQUIRE_CORE_MATRIX:-0}" == "1" ] || [ "${AIOS_STRICT_DEPS:-0}" == "1" ]
    then
        local msg="[FAIL] [SKIP][dependency] forbidden in strict mode: ${case_id}: ${reason}"
        FAIL_COUNT=$((FAIL_COUNT + 1))
        HarnessRecordCase "FAIL" "$case_id"
        HarnessEmitFail "$msg"
        return 0
    fi

    SKIP_DEPENDENCY_COUNT=$((SKIP_DEPENDENCY_COUNT + 1))
    HarnessRecordCase "SKIP_DEPENDENCY" "$case_id"
    HarnessEmitEvent "[SKIP][dependency] ${case_id}: ${reason}"
}

ShowCaptured()
{
    local title="$1"
    local body="$2"

    if [ "$SHOW_OUTPUT" -eq 1 ]
    then
        printf '\n--- [OUTPUT] %s ---\n' "$title"
        StripAnsi "$body"
        printf '\n--- [END] %s ---\n' "$title"
    fi
}

AssertEq()
{
    local expected="$1"
    local actual="$2"
    local label="$3"

    if [ "$expected" == "$actual" ]
    then
        PASS_COUNT=$((PASS_COUNT + 1))
        HarnessRecordCase "PASS" "$label"
        HarnessEmitEvent "[PASS] ${label}"
    else
        local detail
        detail=$(printf '  expected: %q\n  actual:   %q' "$expected" "$actual")
        RecordFail "$label" "$detail"
    fi
}

AssertContains()
{
    local haystack="$1"
    local needle="$2"
    local label="$3"
    local plain
    plain=$(StripAnsi "$haystack")

    if [[ "$plain" == *"$needle"* ]]
    then
        PASS_COUNT=$((PASS_COUNT + 1))
        HarnessRecordCase "PASS" "$label"
        HarnessEmitEvent "[PASS] ${label}"
    else
        local detail
        detail=$(printf '  missing substring: %q' "$needle")
        RecordFail "$label" "$detail"
    fi
}

AssertNotContains()
{
    local haystack="$1"
    local needle="$2"
    local label="$3"
    local plain
    plain=$(StripAnsi "$haystack")

    if [[ "$plain" != *"$needle"* ]]
    then
        PASS_COUNT=$((PASS_COUNT + 1))
        HarnessRecordCase "PASS" "$label"
        HarnessEmitEvent "[PASS] ${label}"
    else
        local detail
        detail=$(printf '  unexpected substring: %q' "$needle")
        RecordFail "$label" "$detail"
    fi
}

AssertJsonEq()
{
    local file="$1"
    local expr="$2"
    local expected="$3"
    local label="$4"
    local actual
    actual=$($JQ_FILE -r "$expr" "$file")
    AssertEq "$expected" "$actual" "$label"
}

AssertOk()
{
    local label="$1"
    shift

    if "$@" > /dev/null 2>&1
    then
        PASS_COUNT=$((PASS_COUNT + 1))
        HarnessRecordCase "PASS" "$label"
        HarnessEmitEvent "[PASS] ${label}"
    else
        RecordFail "${label} (command failed: $*)"
    fi
}

AssertFail()
{
    local label="$1"
    shift

    if "$@" > /dev/null 2>&1
    then
        RecordFail "${label} (expected failure but succeeded: $*)"
    else
        PASS_COUNT=$((PASS_COUNT + 1))
        HarnessRecordCase "PASS" "$label"
        HarnessEmitEvent "[PASS] ${label}"
    fi
}

AssertFailWithOutput()
{
    local label="$1"
    local expected_pattern="$2"
    shift 2

    local out="" rc=0 plain=""
    out=$("$@" 2>&1) || rc=$?
    plain=$(StripAnsi "$out")

    if [ "$rc" -eq 0 ]
    then
        local detail
        detail=$(printf '  expected failure containing %q but command exited 0\n  output: %q' "$expected_pattern" "$plain")
        RecordFail "$label" "$detail"
        return 0
    fi

    if [[ "$plain" == *"$expected_pattern"* ]]
    then
        PASS_COUNT=$((PASS_COUNT + 1))
        HarnessRecordCase "PASS" "$label"
        HarnessEmitEvent "[PASS] ${label}"
    else
        local detail
        detail=$(printf '  expected failure output substring: %q\n  exit_code: %d\n  actual output: %q' "$expected_pattern" "$rc" "$plain")
        RecordFail "$label" "$detail"
    fi
}

TestInstallLinuxSystemctlStub()
{
    local bin_dir="$1"
    local log_file="$2"
    local state_dir="$3"

    if [ "${AIOS_TEST_HOST_OS:-}" != "linux" ]
    then
        printf '[ERROR] TestInstallLinuxSystemctlStub is forbidden on host OS "%s" (linux only)\n' "${AIOS_TEST_HOST_OS:-unknown}" >&2
        return 1
    fi

    mkdir -p "$bin_dir" "$state_dir" "$(dirname "$log_file")"
    touch "$log_file"

    local stub_path="$bin_dir/systemctl"
    {
        printf '#!/usr/bin/env bash\n'
        printf 'DEFAULT_LOG_FILE=%q\n' "$log_file"
        printf 'DEFAULT_STATE_DIR=%q\n' "$state_dir"
        cat <<'MOCKSYS'
LOG_FILE="${AIOS_STUB_SYSTEMCTL_LOG:-$DEFAULT_LOG_FILE}"
STATE_DIR="${AIOS_STUB_SYSTEMCTL_STATE_DIR:-${AIOS_MOCK_SVC_STATE_DIR:-$DEFAULT_STATE_DIR}}"

if [ -n "$LOG_FILE" ]
then
    printf '%s\n' "$*" >> "$LOG_FILE"
fi

action=""
target=""
has_now=0
for arg in "$@"
do
    case "$arg" in
        --now)
            has_now=1
        ;;
        -*)
            continue
        ;;
        *)
            if [ -z "$action" ]
            then
                action="$arg"
            elif [ -z "$target" ]
            then
                target="$arg"
            fi
        ;;
    esac
done

unit="${target%.service}"

if [ -n "$STATE_DIR" ]
then
    mkdir -p "$STATE_DIR"
    case "$action" in
        daemon-reload)
            count_file="$STATE_DIR/daemon_reload_count"
            reload_count=0
            if [ -f "$count_file" ]
            then
                reload_count=$(cat "$count_file" 2> /dev/null || printf '0')
            fi
            reload_count=$((reload_count + 1))
            printf '%d\n' "$reload_count" > "$count_file"

            if [ -f "$STATE_DIR/fail_daemon_reload" ]
            then
                printf 'Failed to reload daemon: mock persistent failure\n' >&2
                exit 1
            fi

            if [ -f "$STATE_DIR/fail_next_daemon_reload" ]
            then
                rm -f "$STATE_DIR/fail_next_daemon_reload"
                printf 'Failed to reload daemon: mock transient failure\n' >&2
                exit 1
            fi

            if [ -f "$STATE_DIR/fail_nth_daemon_reload" ]
            then
                nth=$(cat "$STATE_DIR/fail_nth_daemon_reload" 2> /dev/null || printf '0')
                if [ "$reload_count" -eq "$nth" ]
                then
                    printf 'Failed to reload daemon: mock nth failure (%d)\n' "$nth" >&2
                    exit 1
                fi
            fi

            exit 0
        ;;
        is-active)
            if [ -f "$STATE_DIR/${unit}.active" ]
            then
                exit 0
            fi
            exit 3
        ;;
        is-enabled)
            if [ -f "$STATE_DIR/${unit}.enabled" ]
            then
                exit 0
            fi
            exit 1
        ;;
        enable)
            touch "$STATE_DIR/${unit}.enabled"
            if [ "$has_now" -eq 1 ]
            then
                touch "$STATE_DIR/${unit}.active"
            fi
            exit 0
        ;;
        disable)
            rm -f "$STATE_DIR/${unit}.enabled"
            if [ "$has_now" -eq 1 ]
            then
                rm -f "$STATE_DIR/${unit}.active"
            fi
            exit 0
        ;;
        start|restart|reload|try-reload-or-restart)
            if [ -f "$STATE_DIR/fail_next_restart" ]
            then
                rm -f "$STATE_DIR/fail_next_restart"
                rm -f "$STATE_DIR/${unit}.active"
                printf 'mock restart failed\n' >&2
                exit 1
            fi

            if [ -f "$STATE_DIR/fail_all_restarts" ]
            then
                rm -f "$STATE_DIR/${unit}.active"
                printf 'mock persistent restart failure\n' >&2
                exit 1
            fi

            touch "$STATE_DIR/${unit}.active"
            exit 0
        ;;
        stop)
            rm -f "$STATE_DIR/${unit}.active"
            exit 0
        ;;
        status)
            if [ -f "$STATE_DIR/${unit}.active" ]
            then
                printf '%s.service - mock service\n   Active: active (running)\n' "$unit"
                exit 0
            fi
            printf '%s.service - mock service\n   Active: inactive (dead)\n' "$unit"
            exit 3
        ;;
    esac
fi

exit 0
MOCKSYS
    } > "$stub_path"
    chmod +x "$stub_path"
}

TestInstallMacLaunchctlStub()
{
    local bin_dir="$1"
    local log_file="$2"
    local state_dir="$3"

    if [ "${AIOS_TEST_HOST_OS:-}" != "mac" ]
    then
        printf '[ERROR] TestInstallMacLaunchctlStub is forbidden on host OS "%s" (mac only)\n' "${AIOS_TEST_HOST_OS:-unknown}" >&2
        return 1
    fi

    mkdir -p "$bin_dir" "$state_dir" "$(dirname "$log_file")"
    touch "$log_file"

    local stub_path="$bin_dir/launchctl"
    {
        printf '#!/usr/bin/env bash\n'
        printf 'DEFAULT_LOG_FILE=%q\n' "$log_file"
        printf 'DEFAULT_STATE_DIR=%q\n' "$state_dir"
        cat <<'MOCKLAUNCH'
LOG_FILE="${AIOS_STUB_LAUNCHCTL_LOG:-$DEFAULT_LOG_FILE}"
STATE_DIR="${AIOS_STUB_LAUNCHCTL_STATE_DIR:-${AIOS_MOCK_SVC_STATE_DIR:-$DEFAULT_STATE_DIR}}"

if [ -n "$LOG_FILE" ]
then
    printf '%s\n' "$*" >> "$LOG_FILE"
fi

action="${1:-}"
shift || true

target=""
for arg in "$@"
do
    case "$arg" in
        -*)
            continue
        ;;
        *)
            target="$arg"
        ;;
    esac
done

label=""
case "$target" in
    gui/*/*)
        label="${target##*/}"
    ;;
    *.plist)
        label="${target##*/}"
        label="${label%.plist}"
    ;;
    *)
        label="${target##*/}"
    ;;
esac

short_label=""
case "$label" in
    com.aios.*)
        short_label="${label#com.aios.}"
    ;;
esac

if [ -n "$STATE_DIR" ]
then
    mkdir -p "$STATE_DIR"
    case "$action" in
        print)
            if [ -f "$STATE_DIR/${label}.active" ] || { [ -n "$short_label" ] && [ -f "$STATE_DIR/${short_label}.active" ]; }
            then
                printf 'gui/%s/%s = {\n    state = running\n    pid = 12345\n}\n' "${UID:-501}" "$label"
                exit 0
            fi
            exit 113
        ;;
        load|bootstrap|kickstart)
            if [ -f "$STATE_DIR/fail_next_restart" ]
            then
                rm -f "$STATE_DIR/fail_next_restart"
                rm -f "$STATE_DIR/${label}.active"
                if [ -n "$short_label" ]
                then
                    rm -f "$STATE_DIR/${short_label}.active"
                fi
                printf 'mock launchctl load failed\n' >&2
                exit 1
            fi

            if [ -f "$STATE_DIR/fail_all_restarts" ]
            then
                rm -f "$STATE_DIR/${label}.active"
                if [ -n "$short_label" ]
                then
                    rm -f "$STATE_DIR/${short_label}.active"
                fi
                printf 'mock launchctl persistent failure\n' >&2
                exit 1
            fi

            touch "$STATE_DIR/${label}.active"
            if [ -n "$short_label" ]
            then
                touch "$STATE_DIR/${short_label}.active"
            fi
            exit 0
        ;;
        unload|bootout)
            rm -f "$STATE_DIR/${label}.active"
            if [ -n "$short_label" ]
            then
                rm -f "$STATE_DIR/${short_label}.active"
            fi
            exit 0
        ;;
    esac
fi

exit 0
MOCKLAUNCH
    } > "$stub_path"
    chmod +x "$stub_path"
}

MockInquirerEnsureStateDir()
{
    if [ -z "${MOCK_INQUIRER_STATE_DIR:-}" ] || [ ! -d "$MOCK_INQUIRER_STATE_DIR" ]
    then
        MOCK_INQUIRER_STATE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/aios-mock-inq.XXXXXX")
        printf '0\n' > "$MOCK_INQUIRER_STATE_DIR/pos"
        : > "$MOCK_INQUIRER_STATE_DIR/trace"
    fi
}

MockInquirerReset()
{
    MOCK_INQUIRER_QUEUE=()
    MOCK_INQUIRER_POS=0
    MOCK_INQUIRER_TRACE=()
    MockInquirerEnsureStateDir
    printf '0\n' > "$MOCK_INQUIRER_STATE_DIR/pos"
    : > "$MOCK_INQUIRER_STATE_DIR/trace"
}

MockInquirerCleanup()
{
    if [ -n "${MOCK_INQUIRER_STATE_DIR:-}" ] && [ -d "$MOCK_INQUIRER_STATE_DIR" ]
    then
        rm -rf "$MOCK_INQUIRER_STATE_DIR"
        MOCK_INQUIRER_STATE_DIR=""
    fi
}

MockInquirerPush()
{
    local val
    for val in "$@"
    do
        MOCK_INQUIRER_QUEUE+=("$val")
    done
}

AssertInquirerDrained()
{
    local label="$1"
    local pos="$MOCK_INQUIRER_POS"

    if [ -n "${MOCK_INQUIRER_STATE_DIR:-}" ] && [ -f "$MOCK_INQUIRER_STATE_DIR/pos" ]
    then
        pos=$(cat "$MOCK_INQUIRER_STATE_DIR/pos")
        MOCK_INQUIRER_POS="$pos"
    fi

    if [ "$SHOW_OUTPUT" -eq 1 ] && [ -n "${MOCK_INQUIRER_STATE_DIR:-}" ] && [ -s "$MOCK_INQUIRER_STATE_DIR/trace" ]
    then
        printf '\n--- [TRACE] %s ---\n' "$label"
        cat "$MOCK_INQUIRER_STATE_DIR/trace"
        printf -- '--- [END TRACE] %s ---\n' "$label"
    fi

    local remaining=$(( ${#MOCK_INQUIRER_QUEUE[@]} - pos ))

    if [ "$remaining" -eq 0 ]
    then
        PASS_COUNT=$((PASS_COUNT + 1))
        HarnessRecordCase "PASS" "$label"
        HarnessEmitEvent "[PASS] ${label} (steps=${pos})"
    else
        RecordFail "${label}: ${remaining} unused mock input(s) left in queue (consumed=${pos}, queued=${#MOCK_INQUIRER_QUEUE[@]})"
    fi
}

inquirer()
{
    local kind="$1"
    local prompt="$2"
    shift 2
    local out_var=""
    local next_val=""
    local pos="$MOCK_INQUIRER_POS"

    if [ -n "${MOCK_INQUIRER_STATE_DIR:-}" ] && [ -f "$MOCK_INQUIRER_STATE_DIR/pos" ]
    then
        pos=$(cat "$MOCK_INQUIRER_STATE_DIR/pos")
    fi

    if [ "$pos" -ge "${#MOCK_INQUIRER_QUEUE[@]}" ]
    then
        HarnessEmitFail "[FAIL] inquirer(${kind} \"${prompt}\"): mock queue exhausted at step ${pos}"
        return 1
    fi

    next_val="${MOCK_INQUIRER_QUEUE[$pos]}"
    pos=$((pos + 1))
    MOCK_INQUIRER_POS="$pos"

    if [ -n "${MOCK_INQUIRER_STATE_DIR:-}" ] && [ -d "$MOCK_INQUIRER_STATE_DIR" ]
    then
        printf '%d\n' "$pos" > "$MOCK_INQUIRER_STATE_DIR/pos"
    fi

    local trace_line=""
    case "$kind" in
        list_input_index)
            local arr_name="$1"
            out_var="$2"
            local opts_len=0
            eval "opts_len=\${#${arr_name}[@]}"

            if ! [[ "$next_val" =~ ^[0-9]+$ ]] || [ "$next_val" -ge "$opts_len" ]
            then
                HarnessEmitFail "[FAIL] inquirer(list_input_index \"${prompt}\"): index ${next_val} out of range [0..${opts_len})"
                return 1
            fi

            local chosen_label=""
            eval "chosen_label=\"\${${arr_name}[$next_val]}\""
            trace_line="[STEP $pos] $kind \"$prompt\" => [$next_val] $chosen_label"
            read -r "${out_var?}" <<< "$next_val"
        ;;
        list_input|list_input_ny)
            local arr_name="$1"
            out_var="$2"
            trace_line="[STEP $pos] $kind \"$prompt\" => $next_val"
            read -r "${out_var?}" <<< "$next_val"
        ;;
        text_input)
            out_var="$1"
            trace_line="[STEP $pos] $kind \"$prompt\" => \"$next_val\""
            read -r "${out_var?}" <<< "$next_val"
        ;;
        checkbox_input|checkbox_input_indices)
            local arr_name="$1"
            out_var="$2"
            trace_line="[STEP $pos] $kind \"$prompt\" => [$next_val]"
            IFS="," read -r -a "${out_var?}" <<< "$next_val"
        ;;
        *)
            return 1
        ;;
    esac

    MOCK_INQUIRER_TRACE+=("$trace_line")

    if [ -n "${MOCK_INQUIRER_STATE_DIR:-}" ] && [ -d "$MOCK_INQUIRER_STATE_DIR" ]
    then
        printf '%s\n' "$trace_line" >> "$MOCK_INQUIRER_STATE_DIR/trace"
    fi
}

ServiceControl()
{
    MOCK_SERVICE_CALLS+=("$*")
    return 0
}

ExitOnList()
{
    return 0
}

ExitOnText()
{
    inquirer text_input "$1" "$2" "${i18n_cancel:-}" "${3:-}" "${4:-}"
}

gettext()
{
    printf '%s' "$1"
}

eval_gettext()
{
    # shellcheck disable=SC2046
    gettext "$1" | (export PATH $(envsubst --variables "$1"); envsubst "$1")
}
